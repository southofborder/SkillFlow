{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {"type": "string", "enum": ["completed", "partial"]},
    "declared_purpose": {"type": "string"},
    "data_operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {"type": "string"},
          "source": {"type": "string"},
          "data_scope": {"type": "string"},
          "recipient_or_storage": {"type": "string"},
          "condition": {"type": "string"},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/source_range"}}
        },
        "required": ["operation", "source", "data_scope", "recipient_or_storage", "condition", "evidence"]
      }
    },
    "potential_excess": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data_scope": {"type": "string"},
          "recipient_or_storage": {"type": "string"},
          "condition": {"type": "string"},
          "purpose_basis": {"type": "string"},
          "necessary_behavior": {"type": "string"},
          "proposed_reduction": {"type": "string"},
          "preservation_conditions": {"type": "string"},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/source_range"}}
        },
        "required": ["data_scope", "recipient_or_storage", "condition", "purpose_basis", "necessary_behavior", "proposed_reduction", "preservation_conditions", "evidence"]
      }
    },
    "unknowns": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["status", "declared_purpose", "data_operations", "potential_excess", "unknowns"],
  "$defs": {
    "source_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "start_line": {"type": "integer"},
        "end_line": {"type": "integer"}
      },
      "required": ["path", "start_line", "end_line"]
    }
  }
}
