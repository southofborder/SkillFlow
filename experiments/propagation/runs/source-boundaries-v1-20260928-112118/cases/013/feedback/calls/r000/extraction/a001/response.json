_fetch_first_call\",\n      \"block_name\": \"Try fast.fetch first with source_id and FAST_KEY\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"call_fast_fetch_first\",\n          \"opcode\": \"fast.fetch\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"fast.fetch\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"source_id\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_key\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_fetch_first_response\"\n            }\n          ],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"go_check_fast_fetch_first\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"decide_fast_fetch_first_outcome\",\n      \"block_name\": \"Classify the first fast.fetch attempt\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"classify_fast_fetch_first_instruction\",\n          \"opcode\": \"classify_fast_fetch_outcome\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_fetch_first_response\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_fetch_first_outcome\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_fetch_first_body\"\n            }\n          ],\n          \"constraints\": []\n        },\n        {\n          \"instructi