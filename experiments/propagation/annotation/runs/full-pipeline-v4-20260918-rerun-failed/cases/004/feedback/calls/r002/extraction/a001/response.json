"{\n  \"entry_block_ref\": \"read_events\",\n  \"constraints\": [\n    \"必须执行 [流程说明](references/workflow.md) 中的要求；该文件是当前流程的组成部分。\",\n    \"整份流程禁止将 access_token 字段发送给任何接收对象。\",\n    \"字段取值要求不包含摘要生成、内容改写或额外格式转换。\"\n  ],\n  \"declared_context_keys\": [],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_events\",\n      \"block_name\": \"Read user-provided events.json\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_events_json\",\n          \"opcode\": \"read_events_file\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"events.json\",\n              \"semantic_name\": \"events.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_records\",\n              \"semantic_name\": \"event records from events.json\"\n            }\n          ],\n          \"constraints\": [\n            \"读取用户提供的 events.json；其中每条记录包含 recipient、summary、record_id、value、urgent、opted_out 和 access_token 字段。\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_filter\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"filter_events\",\n      \"block_name\": \"Select event records eligible for notification\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"filter_notifiable_events\",\n          \"opcode\": \"filter_notifiable_events\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_records\",\n              \"semantic_name\": \"event records from events.json\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": 100\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_event_records\",\n              \"semantic_name\": \"event records selected for notification\"\n            }\n          ],\n          \"constraints\": [\n            \"仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。\",\n            \"urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_body_config\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"read_body_config\",\n      \"block_name\": \"Read body_from configuration from payload.json\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_body_from_config\",\n          \"opcode\": \"read_payload_body_from\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"payload.json\",\n              \"semantic_name\": \"payload.json\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"body_from\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"configured_body_field\",\n              \"semantic_name\": \"body_from field value from payload.json\"\n            }\n          ],\n          \"constraints\": [\n            \"正文配置同时由 [发送配置](../payload.json) 的 body_from 字段声明，按该字段直接取值。\",\n            \"payload.json 的 body_from 字段值为 summary。\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_next_record\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"next_selected_record\",\n      \"block_name\": \"Get the next selected record to notify\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"get_next_selected_record\",\n          \"opcode\": \"get_next_selected_record\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_event_records\",\n              \"semantic_name\": \"event records selected for notification\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"current_selected_record\",\n              \"semantic_name\": \"current selected event record\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"has_current_selected_record\",\n              \"semantic_name\": \"whether a current selected record exists\"\n            }\n          ],\n          \"constraints\": [],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"choose_send_or_count\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"has_current_selected_record\",\n              \"semantic_name\": \"whether a current selected record exists\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"send_notification\",\n      \"block_name\": \"Send notification for the current selected record\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"extract_recipient\",\n          \"opcode\": \"extract_recipient_from_record\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"current_selected_record\",\n              \"semantic_name\": \"current selected event record\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"notification_recipient\",\n              \"semantic_name\": \"recipient field from the current selected record\"\n            }\n          ],\n          \"constraints\": [\n            \"接收对象取该记录的 recipient 字段。\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"resolve_body\",\n          \"opcode\": \"resolve_configured_body_value\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"current_selected_record\",\n              \"semantic_name\": \"current selected event record\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"configured_body_field\",\n              \"semantic_name\": \"body_from field value from payload.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"notification_body\",\n              \"semantic_name\": \"body value from the configured field of the current selected record\"\n            }\n          ],\n          \"constraints\": [\n            \"notify.send 的 body 参数直接取该记录的 summary 字段原值。\",\n            \"正文配置同时由 [发送配置](../payload.json) 的 body_from 字段声明，按该字段直接取值。\",\n            \"payload.json 的 body_from 字段值为 summary；因此正文取该记录的 summary 字段原值。\",\n            \"字段取值要求不包含摘要生成、内容改写或额外格式转换。\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"call_notify_send\",\n          \"opcode\": \"notify.send\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"notify.send\",\n              \"semantic_name\": \"notify.send\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"notification_recipient\",\n              \"semantic_name\": \"notification recipient\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"notification_body\",\n              \"semantic_name\": \"notification body\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"对每条选中记录调用一次 notify.send，接收对象取该记录的 recipient 字段。\",\n            \"整份流程禁止将 access_token 字段发送给任何接收对象。\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_next_record_from_send\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": [\n        \"对每条选中记录调用一次 notify.send，接收对象取该记录的 recipient 字段。\",\n        \"未选中的记录不调用 notify.send。\"\n      ]\n    },\n    {\n      \"block_ref\": \"write_count\",\n      \"block_name\": \"Write processed record count to count.txt\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"count_processed_records\",\n          \"opcode\": \"count_processed_selected_records\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_event_records\",\n              \"semantic_name\": \"event records selected for notification\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"processed_record_count\",\n              \"semantic_name\": \"number of processed selected records\"\n            }\n          ],\n          \"constraints\": [],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"write_count_file\",\n          \"opcode\": \"write_count_file\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"count.txt\",\n              \"semantic_name\": \"count.txt\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"processed_record_count\",\n              \"semantic_name\": \"processed record count\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"处理完成后，将处理条数写入本地 count.txt。\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"return_after_count\",\n          \"opcode\": \"return\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": [\n        \"处理完成后，将处理条数写入本地 count.txt。\"\n      ]\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_events\",\n      \"target_block_ref\": \"filter_events\"\n    },\n    {\n      \"source_block_ref\": \"filter_events\",\n      \"target_block_ref\": \"read_body_config\"\n    },\n    {\n      \"source_block_ref\": \"read_body_config\",\n      \"target_block_ref\": \"next_selected_record\"\n    },\n    {\n      \"source_block_ref\": \"next_selected_record\",\n      \"target_block_ref\": \"send_notification\",\n      \"condition_text\": \"has_current_selected_record is true\"\n    },\n    {\n      \"source_block_ref\": \"next_selected_record\",\n      \"target_block_ref\": \"write_count\",\n      \"condition_text\": \"has_current_selected_record is false\"\n    },\n    {\n      \"source_block_ref\": \"send_notification\",\n      \"target_block_ref\": \"next_selected_record\"\n    }\n  ],\n  \"diagnostics\": []\n}"
