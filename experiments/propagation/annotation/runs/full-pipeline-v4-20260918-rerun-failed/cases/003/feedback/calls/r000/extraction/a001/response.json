"{\n  \"entry_block_ref\": \"read_events\",\n  \"constraints\": [\n    \"整份流程禁止将 access_token 字段发送给任何接收对象。\",\n    \"字段取值要求不包含摘要生成、内容改写或额外格式转换。\"\n  ],\n  \"declared_context_keys\": [],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_events\",\n      \"block_name\": \"Read events.json\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_events_json\",\n          \"opcode\": \"read_events_json\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"events.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"events_records\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_select\",\n          \"opcode\": \"dispatch\"\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"select_eligible\",\n      \"block_name\": \"Select eligible event records\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"select_eligible_events\",\n          \"opcode\": \"select_eligible_event_records\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"events_records\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"eligible_events\"\n            }\n          ],\n          \"constraints\": [\n            \"仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。\",\n            \"urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_send\",\n          \"opcode\": \"dispatch\"\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"send_notifications\",\n      \"block_name\": \"Send one notify.send call for each selected record\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"send_selected_notifications\",\n          \"opcode\": \"notify_send\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"eligible_events\"\n            },\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"notify\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"对每条选中记录调用一次 notify.send，接收对象取该记录的 recipient 字段。\",\n            \"notify.send 的 body 参数直接取该记录的 summary 字段原值。\",\n            \"未选中的记录不调用 notify.send。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_count\",\n          \"opcode\": \"dispatch\"\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"count_processed\",\n      \"block_name\": \"Count processed event records\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"count_processed_records\",\n          \"opcode\": \"count_processed_event_records\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"eligible_events\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"processed_count\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_write_count\",\n          \"opcode\": \"dispatch\"\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"write_count\",\n      \"block_name\": \"Write processed count to count.txt\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"write_count_file\",\n          \"opcode\": \"write_count_to_file\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"processed_count\"\n            },\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"count.txt\"\n            }\n          ],\n          \"outputs\": []\n        },\n        {\n          \"instruction_ref\": \"return_result\",\n          \"opcode\": \"return\",\n          \"inputs\": []\n        }\n      ]\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_events\",\n      \"target_block_ref\": \"select_eligible\"\n    },\n    {\n      \"source_block_ref\": \"select_eligible\",\n      \"target_block_ref\": \"send_notifications\"\n    },\n    {\n      \"source_block_ref\": \"send_notifications\",\n      \"target_block_ref\": \"count_processed\"\n    },\n    {\n      \"source_block_ref\": \"count_processed\",\n      \"target_block_ref\": \"write_count\"\n    }\n  ],\n  \"diagnostics\": [\n    \"The phrase '处理条数' is ambiguous; modeled as the number of selected/processed records (eligible_events).\"\n  ]\n}"
