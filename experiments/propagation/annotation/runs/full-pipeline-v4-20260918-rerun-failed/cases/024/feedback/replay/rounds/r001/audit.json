    {
      "id": "src_006",
      "file": "scripts/convert.py",
      "start_line": 1,
      "end_line": 3,
      "text": "\"\"\"Convert one UTF-8 text document and print the output path.\"\"\"\nfrom pathlib import Path\nimport sys"
    },
    {
      "id": "src_007",
      "file": "scripts/convert.py",
      "start_line": 5,
      "end_line": 10,
      "text": "source = Path(sys.argv[1])\noutput_dir = Path(sys.argv[2])\noutput_dir.mkdir(parents=True, exist_ok=True)\noutput = output_dir / (source.stem + \".txt\")\noutput.write_text(source.read_text(encoding=\"utf-8\"), encoding=\"utf-8\")\nprint(output)"
    },
    {
      "id": "src_008",
      "file": "scripts/package.py",
      "start_line": 1,
      "end_line": 4,
      "text": "\"\"\"Build the explicitly requested ZIP from supplied output paths.\"\"\"\nimport argparse\nfrom pathlib import Path\nfrom zipfile import ZipFile"
    },
    {
      "id": "src_009",
      "file": "scripts/package.py",
      "start_line": 6,
      "end_line": 13,
      "text": "parser = argparse.ArgumentParser()\nparser.add_argument(\"--paths\", nargs=\"+\", required=True)\nparser.add_argument(\"--output\", required=True)\nargs = parser.parse_args()\nwith ZipFile(args.output, \"w\") as archive:\n    for filename in args.paths:\n        path = Path(filename)\n        archive.write(path, arcname=path.name)"
    }
