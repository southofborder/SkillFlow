\n              \"type\": \"result\",\n              \"identifier\": \"rendered_pngs\"\n            }\n          ],\n          \"constraints\": [\n            \"Prefer visual review: render PDF pages to PNGs and inspect them.\"\n          ],\n          \"metadata\": {\n            \"script_content\": \"pdftoppm -png $INPUT_PDF $OUTPUT_PREFIX\"\n          }\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_inspection\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"inspect_rendered_pages\",\n      \"block_name\": \"Inspect rendered PNGs for alignment, spacing, legibility, and defects\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"inspect_pngs\",\n          \"opcode\": \"inspect_rendered_pngs_for_visual_defects\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"rendered_pngs\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"zero_visual_defects\"\n            }\n          ],\n          \"constraints\": [\n            \"After each meaningful update, re-render pages and verify alignment, spacing, and legibility.\",\n            \"Do not deliver until the latest PNG inspection shows zero visual or formatting defects.\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"dispatch_on_inspection\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"zero_visual_defects\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"halt_delivery\",\n      \"block_name\": \"Do not deliver while visual or formatting defects remain\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"return_without_delivery\",\n          \"opcode\": \"return\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [\n            \"Do not deliver until the latest PNG inspection shows zero visual or formatting defects.\"\n          ],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"final_checks\",\n      \"block_name\": \"Confirm headers, footers, page numbering, and section transitions before delivery\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"confirm_layout\",\n          \"opcode\": \"confirm_headers_footers_page_numbering_section_transitions\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"rendered_pngs\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"layout_confirmed\"\n            }\n          ],\n          \"constraints\": [\n            \"Confirm headers/footers, page numbering, and section transitions look polished.\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"cleanup_intermediate\",\n          \"opcode\": \"organize_or_remove_intermediate_files\",\n          \"inputs\": [\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"tmp/pdfs/\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"Keep intermediate files organized or remove them after final approval.\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"return_layout_confirmed\",\n          \"opcode\": \"return\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"layout_confirmed\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"install_poppler\",\n      \"block_name\": \"Install Poppler for PDF rendering\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"install_poppler_system_tool\",\n          \"opcode\": \"install_poppler_system_tool\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"poppler\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"If installation isn't possible in this environment, tell the user which dependency is missing and how to install it locally.\"\n          ],\n          \"metadata\": {\n            \"script_content\": \"# macOS (Homebrew)\\nbrew install poppler\\n\\n# Ubuntu/Debian\\nsudo apt-get install -y poppler-utils\"\n          }\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_render_after_poppler\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": [\n        \"System tools (for rendering).\"\n      ]\n    },\n    {\n      \"block_ref\": \"ask_user_to_review_locally\",\n      \"block_name\": \"Ask the user to review the PDF output locally\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"ask_user_to_review\",\n          \"opcode\": \"ask_user_to_review_pdf_locally\",\n          \"inputs\": [],\n          \"outputs\": [\n            {\n              \"