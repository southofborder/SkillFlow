l_pdf_update\",\n          \"opcode\": \"apply_meaningful_pdf_update\",\n          \"inputs\": [],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"updated_pdf\"\n            }\n          ],\n          \"constraints\": [\n            \"After each meaningful update, re-render pages and verify alignment, spacing, and legibility.\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_re_render\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"extract_pdf_text\",\n      \"block_name\": \"Extract text from a PDF with pdfplumber or pypdf\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"extract_pdf_text\",\n          \"opcode\": \"extract_pdf_text_with_pdfplumber_or_pypdf\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"input_pdf\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"extracted_text\"\n            }\n          ],\n          \"constraints\": [\n            \"Use `pdfplumber` (or `pypdf`) for text extraction and quick checks; do not rely on it for layout fidelity.\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"return_extracted_text\",\n          \"opcode\": \"return\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"extracted_text\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n  