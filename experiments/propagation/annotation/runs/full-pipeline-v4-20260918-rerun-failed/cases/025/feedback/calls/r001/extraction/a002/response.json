ity\",\n          \"opcode\": \"read_uv_availability\",\n          \"inputs\": [\n            {\n              \"type\": \"context_key\",\n              \"identifier\": \"uv_available\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"uv_availability\"\n            }\n          ],\n          \"constraints\": [\n            \"Prefer `uv` for dependency management.\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"dispatch_on_uv_availability\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"uv_availability\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"install_python_packages_with_uv\",\n      \"block_name\": \"Install missing Python PDF packages with uv\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"uv_pip_install\",\n          \"opcode\": \"uv_pip_install\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"uv\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"reportlab\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"pdfplumber\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"pypdf\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"Prefer `uv` for dependency management.\",\n            \"Dependencies (install if missing).\",\n            \"If installation isn't possible in this environment, tell the user which dependency is missing and how to install it locally.\"\n          ],\n          \"metadata\": {\n            \"script_content\": \"uv pip install reportlab pdfplumber pypdf\"\n          }\n        },\n        {\n          \"instruction_ref\": \"return_after_uv_install\",\n          \"opcode\": \"return\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"install_python_packages_with_pip\",\n      \"block_name\": \"Install missing Python PDF packages with pip\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"python3_m_pip_install\",\n          \"opcode\": \"python3_m_pip_install\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"python3\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"reportlab\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"pdfplumber\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"pypdf\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"If `uv` is unavailable:\",\n            \"Dependencies (install if missing).\",\n            \"If installation isn't possible in this environment, tell the user which dependency is missing and how to install it locally.\"\n          ],\n          \"metadata\": {\n            \"script_content\": \"python3 -m pip install reportlab pdfplumber pypdf\"\n          }\n        },\n        {\n          \"instruction_ref\": \"return_after_pip_install\",\n          \"opcode\": \"return\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"