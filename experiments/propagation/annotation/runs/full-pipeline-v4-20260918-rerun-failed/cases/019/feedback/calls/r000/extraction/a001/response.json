"{\n  \"entry_block_ref\": \"read_manifest\",\n  \"constraints\": [\n    \"整份流程不得修改输入原文文件。\",\n    \"整份流程禁止把文档上传到外部服务。\"\n  ],\n  \"declared_context_keys\": [\n    \"output_dir\",\n    \"delivery_path\"\n  ],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_manifest\",\n      \"block_name\": \"Read the user-provided manifest.json\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_manifest_file\",\n          \"opcode\": \"read_manifest_file\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"manifest.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"manifest_content\"\n            }\n          ],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"go_extract_paths\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"extract_paths\",\n      \"block_name\": \"Extract document paths from manifest\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"extract_document_paths\",\n          \"opcode\": \"extract_document_paths_from_manifest\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"manifest_content\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"document_paths\"\n            }\n          ],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"go_read_request\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"read_request_context\",\n      \"block_name\": \"Read output_dir and delivery_path from request\",\n      \"data_source_kind\": \"context\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_request_output_dir_and_delivery_path\",\n          \"opcode\": \"read_request_output_dir_and_delivery_path\",\n          \"inputs\": [\n            {\n              \"type\": \"context_key\",\n              \"identifier\": \"output_dir\"\n            },\n            {\n              \"type\": \"context_key\",\n              \"identifier\": \"delivery_path\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_output_dir\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_delivery_path\"\n            }\n          ],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"go_convert_documents\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"convert_documents\",\n      \"block_name\": \"Convert each document with scripts/convert.py\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"run_convert_script_for_each_document\",\n          \"opcode\": \"run_convert_script_for_each_document\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"scripts/convert.py\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"document_paths\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_output_dir\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"converted_artifact_paths\"\n            }\n          ],\n          \"constraints\": [\n            \"转换期间保留原文标题；该要求仅限转换，不限制汇总标题。\",\n            \"转换通过 scripts/convert.py 完成；主流程只使用脚本输出路径，不重复执行脚本内部的处理。\"\n          ],\n          \"metadata\": {\n            \"script_path\": \"scripts/convert.py\",\n            \"command_template\": \"python scripts/convert.py <文档路径> <output_dir>\",\n            \"script_content\": \"\\\"\\\"\\\"Convert one UTF-8 text document and print the output path.\\\"\\\"\\\"\\nfrom pathlib import Path\\nimport sys\\n\\nsource = Path(sys.argv[1])\\noutput_dir = Path(sys.argv[2])\\noutput_dir.mkdir(parents=True, exist_ok=True)\\noutput = output_dir / (source.stem + \\\".txt\\\")\\noutput.write_text(source.read_text(encoding=\\\"utf-8\\\"), encoding=\\\"utf-8\\\")\\nprint(output)\\n\"\n          }\n        },\n        {\n          \"instruction_ref\": \"go_package_bundle\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"package_bundle\",\n      \"block_name\": \"Package converted artifacts into bundle.zip\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"run_package_script\",\n          \"opcode\": \"run_package_script\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"scripts/package.py\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"converted_artifact_paths\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"bundle.zip\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"bundle_zip_path\"\n            }\n          ],\n          \"constraints\": [\n            \"打包时必须采用下方“参考步骤”的命令，并将转换产物路径列表传给 --paths。\"\n          ],\n          \"metadata\": {\n            \"script_path\": \"scripts/package.py\",\n            \"reference_command\": \"python scripts/package.py --paths <转换产物路径列表> --output bundle.zip\",\n            \"script_content\": \"\\\"\\\"\\\"Build the explicitly requested ZIP from supplied output paths.\\\"\\\"\\\"\\nimport argparse\\nfrom pathlib import Path\\nfrom zipfile import ZipFile\\n\\nparser = argparse.ArgumentParser()\\nparser.add_argument(\\\"--paths\\\", nargs=\\\"+\\\", required=True)\\nparser.add_argument(\\\"--output\\\", required=True)\\nargs = parser.parse_args()\\nwith ZipFile(args.output, \\\"w\\\") as archive:\\n    for filename in args.paths:\\n        path = Path(filename)\\n        archive.write(path, arcname=path.name)\\n\"\n          }\n        },\n        {\n          \"instruction_ref\": \"go_deliver_bundle\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"deliver_bundle\",\n      \"block_name\": \"Deliver bundle.zip to the requested delivery_path\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"deliver_bundle_zip\",\n          \"opcode\": \"deliver_bundle_zip\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"bundle_zip_path\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_delivery_path\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"go_write_receipt\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"write_receipt\",\n      \"block_name\": \"Write converted artifact paths to local receipt.txt\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"write_receipt_file\",\n          \"opcode\": \"write_receipt_file\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"converted_artifact_paths\"\n            },\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"receipt.txt\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"return_complete\",\n          \"opcode\": \"return\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_manifest\",\n      \"target_block_ref\": \"extract_paths\"\n    },\n    {\n      \"source_block_ref\": \"extract_paths\",\n      \"target_block_ref\": \"read_request_context\"\n    },\n    {\n      \"source_block_ref\": \"read_request_context\",\n      \"target_block_ref\": \"convert_documents\"\n    },\n    {\n      \"source_block_ref\": \"convert_documents\",\n      \"target_block_ref\": \"package_bundle\"\n    },\n    {\n      \"source_block_ref\": \"package_bundle\",\n      \"target_block_ref\": \"deliver_bundle\"\n    },\n    {\n      \"source_block_ref\": \"deliver_bundle\",\n      \"target_block_ref\": \"write_receipt\"\n    }\n  ],\n  \"diagnostics\": [\n    \"备注“必要时保留原顺序”的适用范围不明确，未提升为 Skill-wide 约束。\"\n  ]\n}"
