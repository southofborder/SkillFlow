                {
                  "name": "Smart Labeling",
                  "description": "Analyze unlabeled issues, suggest/apply labels, and create missing label categories."
                },
                {
                  "name": "Sprint Retrospectives",
                  "description": "Generate a report for the last completed cycle, note completed vs. pushed work, and open discussion issues for patterns."
                }
