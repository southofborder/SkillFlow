"{\n  \"entry_block_ref\": \"read_events\",\n  \"constraints\": [\n    \"未选中的记录不调用 notify.send。\",\n    \"整份流程禁止将 access_token 字段发送给任何接收对象。\",\n    \"字段取值要求不包含摘要生成、内容改写或额外格式转换。\"\n  ],\n  \"declared_context_keys\": [],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_events\",\n      \"block_name\": \"Read events.json\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_events_json\",\n          \"opcode\": \"read_events_json\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"events.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_records\"\n            }\n          ],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"go_to_iteration\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"next_event\",\n      \"block_name\": \"Get next event record\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"get_next_event_record\",\n          \"opcode\": \"get_next_event_record\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_records\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"current_event_record\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"has_more_records\"\n            }\n          ],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"dispatch_has_more\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"has_more_records\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"evaluate_record\",\n      \"block_name\": \"Extract fields and evaluate notification condition\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"extract_notification_fields\",\n          \"opcode\": \"extract_notification_fields\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"current_event_record\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"recipient\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"summary\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"value\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"urgent\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"opted_out\"\n            }\n          ],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"evaluate_notification_condition\",\n          \"opcode\": \"evaluate_notification_condition\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"value\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"urgent\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"opted_out\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": 100\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_for_notification\"\n            }\n          ],\n          \"constraints\": [\n            \"仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。\",\n            \"urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_selection\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_for_notification\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"send_notification\",\n      \"block_name\": \"Send notification for selected event\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"send_notify\",\n          \"opcode\": \"notify.send\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"notify.send\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"recipient\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"summary\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"对每条选中记录调用一次 notify.send，接收对象取该记录的 recipient 字段。\",\n            \"notify.send 的 body 参数直接取该记录的 summary 字段原值。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_next_after_send\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"finish\",\n      \"block_name\": \"Finish processing\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"return_done\",\n          \"opcode\": \"return\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_events\",\n      \"target_block_ref\": \"next_event\",\n      \"condition_text\": null\n    },\n    {\n      \"source_block_ref\": \"next_event\",\n      \"target_block_ref\": \"evaluate_record\",\n      \"condition_text\": \"has_more_records is true\"\n    },\n    {\n      \"source_block_ref\": \"next_event\",\n      \"target_block_ref\": \"finish\",\n      \"condition_text\": \"has_more_records is false\"\n    },\n    {\n      \"source_block_ref\": \"evaluate_record\",\n      \"target_block_ref\": \"send_notification\",\n      \"condition_text\": \"selected_for_notification is true\"\n    },\n    {\n      \"source_block_ref\": \"evaluate_record\",\n      \"target_block_ref\": \"next_event\",\n      \"condition_text\": \"selected_for_notification is false\"\n    },\n    {\n      \"source_block_ref\": \"send_notification\",\n      \"target_block_ref\": \"next_event\",\n      \"condition_text\": null\n    }\n  ],\n  \"diagnostics\": [\n    \"历史示例（当前流程不执行）中的 count.txt 写入未提取为执行行为。\"\n  ]\n}"
