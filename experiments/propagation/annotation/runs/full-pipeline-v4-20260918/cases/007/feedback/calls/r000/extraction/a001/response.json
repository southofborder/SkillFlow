"{\n  \"entry_block_ref\": \"read_request\",\n  \"constraints\": [\n    \"Capability note: index.search supports fuzzy matching; this note does not request fuzzy expansion in this workflow.\",\n    \"Do not invoke index.delete anywhere in this workflow.\",\n    \"Parameter descriptions are call requirements and do not instruct pre-call validation or normalization.\"\n  ],\n  \"declared_context_keys\": [],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_request\",\n      \"block_name\": \"Read the user-supplied request.json\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_request_json\",\n          \"opcode\": \"read_request_json\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"request.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_term\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_from_date\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_limit\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_search\",\n          \"opcode\": \"dispatch\"\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"search_index\",\n      \"block_name\": \"Call index.search with the supplied request parameters\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"call_index_search\",\n          \"opcode\": \"index.search\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"index.search\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_term\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_from_date\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_limit\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"search_response\"\n            }\n          ],\n          \"constraints\": [\n            \"Call index.search exactly once, using request.term unchanged as its query argument.\",\n            \"When from_date is present, pass its value unchanged; the accepted format is YYYY-MM-DD.\",\n            \"When from_date is missing, omit the from_date argument.\",\n            \"When limit is present, pass its value unchanged as the limit argument.\",\n            \"When limit is missing, omit the limit argument.\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_write_and_return\",\n          \"opcode\": \"dispatch\"\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"write_and_return\",\n      \"block_name\": \"Write the response total to count.txt and return the response items\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"extract_total\",\n          \"opcode\": \"extract_total_from_search_response\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"search_response\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"response_total\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"write_count\",\n          \"opcode\": \"write_total_to_count_txt\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"response_total\"\n            },\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"count.txt\"\n            }\n          ],\n          \"constraints\": [\n            \"After the search, write the response's total value to local count.txt.\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"extract_items\",\n          \"opcode\": \"extract_items_from_search_response\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"search_response\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"response_items\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"return_items\",\n          \"opcode\": \"return\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"response_items\"\n            }\n          ],\n          \"constraints\": [\n            \"Return the search response's items value unchanged.\"\n          ]\n        }\n      ]\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_request\",\n      \"target_block_ref\": \"search_index\"\n    },\n    {\n      \"source_block_ref\": \"search_index\",\n      \"target_block_ref\": \"write_and_return\"\n    }\n  ],\n  \"diagnostics\": []\n}"
