"{\n  \"entry_block_ref\": \"read_events\",\n  \"constraints\": [\n    \"整份流程禁止将 access_token 字段发送给任何接收对象。\",\n    \"字段取值要求不包含摘要生成、内容改写或额外格式转换。\"\n  ],\n  \"declared_context_keys\": [],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_events\",\n      \"block_name\": \"读取 events.json\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_events_json\",\n          \"opcode\": \"read_events_json\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"events.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_records\"\n            }\n          ],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"go_select_records\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"select_records\",\n      \"block_name\": \"筛选需要通知的事件记录\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"select_eligible_event_records\",\n          \"opcode\": \"select_eligible_event_records\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_records\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_records\"\n            }\n          ],\n          \"constraints\": [\n            \"仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。\",\n            \"urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_next_selected_record\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"next_selected_record\",\n      \"block_name\": \"遍历选中的事件记录\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"get_next_selected_record\",\n          \"opcode\": \"get_next_selected_record\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_records\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"current_selected_record\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"has_more_selected_records\"\n            }\n          ],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"dispatch_has_more\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"has_more_selected_records\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"send_notification\",\n      \"block_name\": \"发送 notify.send 通知\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"extract_recipient\",\n          \"opcode\": \"extract_record_recipient\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"current_selected_record\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"recipient\"\n            }\n          ],\n          \"constraints\": [\n            \"接收对象取该记录的 recipient 字段。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"extract_summary\",\n          \"opcode\": \"extract_record_summary\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"current_selected_record\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"summary\"\n            }\n          ],\n          \"constraints\": [\n            \"notify.send 的 body 参数直接取该记录的 summary 字段原值。\",\n            \"字段取值要求不包含摘要生成、内容改写或额外格式转换。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"call_notify_send\",\n          \"opcode\": \"notify.send\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"notify.send\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"recipient\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"summary\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"整份流程禁止将 access_token 字段发送给任何接收对象。\",\n            \"对每条选中记录调用一次 notify.send。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_next_record_after_send\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": [\n        \"未选中的记录不调用 notify.send。\"\n      ]\n    },\n    {\n      \"block_ref\": \"write_count\",\n      \"block_name\": \"统计处理条数并写入 count.txt\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"count_processed_records\",\n          \"opcode\": \"count_processed_records\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_records\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"processed_count\"\n            }\n          ],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"write_processed_count\",\n          \"opcode\": \"write_processed_count\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"count.txt\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"processed_count\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"return_done\",\n          \"opcode\": \"return\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": [\n        \"处理完成后，将处理条数写入本地 count.txt。\"\n      ]\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_events\",\n      \"target_block_ref\": \"select_records\"\n    },\n    {\n      \"source_block_ref\": \"select_records\",\n      \"target_block_ref\": \"next_selected_record\"\n    },\n    {\n      \"source_block_ref\": \"next_selected_record\",\n      \"target_block_ref\": \"send_notification\",\n      \"condition_text\": \"has_more_selected_records\"\n    },\n    {\n      \"source_block_ref\": \"next_selected_record\",\n      \"target_block_ref\": \"write_count\",\n      \"condition_text\": \"no more selected records\"\n    },\n    {\n      \"source_block_ref\": \"send_notification\",\n      \"target_block_ref\": \"next_selected_record\"\n    }\n  ],\n  \"diagnostics\": [\n    \"源文本中的“处理条数”未明确说明是全部记录数还是选中记录数；此处按选中并处理的记录数建模为 processed_count。\",\n    \"notify.send 未说明返回值，因此建模为无返回值的副作用调用。\"\n  ]\n}"
