{
  "cfg": {
    "entry_block_id": "block_001",
    "constraints": [
      "整份流程禁止将 access_token 字段发送给任何接收对象。",
      "字段取值要求不包含摘要生成、内容改写或额外格式转换。"
    ],
    "blocks": {
      "block_001": {
        "block_id": "block_001",
        "block_name": "Read user-provided events.json",
        "instructions": [
          {
            "id": "ir_001",
            "opcode": "read_events_json",
            "inputs": [
              {
                "type": "external_resource",
                "identifier": "events.json",
                "semantic_name": "user-provided events.json"
              }
            ],
            "outputs": [
              {
                "type": "result",
                "identifier": "result_001",
                "semantic_name": "event records from events.json"
              }
            ],
            "constraints": [],
            "metadata": {},
            "draft_instruction_id": "read_events_json"
          },
          {
            "id": "ir_002",
            "opcode": "dispatch",
            "inputs": [],
            "outputs": [],
            "constraints": [],
            "metadata": {},
            "draft_instruction_id": "dispatch_to_next_event"
          }
        ],
        "constraints": [
          "读取用户提供的 events.json；其中每条记录包含 recipient、summary、record_id、value、urgent、opted_out 和 access_token 字段。"
        ],
        "data_source_kind": "external"
      },
      "block_002": {
        "block_id": "block_002",
        "block_name": "Iterate to next event record",
        "instructions": [
          {
            "id": "ir_003",
            "opcode": "get_next_event",
            "inputs": [
              {
                "type": "result",
                "identifier": "result_001",
                "semantic_name": "events_records"
              }
            ],
            "outputs": [
              {
                "type": "result",
                "identifier": "result_002",
                "semantic_name": "current_event"
              },
              {
                "type": "result",
                "identifier": "result_003",
                "semantic_name": "has_more_events"
              }
            ],
            "constraints": [],
            "metadata": {},
            "draft_instruction_id": "get_next_event"
          },
          {
            "id": "ir_004",
            "opcode": "dispatch",
            "inputs": [
              {
                "type": "result",
                "identifier": "result_003",
                "semantic_name": "has_more_events"
              }
            ],
            "outputs": [],
            "constraints": [],
            "metadata": {},
            "draft_instruction_id": "dispatch_next_or_done"
          }
        ],
        "constraints": [],
        "data_source_kind": null
      },
      "block_003": {
        "block_id": "block_003",
        "block_name": "Extract event fields for selection and notification",
        "instructions": [
          {
            "id": "ir_005",
            "opcode": "extract_event_fields",
            "inputs": [
              {
                "type": "result",
                "identifier": "result_002",
                "semantic_name": "current_event"
              }
            ],
            "outputs": [
              {
                "type": "result",
                "identifier": "result_004",
                "semantic_name": "event_recipient"
              },
              {
                "type": "result",
                "identifier": "result_005",
                "semantic_name": "event_summary"
              },
              {
                "type": "result",
                "identifier": "result_006",
                "semantic_name": "event_value"
              },
              {
                "type": "result",
                "identifier": "result_007",
                "semantic_name": "event_urgent"
              },
              {
                "type": "result",
                "identifier": "result_008",
                "semantic_name": "event_opted_out"
              }
            ],
            "constraints": [],
            "metadata": {},
            "draft_instruction_id": "extract_event_fields"
          },
          {
            "id": "ir_006",
            "opcode": "dispatch",
            "inputs": [],
            "outputs": [],
            "constraints": [],
            "metadata": {},
            "draft_instruction_id": "dispatch_to_selection"
          }
        ],
        "constraints": [],
        "data_source_kind": null
      },
      "block_004": {
        "block_id": "block_004",
        "block_name": "Select event records matching subscription and urgency/value rules",
        "instructions": [
          {
            "id": "ir_007",
            "opcode": "check_event_selection",
            "inputs": [
              {
                "type": "result",
                "identifier": "result_008",
                "semantic_name": "event_opted_out"
              },
              {
                "type": "literal",
                "identifier": null,
                "literal_value": true
              },
              {
                "type": "result",
                "identifier": "result_007",
                "semantic_name": "event_urgent"
              },
              {
                "type": "literal",
                "identifier": null,
                "literal_value": true
              },
              {
                "type": "result",
                "identifier": "result_006",
                "semantic_name": "event_value"
              },
              {
                "type": "literal",
                "identifier": null,
                "literal_value": 100
              }
            ],
            "outputs": [
              {
                "type": "result",
                "identifier": "result_009",
                "semantic_name": "event_selected"
              }
            ],
            "constraints": [
              "仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。",
              "urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。"
            ],
            "metadata": {},
            "draft_instruction_id": "check_event_selection"
          },
          {
            "id": "ir_008",
            "opcode": "dispatch",
            "inputs": [
              {
                "type": "result",
                "identifier": "result_009",
                "semantic_name": "event_selected"
              }
            ],
            "outputs": [],
            "constraints": [
              "未选中的记录不调用 notify.send。"
            ],
            "metadata": {},
            "draft_instruction_id": "dispatch_selected_or_skip"
          }
        ],
        "constraints": [],
        "data_source_kind": null
      },
      "block_005": {
        "block_id": "block_005",
        "block_name": "Send notification for selected event",
        "instructions": [
          {
            "id": "ir_009",
            "opcode": "notify.send",
            "inputs": [
              {
                "type": "external_resource",
                "identifier": "notify.send",
                "semantic_name": "notification service"
              },
              {
                "type": "result",
                "identifier": "result_004",
                "semantic_name": "event_recipient"
              },
              {
                "type": "result",
                "identifier": "result_005",
                "semantic_name": "event_summary"
              }
            ],
            "outputs": [],
            "constraints": [
              "对每条选中记录调用一次 notify.send，接收对象取该记录的 recipient 字段。",
              "notify.send 的 body 参数直接取该记录的 summary 字段原值。"
            ],
            "metadata": {},
            "draft_instruction_id": "notify_send"
          },
          {
            "id": "ir_010",
            "opcode": "dispatch",
            "inputs": [],
            "outputs": [],
            "constraints": [],
            "metadata": {},
            "draft_instruction_id": "dispatch_after_send"
          }
        ],
        "constraints": [],
        "data_source_kind": null
      },
      "block_006": {
        "block_id": "block_006",
        "block_name": "Count processed event records",
        "instructions": [
          {
            "id": "ir_011",
            "opcode": "count_processed_records",
            "inputs": [
              {
                "type": "result",
                "identifier": "result_001",
                "semantic_name": "events_records"
              }
            ],
            "outputs": [
              {
                "type": "result",
                "identifier": "result_010",
                "semantic_name": "processed_count"
              }
            ],
            "constraints": [],
            "metadata": {},
            "draft_instruction_id": "count_processed_records"
          },
          {
            "id": "ir_012",
            "opcode": "dispatch",
            "inputs": [],
            "outputs": [],
            "constraints": [],
            "metadata": {},
            "draft_instruction_id": "dispatch_to_write_count"
          }
        ],
        "constraints": [],
        "data_source_kind": null
      },
      "block_007": {
        "block_id": "block_007",
        "block_name": "Write processed count to local count.txt",
        "instructions": [
          {
            "id": "ir_013",
            "opcode": "write_count_txt",
            "inputs": [
              {
                "type": "external_resource",
                "identifier": "count.txt",
                "semantic_name": "local count file"
              },
              {
                "type": "result",
                "identifier": "result_010",
                "semantic_name": "processed_count"
              }
            ],
            "outputs": [],
            "constraints": [
              "处理完成后，将处理条数写入本地 count.txt。"
            ],
            "metadata": {},
            "draft_instruction_id": "write_count_file"
          },
          {
            "id": "ir_014",
            "opcode": "return",
            "inputs": [],
            "outputs": [],
            "constraints": [],
            "metadata": {},
            "draft_instruction_id": "return_done"
          }
        ],
        "constraints": [],
        "data_source_kind": null
      }
    },
    "edges": [
      {
        "source_block_id": "block_001",
        "target_block_id": "block_002",
        "condition_text": null
      },
      {
        "source_block_id": "block_002",
        "target_block_id": "block_003",
        "condition_text": "has_more_events is true"
      },
      {
        "source_block_id": "block_002",
        "target_block_id": "block_006",
        "condition_text": "has_more_events is false"
      },
      {
        "source_block_id": "block_003",
        "target_block_id": "block_004",
        "condition_text": null
      },
      {
        "source_block_id": "block_004",
        "target_block_id": "block_005",
        "condition_text": "event_selected is true"
      },
      {
        "source_block_id": "block_004",
        "target_block_id": "block_002",
        "condition_text": "event_selected is false; unselected record is skipped"
      },
      {
        "source_block_id": "block_005",
        "target_block_id": "block_002",
        "condition_text": null
      },
      {
        "source_block_id": "block_006",
        "target_block_id": "block_007",
        "condition_text": null
      }
    ],
    "declared_context_keys": []
  }
}
