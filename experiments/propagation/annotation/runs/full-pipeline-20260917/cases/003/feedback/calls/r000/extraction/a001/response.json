"{\n  \"entry_block_ref\": \"read_events\",\n  \"constraints\": [\n    \"整份流程禁止将 access_token 字段发送给任何接收对象。\",\n    \"字段取值要求不包含摘要生成、内容改写或额外格式转换。\"\n  ],\n  \"declared_context_keys\": [],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_events\",\n      \"block_name\": \"Read user-provided events.json\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_events_json\",\n          \"opcode\": \"read_events_json\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"events.json\",\n              \"semantic_name\": \"user-provided events.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"events_records\",\n              \"semantic_name\": \"event records from events.json\"\n            }\n          ],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_next_event\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": [\n        \"读取用户提供的 events.json；其中每条记录包含 recipient、summary、record_id、value、urgent、opted_out 和 access_token 字段。\"\n      ]\n    },\n    {\n      \"block_ref\": \"next_event\",\n      \"block_name\": \"Iterate to next event record\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"get_next_event\",\n          \"opcode\": \"get_next_event\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"events_records\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"current_event\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"has_more_events\"\n            }\n          ],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"dispatch_next_or_done\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"has_more_events\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"extract_event\",\n      \"block_name\": \"Extract event fields for selection and notification\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"extract_event_fields\",\n          \"opcode\": \"extract_event_fields\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"current_event\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_recipient\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_summary\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_value\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_urgent\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_opted_out\"\n            }\n          ],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_selection\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"evaluate_selection\",\n      \"block_name\": \"Select event records matching subscription and urgency/value rules\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"check_event_selection\",\n          \"opcode\": \"check_event_selection\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_opted_out\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": true\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_urgent\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": true\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_value\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": 100\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_selected\"\n            }\n          ],\n          \"constraints\": [\n            \"仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。\",\n            \"urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_selected_or_skip\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_selected\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"未选中的记录不调用 notify.send。\"\n          ]\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"send_notification\",\n      \"block_name\": \"Send notification for selected event\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"notify_send\",\n          \"opcode\": \"notify.send\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"notify.send\",\n              \"semantic_name\": \"notification service\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_recipient\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_summary\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"对每条选中记录调用一次 notify.send，接收对象取该记录的 recipient 字段。\",\n            \"notify.send 的 body 参数直接取该记录的 summary 字段原值。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_after_send\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"count_processed\",\n      \"block_name\": \"Count processed event records\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"count_processed_records\",\n          \"opcode\": \"count_processed_records\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"events_records\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"processed_count\"\n            }\n          ],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_write_count\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"write_count\",\n      \"block_name\": \"Write processed count to local count.txt\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"write_count_file\",\n          \"opcode\": \"write_count_txt\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"count.txt\",\n              \"semantic_name\": \"local count file\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"processed_count\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"处理完成后，将处理条数写入本地 count.txt。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"return_done\",\n          \"opcode\": \"return\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": []\n        }\n      ],\n      \"constraints\": []\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_events\",\n      \"target_block_ref\": \"next_event\"\n    },\n    {\n      \"source_block_ref\": \"next_event\",\n      \"target_block_ref\": \"extract_event\",\n      \"condition_text\": \"has_more_events is true\"\n    },\n    {\n      \"source_block_ref\": \"next_event\",\n      \"target_block_ref\": \"count_processed\",\n      \"condition_text\": \"has_more_events is false\"\n    },\n    {\n      \"source_block_ref\": \"extract_event\",\n      \"target_block_ref\": \"evaluate_selection\"\n    },\n    {\n      \"source_block_ref\": \"evaluate_selection\",\n      \"target_block_ref\": \"send_notification\",\n      \"condition_text\": \"event_selected is true\"\n    },\n    {\n      \"source_block_ref\": \"evaluate_selection\",\n      \"target_block_ref\": \"next_event\",\n      \"condition_text\": \"event_selected is false; unselected record is skipped\"\n    },\n    {\n      \"source_block_ref\": \"send_notification\",\n      \"target_block_ref\": \"next_event\"\n    },\n    {\n      \"source_block_ref\": \"count_processed\",\n      \"target_block_ref\": \"write_count\"\n    }\n  ],\n  \"diagnostics\": [\n    \"Step 9 的“处理条数”未明确区分全部事件记录与选中/发送记录；按字面建模为已处理的事件记录总数。\"\n  ]\n}"
