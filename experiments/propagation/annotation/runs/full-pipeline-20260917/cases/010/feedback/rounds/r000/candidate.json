{
  "entry_block_ref": "read_request",
  "constraints": [
    "Call index.search exactly once.",
    "Do not invoke index.delete anywhere in this workflow.",
    "Capability note: index.search supports fuzzy matching; this note does not request fuzzy expansion in this workflow.",
    "Parameter descriptions are call requirements and do not instruct pre-call validation or normalization.",
    "Apply the missing-argument settings in query configuration to this same call.",
    "missing_arguments: from_date: omit, limit: omit"
  ],
  "declared_context_keys": [],
  "blocks": [
    {
      "block_ref": "read_request",
      "block_name": "Read the user-supplied request.json",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "read_request_json",
          "opcode": "read_request_json",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "request.json"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "request_term"
            },
            {
              "type": "result",
              "identifier": "request_from_date"
            },
            {
              "type": "result",
              "identifier": "request_limit"
            },
            {
              "type": "result",
              "identifier": "from_date_present"
            },
            {
              "type": "result",
              "identifier": "limit_present"
            }
          ],
          "constraints": [
            "Read the user-supplied request.json, which contains term and may contain from_date and limit."
          ]
        },
        {
          "instruction_ref": "go_choose_args",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "choose_args",
      "block_name": "Choose index.search arguments based on optional parameters",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "choose_search_args",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "from_date_present"
            },
            {
              "type": "result",
              "identifier": "limit_present"
            }
          ]
        }
      ],
      "constraints": [
        "When from_date is present, pass its value unchanged; the accepted format is YYYY-MM-DD.",
        "When from_date is missing, omit the from_date argument.",
        "When limit is present, pass its value unchanged as the limit argument.",
        "When limit is missing, omit the limit argument."
      ]
    },
    {
      "block_ref": "search_both",
      "block_name": "Call index.search with term, from_date, and limit",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "call_index_both",
          "opcode": "index.search",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "index.search"
            },
            {
              "type": "result",
              "identifier": "request_term"
            },
            {
              "type": "result",
              "identifier": "request_from_date"
            },
            {
              "type": "result",
              "identifier": "request_limit"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "search_response_both"
            }
          ],
          "constraints": [
            "Use request.term unchanged as its query argument.",
            "Pass from_date value unchanged; the accepted format is YYYY-MM-DD.",
            "Pass limit value unchanged as the limit argument."
          ]
        },
        {
          "instruction_ref": "go_extract_from_both",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "search_from_date",
      "block_name": "Call index.search with term and from_date",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "call_index_from_date",
          "opcode": "index.search",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "index.search"
            },
            {
              "type": "result",
              "identifier": "request_term"
            },
            {
              "type": "result",
              "identifier": "request_from_date"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "search_response_from_date"
            }
          ],
          "constraints": [
            "Use request.term unchanged as its query argument.",
            "Pass from_date value unchanged; the accepted format is YYYY-MM-DD."
          ]
        },
        {
          "instruction_ref": "go_extract_from_from_date",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "search_limit",
      "block_name": "Call index.search with term and limit",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "call_index_limit",
          "opcode": "index.search",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "index.search"
            },
            {
              "type": "result",
              "identifier": "request_term"
            },
            {
              "type": "result",
              "identifier": "request_limit"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "search_response_limit"
            }
          ],
          "constraints": [
            "Use request.term unchanged as its query argument.",
            "Pass limit value unchanged as the limit argument."
          ]
        },
        {
          "instruction_ref": "go_extract_from_limit",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "search_none",
      "block_name": "Call index.search with term only",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "call_index_none",
          "opcode": "index.search",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "index.search"
            },
            {
              "type": "result",
              "identifier": "request_term"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "search_response_none"
            }
          ],
          "constraints": [
            "Use request.term unchanged as its query argument."
          ]
        },
        {
          "instruction_ref": "go_extract_from_none",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "extract_response",
      "block_name": "Extract total and items from the search response",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "extract_total_items",
          "opcode": "extract_search_total_and_items",
          "inputs": [
            {
              "type": "result",
              "identifier": "search_response_both"
            },
            {
              "type": "result",
              "identifier": "search_response_from_date"
            },
            {
              "type": "result",
              "identifier": "search_response_limit"
            },
            {
              "type": "result",
              "identifier": "search_response_none"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "search_total"
            },
            {
              "type": "result",
              "identifier": "search_items"
            }
          ]
        },
        {
          "instruction_ref": "go_write_count",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "write_and_return",
      "block_name": "Write total to count.txt and return items",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "write_count",
          "opcode": "write_count_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "count.txt"
            },
            {
              "type": "result",
              "identifier": "search_total"
            }
          ],
          "constraints": [
            "After the search, write the response's total value to local count.txt."
          ]
        },
        {
          "instruction_ref": "return_items",
          "opcode": "return",
          "inputs": [
            {
              "type": "result",
              "identifier": "search_items"
            }
          ],
          "constraints": [
            "Return the search response's items value unchanged."
          ]
        }
      ]
    }
  ],
  "edges": [
    {
      "source_block_ref": "read_request",
      "target_block_ref": "choose_args"
    },
    {
      "source_block_ref": "choose_args",
      "target_block_ref": "search_both",
      "condition_text": "from_date present and limit present"
    },
    {
      "source_block_ref": "choose_args",
      "target_block_ref": "search_from_date",
      "condition_text": "from_date present and limit missing"
    },
    {
      "source_block_ref": "choose_args",
      "target_block_ref": "search_limit",
      "condition_text": "from_date missing and limit present"
    },
    {
      "source_block_ref": "choose_args",
      "target_block_ref": "search_none",
      "condition_text": "from_date missing and limit missing"
    },
    {
      "source_block_ref": "search_both",
      "target_block_ref": "extract_response"
    },
    {
      "source_block_ref": "search_from_date",
      "target_block_ref": "extract_response"
    },
    {
      "source_block_ref": "search_limit",
      "target_block_ref": "extract_response"
    },
    {
      "source_block_ref": "search_none",
      "target_block_ref": "extract_response"
    },
    {
      "source_block_ref": "extract_response",
      "target_block_ref": "write_and_return"
    }
  ],
  "diagnostics": []
}
