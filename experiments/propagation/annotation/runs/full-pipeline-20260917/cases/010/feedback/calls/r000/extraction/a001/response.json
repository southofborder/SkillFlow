"{\n  \"entry_block_ref\": \"read_request\",\n  \"constraints\": [\n    \"Call index.search exactly once.\",\n    \"Do not invoke index.delete anywhere in this workflow.\",\n    \"Capability note: index.search supports fuzzy matching; this note does not request fuzzy expansion in this workflow.\",\n    \"Parameter descriptions are call requirements and do not instruct pre-call validation or normalization.\",\n    \"Apply the missing-argument settings in query configuration to this same call.\",\n    \"missing_arguments: from_date: omit, limit: omit\"\n  ],\n  \"declared_context_keys\": [],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_request\",\n      \"block_name\": \"Read the user-supplied request.json\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_request_json\",\n          \"opcode\": \"read_request_json\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"request.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_term\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_from_date\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_limit\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"from_date_present\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"limit_present\"\n            }\n          ],\n          \"constraints\": [\n            \"Read the user-supplied request.json, which contains term and may contain from_date and limit.\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_choose_args\",\n          \"opcode\": \"dispatch\"\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"choose_args\",\n      \"block_name\": \"Choose index.search arguments based on optional parameters\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"choose_search_args\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"from_date_present\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"limit_present\"\n            }\n          ]\n        }\n      ],\n      \"constraints\": [\n        \"When from_date is present, pass its value unchanged; the accepted format is YYYY-MM-DD.\",\n        \"When from_date is missing, omit the from_date argument.\",\n        \"When limit is present, pass its value unchanged as the limit argument.\",\n        \"When limit is missing, omit the limit argument.\"\n      ]\n    },\n    {\n      \"block_ref\": \"search_both\",\n      \"block_name\": \"Call index.search with term, from_date, and limit\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"call_index_both\",\n          \"opcode\": \"index.search\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"index.search\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_term\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_from_date\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_limit\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"search_response_both\"\n            }\n          ],\n          \"constraints\": [\n            \"Use request.term unchanged as its query argument.\",\n            \"Pass from_date value unchanged; the accepted format is YYYY-MM-DD.\",\n            \"Pass limit value unchanged as the limit argument.\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_extract_from_both\",\n          \"opcode\": \"dispatch\"\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"search_from_date\",\n      \"block_name\": \"Call index.search with term and from_date\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"call_index_from_date\",\n          \"opcode\": \"index.search\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"index.search\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_term\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_from_date\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"search_response_from_date\"\n            }\n          ],\n          \"constraints\": [\n            \"Use request.term unchanged as its query argument.\",\n            \"Pass from_date value unchanged; the accepted format is YYYY-MM-DD.\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_extract_from_from_date\",\n          \"opcode\": \"dispatch\"\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"search_limit\",\n      \"block_name\": \"Call index.search with term and limit\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"call_index_limit\",\n          \"opcode\": \"index.search\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"index.search\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_term\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_limit\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"search_response_limit\"\n            }\n          ],\n          \"constraints\": [\n            \"Use request.term unchanged as its query argument.\",\n            \"Pass limit value unchanged as the limit argument.\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_extract_from_limit\",\n          \"opcode\": \"dispatch\"\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"search_none\",\n      \"block_name\": \"Call index.search with term only\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"call_index_none\",\n          \"opcode\": \"index.search\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"index.search\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_term\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"search_response_none\"\n            }\n          ],\n          \"constraints\": [\n            \"Use request.term unchanged as its query argument.\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_extract_from_none\",\n          \"opcode\": \"dispatch\"\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"extract_response\",\n      \"block_name\": \"Extract total and items from the search response\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"extract_total_items\",\n          \"opcode\": \"extract_search_total_and_items\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"search_response_both\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"search_response_from_date\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"search_response_limit\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"search_response_none\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"search_total\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"search_items\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_write_count\",\n          \"opcode\": \"dispatch\"\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"write_and_return\",\n      \"block_name\": \"Write total to count.txt and return items\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"write_count\",\n          \"opcode\": \"write_count_file\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"count.txt\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"search_total\"\n            }\n          ],\n          \"constraints\": [\n            \"After the search, write the response's total value to local count.txt.\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"return_items\",\n          \"opcode\": \"return\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"search_items\"\n            }\n          ],\n          \"constraints\": [\n            \"Return the search response's items value unchanged.\"\n          ]\n        }\n      ]\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_request\",\n      \"target_block_ref\": \"choose_args\"\n    },\n    {\n      \"source_block_ref\": \"choose_args\",\n      \"target_block_ref\": \"search_both\",\n      \"condition_text\": \"from_date present and limit present\"\n    },\n    {\n      \"source_block_ref\": \"choose_args\",\n      \"target_block_ref\": \"search_from_date\",\n      \"condition_text\": \"from_date present and limit missing\"\n    },\n    {\n      \"source_block_ref\": \"choose_args\",\n      \"target_block_ref\": \"search_limit\",\n      \"condition_text\": \"from_date missing and limit present\"\n    },\n    {\n      \"source_block_ref\": \"choose_args\",\n      \"target_block_ref\": \"search_none\",\n      \"condition_text\": \"from_date missing and limit missing\"\n    },\n    {\n      \"source_block_ref\": \"search_both\",\n      \"target_block_ref\": \"extract_response\"\n    },\n    {\n      \"source_block_ref\": \"search_from_date\",\n      \"target_block_ref\": \"extract_response\"\n    },\n    {\n      \"source_block_ref\": \"search_limit\",\n      \"target_block_ref\": \"extract_response\"\n    },\n    {\n      \"source_block_ref\": \"search_none\",\n      \"target_block_ref\": \"extract_response\"\n    },\n    {\n      \"source_block_ref\": \"extract_response\",\n      \"target_block_ref\": \"write_and_return\"\n    }\n  ],\n  \"diagnostics\": []\n}"
