{
  "entry_block_id": "block_001",
  "constraints": [
    "整份流程禁止将 access_token 字段发送给任何接收对象。",
    "字段取值要求不包含摘要生成、内容改写或额外格式转换。"
  ],
  "blocks": {
    "block_001": {
      "block_id": "block_001",
      "block_name": "Read the user-provided events.json",
      "instructions": [
        {
          "id": "ir_001",
          "opcode": "read_events_json",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "events.json",
              "semantic_name": "events.json"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "result_001",
              "semantic_name": "event_records"
            }
          ],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "read_events_json"
        },
        {
          "id": "ir_002",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "go_to_next_event"
        }
      ],
      "constraints": [],
      "data_source_kind": "external"
    },
    "block_002": {
      "block_id": "block_002",
      "block_name": "Get next event record and check whether more records remain",
      "instructions": [
        {
          "id": "ir_003",
          "opcode": "get_next_event_record",
          "inputs": [
            {
              "type": "result",
              "identifier": "result_001",
              "semantic_name": "event_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "result_002",
              "semantic_name": "current_event"
            },
            {
              "type": "result",
              "identifier": "result_003",
              "semantic_name": "has_more_events"
            }
          ],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "take_next_event"
        },
        {
          "id": "ir_004",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "result_003",
              "semantic_name": "has_more_events"
            }
          ],
          "outputs": [],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "dispatch_after_next_event"
        }
      ],
      "constraints": [],
      "data_source_kind": null
    },
    "block_003": {
      "block_id": "block_003",
      "block_name": "Evaluate whether the current event is selected",
      "instructions": [
        {
          "id": "ir_005",
          "opcode": "extract_event_selection_fields",
          "inputs": [
            {
              "type": "result",
              "identifier": "result_002",
              "semantic_name": "current_event"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "result_004",
              "semantic_name": "event_value"
            },
            {
              "type": "result",
              "identifier": "result_005",
              "semantic_name": "event_urgent"
            },
            {
              "type": "result",
              "identifier": "result_006",
              "semantic_name": "event_opted_out"
            }
          ],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "extract_selection_fields"
        },
        {
          "id": "ir_006",
          "opcode": "check_event_selection",
          "inputs": [
            {
              "type": "result",
              "identifier": "result_006",
              "semantic_name": "event_opted_out"
            },
            {
              "type": "result",
              "identifier": "result_005",
              "semantic_name": "event_urgent"
            },
            {
              "type": "result",
              "identifier": "result_004",
              "semantic_name": "event_value"
            },
            {
              "type": "literal",
              "identifier": null,
              "literal_value": 100
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "result_007",
              "semantic_name": "event_is_selected"
            }
          ],
          "constraints": [
            "仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。",
            "urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。"
          ],
          "metadata": {},
          "draft_instruction_id": "check_event_selection"
        },
        {
          "id": "ir_007",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "result_007",
              "semantic_name": "event_is_selected"
            }
          ],
          "outputs": [],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "dispatch_selection"
        }
      ],
      "constraints": [
        "未选中的记录不调用 notify.send。"
      ],
      "data_source_kind": null
    },
    "block_004": {
      "block_id": "block_004",
      "block_name": "Send notification for the selected event",
      "instructions": [
        {
          "id": "ir_008",
          "opcode": "extract_event_notification_fields",
          "inputs": [
            {
              "type": "result",
              "identifier": "result_002",
              "semantic_name": "current_event"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "result_008",
              "semantic_name": "event_recipient"
            },
            {
              "type": "result",
              "identifier": "result_009",
              "semantic_name": "event_summary"
            }
          ],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "extract_notification_fields"
        },
        {
          "id": "ir_009",
          "opcode": "notify_send",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "notify.send",
              "semantic_name": "notify.send"
            },
            {
              "type": "result",
              "identifier": "result_008",
              "semantic_name": "event_recipient"
            },
            {
              "type": "result",
              "identifier": "result_009",
              "semantic_name": "event_summary"
            }
          ],
          "outputs": [],
          "constraints": [
            "对每条选中记录调用一次 notify.send。",
            "接收对象取该记录的 recipient 字段。",
            "notify.send 的 body 参数直接取该记录的 summary 字段原值。"
          ],
          "metadata": {},
          "draft_instruction_id": "send_notify"
        },
        {
          "id": "ir_010",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "dispatch_after_send"
        }
      ],
      "constraints": [],
      "data_source_kind": null
    },
    "block_005": {
      "block_id": "block_005",
      "block_name": "Finish after all event records are processed",
      "instructions": [
        {
          "id": "ir_011",
          "opcode": "return",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "return_done"
        }
      ],
      "constraints": [],
      "data_source_kind": null
    }
  },
  "edges": [
    {
      "source_block_id": "block_001",
      "target_block_id": "block_002",
      "condition_text": null
    },
    {
      "source_block_id": "block_002",
      "target_block_id": "block_003",
      "condition_text": "has_more_events 为 true"
    },
    {
      "source_block_id": "block_002",
      "target_block_id": "block_005",
      "condition_text": "has_more_events 为 false"
    },
    {
      "source_block_id": "block_003",
      "target_block_id": "block_004",
      "condition_text": "记录被选中"
    },
    {
      "source_block_id": "block_003",
      "target_block_id": "block_002",
      "condition_text": "记录未被选中"
    },
    {
      "source_block_id": "block_004",
      "target_block_id": "block_002",
      "condition_text": null
    }
  ],
  "declared_context_keys": []
}
