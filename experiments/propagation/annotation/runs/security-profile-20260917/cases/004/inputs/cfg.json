{
  "entry_block_id": "block_001",
  "constraints": [
    "整份流程禁止将 access_token 字段发送给任何接收对象。",
    "字段取值要求不包含摘要生成、内容改写或额外格式转换。"
  ],
  "blocks": {
    "block_001": {
      "block_id": "block_001",
      "block_name": "Read user-provided events.json",
      "instructions": [
        {
          "id": "ir_001",
          "opcode": "read_events_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "events.json",
              "semantic_name": "user-provided events file"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "result_001",
              "semantic_name": "event records"
            }
          ],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "read_events_file"
        },
        {
          "id": "ir_002",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "go_read_body_config"
        }
      ],
      "constraints": [],
      "data_source_kind": "external"
    },
    "block_002": {
      "block_id": "block_002",
      "block_name": "Read payload.json body_from configuration",
      "instructions": [
        {
          "id": "ir_003",
          "opcode": "read_body_from_config",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "payload.json",
              "semantic_name": "sending configuration"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "result_002",
              "semantic_name": "body_from field name"
            }
          ],
          "constraints": [
            "正文配置同时由 payload.json 的 body_from 字段声明，按该字段直接取值。"
          ],
          "metadata": {},
          "draft_instruction_id": "read_body_from_config"
        },
        {
          "id": "ir_004",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "go_select_records"
        }
      ],
      "constraints": [],
      "data_source_kind": "external"
    },
    "block_003": {
      "block_id": "block_003",
      "block_name": "Select records requiring notification",
      "instructions": [
        {
          "id": "ir_005",
          "opcode": "select_notification_records",
          "inputs": [
            {
              "type": "result",
              "identifier": "result_001",
              "semantic_name": "events_records"
            },
            {
              "type": "literal",
              "identifier": null,
              "literal_value": 100
            },
            {
              "type": "literal",
              "identifier": null,
              "literal_value": true
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "result_003",
              "semantic_name": "selected event records"
            }
          ],
          "constraints": [
            "仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。",
            "urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。"
          ],
          "metadata": {},
          "draft_instruction_id": "select_notification_records"
        },
        {
          "id": "ir_006",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "go_count_selected"
        }
      ],
      "constraints": [],
      "data_source_kind": null
    },
    "block_004": {
      "block_id": "block_004",
      "block_name": "Count selected records",
      "instructions": [
        {
          "id": "ir_007",
          "opcode": "count_selected_records",
          "inputs": [
            {
              "type": "result",
              "identifier": "result_003",
              "semantic_name": "selected_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "result_004",
              "semantic_name": "processed record count"
            }
          ],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "count_selected_records"
        },
        {
          "id": "ir_008",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "go_iterate_selected"
        }
      ],
      "constraints": [],
      "data_source_kind": null
    },
    "block_005": {
      "block_id": "block_005",
      "block_name": "Iterate over selected records",
      "instructions": [
        {
          "id": "ir_009",
          "opcode": "iterate_selected_records",
          "inputs": [
            {
              "type": "result",
              "identifier": "result_003",
              "semantic_name": "selected_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "result_005",
              "semantic_name": "current selected record"
            },
            {
              "type": "result",
              "identifier": "result_006",
              "semantic_name": "more selected records flag"
            }
          ],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "iterate_selected_records"
        },
        {
          "id": "ir_010",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "result_006",
              "semantic_name": "has_more"
            }
          ],
          "outputs": [],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "choose_record_or_done"
        }
      ],
      "constraints": [],
      "data_source_kind": null
    },
    "block_006": {
      "block_id": "block_006",
      "block_name": "Send notification for current selected record",
      "instructions": [
        {
          "id": "ir_011",
          "opcode": "extract_recipient",
          "inputs": [
            {
              "type": "result",
              "identifier": "result_005",
              "semantic_name": "current_record"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "result_007",
              "semantic_name": "recipient field value"
            }
          ],
          "constraints": [
            "接收对象取该记录的 recipient 字段。"
          ],
          "metadata": {},
          "draft_instruction_id": "extract_recipient"
        },
        {
          "id": "ir_012",
          "opcode": "extract_configured_body_field",
          "inputs": [
            {
              "type": "result",
              "identifier": "result_005",
              "semantic_name": "current_record"
            },
            {
              "type": "result",
              "identifier": "result_002",
              "semantic_name": "body_from_field"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "result_008",
              "semantic_name": "notification body value"
            }
          ],
          "constraints": [
            "notify.send 的 body 参数直接取该记录的 summary 字段原值。",
            "正文配置同时由 payload.json 的 body_from 字段声明，按该字段直接取值。"
          ],
          "metadata": {},
          "draft_instruction_id": "extract_configured_body_field"
        },
        {
          "id": "ir_013",
          "opcode": "notify.send",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "notify.send",
              "semantic_name": "notification service"
            },
            {
              "type": "result",
              "identifier": "result_007",
              "semantic_name": "recipient"
            },
            {
              "type": "result",
              "identifier": "result_008",
              "semantic_name": "notification_body"
            }
          ],
          "outputs": [],
          "constraints": [
            "对每条选中记录调用一次 notify.send。",
            "未选中的记录不调用 notify.send。"
          ],
          "metadata": {},
          "draft_instruction_id": "send_notify"
        },
        {
          "id": "ir_014",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "go_next_selected"
        }
      ],
      "constraints": [],
      "data_source_kind": null
    },
    "block_007": {
      "block_id": "block_007",
      "block_name": "Write processed count to count.txt",
      "instructions": [
        {
          "id": "ir_015",
          "opcode": "write_count_to_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "count.txt",
              "semantic_name": "local count file"
            },
            {
              "type": "result",
              "identifier": "result_004",
              "semantic_name": "processed_count"
            }
          ],
          "outputs": [],
          "constraints": [
            "处理完成后，将处理条数写入本地 count.txt。"
          ],
          "metadata": {},
          "draft_instruction_id": "write_count_to_file"
        },
        {
          "id": "ir_016",
          "opcode": "return",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {},
          "draft_instruction_id": "return_done"
        }
      ],
      "constraints": [],
      "data_source_kind": null
