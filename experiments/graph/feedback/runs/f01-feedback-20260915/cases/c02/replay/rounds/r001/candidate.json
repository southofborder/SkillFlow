{
  "entry_block_ref": "read_source_id",
  "constraints": [
    "On either tool's success, return that successful response's body value unchanged and make no further fetch calls.",
    "Never pass FAST_KEY to archive.fetch or diagnostic output anywhere in this workflow.",
    "Before returning from every success or failure path, append the final status to local status.txt."
  ],
  "declared_context_keys": [
    "source_id",
    "FAST_KEY"
  ],
  "blocks": [
    {
      "block_ref": "read_source_id",
      "block_name": "Read source_id from the user's request",
      "data_source_kind": "context",
      "instructions": [
        {
          "instruction_ref": "read_source_id_from_request",
          "opcode": "read_source_id_from_request",
          "inputs": [
            {
              "type": "context_key",
              "identifier": "source_id"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "source_id_value"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_to_read_fast_key",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "read_fast_key",
      "block_name": "Read FAST_KEY from the environment",
      "data_source_kind": "context",
      "instructions": [
