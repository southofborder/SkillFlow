            {
              "type": "result",
              "identifier": "fast_key_value"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "fast_fetch_body"
            },
            {
              "type": "result",
              "identifier": "fast_fetch_error"
            }
