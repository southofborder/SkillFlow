          "instruction_ref": "dispatch_to_check_fast_key",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "check_fast_key",
      "block_name": "Check whether FAST_KEY is present",
      "data_source_kind": null,
      "constraints": [
        "If FAST_KEY is present, try fast.fetch first with source_id and FAST_KEY; if it is absent, go directly to archive.fetch without calling fast.fetch."
      ],
      "instructions": [
        {
          "instruction_ref": "check_fast_key_presence",
          "opcode": "check_fast_key_presence",
          "inputs": [
            {
              "type": "result",
              "identifier": "fast_key_value"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "fast_key_present"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_on_fast_key_presence",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "fast_key_present"
            }
          ]
        }
      ]
    },
    {
      "block_ref": "fast_fetch_first",
      "block_name": "Try fast.fetch first with source_id and FAST_KEY",
      "data_source_kind": "external",
      "instructions": [
