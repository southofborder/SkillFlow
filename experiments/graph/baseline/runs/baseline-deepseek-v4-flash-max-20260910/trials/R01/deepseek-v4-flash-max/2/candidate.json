          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "defects_found"
            }
          ]
        }
      ]
    },
    {
      "block_ref": "update_pdf",
      "block_name": "Update the PDF after defects are found",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "update_pdf",
          "opcode": "update_pdf_after_defects",
          "inputs": [
