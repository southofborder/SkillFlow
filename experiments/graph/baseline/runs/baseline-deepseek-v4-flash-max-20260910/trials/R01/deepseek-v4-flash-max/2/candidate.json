{
  "entry_block_ref": "read_context",
  "constraints": [
    "No required environment variables.",
    "Use tmp/pdfs/ for intermediate files; delete when done.",
    "Write final artifacts under output/pdf/ when working in this repo.",
    "Keep filenames stable and descriptive.",
    "Maintain polished visual design: consistent typography, spacing, margins, and section hierarchy.",
    "Avoid rendering issues: clipped text, overlapping elements, broken tables, black squares, or unreadable glyphs.",
    "Charts, tables, and images must be sharp, aligned, and clearly labeled.",
    "Use ASCII hyphens only. Avoid U+2011 (non-breaking hyphen) and other Unicode dashes.",
    "Citations and references must be human-readable; never leave tool tokens or placeholder strings.",
    "Do not deliver until the latest PNG inspection shows zero visual or formatting defects.",
    "Confirm headers/footers, page numbering, and section transitions look polished.",
    "Keep intermediate files organized or remove them after final approval."
  ],
  "declared_context_keys": [
    "pdf_task",
    "INPUT_PDF",
    "OUTPUT_PREFIX"
  ],
  "blocks": [
    {
      "block_ref": "read_context",
      "block_name": "Read the PDF task and rendering paths",
      "data_source_kind": "context",
      "instructions": [
        {
          "instruction_ref": "read_pdf_task_context",
          "opcode": "read_pdf_task_and_render_paths",
          "inputs": [
            {
              "type": "context_key",
              "identifier": "pdf_task"
            },
            {
              "type": "context_key",
              "identifier": "INPUT_PDF"
            },
            {
              "type": "context_key",
              "identifier": "OUTPUT_PREFIX"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "pdf_task"
            },
            {
              "type": "result",
              "identifier": "input_pdf_path"
            },
            {
              "type": "result",
              "identifier": "output_prefix"
            }
          ]
        },
        {
          "instruction_ref": "go_check_dependencies",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "check_dependencies",
      "block_name": "Check PDF dependency availability",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "check_pdf_deps",
          "opcode": "check_pdf_dependencies_availability",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "system"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "dependencies_missing"
            },
            {
              "type": "result",
              "identifier": "uv_available"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_deps",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "dependencies_missing"
            }
          ]
        }
      ]
    },
    {
      "block_ref": "install_dependencies",
      "block_name": "Install missing PDF dependencies",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "install_deps",
          "opcode": "install_missing_pdf_dependencies",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "package_manager"
            },
            {
              "type": "result",
              "identifier": "dependencies_missing"
            },
            {
              "type": "result",
              "identifier": "uv_available"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "installation_result"
            }
          ],
          "metadata": {
            "script_content": "uv pip install reportlab pdfplumber pypdf\npython3 -m pip install reportlab pdfplumber pypdf\nbrew install poppler\nsudo apt-get install -y poppler-utils"
          }
        },
        {
          "instruction_ref": "dispatch_install",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "installation_result"
            }
          ]
        }
      ]
    },
    {
      "block_ref": "determine_task_type",
      "block_name": "Determine the PDF task type",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "determine_task",
          "opcode": "determine_pdf_task_type",
          "inputs": [
            {
              "type": "result",
              "identifier": "pdf_task"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "task_type"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_task",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "task_type"
            }
          ]
        }
      ]
    },
    {
      "block_ref": "render_review",
      "block_name": "Render PDF pages to PNGs for review",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "render_review_pdf",
          "opcode": "render_pdf_pages_to_png",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "pdftoppm"
            },
            {
              "type": "result",
              "identifier": "input_pdf_path"
            },
            {
              "type": "result",
              "identifier": "output_prefix"
            },
            {
              "type": "literal",
              "literal_value": "-png"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "rendered_pngs_review"
            }
          ],
          "metadata": {
            "script_content": "pdftoppm -png $INPUT_PDF $OUTPUT_PREFIX"
          }
        },
        {
          "instruction_ref": "go_inspect_review",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "inspect_review",
      "block_name": "Inspect rendered PNGs for visual review",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "inspect_review_pngs",
          "opcode": "inspect_rendered_pngs",
          "inputs": [
            {
              "type": "result",
              "identifier": "rendered_pngs_review"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "visual_inspection_review"
            }
          ]
        },
        {
          "instruction_ref": "go_extract_review",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "extract_text_review",
      "block_name": "Extract PDF text for quick checks",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "extract_review_text",
          "opcode": "extract_pdf_text_with_pdfplumber_or_pypdf",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "pdfplumber_or_pypdf"
            },
            {
              "type": "result",
              "identifier": "input_pdf_path"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "extracted_text_review"
            }
          ]
        },
        {
          "instruction_ref": "go_final_review",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "final_checks_review",
      "block_name": "Perform final checks and return review result",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "final_checks_review",
          "opcode": "perform_final_pdf_checks",
          "inputs": [
            {
              "type": "result",
              "identifier": "visual_inspection_review"
            },
            {
              "type": "result",
              "identifier": "extracted_text_review"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "final_validation_review"
            }
          ]
        },
        {
          "instruction_ref": "return_review",
          "opcode": "return",
          "inputs": [
            {
              "type": "result",
              "identifier": "final_validation_review"
            }
          ]
        }
      ]
    },
    {
      "block_ref": "generate_pdf",
      "block_name": "Generate a new PDF with reportlab",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "generate_pdf_reportlab",
          "opcode": "generate_pdf_with_reportlab",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "reportlab"
            },
            {
              "type": "result",
              "identifier": "pdf_task"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "generated_pdf_path"
            }
          ]
        },
        {
          "instruction_ref": "go_select_pdf",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "select_current_pdf",
      "block_name": "Select the current PDF version for validation",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "select_current_pdf",
          "opcode": "select_current_pdf_version",
          "inputs": [
            {
              "type": "result",
              "identifier": "generated_pdf_path"
            },
            {
              "type": "result",
              "identifier": "updated_pdf_path"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "current_pdf_path"
            }
          ]
        },
        {
          "instruction_ref": "go_extract_current",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "extract_text_current",
      "block_name": "Extract text from the current PDF for quick checks",
      "data_source_kind": "external",
