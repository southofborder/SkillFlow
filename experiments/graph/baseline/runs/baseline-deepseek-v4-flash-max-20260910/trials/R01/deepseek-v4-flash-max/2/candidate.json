      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "render_current_pdf",
          "opcode": "render_pdf_pages_to_png",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "pdftoppm"
            },
            {
              "type": "result",
