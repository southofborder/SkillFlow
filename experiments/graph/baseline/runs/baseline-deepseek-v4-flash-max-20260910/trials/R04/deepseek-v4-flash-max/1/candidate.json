{
  "entry_block_ref": "check_auth_status",
  "constraints": [
    "Netlify CLI is installed via npx (no global install required).",
    "Authentication requires a Netlify account with active login session.",
    "Project must be a valid web project in current directory.",
    "When sandboxing blocks the deployment network calls, rerun with `sandbox_permissions=require_escalated`.",
    "The deployment might take a few minutes. Use appropriate timeout values.",
    "Never commit secrets to Git.",
    "Set secrets and configuration in Netlify dashboard: Site Settings → Environment Variables.",
    "Access environment variables in builds via `process.env.VARIABLE_NAME`.",
    "Authentication uses either browser-based OAuth (primary) or API key (alternative) via `NETLIFY_AUTH_TOKEN`.",
    "If a `netlify.toml` file exists, the CLI uses it automatically. If not, the CLI will prompt for build command and publish directory.",
    "Common framework defaults: Next.js: build command `npm run build`, publish `.next`; React (Vite): build command `npm run build`, publish `dist`; Static HTML: no build command, publish current directory.",
    "The skill should detect framework from `package.json` if possible and suggest appropriate settings."
  ],
  "declared_context_keys": [
    "user_request"
  ],
  "blocks": [
    {
      "block_ref": "check_auth_status",
      "block_name": "Check Netlify CLI authentication status",
      "data_source_kind": "external",
      "constraints": [
        "Check authentication status with `npx netlify status`."
      ],
      "instructions": [
        {
          "instruction_ref": "run_netlify_status",
          "opcode": "run_netlify_status",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "netlify_cli"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "netlify_status_output"
            }
          ],
          "constraints": [
            "Expected output patterns: Authenticated shows logged-in user email and site link status; Not authenticated shows 'Not logged into any site' or authentication error."
          ],
          "metadata": {
            "script_content": "npx netlify status"
          }
        },
        {
          "instruction_ref": "dispatch_to_auth_check",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": []
        }
      ]
    },
    {
      "block_ref": "decide_auth",
      "block_name": "Determine whether Netlify CLI is authenticated",
      "data_source_kind": null,
      "constraints": [],
      "instructions": [
        {
          "instruction_ref": "check_netlify_authentication",
          "opcode": "check_netlify_authentication",
          "inputs": [
            {
              "type": "result",
              "identifier": "netlify_status_output"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "is_authenticated"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_on_auth",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "is_authenticated"
            }
          ],
          "outputs": []
        }
      ]
    },
    {
      "block_ref": "login",
      "block_name": "Guide user through Netlify login",
      "data_source_kind": null,
      "constraints": [
        "This opens a browser window for OAuth authentication. Wait for user to complete login, then verify with `netlify status` again."
      ],
      "instructions": [
        {
          "instruction_ref": "run_netlify_login",
          "opcode": "run_netlify_login",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "netlify_cli"
            }
          ],
          "outputs": [],
          "metadata": {
            "script_content": "npx netlify login"
          }
        },
        {
          "instruction_ref": "dispatch_to_recheck_auth",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": []
        }
      ]
    },
    {
      "block_ref": "detect_site_link",
      "block_name": "Detect site link status from Netlify status output",
      "data_source_kind": null,
      "constraints": [],
