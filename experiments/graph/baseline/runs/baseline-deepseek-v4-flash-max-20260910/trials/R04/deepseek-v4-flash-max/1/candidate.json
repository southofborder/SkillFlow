            }
          ],
          "outputs": []
        }
      ]
    },
    {
      "block_ref": "link_git_remote",
      "block_name": "Link project to existing Netlify site by Git remote URL",
      "data_source_kind": "external",
      "constraints": [
        "If link fails (site doesn't exist on Netlify), create new site interactively."
      ],
      "instructions": [
        {
          "instruction_ref": "netlify_link_git_remote",
          "opcode": "netlify_link_git_remote",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "netlify_cli"
            },
            {
              "type": "result",
              "identifier": "remote_url"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "link_result"
            }
          ],
          "metadata": {
            "script_content": "npx netlify link --git-remote-url <REMOTE_URL>"
