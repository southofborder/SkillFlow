        },
        {
          "instruction_ref": "dispatch_on_site_link",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "site_link_status"
            }
          ],
          "outputs": []
        }
      ]
    },
    {
      "block_ref": "read_git_remote",
      "block_name": "Read Git remote origin",
      "data_source_kind": "external",
      "constraints": [],
      "instructions": [
        {
          "instruction_ref": "git_remote_show_origin",
