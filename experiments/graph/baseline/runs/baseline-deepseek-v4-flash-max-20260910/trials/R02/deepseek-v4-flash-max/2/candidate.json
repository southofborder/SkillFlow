      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "open_page_via_wrapper",
          "opcode": "run_playwright_cli_open",
          "inputs": [
            {
              "type": "result",
              "identifier": "pwcli_path"
            },
            {
              "type": "result",
              "identifier": "playwright_cli_session"
            },
            {
              "type": "result",
              "identifier": "browser_task"
            }
          ],
          "outputs": [],
          "constraints": [
            "Use the wrapper script unless the repository already standardizes on a global install.",
            "Use --headed when a visual check will help."
          ],
          "metadata": {
            "script_content": "#!/usr/bin/env bash\nset -euo pipefail\n\nif ! command -v npx >/dev/null 2>&1; then\n  echo \"Error: npx is required but not found on PATH.\" >&2\n  exit 1\nfi\n\nhas_session_flag=\"false\"\nfor arg in \"$@\"; do\n  case \"$arg\" in\n    --session|--session=*)\n      has_session_flag=\"true\"\n      break\n      ;;\n  esac\ndone\n\ncmd=(npx --yes --package @playwright/cli playwright-cli)\nif [[ \"${has_session_flag}\" != \"true\" && -n \"${PLAYWRIGHT_CLI_SESSION:-}\" ]]; then\n  cmd+=(--session \"${PLAYWRIGHT_CLI_SESSION}\")\nfi\ncmd+=(\"$@\")\n\nexec \"${cmd[@]}\"\n"
          }
        },
        {
          "instruction_ref": "dispatch_open",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": []
        }
