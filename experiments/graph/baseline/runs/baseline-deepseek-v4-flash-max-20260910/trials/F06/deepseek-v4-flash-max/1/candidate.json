              "type": "context_key",
              "identifier": "user_request"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "source_id"
            }
          ]
        },
        {
          "instruction_ref": "go_read_fast_key",
          "opcode": "dispatch"
        }
      ]
    },
    {
