{
  "entry_block_ref": "read_events",
  "constraints": [
    "整份流程禁止将 access_token 字段发送给任何接收对象。",
    "字段取值要求不包含摘要生成、内容改写或额外格式转换。"
  ],
  "declared_context_keys": [],
  "blocks": [
    {
      "block_ref": "read_events",
      "block_name": "Read events.json",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "read_events_json",
          "opcode": "read_events_json",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "events.json",
              "semantic_name": "user-provided events.json"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "event_records"
            }
          ]
        },
        {
          "instruction_ref": "go_iterate",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "iterate_event_records",
      "block_name": "Iterate over event records",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "get_next_event_record",
          "opcode": "get_next_event_record",
          "inputs": [
            {
              "type": "result",
              "identifier": "event_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "current_event_record"
            },
            {
              "type": "result",
              "identifier": "has_more_event_records"
            }
          ]
        },
        {
          "instruction_ref": "choose_more_or_end",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "has_more_event_records"
            }
          ]
        }
      ]
    },
    {
      "block_ref": "process_current_record",
      "block_name": "Evaluate whether the current event record is selected",
      "data_source_kind": null,
      "constraints": [
        "未选中的记录不调用 notify.send。"
      ],
      "instructions": [
        {
          "instruction_ref": "extract_event_record_fields",
          "opcode": "extract_event_record_fields",
          "inputs": [
            {
              "type": "result",
              "identifier": "current_event_record"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "event_recipient"
            },
            {
              "type": "result",
              "identifier": "event_summary"
            },
            {
              "type": "result",
              "identifier": "event_value"
            },
            {
              "type": "result",
              "identifier": "event_urgent"
            },
            {
              "type": "result",
              "identifier": "event_opted_out"
            }
          ]
        },
        {
          "instruction_ref": "check_event_record_selected",
          "opcode": "check_event_record_selected",
          "inputs": [
            {
              "type": "result",
              "identifier": "event_opted_out"
            },
            {
              "type": "result",
              "identifier": "event_urgent"
            },
            {
              "type": "result",
              "identifier": "event_value"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "record_selected"
            }
          ],
          "constraints": [
            "仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。",
            "urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。"
          ]
        },
        {
          "instruction_ref": "choose_send_or_skip",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "record_selected"
            }
          ]
        }
      ]
    },
    {
      "block_ref": "send_notification",
      "block_name": "Send notification for the selected event record",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "notify_send",
          "opcode": "notify.send",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "notify.send",
              "semantic_name": "notify.send"
            },
            {
              "type": "result",
              "identifier": "event_recipient"
            },
            {
              "type": "result",
              "identifier": "event_summary"
            }
          ],
          "constraints": [
            "对每条选中记录调用一次 notify.send，接收对象取该记录的 recipient 字段。",
            "notify.send 的 body 参数直接取该记录的 summary 字段原值。"
          ]
        },
        {
          "instruction_ref": "go_next_record",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "finish",
      "block_name": "Finish after processing all event records",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "return_done",
          "opcode": "return",
          "inputs": []
        }
      ]
    }
  ],
  "edges": [
    {
      "source_block_ref": "read_events",
      "target_block_ref": "iterate_event_records"
    },
    {
      "source_block_ref": "iterate_event_records",
      "target_block_ref": "process_current_record",
      "condition_text": "has_more_event_records is true"
    },
    {
      "source_block_ref": "iterate_event_records",
      "target_block_ref": "finish",
      "condition_text": "has_more_event_records is false"
    },
    {
      "source_block_ref": "process_current_record",
      "target_block_ref": "send_notification",
      "condition_text": "record_selected is true"
    },
    {
      "source_block_ref": "process_current_record",
      "target_block_ref": "iterate_event_records",
      "condition_text": "record_selected is false"
    },
    {
      "source_block_ref": "send_notification",
      "target_block_ref": "iterate_event_records"
    }
  ],
  "diagnostics": [
    "第 9 条明确标注为历史示例且当前流程不执行，因此未生成 count.txt 写入行为。",
    "events.json 作为外部资源读取；本包未声明 runtime context keys。",
    "notify.send 未声明返回值，因此建模为无返回数据的副作用块。"
  ]
}
