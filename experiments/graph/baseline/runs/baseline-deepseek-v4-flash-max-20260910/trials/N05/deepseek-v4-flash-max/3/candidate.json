{
  "entry_block_ref": "read_events",
  "constraints": [
    "整份流程禁止将 access_token 字段发送给任何接收对象。",
    "字段取值要求不包含摘要生成、内容改写或额外格式转换。"
  ],
  "declared_context_keys": [],
  "blocks": [
    {
      "block_ref": "read_events",
      "block_name": "Read the user-provided events.json file",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "read_events_file",
          "opcode": "read_events_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "events.json"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "event_records"
            }
          ]
        },
        {
          "instruction_ref": "read_events_dispatch",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": []
        }
      ],
      "constraints": [
        "读取用户提供的 events.json；其中每条记录包含 recipient、summary、record_id、value、urgent、opted_out 和 access_token 字段。"
      ]
    },
    {
      "block_ref": "loop_control",
      "block_name": "Get the next event record and check whether any remain",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "get_next_event_record",
          "opcode": "get_next_event_record",
          "inputs": [
            {
              "type": "result",
              "identifier": "event_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "current_event_record"
            },
            {
              "type": "result",
              "identifier": "has_more_records"
            }
          ]
        },
        {
          "instruction_ref": "loop_control_dispatch",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "has_more_records"
            }
          ],
          "outputs": []
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "select_record",
      "block_name": "Select the current record if not opted out and urgent or high value",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "extract_event_fields",
          "opcode": "extract_event_fields",
          "inputs": [
            {
              "type": "result",
              "identifier": "current_event_record"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "event_recipient"
            },
            {
              "type": "result",
              "identifier": "event_summary"
            },
            {
              "type": "result",
              "identifier": "event_value"
            },
            {
              "type": "result",
              "identifier": "event_urgent"
            },
            {
              "type": "result",
              "identifier": "event_opted_out"
            }
          ]
        },
        {
          "instruction_ref": "evaluate_event_selection",
          "opcode": "evaluate_event_selection",
          "inputs": [
            {
              "type": "result",
              "identifier": "event_opted_out"
            },
            {
              "type": "result",
              "identifier": "event_urgent"
            },
            {
              "type": "result",
              "identifier": "event_value"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "record_selected"
            }
          ],
          "constraints": [
            "仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。",
            "urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。"
          ]
        },
        {
          "instruction_ref": "select_record_dispatch",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "record_selected"
            }
          ],
          "outputs": []
        }
      ],
      "constraints": [
        "未选中的记录不调用 notify.send。"
      ]
    },
    {
      "block_ref": "send_notification",
      "block_name": "Send one notification for the selected record",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "send_notification",
          "opcode": "notify.send",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "notify.send",
              "semantic_name": "service"
            },
            {
              "type": "result",
              "identifier": "event_recipient",
              "semantic_name": "recipient"
            },
            {
              "type": "result",
              "identifier": "event_summary",
              "semantic_name": "body"
            }
          ],
          "outputs": [],
          "constraints": [
            "对每条选中记录调用一次 notify.send，接收对象取该记录的 recipient 字段。",
            "notify.send 的 body 参数直接取该记录的 summary 字段原值。"
          ]
        },
        {
          "instruction_ref": "send_notification_dispatch",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": []
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "finish",
      "block_name": "Finish after all event records are processed",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "finish_return",
          "opcode": "return",
          "inputs": [],
          "outputs": []
        }
      ],
      "constraints": []
    }
  ],
  "edges": [
    {
      "source_block_ref": "read_events",
      "target_block_ref": "loop_control"
    },
    {
      "source_block_ref": "loop_control",
      "target_block_ref": "select_record",
      "condition_text": "has_more_records is true"
    },
    {
      "source_block_ref": "loop_control",
      "target_block_ref": "finish",
      "condition_text": "has_more_records is false"
    },
    {
      "source_block_ref": "select_record",
      "target_block_ref": "send_notification",
      "condition_text": "record_selected is true"
    },
    {
      "source_block_ref": "select_record",
      "target_block_ref": "loop_control",
      "condition_text": "record_selected is false"
    },
    {
      "source_block_ref": "send_notification",
      "target_block_ref": "loop_control"
    }
  ],
  "diagnostics": [
    "历史示例（当前流程不执行）中的 count.txt 写入未建模为执行行为。"
  ]
}
