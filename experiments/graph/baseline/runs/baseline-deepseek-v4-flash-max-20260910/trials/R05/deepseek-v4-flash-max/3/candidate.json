            {
              "type": "external_resource",
              "identifier": "linear"
            },
            {
              "type": "literal",
              "literal_value": "https://mcp.linear.app/mcp"
            }
          ],
          "outputs": [],
          "constraints": [],
          "metadata": {
            "script_content": "codex mcp add linear --url https://mcp.linear.app/mcp"
          }
        },
        {
          "instruction_ref": "enable_remote_mcp_client",
          "opcode": "enable_rmcp_client",
          "inputs": [
            {
              "type": "literal",
              "literal_value": "Set [features] rmcp_client = true in config.toml or run codex --enable rmcp_client"
            }
          ],
          "outputs": [],
          "constraints": [],
          "metadata": {
            "script_content": "Set [features] rmcp_client = true in config.toml **or** run codex --enable rmcp_client"
          }
        },
        {
          "instruction_ref": "login_linear_oauth",
          "opcode": "codex_mcp_login_linear",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "linear"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "setup_status"
            }
          ],
          "constraints": [],
          "metadata": {
            "script_content": "codex mcp login linear"
          }
        },
        {
          "instruction_ref": "dispatch_setup",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "setup_status"
            }
          ],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        }
      ],
      "constraints": [
        "If any MCP call fails because Linear MCP is not connected, pause and set it up"
      ]
    },
    {
      "block_ref": "configure_wsl",
