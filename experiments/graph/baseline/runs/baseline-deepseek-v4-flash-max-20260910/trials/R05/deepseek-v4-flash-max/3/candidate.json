        {
          "instruction_ref": "configure_wsl_mcp",
          "opcode": "configure_linear_mcp_via_wsl",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "linear"
            },
            {
              "type": "literal",
              "literal_value": {
                "mcpServers": {
                  "linear": {
                    "command": "wsl",
                    "args": [
                      "npx",
                      "-y",
                      "mcp-remote",
                      "https://mcp.linear.app/sse",
                      "--transport",
                      "sse-only"
                    ]
                  }
                }
              }
            }
          ],
          "outputs": [],
          "constraints": [],
          "metadata": {
            "script_content": "{\"mcpServers\": {\"linear\": {\"command\": \"wsl\", \"args\": [\"npx\", \"-y\", \"mcp-remote\", \"https://mcp.linear.app/sse\", \"--transport\", \"sse-only\"]}}}"
          }
        },
        {
          "instruction_ref": "dispatch_wsl",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        }
      ],
      "constraints": [
        "Windows/WSL note: If you see connection errors on Windows, try configuring the Linear MCP to run via WSL"
