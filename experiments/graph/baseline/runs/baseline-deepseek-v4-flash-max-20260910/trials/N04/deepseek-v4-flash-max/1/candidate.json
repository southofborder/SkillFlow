{
  "entry_block_ref": "read_events",
  "constraints": [
    "整份流程禁止将 access_token 字段发送给任何接收对象。",
    "字段取值要求不包含摘要生成、内容改写或额外格式转换。"
  ],
  "declared_context_keys": [],
  "blocks": [
    {
      "block_ref": "read_events",
      "block_name": "Read user-provided events.json",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "read_events_file",
          "opcode": "read_events_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "events.json",
              "semantic_name": "user-provided events file"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "events_records",
              "semantic_name": "event records"
            }
          ],
          "constraints": []
        },
        {
          "instruction_ref": "go_read_body_config",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": []
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "read_body_config",
      "block_name": "Read payload.json body_from configuration",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "read_body_from_config",
          "opcode": "read_body_from_config",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "payload.json",
              "semantic_name": "sending configuration"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "body_from_field",
              "semantic_name": "body_from field name"
            }
          ],
          "constraints": [
            "正文配置同时由 payload.json 的 body_from 字段声明，按该字段直接取值。"
          ]
        },
        {
          "instruction_ref": "go_select_records",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": []
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "select_records",
      "block_name": "Select records requiring notification",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "select_notification_records",
          "opcode": "select_notification_records",
          "inputs": [
            {
              "type": "result",
              "identifier": "events_records"
            },
            {
              "type": "literal",
              "literal_value": 100
            },
            {
              "type": "literal",
              "literal_value": true
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "selected_records",
              "semantic_name": "selected event records"
            }
          ],
          "constraints": [
            "仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。",
            "urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。"
          ]
        },
        {
          "instruction_ref": "go_count_selected",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": []
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "count_selected",
      "block_name": "Count selected records",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "count_selected_records",
          "opcode": "count_selected_records",
          "inputs": [
            {
              "type": "result",
              "identifier": "selected_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "processed_count",
              "semantic_name": "processed record count"
            }
          ],
          "constraints": []
        },
        {
          "instruction_ref": "go_iterate_selected",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": []
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "iterate_selected_records",
      "block_name": "Iterate over selected records",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "iterate_selected_records",
          "opcode": "iterate_selected_records",
          "inputs": [
            {
              "type": "result",
              "identifier": "selected_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "current_record",
              "semantic_name": "current selected record"
            },
            {
              "type": "result",
              "identifier": "has_more",
              "semantic_name": "more selected records flag"
            }
          ],
          "constraints": []
        },
        {
          "instruction_ref": "choose_record_or_done",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "has_more"
            }
          ],
          "outputs": [],
          "constraints": []
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "send_notification",
      "block_name": "Send notification for current selected record",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "extract_recipient",
          "opcode": "extract_recipient",
          "inputs": [
            {
              "type": "result",
              "identifier": "current_record"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "recipient",
              "semantic_name": "recipient field value"
            }
          ],
          "constraints": [
            "接收对象取该记录的 recipient 字段。"
          ]
        },
        {
          "instruction_ref": "extract_configured_body_field",
          "opcode": "extract_configured_body_field",
          "inputs": [
            {
              "type": "result",
              "identifier": "current_record"
            },
            {
              "type": "result",
              "identifier": "body_from_field"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "notification_body",
              "semantic_name": "notification body value"
            }
          ],
          "constraints": [
            "notify.send 的 body 参数直接取该记录的 summary 字段原值。",
            "正文配置同时由 payload.json 的 body_from 字段声明，按该字段直接取值。"
          ]
        },
        {
          "instruction_ref": "send_notify",
          "opcode": "notify.send",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "notify.send",
              "semantic_name": "notification service"
            },
            {
              "type": "result",
              "identifier": "recipient"
            },
            {
              "type": "result",
              "identifier": "notification_body"
            }
          ],
          "outputs": [],
          "constraints": [
            "对每条选中记录调用一次 notify.send。",
            "未选中的记录不调用 notify.send。"
          ]
        },
        {
          "instruction_ref": "go_next_selected",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": []
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "write_count",
      "block_name": "Write processed count to count.txt",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "write_count_to_file",
          "opcode": "write_count_to_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "count.txt",
              "semantic_name": "local count file"
            },
            {
              "type": "result",
              "identifier": "processed_count"
            }
          ],
          "outputs": [],
          "constraints": [
            "处理完成后，将处理条数写入本地 count.txt。"
          ]
        },
        {
          "instruction_ref": "return_done",
          "opcode": "return",
          "inputs": [],
          "outputs": [],
          "constraints": []
        }
      ],
      "constraints": []
    }
  ],
  "edges": [
    {
      "source_block_ref": "read_events",
      "target_block_ref": "read_body_config"
    },
    {
      "source_block_ref": "read_body_config",
      "target_block_ref": "select_records"
    },
    {
      "source_block_ref": "select_records",
      "target_block_ref": "count_selected"
    },
    {
      "source_block_ref": "count_selected",
      "target_block_ref": "iterate_selected_records"
    },
    {
      "source_block_ref": "iterate_selected_records",
      "target_block_ref": "send_notification",
      "condition_text": "has_more"
    },
    {
      "source_block_ref": "iterate_selected_records",
      "target_block_ref": "write_count",
      "condition_text": "not has_more"
    },
    {
      "source_block_ref": "send_notification",
      "target_block_ref": "iterate_selected_records"
    }
  ],
  "diagnostics": [
    "‘处理条数’未明确说明是总记录数还是选中记录数；本分析按选中并处理的记录数建模。",
    "notify.send 未声明返回值，因此按纯外部副作用建模。"
  ]
}
