    {
      "block_ref": "package_documents",
      "block_name": "Build bundle.zip from converted artifact paths with scripts/package.py",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "package_converted_documents",
          "opcode": "run_package_script",
          "inputs": [
