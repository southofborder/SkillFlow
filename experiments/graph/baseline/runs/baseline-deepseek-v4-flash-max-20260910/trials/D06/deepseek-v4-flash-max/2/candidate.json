      "block_ref": "convert_documents",
      "block_name": "Convert each manifest document with scripts/convert.py and collect stdout paths",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "convert_all_documents",
          "opcode": "run_convert_script_for_each_document",
          "inputs": [
            {
              "type": "result",
              "identifier": "document_paths"
