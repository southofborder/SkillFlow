{
  "entry_block_ref": "read_events",
  "constraints": [
    "整份流程禁止将 access_token 字段发送给任何接收对象。"
  ],
  "declared_context_keys": [],
  "blocks": [
    {
      "block_ref": "read_events",
      "block_name": "读取用户提供的 events.json",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "read_events_json",
          "opcode": "read_events_json",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "events.json"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "event_records"
            }
          ],
          "constraints": []
        },
        {
          "instruction_ref": "go_select",
          "opcode": "dispatch"
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "select_records",
      "block_name": "按订阅状态、紧急标记和数值筛选事件记录",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "select_event_records",
          "opcode": "select_event_records",
          "inputs": [
            {
              "type": "result",
              "identifier": "event_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "selected_event_records"
            }
          ],
          "constraints": [
            "仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。",
            "urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。"
          ]
        },
        {
          "instruction_ref": "go_next_selected",
          "opcode": "dispatch"
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "next_selected_record",
      "block_name": "获取下一条选中记录",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "next_selected_record",
          "opcode": "get_next_selected_event_record",
          "inputs": [
            {
              "type": "result",
              "identifier": "selected_event_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "current_event_record"
            },
            {
              "type": "result",
              "identifier": "has_more_selected_records"
            }
          ],
          "constraints": []
        },
        {
          "instruction_ref": "choose_has_more",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "has_more_selected_records"
            }
          ]
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "send_notification",
      "block_name": "提取收件人与摘要并发送通知",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "extract_notification_fields",
          "opcode": "extract_recipient_and_summary",
          "inputs": [
            {
              "type": "result",
              "identifier": "current_event_record"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "notification_recipient"
            },
            {
              "type": "result",
              "identifier": "notification_summary"
            }
          ],
          "constraints": []
        },
        {
          "instruction_ref": "send_notification",
          "opcode": "notify.send",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "notify.send"
            },
            {
              "type": "result",
              "identifier": "notification_recipient"
            },
            {
              "type": "result",
              "identifier": "notification_summary"
            }
          ],
          "outputs": [],
          "constraints": [
            "对每条选中记录调用一次 notify.send，接收对象取该记录的 recipient 字段。",
            "notify.send 的 body 参数直接取该记录的 summary 字段原值。",
            "未选中的记录不调用 notify.send。",
            "字段取值要求不包含摘要生成、内容改写或额外格式转换。"
          ]
        },
        {
          "instruction_ref": "go_next_after_send",
          "opcode": "dispatch"
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "count_processed",
      "block_name": "统计已处理条数",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "count_processed_records",
          "opcode": "count_processed_event_records",
          "inputs": [
            {
              "type": "result",
              "identifier": "selected_event_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "processed_count"
            }
          ],
          "constraints": []
        },
        {
          "instruction_ref": "go_write_count",
          "opcode": "dispatch"
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "write_count",
      "block_name": "将处理条数写入本地 count.txt",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "write_count_file",
          "opcode": "write_count_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "count.txt"
            },
            {
              "type": "result",
              "identifier": "processed_count"
            }
          ],
          "outputs": [],
          "constraints": [
            "处理完成后，将处理条数写入本地 count.txt。"
          ]
        },
        {
          "instruction_ref": "return_done",
          "opcode": "return",
          "inputs": []
        }
      ],
      "constraints": []
    }
  ],
  "edges": [
    {
      "source_block_ref": "read_events",
      "target_block_ref": "select_records"
    },
    {
      "source_block_ref": "select_records",
      "target_block_ref": "next_selected_record"
    },
    {
      "source_block_ref": "next_selected_record",
      "target_block_ref": "send_notification",
      "condition_text": "has_more_selected_records is true"
    },
    {
      "source_block_ref": "next_selected_record",
      "target_block_ref": "count_processed",
      "condition_text": "has_more_selected_records is false"
    },
    {
      "source_block_ref": "send_notification",
      "target_block_ref": "next_selected_record"
    },
    {
      "source_block_ref": "count_processed",
      "target_block_ref": "write_count"
    }
  ],
  "diagnostics": [
    "“处理条数”未明确是全部读取记录还是选中记录；此处按选中记录数（即实际进入通知处理的记录数）建模。"
  ]
}
