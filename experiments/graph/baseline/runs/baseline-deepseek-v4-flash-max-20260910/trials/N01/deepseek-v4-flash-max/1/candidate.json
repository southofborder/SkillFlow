{
  "entry_block_ref": "read_events_file",
  "constraints": [
    "整份流程禁止将 access_token 字段发送给任何接收对象。",
    "字段取值要求不包含摘要生成、内容改写或额外格式转换。"
  ],
  "declared_context_keys": [],
  "blocks": [
    {
      "block_ref": "read_events_file",
      "block_name": "Read user-provided events.json",
      "data_source_kind": "external",
      "constraints": [
        "读取用户提供的 events.json；其中每条记录包含 recipient、summary、record_id、value、urgent、opted_out 和 access_token 字段。"
      ],
      "instructions": [
        {
          "instruction_ref": "read_events",
          "opcode": "read_events_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "events.json"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "event_records"
            }
          ],
          "constraints": []
        },
        {
          "instruction_ref": "go_iterate_events",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": []
        }
      ]
    },
    {
      "block_ref": "iterate_events",
      "block_name": "Iterate over event records",
      "data_source_kind": null,
      "constraints": [],
      "instructions": [
        {
          "instruction_ref": "get_next_event",
          "opcode": "get_next_event_record",
          "inputs": [
            {
              "type": "result",
              "identifier": "event_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "current_event_record"
            },
            {
              "type": "result",
              "identifier": "has_more_event_records"
            }
          ],
          "constraints": []
        },
        {
          "instruction_ref": "dispatch_on_more",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "has_more_event_records"
            }
          ],
          "outputs": [],
          "constraints": []
        }
      ]
    },
    {
      "block_ref": "evaluate_record",
      "block_name": "Extract fields and evaluate notification selection",
      "data_source_kind": null,
      "constraints": [
        "仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。",
        "urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。"
      ],
      "instructions": [
        {
          "instruction_ref": "extract_event_fields",
          "opcode": "extract_event_notification_fields",
          "inputs": [
            {
              "type": "result",
              "identifier": "current_event_record"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "opted_out_flag"
            },
            {
              "type": "result",
              "identifier": "urgent_flag"
            },
            {
              "type": "result",
              "identifier": "record_value"
            },
            {
              "type": "result",
              "identifier": "notification_recipient"
            },
            {
              "type": "result",
              "identifier": "notification_body"
            }
          ],
          "constraints": [
            "接收对象取该记录的 recipient 字段。",
            "notify.send 的 body 参数直接取该记录的 summary 字段原值。",
            "字段取值要求不包含摘要生成、内容改写或额外格式转换。"
          ]
        },
        {
          "instruction_ref": "check_notification_condition",
          "opcode": "check_notification_condition",
          "inputs": [
            {
              "type": "result",
              "identifier": "opted_out_flag"
            },
            {
              "type": "result",
              "identifier": "urgent_flag"
            },
            {
              "type": "result",
              "identifier": "record_value"
            },
            {
              "type": "literal",
              "literal_value": 100
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "should_notify"
            }
          ],
          "constraints": [
            "仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。",
            "urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。"
          ]
        },
        {
          "instruction_ref": "dispatch_on_selection",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "should_notify"
            }
          ],
          "outputs": [],
          "constraints": []
        }
      ]
    },
    {
      "block_ref": "send_notification",
      "block_name": "Send notify.send for selected record",
      "data_source_kind": null,
      "constraints": [
        "对每条选中记录调用一次 notify.send，接收对象取该记录的 recipient 字段。",
        "notify.send 的 body 参数直接取该记录的 summary 字段原值。",
        "未选中的记录不调用 notify.send。",
        "整份流程禁止将 access_token 字段发送给任何接收对象。"
      ],
      "instructions": [
        {
          "instruction_ref": "send_notify",
          "opcode": "send_notification",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "notify.send"
            },
            {
              "type": "result",
              "identifier": "notification_recipient"
            },
            {
              "type": "result",
              "identifier": "notification_body"
            }
          ],
          "outputs": [],
          "constraints": [
            "对每条选中记录调用一次 notify.send。",
            "整份流程禁止将 access_token 字段发送给任何接收对象。"
          ]
        },
        {
          "instruction_ref": "go_next_after_send",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": []
        }
      ]
    },
    {
      "block_ref": "count_selected_records",
      "block_name": "Count selected event records for processed total",
      "data_source_kind": null,
      "constraints": [],
      "instructions": [
        {
          "instruction_ref": "count_selected",
          "opcode": "count_selected_event_records",
          "inputs": [
            {
              "type": "result",
              "identifier": "event_records"
            },
            {
              "type": "literal",
              "literal_value": 100
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "processed_count"
            }
          ],
          "constraints": [
            "仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。"
          ]
        },
        {
          "instruction_ref": "go_write_count",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": []
        }
      ]
    },
    {
      "block_ref": "write_count",
      "block_name": "Write processed count to count.txt",
      "data_source_kind": null,
      "constraints": [
        "处理完成后，将处理条数写入本地 count.txt。"
      ],
      "instructions": [
        {
          "instruction_ref": "write_count_file",
          "opcode": "write_processed_count_to_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "count.txt"
            },
            {
              "type": "result",
              "identifier": "processed_count"
            }
          ],
          "outputs": [],
          "constraints": [
            "处理完成后，将处理条数写入本地 count.txt。"
          ]
        },
        {
          "instruction_ref": "return_after_write",
          "opcode": "return",
          "inputs": [],
          "outputs": [],
          "constraints": []
        }
      ]
    }
  ],
  "edges": [
    {
      "source_block_ref": "read_events_file",
      "target_block_ref": "iterate_events"
    },
    {
      "source_block_ref": "iterate_events",
      "target_block_ref": "evaluate_record",
      "condition_text": "has more event records"
    },
    {
      "source_block_ref": "iterate_events",
      "target_block_ref": "count_selected_records",
      "condition_text": "no more event records"
    },
    {
      "source_block_ref": "evaluate_record",
      "target_block_ref": "send_notification",
      "condition_text": "selected: opted_out is not true and (urgent is true or value >= 100)"
    },
    {
      "source_block_ref": "evaluate_record",
      "target_block_ref": "iterate_events",
      "condition_text": "not selected: do not call notify.send"
    },
    {
      "source_block_ref": "send_notification",
      "target_block_ref": "iterate_events"
    },
    {
      "source_block_ref": "count_selected_records",
      "target_block_ref": "write_count"
    }
  ],
  "diagnostics": [
    "源文中的“处理条数”未明确是选中记录数还是读取记录总数；本候选按选中并调用 notify.send 的记录数解释。",
    "notify.send 未说明返回值，因此按纯副作用处理。",
    "events.json 按外部文件读取，未声明运行时 context key。",
    "包内没有代码块，因此未提供 metadata.script_content。"
  ]
}
