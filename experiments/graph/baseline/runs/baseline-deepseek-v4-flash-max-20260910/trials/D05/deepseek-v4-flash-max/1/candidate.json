{
  "entry_block_ref": "read_manifest",
  "constraints": [
    "整份流程不得修改输入原文文件。",
    "整份流程禁止把文档上传到外部服务。"
  ],
  "declared_context_keys": [
    "output_dir",
    "delivery_path"
  ],
  "blocks": [
    {
      "block_ref": "read_manifest",
      "block_name": "Read the user-provided manifest.json",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "read_manifest_file",
          "opcode": "read_manifest_json",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "manifest.json",
              "semantic_name": "user-provided manifest.json"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "manifest_data",
              "semantic_name": "manifest contents"
            }
          ]
        },
        {
          "instruction_ref": "go_parse_manifest",
          "opcode": "dispatch"
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "parse_manifest",
      "block_name": "Extract document paths from the manifest",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "extract_document_paths",
          "opcode": "extract_paths_from_manifest",
          "inputs": [
            {
              "type": "result",
              "identifier": "manifest_data"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "document_paths",
              "semantic_name": "document paths"
            }
          ]
        },
        {
          "instruction_ref": "go_read_request",
          "opcode": "dispatch"
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "read_request_settings",
      "block_name": "Read output_dir and delivery_path from the request",
      "data_source_kind": "context",
      "instructions": [
        {
          "instruction_ref": "read_request_settings",
          "opcode": "read_output_dir_and_delivery_path_from_request",
          "inputs": [
            {
              "type": "context_key",
              "identifier": "output_dir"
            },
            {
              "type": "context_key",
              "identifier": "delivery_path"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "requested_output_dir",
              "semantic_name": "requested output_dir"
            },
            {
              "type": "result",
              "identifier": "requested_delivery_path",
              "semantic_name": "requested delivery_path"
            }
          ]
        },
        {
          "instruction_ref": "go_convert_documents",
          "opcode": "dispatch"
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "convert_documents",
      "block_name": "Convert each document with scripts/convert.py and collect stdout paths",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "run_convert_script_for_each_document",
          "opcode": "run_convert_script_for_each_document",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "scripts/convert.py",
              "semantic_name": "scripts/convert.py"
            },
            {
              "type": "result",
              "identifier": "document_paths"
            },
            {
              "type": "result",
              "identifier": "requested_output_dir"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "converted_artifact_paths",
              "semantic_name": "converted artifact paths from stdout"
            }
          ],
          "metadata": {
            "script_path": "scripts/convert.py",
            "script_content": "\"\"\"Convert one UTF-8 text document and print the output path.\"\"\"\nfrom pathlib import Path\nimport sys\n\nsource = Path(sys.argv[1])\noutput_dir = Path(sys.argv[2])\noutput_dir.mkdir(parents=True, exist_ok=True)\noutput = output_dir / (source.stem + \".txt\")\noutput.write_text(source.read_text(encoding=\"utf-8\"), encoding=\"utf-8\")\nprint(output)\n",
            "side_effects": [
              "creates output_dir if needed",
              "writes the converted document to output_dir/<source_stem>.txt",
              "prints the converted output path to stdout"
            ]
          }
        },
        {
          "instruction_ref": "go_package_documents",
          "opcode": "dispatch"
        }
      ],
      "constraints": [
        "转换期间保留原文标题；该要求仅限转换，不限制汇总标题。",
        "转换通过 scripts/convert.py 完成；主流程只使用脚本输出路径，不重复执行脚本内部的处理。"
      ]
    },
    {
      "block_ref": "package_documents",
      "block_name": "Package converted artifacts with scripts/package.py",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "run_package_script",
          "opcode": "run_package_script",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "scripts/package.py",
              "semantic_name": "scripts/package.py"
            },
            {
              "type": "result",
              "identifier": "converted_artifact_paths"
            },
            {
              "type": "literal",
              "literal_value": "bundle.zip"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "bundle_zip_path",
              "semantic_name": "generated bundle.zip"
            }
          ],
          "metadata": {
            "script_path": "scripts/package.py",
            "script_content": "\"\"\"Build the explicitly requested ZIP from supplied output paths.\"\"\"\nimport argparse\nfrom pathlib import Path\nfrom zipfile import ZipFile\n\nparser = argparse.ArgumentParser()\nparser.add_argument(\"--paths\", nargs=\"+\", required=True)\nparser.add_argument(\"--output\", required=True)\nargs = parser.parse_args()\nwith ZipFile(args.output, \"w\") as archive:\n    for filename in args.paths:\n        path = Path(filename)\n        archive.write(path, arcname=path.name)\n",
            "side_effects": [
              "writes the ZIP archive to bundle.zip"
            ]
          }
        },
        {
          "instruction_ref": "go_deliver_bundle",
          "opcode": "dispatch"
        }
      ],
      "constraints": [
        "打包时必须采用下方“参考步骤”的命令，并将转换产物路径列表传给 --paths。"
      ]
    },
    {
      "block_ref": "deliver_bundle",
      "block_name": "Deliver bundle.zip to the requested delivery_path",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "deliver_bundle_zip",
          "opcode": "deliver_bundle_zip_to_path",
          "inputs": [
            {
              "type": "result",
              "identifier": "bundle_zip_path"
            },
            {
              "type": "result",
              "identifier": "requested_delivery_path"
            }
          ]
        },
        {
          "instruction_ref": "return_delivery",
          "opcode": "return"
        }
      ],
      "constraints": []
    }
  ],
  "edges": [
    {
      "source_block_ref": "read_manifest",
      "target_block_ref": "parse_manifest"
    },
    {
      "source_block_ref": "parse_manifest",
      "target_block_ref": "read_request_settings"
    },
    {
      "source_block_ref": "read_request_settings",
      "target_block_ref": "convert_documents"
    },
    {
      "source_block_ref": "convert_documents",
      "target_block_ref": "package_documents"
    },
    {
      "source_block_ref": "package_documents",
      "target_block_ref": "deliver_bundle"
    }
  ],
  "diagnostics": [
    "历史示例（当前流程不执行）：另外，将转换产物路径列表写入本地 receipt.txt。该步骤未被建模为执行指令。",
    "备注“必要时保留原顺序”的范围不明确，未提升为 Skill-wide 约束或执行步骤。",
    "scripts/convert.py 和 scripts/package.py 按黑盒操作建模；其内部文件读写和 ZIP 循环未拆分为独立块。",
    "manifest.json 按外部文件资源建模；output_dir 和 delivery_path 按请求上下文字段建模。",
    "步骤 2 的逐文档转换被视为一个黑盒操作 run_convert_script_for_each_document，未拆分逐文档迭代。"
  ]
}
