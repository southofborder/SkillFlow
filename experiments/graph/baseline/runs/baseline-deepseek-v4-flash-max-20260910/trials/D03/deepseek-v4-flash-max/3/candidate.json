{
  "entry_block_ref": "read_manifest",
  "constraints": [
    "整份流程不得修改输入原文文件。",
    "整份流程禁止把文档上传到外部服务。"
  ],
  "declared_context_keys": [
    "output_dir",
    "delivery_path"
  ],
  "blocks": [
    {
      "block_ref": "read_manifest",
      "block_name": "Read user-provided manifest file",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "read_manifest",
          "opcode": "read_manifest_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "manifest.json"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "manifest_contents"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_to_read_output_dir",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": []
        }
      ]
    },
    {
      "block_ref": "read_output_dir",
      "block_name": "Read output_dir from request",
      "data_source_kind": "context",
      "instructions": [
        {
          "instruction_ref": "read_output_dir",
          "opcode": "read_output_dir_from_request",
          "inputs": [
            {
              "type": "context_key",
              "identifier": "output_dir"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "output_dir_path"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_to_read_delivery_path",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": []
        }
      ]
    },
    {
      "block_ref": "read_delivery_path",
      "block_name": "Read delivery_path from request",
      "data_source_kind": "context",
      "instructions": [
        {
          "instruction_ref": "read_delivery_path",
          "opcode": "read_delivery_path_from_request",
          "inputs": [
            {
              "type": "context_key",
              "identifier": "delivery_path"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "delivery_path_value"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_to_extract_paths",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": []
        }
      ]
    },
    {
      "block_ref": "extract_paths",
      "block_name": "Extract document paths from manifest",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "extract_paths",
          "opcode": "extract_paths_from_manifest",
          "inputs": [
            {
              "type": "result",
              "identifier": "manifest_contents"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "document_paths"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_to_convert_documents",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": []
        }
      ]
    },
    {
      "block_ref": "convert_documents",
      "block_name": "Convert each document with scripts/convert.py",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "convert_documents",
          "opcode": "run_convert_script_for_each_document",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "scripts/convert.py"
            },
            {
              "type": "result",
              "identifier": "document_paths"
            },
            {
              "type": "result",
              "identifier": "output_dir_path"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "converted_artifact_paths"
            }
          ],
          "constraints": [
            "转换期间保留原文标题；该要求仅限转换，不限制汇总标题。",
            "转换通过 scripts/convert.py 完成；主流程只使用脚本输出路径，不重复执行脚本内部的处理。"
          ],
          "metadata": {
            "command_template": "python scripts/convert.py <文档路径> <output_dir>",
            "script_content": "\"\"\"Convert one UTF-8 text document and print the output path.\"\"\"\nfrom pathlib import Path\nimport sys\n\nsource = Path(sys.argv[1])\noutput_dir = Path(sys.argv[2])\noutput_dir.mkdir(parents=True, exist_ok=True)\noutput = output_dir / (source.stem + \".txt\")\noutput.write_text(source.read_text(encoding=\"utf-8\"), encoding=\"utf-8\")\nprint(output)\n"
          }
        },
        {
          "instruction_ref": "dispatch_to_package_documents",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": []
        }
      ]
    },
    {
      "block_ref": "package_documents",
      "block_name": "Package converted documents with scripts/package.py",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "package_documents",
          "opcode": "package_converted_documents",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "scripts/package.py"
            },
            {
              "type": "result",
              "identifier": "converted_artifact_paths"
            },
            {
              "type": "external_resource",
              "identifier": "bundle.zip"
            }
          ],
          "constraints": [
            "打包时必须采用下方“参考步骤”的命令，并将转换产物路径列表传给 --paths。"
          ],
          "metadata": {
            "command": "python scripts/package.py --paths <转换产物路径列表> --output bundle.zip",
            "script_content": "\"\"\"Build the explicitly requested ZIP from supplied output paths.\"\"\"\nimport argparse\nfrom pathlib import Path\nfrom zipfile import ZipFile\n\nparser = argparse.ArgumentParser()\nparser.add_argument(\"--paths\", nargs=\"+\", required=True)\nparser.add_argument(\"--output\", required=True)\nargs = parser.parse_args()\nwith ZipFile(args.output, \"w\") as archive:\n    for filename in args.paths:\n        path = Path(filename)\n        archive.write(path, arcname=path.name)\n"
          }
        },
        {
          "instruction_ref": "dispatch_to_deliver_bundle",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": []
        }
      ]
    },
    {
      "block_ref": "deliver_bundle",
      "block_name": "Deliver bundle.zip to delivery_path",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "deliver_bundle",
          "opcode": "deliver_bundle",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "bundle.zip"
            },
            {
              "type": "result",
              "identifier": "delivery_path_value"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_to_write_receipt",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": []
        }
      ]
    },
    {
      "block_ref": "write_receipt",
      "block_name": "Write converted artifact paths to receipt.txt",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "write_receipt",
          "opcode": "write_receipt_file",
          "inputs": [
            {
              "type": "result",
              "identifier": "converted_artifact_paths"
            },
            {
              "type": "external_resource",
              "identifier": "receipt.txt"
            }
          ]
        },
        {
          "instruction_ref": "return_receipt",
          "opcode": "return",
          "inputs": [],
          "outputs": []
        }
      ]
    }
  ],
