{
  "entry_block_ref": "read_manifest",
  "constraints": [
    "整份流程不得修改输入原文文件。",
    "整份流程禁止把文档上传到外部服务。"
  ],
  "declared_context_keys": [
    "output_dir",
    "delivery_path"
  ],
  "blocks": [
    {
      "block_ref": "read_manifest",
      "block_name": "Read the user-provided manifest.json",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "read_manifest_json",
          "opcode": "read_manifest_json",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "manifest.json"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "manifest_data"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_after_manifest",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "extract_paths",
      "block_name": "Extract document paths from the manifest",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "extract_document_paths",
          "opcode": "extract_document_paths",
          "inputs": [
            {
              "type": "result",
              "identifier": "manifest_data"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "document_paths"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_after_extract",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "read_request",
      "block_name": "Read output_dir and delivery_path from the request",
      "data_source_kind": "context",
      "instructions": [
        {
          "instruction_ref": "read_request_params",
          "opcode": "read_output_dir_and_delivery_path_from_request",
          "inputs": [
            {
              "type": "context_key",
              "identifier": "output_dir"
            },
            {
              "type": "context_key",
              "identifier": "delivery_path"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "requested_output_dir"
            },
            {
              "type": "result",
              "identifier": "requested_delivery_path"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_after_request",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "convert",
      "block_name": "Convert each document and collect output paths",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "run_convert_script",
          "opcode": "convert_documents",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "scripts/convert.py"
            },
            {
              "type": "result",
              "identifier": "document_paths"
            },
            {
              "type": "result",
              "identifier": "requested_output_dir"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "converted_artifact_paths"
            }
          ],
          "constraints": [
            "转换期间保留原文标题；该要求仅限转换，不限制汇总标题。",
            "转换通过 scripts/convert.py 完成；主流程只使用脚本输出路径，不重复执行脚本内部的处理。"
          ],
          "metadata": {
            "command": "python scripts/convert.py <文档路径> <output_dir>",
            "script_content": "\"\"\"Convert one UTF-8 text document and print the output path.\"\"\"\nfrom pathlib import Path\nimport sys\n\nsource = Path(sys.argv[1])\noutput_dir = Path(sys.argv[2])\noutput_dir.mkdir(parents=True, exist_ok=True)\noutput = output_dir / (source.stem + \".txt\")\noutput.write_text(source.read_text(encoding=\"utf-8\"), encoding=\"utf-8\")\nprint(output)\n"
          }
        },
        {
          "instruction_ref": "dispatch_after_convert",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "package",
      "block_name": "Package converted artifacts into bundle.zip",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "run_package_script",
          "opcode": "package_artifacts_into_zip",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "scripts/package.py"
            },
            {
              "type": "result",
              "identifier": "converted_artifact_paths"
            },
            {
              "type": "literal",
              "literal_value": "bundle.zip"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "bundle_zip_path"
            }
          ],
          "constraints": [
            "打包时必须采用下方“参考步骤”的命令，并将转换产物路径列表传给 --paths。"
          ],
          "metadata": {
            "command": "python scripts/package.py --paths <转换产物路径列表> --output bundle.zip",
            "script_content": "\"\"\"Build the explicitly requested ZIP from supplied output paths.\"\"\"\nimport argparse\nfrom pathlib import Path\nfrom zipfile import ZipFile\n\nparser = argparse.ArgumentParser()\nparser.add_argument(\"--paths\", nargs=\"+\", required=True)\nparser.add_argument(\"--output\", required=True)\nargs = parser.parse_args()\nwith ZipFile(args.output, \"w\") as archive:\n    for filename in args.paths:\n        path = Path(filename)\n        archive.write(path, arcname=path.name)\n"
          }
        },
        {
          "instruction_ref": "dispatch_after_package",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "deliver",
      "block_name": "Deliver bundle.zip to the requested delivery path",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "deliver_bundle",
          "opcode": "deliver_bundle_zip",
          "inputs": [
            {
              "type": "result",
              "identifier": "bundle_zip_path"
            },
            {
              "type": "result",
              "identifier": "requested_delivery_path"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_after_deliver",
          "opcode": "dispatch"
        }
      ]
    },
    {
      "block_ref": "receipt",
      "block_name": "Write converted artifact paths to local receipt.txt",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "write_receipt",
          "opcode": "write_receipt_txt",
          "inputs": [
            {
              "type": "result",
              "identifier": "converted_artifact_paths"
            },
            {
              "type": "external_resource",
              "identifier": "receipt.txt"
            }
          ]
        },
        {
          "instruction_ref": "return_after_receipt",
          "opcode": "return"
        }
      ]
    }
  ],
  "edges": [
    {
      "source_block_ref": "read_manifest",
      "target_block_ref": "extract_paths"
    },
    {
      "source_block_ref": "extract_paths",
      "target_block_ref": "read_request"
    },
    {
      "source_block_ref": "read_request",
      "target_block_ref": "convert"
    },
    {
      "source_block_ref": "convert",
      "target_block_ref": "package"
    },
    {
      "source_block_ref": "package",
      "target_block_ref": "deliver"
    },
    {
      "source_block_ref": "deliver",
      "target_block_ref": "receipt"
    }
  ],
  "diagnostics": [
    "Note in SKILL.md says '必要时保留原顺序'; scope unclear, not promoted to constraint."
  ]
}
