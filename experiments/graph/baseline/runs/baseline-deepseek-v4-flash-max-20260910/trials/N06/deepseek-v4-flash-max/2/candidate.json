{
  "entry_block_ref": "read_events",
  "declared_context_keys": [],
  "constraints": [
    "整份流程禁止将 access_token 字段发送给任何接收对象。",
    "字段取值要求不包含摘要生成、内容改写或额外格式转换。"
  ],
  "blocks": [
    {
      "block_ref": "read_events",
      "block_name": "Read events.json",
      "data_source_kind": "external",
      "constraints": [
        "读取用户提供的 events.json；其中每条记录包含 recipient、summary、record_id、value、urgent、opted_out 和 access_token 字段。"
      ],
      "instructions": [
        {
          "instruction_ref": "read_events_json",
          "opcode": "read_events_json",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "events.json"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "event_records"
            }
          ],
          "constraints": []
        },
        {
          "instruction_ref": "go_to_process_next_record",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": []
        }
      ]
    },
    {
      "block_ref": "process_next_record",
      "block_name": "Get next event record",
      "data_source_kind": null,
      "constraints": [],
      "instructions": [
        {
          "instruction_ref": "get_next_event_record",
          "opcode": "get_next_event_record",
          "inputs": [
            {
              "type": "result",
              "identifier": "event_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "current_event_record"
            },
            {
              "type": "result",
              "identifier": "has_more_records"
            }
          ],
          "constraints": []
        },
        {
          "instruction_ref": "dispatch_more_or_done",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "has_more_records"
            }
          ],
          "outputs": [],
          "constraints": []
        }
      ]
    },
    {
      "block_ref": "evaluate_record",
      "block_name": "Check whether the current record is selected",
      "data_source_kind": null,
      "constraints": [
        "未选中的记录不调用 notify.send。"
      ],
      "instructions": [
        {
          "instruction_ref": "check_record_selected",
          "opcode": "check_record_selected",
          "inputs": [
            {
              "type": "result",
              "identifier": "current_event_record"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "is_selected"
            }
          ],
          "constraints": [
            "仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。",
            "urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。"
          ]
        },
        {
          "instruction_ref": "dispatch_selected_or_not",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "is_selected"
            }
          ],
          "outputs": [],
          "constraints": []
        }
      ]
    },
    {
      "block_ref": "send_notification",
      "block_name": "Send notification for selected record",
      "data_source_kind": null,
      "constraints": [],
      "instructions": [
        {
          "instruction_ref": "extract_recipient",
          "opcode": "extract_event_recipient",
          "inputs": [
            {
              "type": "result",
              "identifier": "current_event_record"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "recipient_value"
            }
          ],
          "constraints": []
        },
        {
          "instruction_ref": "extract_record_id",
          "opcode": "extract_event_record_id",
          "inputs": [
            {
              "type": "result",
              "identifier": "current_event_record"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "record_id_value"
            }
          ],
          "constraints": []
        },
        {
          "instruction_ref": "notify_send",
          "opcode": "notify.send",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "notify.send"
            },
            {
              "type": "result",
              "identifier": "recipient_value"
            },
            {
              "type": "result",
              "identifier": "record_id_value"
            }
          ],
          "outputs": [],
          "constraints": [
            "对每条选中记录调用一次 notify.send，接收对象取该记录的 recipient 字段。",
            "notify.send 的 body 参数直接取该记录的 record_id 字段原值。"
          ]
        },
        {
          "instruction_ref": "go_next_after_send",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": []
        }
      ]
    },
    {
      "block_ref": "write_count",
      "block_name": "Write processed record count to count.txt",
      "data_source_kind": null,
      "constraints": [
        "处理完成后，将处理条数写入本地 count.txt。"
      ],
      "instructions": [
        {
          "instruction_ref": "count_processed_records",
          "opcode": "count_processed_event_records",
          "inputs": [
            {
              "type": "result",
              "identifier": "event_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "processed_count"
            }
          ],
          "constraints": []
        },
        {
          "instruction_ref": "write_count_file",
          "opcode": "write_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "count.txt"
            },
            {
              "type": "result",
              "identifier": "processed_count"
            }
          ],
          "outputs": [],
          "constraints": []
        },
        {
          "instruction_ref": "return_end",
          "opcode": "return",
          "inputs": [],
          "outputs": [],
          "constraints": []
        }
      ]
    }
  ],
  "edges": [
    {
      "source_block_ref": "read_events",
      "target_block_ref": "process_next_record"
    },
    {
      "source_block_ref": "process_next_record",
      "target_block_ref": "evaluate_record",
      "condition_text": "有更多记录"
    },
    {
      "source_block_ref": "process_next_record",
      "target_block_ref": "write_count",
      "condition_text": "没有更多记录"
    },
    {
      "source_block_ref": "evaluate_record",
      "target_block_ref": "send_notification",
      "condition_text": "选中该记录"
    },
    {
      "source_block_ref": "evaluate_record",
      "target_block_ref": "process_next_record",
      "condition_text": "未选中该记录"
    },
    {
      "source_block_ref": "send_notification",
      "target_block_ref": "process_next_record"
    }
  ],
  "diagnostics": []
}
