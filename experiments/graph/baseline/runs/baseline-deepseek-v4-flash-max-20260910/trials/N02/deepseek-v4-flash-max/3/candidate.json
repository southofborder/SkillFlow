        },
        {
          "instruction_ref": "write_count_to_file",
          "opcode": "write_count_to_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "count.txt"
            },
            {
              "type": "result",
              "identifier": "processed_record_count"
            }
          ],
          "outputs": [],
          "constraints": [
            "Write the processed count to the local count.txt file."
          ]
        },
        {
          "instruction_ref": "return_after_count",
          "opcode": "return",
          "inputs": [],
          "outputs": [],
          "constraints": []
        }
      ],
      "constraints": []
    }
  ],
  "edges": [
    {
      "source_block_ref": "read_events_file",
      "target_block_ref": "iterate_event_records"
    },
    {
      "source_block_ref": "iterate_event_records",
