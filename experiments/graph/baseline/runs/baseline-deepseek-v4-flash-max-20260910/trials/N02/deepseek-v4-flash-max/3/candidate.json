              "identifier": "event_summary"
            },
            {
              "type": "result",
              "identifier": "event_value"
            },
            {
              "type": "result",
              "identifier": "event_urgent"
            },
            {
              "type": "result",
              "identifier": "event_opted_out"
            }
          ],
          "constraints": []
        },
        {
          "instruction_ref": "check_event_selection",
