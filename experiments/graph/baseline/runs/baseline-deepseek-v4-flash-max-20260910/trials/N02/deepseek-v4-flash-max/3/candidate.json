            },
            {
              "type": "result",
              "identifier": "event_summary"
            }
          ],
          "outputs": [],
          "constraints": [
            "Call notify.send once for each selected record.",
            "The recipient is the record's recipient field.",
            "The body parameter is the record's original summary field value.",
            "Do not send the access_token field to any recipient.",
            "Do not perform summarization, content rewriting, or extra formatting."
          ]
        },
        {
          "instruction_ref": "continue_after_send",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": []
        }
      ],
      "constraints": []
    },
    {
