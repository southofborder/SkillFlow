          "instruction_ref": "count_processed_records",
          "opcode": "count_processed_event_records",
          "inputs": [
            {
              "type": "result",
              "identifier": "events_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "processed_record_count"
            }
          ],
          "constraints": [
