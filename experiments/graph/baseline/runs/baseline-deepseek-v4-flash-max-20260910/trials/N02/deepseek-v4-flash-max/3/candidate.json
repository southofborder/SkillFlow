    },
    {
      "source_block_ref": "process_event_record",
      "target_block_ref": "iterate_event_records",
      "condition_text": "record_selected is false"
    },
    {
      "source_block_ref": "send_notification",
      "target_block_ref": "iterate_event_records"
    }
  ],
  "diagnostics": [
    "The source lists record_id but does not use it in any behavior; it is omitted from operands.",
    "The phrase '处理条数' is not explicitly defined; modeled as the number of selected event records that satisfy the notification criteria and are processed.",
    "notify.send return value is not specified, so no result is produced for it.",
    "events.json is treated as an external resource provided by the user."
  ]
