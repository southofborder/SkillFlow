{
  "entry_block_ref": "read_records",
  "constraints": [
    "不得记录 email。",
    "不得将 email 发送给 notify_admin 之外的任何目标。"
  ],
  "declared_context_keys": [
    "records"
  ],
  "blocks": [
    {
      "block_ref": "read_records",
      "block_name": "从运行时上下文读取输入记录",
      "data_source_kind": "context",
      "instructions": [
        {
          "instruction_ref": "read_input_records",
          "opcode": "read_input_records",
          "inputs": [
            {
              "type": "context_key",
              "identifier": "records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "input_records",
              "semantic_name": "输入记录"
            }
          ],
          "constraints": [],
          "metadata": {}
        },
        {
          "instruction_ref": "dispatch_to_iteration",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "select_next_record",
      "block_name": "选择下一条输入记录",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "iterate_input_records",
          "opcode": "iterate_input_records",
          "inputs": [
            {
              "type": "result",
              "identifier": "input_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "current_record",
              "semantic_name": "当前记录"
            },
            {
              "type": "result",
              "identifier": "record_available",
              "semantic_name": "是否还有记录"
            }
          ],
          "constraints": [],
          "metadata": {}
        },
        {
          "instruction_ref": "dispatch_on_record_availability",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "record_available"
            }
          ],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "extract_record_fields",
      "block_name": "提取记录的 name、email 和 urgency 字段",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "extract_name_email_urgency",
          "opcode": "extract_name_email_urgency",
          "inputs": [
            {
              "type": "result",
              "identifier": "current_record"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "record_name",
              "semantic_name": "name"
            },
            {
              "type": "result",
              "identifier": "record_email",
              "semantic_name": "email"
            },
            {
              "type": "result",
              "identifier": "record_urgency",
              "semantic_name": "urgency"
            }
          ],
          "constraints": [
            "字段提取不得包含内容改写或额外格式转换。"
          ],
          "metadata": {}
        },
        {
          "instruction_ref": "dispatch_to_urgency_check",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "check_record_urgency",
      "block_name": "检查记录的 urgency 是否为 high",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "check_high_urgency",
          "opcode": "check_urgency",
          "inputs": [
            {
              "type": "result",
              "identifier": "record_urgency"
            },
            {
              "type": "literal",
              "literal_value": "high"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "is_high_urgency",
              "semantic_name": "urgency 是否为 high"
            }
          ],
          "constraints": [],
          "metadata": {}
        },
        {
          "instruction_ref": "dispatch_on_urgency",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "is_high_urgency"
            }
          ],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "notify_admin",
      "block_name": "向 notify_admin 发送高紧急度记录",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "call_notify_admin",
          "opcode": "notify_admin",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "notify_admin"
            },
            {
              "type": "result",
              "identifier": "record_name"
            },
            {
              "type": "result",
              "identifier": "record_email"
            }
          ],
          "outputs": [],
          "constraints": [
            "不得记录 email。",
            "不得将 email 发送给 notify_admin 之外的任何目标。"
          ],
          "metadata": {}
        },
        {
          "instruction_ref": "dispatch_to_next_record",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "count_processed_records",
      "block_name": "计算处理完成的记录条数",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "count_records",
          "opcode": "count_processed_records",
          "inputs": [
            {
              "type": "result",
              "identifier": "input_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "processed_record_count",
              "semantic_name": "处理条数"
            }
          ],
          "constraints": [],
          "metadata": {}
        },
        {
          "instruction_ref": "dispatch_to_count_file",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "write_count_file",
      "block_name": "将处理条数写入本地 count.txt",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "write_processed_count",
          "opcode": "write_processed_count_to_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "count.txt"
            },
            {
              "type": "result",
              "identifier": "processed_record_count"
            }
          ],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        },
        {
          "instruction_ref": "return_after_processing",
          "opcode": "return",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        }
      ],
      "constraints": []
    }
  ],
  "edges": [
    {
      "source_block_ref": "read_records",
      "target_block_ref": "select_next_record",
      "condition_text": null
    },
    {
      "source_block_ref": "select_next_record",
      "target_block_ref": "extract_record_fields",
      "condition_text": "还有一条输入记录"
    },
    {
      "source_block_ref": "select_next_record",
      "target_block_ref": "count_processed_records",
      "condition_text": "没有更多输入记录"
    },
    {
      "source_block_ref": "extract_record_fields",
      "target_block_ref": "check_record_urgency",
      "condition_text": null
    },
    {
      "source_block_ref": "check_record_urgency",
      "target_block_ref": "notify_admin",
      "condition_text": "urgency 等于 high"
    },
    {
      "source_block_ref": "check_record_urgency",
      "target_block_ref": "select_next_record",
      "condition_text": "urgency 不等于 high，跳过通知"
    },
    {
      "source_block_ref": "notify_admin",
      "target_block_ref": "select_next_record",
      "condition_text": null
    },
    {
      "source_block_ref": "count_processed_records",
