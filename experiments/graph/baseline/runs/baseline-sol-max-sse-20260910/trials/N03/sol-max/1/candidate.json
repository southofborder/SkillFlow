{
  "entry_block_ref": "read_events",
  "constraints": [
    "整份流程禁止将 access_token 字段发送给任何接收对象。",
    "字段取值要求不包含摘要生成、内容改写或额外格式转换。"
  ],
  "declared_context_keys": [],
  "blocks": [
    {
      "block_ref": "read_events",
      "block_name": "Read the user-provided events.json file",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "read_events_json",
          "opcode": "read_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "events.json",
              "semantic_name": "user-provided events.json"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "event_records",
              "semantic_name": "event records"
            }
          ],
          "constraints": [],
          "metadata": {}
        },
        {
          "instruction_ref": "dispatch_to_iteration",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "iterate_records",
      "block_name": "Process each event record",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "get_next_record",
          "opcode": "get_next_event_record",
          "inputs": [
            {
              "type": "result",
              "identifier": "event_records",
              "semantic_name": "event records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "current_event_record",
              "semantic_name": "current event record"
            },
            {
              "type": "result",
              "identifier": "has_next_event_record",
              "semantic_name": "whether another event record is available"
            }
          ],
          "constraints": [],
          "metadata": {}
        },
        {
          "instruction_ref": "dispatch_on_record_availability",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "has_next_event_record",
              "semantic_name": "whether another event record is available"
            }
          ],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "extract_record_fields",
      "block_name": "Extract the fields needed to evaluate and notify the record",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "extract_fields",
          "opcode": "extract_event_record_fields",
          "inputs": [
            {
              "type": "result",
              "identifier": "current_event_record",
              "semantic_name": "current event record"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "current_recipient",
              "semantic_name": "recipient"
            },
            {
              "type": "result",
              "identifier": "current_summary",
              "semantic_name": "summary"
            },
            {
              "type": "result",
              "identifier": "current_record_id",
              "semantic_name": "record_id"
            },
            {
              "type": "result",
              "identifier": "current_value",
              "semantic_name": "value"
            },
            {
              "type": "result",
              "identifier": "current_urgent",
              "semantic_name": "urgent"
            },
            {
              "type": "result",
              "identifier": "current_opted_out",
              "semantic_name": "opted_out"
            },
            {
              "type": "result",
              "identifier": "current_access_token",
              "semantic_name": "access_token"
            }
          ],
          "constraints": [],
          "metadata": {}
        },
        {
          "instruction_ref": "dispatch_to_selection",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "select_record",
      "block_name": "Select records eligible for notification",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "check_notification_eligibility",
          "opcode": "check_notification_eligibility",
          "inputs": [
            {
              "type": "result",
              "identifier": "current_opted_out",
              "semantic_name": "opted_out"
            },
            {
              "type": "result",
              "identifier": "current_urgent",
              "semantic_name": "urgent"
            },
            {
              "type": "result",
              "identifier": "current_value",
              "semantic_name": "value"
            },
            {
              "type": "literal",
              "literal_value": true
            },
            {
              "type": "literal",
              "literal_value": 100
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "record_selected_for_notification",
              "semantic_name": "whether the record is selected"
            }
          ],
          "constraints": [
            "仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。",
            "urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。"
          ],
          "metadata": {}
        },
        {
          "instruction_ref": "dispatch_on_selection",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "record_selected_for_notification",
              "semantic_name": "whether the record is selected"
            }
          ],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "send_notification",
      "block_name": "Send the selected record notification",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "send_selected_notification",
          "opcode": "notify.send",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "notify.send",
              "semantic_name": "notification service"
            },
            {
              "type": "result",
              "identifier": "current_recipient",
              "semantic_name": "recipient"
            },
            {
              "type": "result",
              "identifier": "current_summary",
              "semantic_name": "body"
            }
          ],
          "outputs": [],
          "constraints": [
            "对每条选中记录调用一次 notify.send。",
            "接收对象取该记录的 recipient 字段。",
            "notify.send 的 body 参数直接取该记录的 summary 字段原值。"
          ],
          "metadata": {}
        },
        {
          "instruction_ref": "dispatch_after_notification",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "skip_notification",
      "block_name": "Skip notification for an unselected record",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "dispatch_after_skip",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        }
      ],
      "constraints": [
        "未选中的记录不调用 notify.send。"
      ]
    },
    {
      "block_ref": "count_records",
      "block_name": "Count the processed event records",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "count_processed_records",
          "opcode": "count_processed_event_records",
          "inputs": [
            {
              "type": "result",
              "identifier": "event_records",
              "semantic_name": "event records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "processed_record_count",
              "semantic_name": "number of processed records"
            }
          ],
          "constraints": [],
          "metadata": {}
        },
        {
          "instruction_ref": "dispatch_to_count_file",
          "opcode": "dispatch",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "write_count",
      "block_name": "Write the processed count to count.txt",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "write_processed_count",
          "opcode": "write_count_to_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "count.txt",
              "semantic_name": "local count file"
            },
            {
              "type": "result",
              "identifier": "processed_record_count",
              "semantic_name": "number of processed records"
            }
          ],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        },
        {
          "instruction_ref": "return_after_count_write",
          "opcode": "return",
          "inputs": [],
          "outputs": [],
          "constraints": [],
          "metadata": {}
        }
      ],
      "constraints": []
    }
  ],
  "edges": [
    {
      "source_block_ref": "read_events",
      "target_block_ref": "iterate_records",
      "condition_text": null
    },
    {
      "source_block_ref": "iterate_records",
      "target_block_ref": "extract_record_fields",
      "condition_text": "another event record is available"
    },
    {
      "source_block_ref": "iterate_records",
      "target_block_ref": "count_records",
      "condition_text": "no event records remain"
    },
    {
      "source_block_ref": "extract_record_fields",
      "target_block_ref": "select_record",
      "condition_text": null
    },
    {
      "source_block_ref": "select_record",
      "target_block_ref": "send_notification",
      "condition_text": "record is selected"
    },
    {
      "source_block_ref": "select_record",
      "target_block_ref": "skip_notification",
      "condition_text": "record is not selected"
    },
    {
      "source_block_ref": "send_notification",
      "target_block_ref": "iterate_records",
      "condition_text": null
    },
    {
      "source_block_ref": "skip_notification",
      "target_block_ref": "iterate_records",
      "condition_text": null
    },
    {
      "source_block_ref": "count_records",
      "target_block_ref": "write_count",
      "condition_text": null
    }
  ],
  "diagnostics": []
}
