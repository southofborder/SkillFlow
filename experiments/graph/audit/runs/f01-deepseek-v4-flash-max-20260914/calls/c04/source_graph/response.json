"{\n  \"direction\": \"source_to_graph\",\n  \"findings\": [\n    {\n      \"id\": \"finding_1\",\n      \"status\": \"represented\",\n      \"statement\": \"原文要求：使用凭据门控的首选工具与有界归档回退来获取一个 source。\",\n      \"explanation\": \"图中 fast.fetch 仅在 FAST_KEY 存在时经 block_003→block_004 尝试；archive.fetch 仅在 FAST_KEY 缺失或 fast.fetch 非瞬时/重试失败后进入，且 block_011 约束限制 archive.fetch 最多调用一次，符合“凭据门控首选工具 + 有界归档回退”的总体方式。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 3,\n          \"end_line\": 3,\n          \"quote\": \"Fetch one source using a credential-gated preferred tool and a bounded archive fallback.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_003\",\n        \"/blocks/block_004/instructions/0\",\n        \"/blocks/block_011/constraints/1\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_1\"\n      ],\n      \"basis\": [\n        \"explicit_graph\",\n        \"declared_constraint\"\n      ]\n    },\n    {\n      \"id\": \"finding_2\",\n      \"status\": \"represented\",\n      \"statement\": \"原文要求：从用户请求读取 source_id，并从环境读取 FAST_KEY。\",\n      \"explanation\": \"block_001/ir_001 从 context_key source_id 读取并产出 result_001；block_002/ir_003 从 context_key FAST_KEY 读取并产出 result_002。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 8,\n          \"end_line\": 8,\n          \"quote\": \"Read source_id from the user's request and read FAST_KEY from the environment.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_001/instructions/0\",\n        \"/blocks/block_002/instructions/0\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_2\"\n      ],\n      \"basis\": [\n        \"explicit_graph\"\n      ]\n    },\n    {\n      \"id\": \"finding_3\",\n      \"status\": \"represented\",\n      \"statement\": \"原文要求：FAST_KEY 存在时先用 source_id 与 FAST_KEY 尝试 fast.fetch；FAST_KEY 不存在时直接 archive.fetch，且不得调用 fast.fetch。\",\n      \"explanation\": \"block_003/ir_005 检查 result_002 是否存在，dispatch 边分别给出 present→block_004、absent→block_011；block_004/ir_007 的输入为 result_001 与 result_002。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 9,\n          \"end_line\": 9,\n          \"quote\": \"If FAST_KEY is present, try fast.fetch first with source_id and FAST_KEY; if it is absent, go directly to archive.fetch without calling fast.fetch.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_003/constraints/0\",\n        \"/blocks/block_003/instructions/0\",\n        \"/edges/2\",\n        \"/edges/3\",\n        \"/blocks/block_004/instructions/0\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_3\"\n      ],\n      \"basis\": [\n        \"explicit_graph\",\n        \"declared_constraint\"\n      ]\n    },\n    {\n      \"id\": \"finding_4\",\n      \"status\": \"represented\",\n      \"statement\": \"原文要求：仅当 fast.fetch 首次以 transient error 失败时重试一次；非 transient 首次失败不得重试。\",\n      \"explanation\": \"block_007/ir_013 分类 transient；边 /edges/7 transient→block_008，/edges/8 non-transient→block_011；block_008 只含一次 ir_015 retry_fast_fetch 且约束文本与原文一致，重试失败边不回环到重试块。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 10,\n          \"end_line\": 10,\n          \"quote\": \"Retry fast.fetch exactly once only when its first attempt fails with a transient error; do not retry a non-transient first failure.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_007/instructions/0\",\n        \"/blocks/block_008/constraints/0\",\n        \"/blocks/block_008/instructions/0\",\n        \"/edges/7\",\n        \"/edges/8\",\n        \"/edges/11\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_4\"\n      ],\n      \"basis\": [\n        \"explicit_graph\",\n        \"declared_constraint\"\n      ]\n    },\n    {\n      \"id\": \"finding_5\",\n      \"status\": \"represented\",\n      \"statement\": \"原文要求：fast.fetch 非 transient 首次失败或任一次重试失败后，用 source_id 调用 archive.fetch。\",\n      \"explanation\": \"非 transient 首次失败边 /edges/8 与重试失败边 /edges/11 均指向 block_011；block_011/ir_021 使用 result_001(source_id) 调用 archive.fetch。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 11,\n          \"end_line\": 11,\n          \"quote\": \"After a non-transient first failure or any failed retry of fast.fetch, call archive.fetch with source_id.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/edges/8\",\n        \"/edges/11\",\n        \"/blocks/block_011/constraints/0\",\n        \"/blocks/block_011/instructions/0\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_5\"\n      ],\n      \"basis\": [\n        \"explicit_graph\",\n        \"declared_constraint\"\n      ]\n    },\n    {\n      \"id\": \"finding_6\",\n      \"status\": \"represented\",\n      \"statement\": \"原文要求：archive.fetch 最多调用一次，并且只传 source_id 作为参数。\",\n      \"explanation\": \"图中仅 block_011/ir_021 一处 call_archive_fetch；block_011 约束声明 at most once 与 source_id only argument。ir_021 中 external_resource archive.fetch 用于定位调用目标，业务参数输入只有 result_001(source_id)。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 12,\n          \"end_line\": 12,\n          \"quote\": \"Call archive.fetch at most once and pass source_id as its only argument.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_011/constraints/1\",\n        \"/blocks/block_011/instructions/0/inputs/0\",\n        \"/blocks/block_011/instructions/0/inputs/1\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_6\"\n      ],\n      \"basis\": [\n        \"explicit_graph\",\n        \"declared_constraint\"\n      ]\n    },\n    {\n      \"id\": \"finding_7\",\n      \"status\": \"mistranslated\",\n      \"statement\": \"原文要求：任一工具成功时，返回该成功响应的 body 值且不改变，并且不再发起 fetch 调用。\",\n      \"explanation\": \"首次 fast.fetch 成功路径 block_006/ir_012 返回 result_004，archive 成功路径 block_013/ir_026 返回 result_011，方向正确；但 retry 成功路径 block_010/ir_020 返回的是首次尝试的 result_004，而成功重试的 body 是 ir_015 产出的 result_008。该错绑使“返回成功响应 body”的要求未在重试成功路径保留；不再 fetch 的结构性终止仍存在。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 13,\n          \"end_line\": 13,\n          \"quote\": \"On either tool's success, return that successful response's body value unchanged and make no further fetch calls.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_010/block_name\",\n        \"/blocks/block_010/instructions/1/inputs/0\",\n        \"/blocks/block_008/instructions/0/outputs/0\",\n        \"/blocks/block_009/instructions/0/outputs/0\",\n        \"/blocks/block_006/instructions/1\",\n        \"/blocks/block_013/instructions/1\",\n        \"/constraints/2\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_7\"\n      ],\n      \"basis\": [\n        \"explicit_graph\",\n        \"declared_constraint\"\n      ]\n    },\n    {\n      \"id\": \"finding_8\",\n      \"status\": \"represented\",\n      \"statement\": \"原文要求：archive.fetch 失败时停止并返回其 error；不得重试。\",\n      \"explanation\": \"block_012 的 archive.fetch failed 边 /edges/14 指向 block_014；block_014/ir_027 先追加 failure，ir_028 返回 result_012(archive_fetch_error)，且 block_014 无后继重试边；block_011 约束亦声明不重试。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 14,\n          \"end_line\": 14,\n          \"quote\": \"If archive.fetch fails, stop and return its error; do not retry archive.fetch.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/edges/14\",\n        \"/blocks/block_011/constraints/2\",\n        \"/blocks/block_014/instructions/0\",\n        \"/blocks/block_014/instructions/1\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_8\"\n      ],\n      \"basis\": [\n        \"explicit_graph\",\n        \"declared_constraint\"\n      ]\n    },\n    {\n      \"id\": \"finding_9\",\n      \"status\": \"represented\",\n      \"statement\": \"原文要求：工作流任何位置都不得把 FAST_KEY 传给 archive.fetch 或 diagnostic output。\",\n      \"explanation\": \"顶层约束 /constraints/0 明确禁止；archive.fetch 调用 ir_021 的输入没有 result_002(FAST_KEY)，图中也没有 diagnostic output 操作把 FAST_KEY 作为输入。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 15,\n          \"end_line\": 15,\n          \"quote\": \"Never pass FAST_KEY to archive.fetch or diagnostic output anywhere in this workflow.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/constraints/0\",\n        \"/blocks/block_011/instructions/0/inputs/0\",\n        \"/blocks/block_011/instructions/0/inputs/1\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_9\"\n      ],\n      \"basis\": [\n        \"explicit_graph\",\n        \"declared_constraint\"\n      ]\n    },\n    {\n      \"id\": \"finding_10\",\n      \"status\": \"represented\",\n      \"statement\": \"原文要求：从每一条成功或失败返回路径返回前，把 final status 追加到本地 status.txt。\",\n      \"explanation\": \"四个终止返回块 block_006、block_010、block_013、block_014 均在 return 指令前包含 append_final_status_to_status_file，且顶层约束 /constraints/1 声明该要求；至于 success/failure 字面值是否由原文规定，另见 finding_11。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 16,\n          \"end_line\": 16,\n          \"quote\": \"Before returning from every success or failure path, append the final status to local status.txt.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/constraints/1\",\n        \"/blocks/block_006/instructions/0\",\n        \"/blocks/block_006/instructions/1\",\n        \"/blocks/block_010/instructions/0\",\n        \"/blocks/block_010/instructions/1\",\n        \"/blocks/block_013/instructions/0\",\n        \"/blocks/block_013/instructions/1\",\n        \"/blocks/block_014/instructions/0\",\n        \"/blocks/block_014/instructions/1\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_10\"\n      ],\n      \"basis\": [\n        \"explicit_graph\",\n        \"declared_constraint\"\n      ]\n    },\n    {\n      \"id\": \"finding_11\",\n      \"status\": \"unknown\",\n      \"statement\": \"图中追加到 status.txt 的具体字面值为 success 或 failure；原句只要求追加 final status，未规定该字面值。\",\n      \"explanation\": \"ir_011、ir_019、ir_025 使用 literal_value success，ir_027 使用 literal_value failure。源文第16行仅要求 append the final status to local status.txt，未给出状态字符串，因此无法裁决这些具体字面值是否属于原文已保留语义。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 16,\n          \"end_line\": 16,\n          \"quote\": \"Before returning from every success or failure path, append the final status to local status.txt.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_006/instructions/0/inputs/1\",\n        \"/blocks/block_010/instructions/0/inputs/1\",\n        \"/blocks/block_013/instructions/0/inputs/1\",\n        \"/blocks/block_014/instructions/0/inputs/1\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_10\"\n      ],\n      \"basis\": [\n        \"explicit_graph\",\n        \"insufficient\"\n      ],\n      \"unknown_reason\": \"原文只声明 final status，未定义其字面值；输入中不足以判定 success/failure 字符串是否为原文指定。\"\n    }\n  ],\n  \"reviewed_requirement_ids\": [\n    \"req_1\",\n    \"req_2\",\n    \"req_3\",\n    \"req_4\",\n    \"req_5\",\n    \"req_6\",\n    \"req_7\",\n    \"req_8\",\n    \"req_9\",\n    \"req_10\"\n  ],\n  \"reviewed_unit_ids\": [],\n  \"reviewed_instruction_ids\": [\n    \"ir_001\",\n    \"ir_002\",\n    \"ir_003\",\n    \"ir_004\",\n    \"ir_005\",\n    \"ir_006\",\n    \"ir_007\",\n    \"ir_008\",\n    \"ir_009\",\n   