":11,"versions":1},"createdAt":1767644556460,"updatedAt":1778485729679,"latestVersion":{"version":"1.0.0","createdAt":1767644556460,"changelog":"","license":null},"metadata":null},{"ownerHandle":"keithvassallomt","slug":"openclaw-nextcloud","displayName":"openclaw-nextcloud","summary":"Manage Notes, Tasks, Calendar, Files, Contacts, and Deck Kanban boards in your Nextcloud instance via CalDAV, WebDAV, Notes, and Deck APIs. Use for creating notes, managing todos and calendar events, uploading/downloading files, managing contacts, and organizing Kanban boards, stacks, and cards.","description":null,"topics":["nextcloud"],"tags":{"latest":"0.8.0"},"stats":{"comments":2,"downloads":7603,"installs":188,"stars":9,"versions":21},"createdAt":1769986427353,"updatedAt":1791791685490,"latestVersion":{"version":"0.8.0","createdAt":1791791309190,"changelog":"- Version updated to 0.8.0.\n- Better handling of binary uploads and downloads.","license":"MIT-0"},"metadata":{"setup":[{"key":"NEXTCLOUD_URL","required":true},{"key":"NEXTCLOUD_USER","required":true},{"key":"NEXTCLOUD_TOKEN","required":true},{"key":"NEXTCLOUD_EMAIL","required":false}],"os":null,"systems":null}},{"ownerHandle":"adinvadim","slug":"2captcha","displayName":"2Captcha","summary":"Solve CAPTCHAs with 2Captcha from the command line during browser automation.","description":null,"topics":["Browser Automation"],"tags":{"automation":"2.0.1","captcha":"2.0.1","cli":"2.0.1","latest":"2.0.1"},"stats":{"comments":1,"downloads":7603,"installs":194,"stars":0,"versions":3},"createdAt":1769960354151,"updatedAt":1780639726914,"latestVersion":{"version":"2.0.1","createdAt":1780639726914,"changelog":"- Added a new privacy and authorized use section to documentation, warning users about data sent to 2Captcha.\n- Updated installation instructions to recommend reviewing and cloning the source, rather than using direct install scripts.\n- Clarified supported credential sources for the CLI tool.\n- Removed extraneous documentation file (skill-card.md).","license":"MIT-0"},"metadata":{"setup":[{"key":"~/.config/2captcha/api-key","required":true},{"key":"TWOCAPTCHA_API_KEY","required":false}],"os":null,"systems":null}},{"ownerHandle":"jdrhyne","slug":"gsc","displayName":"Google Search Console","summary":"Read Google Search Console properties, Search Analytics, URL Inspection, and sitemaps. Use for explicit Search Console or GSC SEO performance, indexing, and freshness analysis; not for general web search.","description":null,"topics":["search-console","seo","search-analytics","url-inspection"],"tags":{"latest":"1.3.0"},"stats":{"comments":2,"downloads":7575,"installs":252,"stars":23,"versions":6},"createdAt":1768599237278,"updatedAt":1788095487348,"latestVersion":{"version":"1.3.0","createdAt":1788095427124,"changelog":"Modernize read-only OAuth, pagination, retries, validation, freshness metadata, bounded queries, exports, and credential safety.","license":"MIT-0"},"metadata":null},{"ownerHandle":"lilei0311","slug":"wps-office","displayName":"Wps Skill","summary":"Automate WPS Office tasks including document creation, opening, format conversion, batch processing, and managing WPS 365 smart forms, docs, sheets, flowchar...","description":null,"topics":["文档"],"tags":{"latest":"1.0.1"},"stats":{"comments":1,"downloads":7571,"installs":226,"stars":3,"versions":2},"createdAt":1771180006771,"updatedAt":1778990778551,"latestVersion":{"version":"1.0.1","createdAt":1771180240233,"changelog":"- Improved security documentation: added detailed warnings about local automation and API credentials.\n- Streamlined feature overview, installation, and usage sections for clarity.\n- Updated dependencies list to include requests.\n- Added implementation and troubleshooting notes for both local and cloud WPS features.\n- SKILL.md content revised for better safety, transparency, and user guidance.","license":null},"metadata":null},{"ownerHandle":"wpank","slug":"mermaid-diagrams","displayName":"Mermaid Diagrams","summary":"Create software diagrams using Mermaid syntax. Use when users need to create, visualize, or document software through diagrams including class diagrams, sequence diagrams, flowcharts, ERDs, C4 architecture diagrams, state diagrams, git graphs, and other diagram types. Triggers include requests to diagram, visualize, model, map out, or show the flow of a system.","description":null,"topics":["Diagrams","Mermaid","Architecture","Documentation","Modeling"],"tags":{"latest":"0.1.0"},"stats":{"comments":0,"downloads":7567,"installs":252,"stars":5,"versions":1},"createdAt":1770730813646,"updatedAt":1778486991803,"latestVersion":{"version":"0.1.0","createdAt":1770730813646,"changelog":"Initial release of Mermaid Diagrams skill.\n\n- Create software diagrams (class, sequence, flowchart, ERD, C4, state, git, Gantt) using Mermaid syntax\n- Includes usage best practices, configuration, theming, and export instructions\n- Provides common pitfalls and recommended/forbidden diagramming habits\n- Installation instructions for OpenClaw / Moltbot / Clawbot included\n- Offers quick start code examples for each major diagram type","license":null},"metadata":null},{"ownerHandle":"hith3sh","slug":"linkedin-social","displayName":"LinkedIn","summary":"Manage LinkedIn presence via the LinkedIn API. Create posts and articles, manage comments, handle media uploads, search ad targeting entities, and retrieve user profile and image data.","description":null,"topics":["LinkedIn"],"tags":{"latest":"1.0.8"},"stats":{"comments":0,"downloads":7563,"installs":87,"stars":32,"versions":8},"createdAt":1777822318064,"updatedAt":1791056538663,"latestVersion":{"version":"1.0.8","createdAt":1791056459661,"changelog":"Security section now states that the public-data tools read other people's public content without a connected account (read-only, paid from credit).","license":"MIT-0"},"metadata":null},{"ownerHandle":"byungkyu","slug":"google-merchant","displayName":"Google Merchant Center","summary":"Google Merchant Center API integration with managed OAuth. This is a write-capable integration — it can read, create, update, and delete products, inventories, data sources, promotions, account settings, and conversions in Google Shopping. Use this skill when users want to interact with their Merchant Center data. All write operations (creating/updating/deleting products, inventories, promotions, data sources, or account settings) require explicit user approval with specific resource identifiers before execution. For other third party apps, use the api-gateway skill (https://clawhub.ai/byungkyu/api-gateway). Requires network access and valid Maton API key. Calls run through the `maton` CLI with OAuth login, or over raw HTTP with a Maton API key where the CLI cannot be installed. Every call is authenticated as the user's connection and reaches only what that connection's authorization allows, which the provider enforces on every request; the endpoints documented here are the ones this skill uses, and any other endpoint of this app needs the user to ask for it by name. Default to read and list calls, and confirm every write or new connection with the user. This file also documents the three constructs that turn a Google Merchant Center connection into automation, in the order they are used: the connection (the first step), a hosted function that runs a Google Merchant Center action through the Maton SDK, and a trigger that calls that function on a schedule or on an event. Those sections are the platform's own reference text, shared with the api-gateway skill, with Google Merchant Center examples; they add no Google Merchant Center capability - Google Merchant Center is not an event source, a trigger cannot read Google Merchant Center data, and the files under `references/<source>/triggers.md` are the platform's event catalogues for the sources Maton offers (time, Calendly, GitHub, Gmail, HubSpot, Linear, Notion, Slack, Stripe).","description":null,"topics":["Api Integration","Shopping"],"tags":{"latest":"1.2.7"},"stats":{"comments":0,"downloads":7559,"installs":231,"stars":5,"versions":18},"createdAt":1770462881185,"updatedAt":1790937952768,"latestVersion":{"version":"1.2.7","createdAt":1790937812170,"changelog":"Simplify the login instructions to the code flow (maton login prints a link; finish with maton login --code <CODE>), drop the API Key subsection, and pin the Maton CLI install to 0.4.0.","license":"MIT-0"},"metadata":{"setup":[],"os":null,"systems":null}},{"ownerHandle":"enjoytdl","slug":"xiaohongshu-publish","displayName":"小红书长文发布","summary":"小红书长文发布。用于在网页版小红书创作服务平台发布长文笔记。当用户说\"发小红书\"、\"发小红书长文\"、\"写一篇小红书\"时使用此技能。","description":null,"topics":["创作","小红书","笔记"],"tags":{"latest":"1.0.0"},"stats":{"comments":1,"downloads":7548,"installs":249,"stars":12,"versions":1},"createdAt":1771339098857,"updatedAt":1778491563795,"latestVersion":{"version":"1.0.0","createdAt":1771339098857,"changelog":"xiaohongshu-publish 1.0.0 initial release\n\n- 新增小红书长文发布技能，支持在网页版小红书创作平台发布长文笔记。\n- 指定适用用户指令，如“发小红书”、“写一篇小红书”等。\n- 明确操作流程，包括进入发布页、写长文、排版、选择模板并发布。\n- 提供注意事项，确保兼容和流程顺畅。","license":null},"metadata":null},{"ownerHandle":"ivangdavila","slug":"ffmpeg","displayName":"FFmpeg","summary":"Process video and audio with correct codec selection, filtering, and encoding settings.","description":null,"topics":["Audio"],"tags":{"latest":"1.0.0"},"stats":{"comments":0,"downloads":7548,"installs":178,"stars":5,"versions":1},"createdAt":1770692193667,"updatedAt":1778486278647,"latestVersion":{"version":"1.0.0","createdAt":1770692193667,"changelog":"Initial release","license":null},"metadata":{"setup":[],"os":["linux","darwin","win32"],"systems":null}},{"ownerHandle":"sunnyyao2222-eng","slug":"feishu-wiki","displayName":"feishu-wiki","summary":"飞书知识库 Skill。创建知识空间、创建 Wiki 页面节点。当需要在飞书知识库中组织和沉淀文档时使用此 Skill。","description":null,"topics":["Feishu","知识库","文档","知识","飞书"],"tags":{"latest":"1.0.0"},"stats":{"comments":0,"downloads":7545,"installs":227,"stars":6,"versi