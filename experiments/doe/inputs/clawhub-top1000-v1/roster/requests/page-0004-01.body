flection":"1.0.0","selfcare":"1.0.0"},"stats":{"comments":1,"downloads":7976,"installs":232,"stars":2,"versions":1},"createdAt":1770788179120,"updatedAt":1778487820503,"latestVersion":{"version":"1.0.0","createdAt":1770788179120,"changelog":"Initial release of Personal Assistant: A minimalist daily briefing and productivity tool.\n\n- Generates structured morning briefings with motivation, weather, top priorities, habits, and self-care reminders.\n- Includes an evening reflection section to review accomplishments and set priorities for tomorrow.\n- Customizable for your location, outputs human-readable or JSON-formatted briefings.\n- No dependencies—runs with Python standard library only.\n- Designed for quick onboarding, daily automation, and ease of use for personal development and well-being.","license":null},"metadata":null},{"ownerHandle":"ivangdavila","slug":"monitoring","displayName":"Monitoring","summary":"Set up observability for applications and infrastructure with metrics, logs, traces, and alerts.","description":null,"topics":["Observability"],"tags":{"latest":"1.0.0"},"stats":{"comments":0,"downloads":7975,"installs":232,"stars":4,"versions":1},"createdAt":1770919741223,"updatedAt":1778488085397,"latestVersion":{"version":"1.0.0","createdAt":1770919741223,"changelog":"Initial release","license":null},"metadata":null},{"ownerHandle":"abdhilabs","slug":"config-guardian","displayName":"Config Guardian","summary":"Safe OpenClaw config updates with automatic backup, validation, and rollback. For agent use - prevents invalid config updates.","description":null,"topics":["Backup"],"tags":{"agent-tool":"1.0.1","backup":"1.0.1","config":"1.0.1","latest":"1.0.1","safety":"1.0.1","validation":"1.0.1"},"stats":{"comments":0,"downloads":7975,"installs":275,"stars":4,"versions":2},"createdAt":1769884817387,"updatedAt":1778485891685,"latestVersion":{"version":"1.0.1","createdAt":1771624219478,"changelog":"**Summary**: Introduces atomic, automatic config updates with built-in backup, validation, and rollback.\n\n- Added `atomic_apply.sh` for one-step safe config changes; creates backups, validates, and auto-rolls back on failure.\n- Removed legacy scripts: `backup_config.sh` and `diff_config.sh`.\n- Updated workflow and documentation to enforce atomic updates and automatic rollback.\n- Tightened guardrails to only allow validated, agent-initiated config changes.\n- Backups now stored in `~/.openclaw/config-guardian-backups/`.","license":null},"metadata":null},{"ownerHandle":"kwall1","slug":"hubspot","displayName":"HubSpot","summary":"HubSpot CRM and CMS API integration for contacts, companies, deals, owners, and content management.","description":null,"topics":["CRM","Api Integration"],"tags":{"latest":"1.0.1"},"stats":{"comments":0,"downloads":7966,"installs":270,"stars":6,"versions":2},"createdAt":1769037980589,"updatedAt":1778485848771,"latestVersion":{"version":"1.0.1","createdAt":1771272245454,"changelog":"Fix security flags: added homepage for provenance, declared curl/jq as required binaries, updated metadata format","license":null},"metadata":{"setup":[{"key":"HUBSPOT_ACCESS_TOKEN","required":true}],"os":null,"systems":null}},{"ownerHandle":"fadeloo","slug":"tiangong-wps-ppt-automation","displayName":"PowerPoint Automation","summary":"Automate common PowerPoint/WPS Presentation operations on Windows via COM (read text/notes/outline, export PDF/images, replace text, insert/delete slides, unify font/size/theme, extract images/media). Use for single-presentation actions (no batch).","description":null,"topics":["Batch","PDF"],"tags":{"automation":"0.1.0","com":"0.1.0","latest":"0.1.0","powerpoint":"0.1.0","ppt":"0.1.0"},"stats":{"comments":0,"downloads":7958,"installs":264,"stars":12,"versions":1},"createdAt":1769677115170,"updatedAt":1778485868789,"latestVersion":{"version":"0.1.0","createdAt":1769677115170,"changelog":"Initial release. PPT automation for read/notes/outline/export/replace/slide ops.","license":null},"metada