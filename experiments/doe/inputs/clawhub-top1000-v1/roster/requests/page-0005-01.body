1},"createdAt":1770084672878,"updatedAt":1779076608120,"latestVersion":{"version":"1.0.0","createdAt":1770084672878,"changelog":"Initial release of BrowserWing – browser automation via HTTP API.\n\n- Control page navigation, element interaction (click, type, select), and advanced operations like screenshots and JavaScript execution.\n- Extract data and analyze accessibility snapshots for structured, stable element references.\n- Supports multiple element identifier types: RefID, CSS selectors, XPath, and text.\n- Batch operations and wait-for-element functionality included for robust scripting.\n- API base URL is fully configurable via the BROWSERWING_EXECUTOR_URL environment variable.","license":null},"metadata":null},{"ownerHandle":"yoder-bawt","slug":"yoder-skill-auditor","displayName":"Yoder Skill Auditor","summary":"The definitive security scanner for OpenClaw skills. 18 security checks including prompt injection detection, download-and-execute, privilege escalation, cre...","description":null,"topics":["Prompt Injection","Crypto"],"tags":{"latest":"3.1.0"},"stats":{"comments":0,"downloads":7090,"installs":244,"stars":3,"versions":2},"createdAt":1771241415710,"updatedAt":1778491556797,"latestVersion":{"version":"3.1.0","createdAt":1771258895953,"changelog":"Security advisory remediation: removed self-allowlist, excluded test fixtures, removed auto-install, documented pattern filters, added warnings","license":null},"metadata":{"setup":[],"os":null,"systems":null}},{"ownerHandle":"jackhua6","slug":"node-connect","displayName":"node-connect","summary":"Diagnose OpenClaw node connection and pairing failures for Android, iOS, and macOS companion apps. Use when QR/setup code/manual connect fails, local Wi-Fi w...","description":null,"topics":[],"tags":{"latest":"1.0.0"},"stats":{"comments":0,"downloads":7089,"installs":182,"stars":1,"versions":1},"createdAt":1774453555202,"updatedAt":1778492190282,"latestVersion":{"version":"1.0.0","createdAt":1774453555202,"changelog":"Initial registration","license":"MIT-0"},"metadata":null},{"ownerHandle":"bmdhodl","slug":"aws-infra","displayName":"AWS Infra","summary":"Chat-based AWS infrastructure assistance using AWS CLI and console context. Use for querying, auditing, and monitoring AWS resources (EC2, S3, IAM, Lambda, ECS/EKS, RDS, CloudWatch, billing, etc.), and for proposing safe changes with explicit confirmation before any write/destructive action.","description":null,"topics":[],"tags":{"aws":"1.0.0","infra":"1.0.0","latest":"1.0.0"},"stats":{"comments":0,"downloads":7088,"installs":237,"stars":3,"versions":1},"createdAt":1769526133525,"updatedAt":1778485857338,"latestVersion":{"version":"1.0.0","createdAt":1769526133525,"changelog":"- Initial release of aws-infra skill.\n- Provides chat-based AWS infrastructure assistance using AWS CLI and console context.\n- Supports querying, auditing, and monitoring AWS resources (EC2, S3, IAM, Lambda, ECS/EKS, RDS, CloudWatch, billing, etc.).\n- All actions are read-only by default; any write or destructive changes require explicit user confirmation.\n- Includes clear safety rules and region/profile handling.","license":null},"metadata":null},{"ownerHandle":"gitgoodordietrying","slug":"log-analyzer","displayName":"Log Analyzer","summary":"Parse, search, and analyze application logs across formats. Use when debugging from log files, setting up structured logging, analyzing error patterns, correlating events across services, parsing stack traces, or monitoring log output in real time.","description":null,"topics":["Log Analyzer","Debugging"],"tags":{"latest":"1.0.0"},"stats":{"comments":0,"downloads":7081,"installs":229,"stars":5,"versions":1},"createdAt":1770155086063,"updatedAt":1778486013286,"latestVersion":{"version":"1.0.0","createdAt":1770155086063,"changelog":"Initial release: Log parsing, error pattern analysis, stack trace extraction, JSON structured logging, real-time monitoring, multi-service correlation","license":null},"metadata":{"setup":[],"os":["linux","darwin","win32"],"systems":null}},{"ownerHandle":"dilomcfly","slug":"n8n-automation","displayName":"n8n Automation","summary":"Manage n8n workflows from OpenClaw via the n8n REST API. Use when the user asks about n8n workflows, automations, executions, or wants to trigger, list, create, activate, or debug n8n workflows. Supports both self-hosted n8n and n8n Cloud instances.","description":null,"topics":["N8n","Rest Api","Debug"],"tags":{"latest":"0.1.0"},"stats":{"comments":0,"downloads":7068,"installs":239,"stars":9,"versions":1},"createdAt":1769873640669,"updatedAt":1778485891685,"latestVersion":{"version":"0.1.0","createdAt":1769873640669,"changelog":"Initial release of n8n-automation skill.\n\n- Control and manage n8n workflows via the n8n REST API.\n- Supports listing, creating, activating/deactivating, triggering, and debugging workflows.\n- Compatible with both n8n Cloud and self-hosted instances.\n- Includes setup instructions, command-line API usage examples, and common automation patterns.\n- Provides quick references for workflow and execution management tasks.","license":null},"metadata":null},{"ownerHandle":"wpank","slug":"react-best-practices","displayName":"React Best Practices","summary":"React and Next.js performance optimization guidelines from Vercel Engineering. 57 rules across 8 categories for writing, reviewing, and refactoring React code.","description":null,"topics":["React","Optimization","Performance","Nextjs","Rendering"],"tags":{"latest":"1.0.0"},"stats":{"comments":0,"downloads":7062,"installs":190,"stars":4,"versions":1},"createdAt":1770728047421,"updatedAt":1778486478500,"latestVersion":{"version":"1.0.0","createdAt":1770728047421,"changelog":"Initial release: Comprehensive React and Next.js performance optimization guide.\n\n- 57 actionable rules across 8 prioritized categories.\n- Covers eliminating waterfalls, bundle size, server/client performance, and re-render optimization.\n- Includes tables for quick rule reference and categories.\n- Detailed usage instructions and example code snippets.\n- MIT licensed, authored by Vercel.","license":null},"metadata":null},{"ownerHandle":"minsheep","slug":"daily-news","displayName":"my-daily-news","summary":"Fetch top news from Baidu, Google, and other sources daily.","description":null,"topics":["News"],"tags":{"latest":"1.0.0"},"stats":{"comments":0,"downloads":7057,"installs":251,"stars":1,"versions":1},"createdAt":1770640339397,"updatedAt":1778486231449,"latestVersion":{"version":"1.0.0","createdAt":1770640339397,"changelog":"Initial release of Daily News Skill:\n\n- Fetches top news headlines daily from Baidu, Google Trends, and other sources.\n- Uses a Python script to collect and output news summaries.\n- Simple setup and execution instructions provided.\n- Requires Python environment and necessary package installation.","license":null},"metadata":{"setup":[{"key":"PYTHONIOENCODING=utf-8","required":true}],"os":null,"systems":null}},{"ownerHandle":"byungkyu","slug":"jobber","displayName":"jobber","summary":"Jobber API integration with managed OAuth. Manage clients, jobs, invoices, quotes, properties, and team members for field service businesses. Use this skill when users want to create and manage service jobs, clients, quotes, invoices, or access scheduling data. For other third party apps, use the api-gateway skill (https://clawhub.ai/byungkyu/api-gateway). Requires network access and valid Maton API key. Calls run through the `maton` CLI with OAuth login, or over raw HTTP with a Maton API key where the CLI cannot be installed. Every call is authenticated as the user's connection and reaches only what that connection's authorization allows, which the provider enforces on every request; the endpoints documented here are the ones this skill uses, and any other endpoint of this app needs the user to ask for it by name. Default to read and list calls, and confirm every write or new connection with the user. This file also documents the three constructs that turn a Jobber connection into automation, in the order they are used: the connection (the first step), a hosted function that runs a Jobber action through the Maton SDK, and a trigger that calls that function on a schedule or on an event. Those sections are the platform's own reference text, shared with the api-gateway skill, with Jobber examples; they add no Jobber capability - Jobber is not an event source, a trigger cannot read Jobber data, and the files under `references/<source>/triggers.md` are the platform's event catalogues for the sources Maton offers (time, Calendly, GitHub, Gmail, HubSpot, Linear, Notion, Slack, Stripe).","description":null,"topics":["Api Integration"],"tags":{"latest":"1.2.6"},"stats":{"comments":0,"downloads":7052,"installs":221,"stars":3,"versions":12},"createdAt":1770463038067,"updatedAt":1790938546312,"latestVersion":{"version":"1.2.6","createdAt":1790938405513,"changelog":"Simplify the login instructions to the code flow (maton login prints a link; finish with maton login --code <CODE>), drop the API Key subsection, and pin the Maton CLI install to 0.4.0.","license":"MIT-0"},"metadata":{"setup":[],"os":null,"systems":null}},{"ownerHandle":"buddyh","slug":"veo","displayName":"Veo","summary":"Generate video using Google Veo (Veo 3.1 / Veo 3.0).","description":null,"topics":["Video Generation"],"tags":{"latest":"1.3.0"},"stats":{"comments":0,"downloads":7048,"installs":241,"stars":1,"versions":4},"createdAt":1768443583807,"updatedAt":1778986919493,"latestVersion":{"version":"1.3.0","createdAt":1770915785653,"changelog":"Simplify metadata: remove nested tags, flatten structure","license":null},"metadata":{"setup":[],"os":null,"systems":null}},{"ownerHandle":"leoyeai","slug":"openclaw-slides","displayName":"openclaw-slides","summary":"Create stunning, animation-rich HTML presentations from scratch or convert PowerPoint files (.ppt/.pptx) to beautiful web slides. Use when the user wants to...","description":null,"topics":["Animation"],"tags":{"latest":"2.0.0"},"stats":{"comments":0,"downloads":7045,"installs":132,"stars":1,"versions":5},"createdAt":1772511897265,"updatedAt":1778491695332,"latestVersion":{"version":"2.0.0","createdAt":1774681996632,"changelog":"Update ecosystem links to myclaw.ai/skills","license":"MIT-0"},"metadata":null},{"ownerHandle":"jdrhyne","slug":"sysadmin-toolbox","displayName":"Sysadmin Toolbox","summary":"Tool discovery and shell one-liner reference for sysadmin, DevOps, and security tasks. AUTO-CONSULT this skill when the user is: troubleshooting network issues, debugging processes, analyzing logs, working with SSL/TLS, managing DNS, testing HTTP endpoints, auditing security, working with containers, writing shell scripts, or asks 'what tool should I use for X'. Source: github.com/trimstray/the-book-of-secret-knowledge","description":null,"topics":["Debugging"],"tags":{"latest":"1.1.0"},"stats":{"comments":0,"downloads":7043,"installs":245,"stars":3,"versions":2},"createdAt":1768842903483,"updatedAt":1778986956314,"latestVersion":{"version":"1.1.0","createdAt":1768843243799,"changelog":"Added refresh.sh script for weekly auto-sync from upstream repo","license":null},"metadata":null},{"ownerHandle":"wpank","slug":"tailwind-design-system","displayName":"Tailwind Design System","summary":"Build scalable, themable Tailwind CSS component libraries using CVA for variants, compound components, design tokens, dark mode, and responsive grids.","description":null,"topics":[],"tags":{"latest":"1.0.0"},"stats":{"comments":0,"downloads":7030,"installs":217,"stars":9,"versions":1},"createdAt":1770728257516,"updatedAt":1778486478500,"latestVersion":{"version":"1.0.0","createdAt":1770728257516,"changelog":"Initial release of Tailwind Design System skill.\n\n- Introduces scalable patterns for building component libraries with Tailwind CSS, including CVA, compound components, design tokens, and theming.\n- Provides copy-paste examples for type-safe variant components, composable card components, validated form inputs, and a responsive grid system.\n- Guides users through utility setup, design token architecture, and responsive/dark mode best practices.\n- Includes installation and usage instructions for common UI patterns.","license":null},"metadata":null},{"ownerHandle":"byungkyu","slug":"eventbrite","displayName":"eventbrite","summary":"Eventbrite API integration with managed OAuth. Manage events, venues, ticket classes, orders, and attendees. Use this skill when users want to create and manage events, check orders, view attendees, or access event categories. For other third party apps, use the api-gateway skill (https://clawhub.ai/byungkyu/api-gateway). Requires network access and valid Maton API key. Calls run through the `maton` CLI with OAuth login, or over raw HTTP with a Maton API key where the CLI cannot be installed. Every call is authenticated as the user's connection and reaches only what that connection's authorization allows, which the provider enforces on every request; the endpoints documented here are the ones this skill uses, and any other endpoint of this app needs the user to ask for it by name. Default to read and list calls, and confirm every write or new connection with the user. This file also documents the three constructs that turn an Eventbrite connection into automation, in the order they are used: the connection (the first step), a hosted function that runs an Eventbrite action through the Maton SDK, and a trigger that calls that function on a schedule or on an event. Those sections are the platform's own reference text, shared with the api-gateway skill, with Eventbrite examples; they add no Eventbrite capability - Eventbrite is not an event source, a trigger cannot read Eventbrite data, and the files under `references/<source>/triggers.md` are the platform's event catalogues for the sources Maton offers (time, Calendly, GitHub, Gmail, HubSpot, Linear, Notion, Slack, Stripe).","description":null,"topics":["Api Integration"],"tags":{"latest":"1.2.5"},"stats":{"comments":0,"downloads":7010,"installs":221,"stars":3,"versions":11},"createdAt":1770463011660,"updatedAt":1790937135169,"latestVersion":{"version":"1.2.5","createdAt":1790936920240,"changelog":"Simplify the login instructions to the code flow (maton login prints a link; finish with maton login --code <CODE>), drop the API Key subsection, and pin the Maton CLI install to 0.4.0.","license":"MIT-0"},"metadata":{"setup":[],"os":null,"systems":null}},{"ownerHandle":"therohitdas","slug":"transcript","displayName":"transcript","summary":"Use when the spoken content of a YouTube video is needed — even if not explicitly requested: pasted video links or IDs, requests to summarize, quote, transcribe, translate, fact-check, or extract anything from a video. Also use for research or learning when a video is the source. Not for uploads or account management.","description":null,"topics":["youtube","transcripts","video","captions","summarization"],"tags":{"latest":"1.5.1"},"stats":{"comments":0,"downloads":6999,"installs":207,"stars":1,"versions":14},"createdAt":1769919881692,"updatedAt":1789981889275,"latestVersion":{"version":"1.5.1","createdAt":1789981691830,"changelog":"Expanded endpoint coverage: video metadata, channel info/playlists/posts/sections, search filters, format tabs (uploads/Shorts/streams)","license":"MIT-0"},"metadata":{"setup":[{"key":"TRANSCRIPT_API_KEY","required":true}],"os":null,"systems":null}},{"ownerHandle":"tekkenkk","slug":"agent-browser-3","displayName":"Agent Browser","summary":"Automates browser interactions for web testing, form filling, screenshots, and data extraction. Use when the user needs to navigate websites, interact with web pages, fill forms, take screenshots, test web applications, or extract information from web pages.","description":null,"topics":["Browser Automation","Data Extraction"],"tags":{"latest":"0.1.0"},"stats":{"comments":0,"downloads":6998,"installs":214,"stars":23,"versions":1},"createdAt":1769694571134,"updatedAt":1778987371599,"latestVersion":{"version":"0.1.0","createdAt":1769694571134,"changelog":"Initial release of agent-browser: Powerful command-line browser automation.\n\n- Automates website navigation, form filling, testing, screenshots, and data extraction.\n- Extensive command set for browser control, interactive element referencing, state checks, and data capture.\n- Supports semantic locators (find by role, label, text, etc.) for robust automation.\n- Provides tools for video recordings, PDF creation, network interception, tab/window management, storage/cookie handling, and more.\n- Includes options for session isolation, headless/headed mode, and structured JSON output.","license":null},"metadata":null},{"ownerHandle":"ivangdavila","slug":"cfo","displayName":"CFO / Chief Financial Officer","summary":"Acts as chief financial officer (CFO): forecasts cash, computes runway and burn, runs the monthly close, and models a fundraise. Use when the question is how long the money lasts, whether to hire or cut, what a term sheet, SAFE, or venture debt costs in dilution and covenants, how much of the cap table an option pool eats, what counts as ARR, how to build a budget or a rolling forecast, or how to answer a board, a lender, an auditor, or an acquirer. Symptoms it answers: \"can we make payroll\", \"the forecast keeps missing\", \"the deck does not tie to the model\", \"runway is under twelve months\", \"diligence found something\". Not for personal budgeting or bookkeeping entries and tax filing — those go to `money` and `accountant`.","description":null,"topics":["Financial"],"tags":{"latest":"1.0.6"},"stats":{"comments":0,"downloads":6989,"installs":217,"stars":7,"versions":7},"createdAt":1770674398958,"updatedAt":1784976285302,"latestVersion":{"version":"1.0.6","createdAt":1784974880018,"changelog":"Full coverage pass: deeper guides, situation-named files, and per-user configuration","license":"MIT-0"},"metadata":{"setup":[],"os":["linux","darwin","win32"],"systems":null}},{"ownerHandle":"elevo11","slug":"finance-radar","displayName":"Finance Radar","summary":"Stock and cryptocurrency analysis powered by Yahoo Finance data. Use when a user wants to: (1) Analyze stocks or crypto prices/fundamentals, (2) Track invest...","description":null,"topics":["Cryptocurrency","Investment","Crypto","Stock"],"tags":{"latest":"1.1.0"},"stats":{"comments":0,"downloads":6983,"installs":219,"stars":1,"versions":2},"createdAt":1772768923413,"updatedAt":1778491745273,"latestVersion":{"version":"1.1.0","createdAt":1772787426522,"changelog":"v1.1.0: Added batch analysis with CSV export","license":null},"metadata":null},{"ownerHandle":"rogersuperbuilderalpha","slug":"academic-research","displayName":"Academic Research","summary":"Search academic papers and conduct literature reviews using OpenAlex API (free, no key needed). Use when the user needs to find scholarly papers by topic/aut...","description":null,"topics":["Literature Review"],"tags":{"latest":"1.0.0"},"stats":{"comments":0,"downloads":6981,"installs":167,"stars":3,"versions":1},"createdAt":1771467688891,"updatedAt":1778991583588,"latestVersion":{"version":"1.0.0","createdAt":1771467688891,"changelog":"- Initial release of the academic-research skill, enabling academic search and literature review via the OpenAlex API.\n- Search and retrieve scholarly papers by topic, author, or DOI without requiring an API key.\n- Access citation chains, paper metadata (title, authors, abstract, citations, DOI, open access URL), and full text for open access articles.\n- Automated literature review workflow with theme identification, synthesis, and markdown or JSON output.\n- Structured and programmable search output, supporting advanced filtering and export options for research analysis.","license":null},"metadata":null},{"ownerHandle":"darinkishore","slug":"voice-transcribe","displayName":"Voice Transcribe","summary":"Transcribe audio files using OpenAI's gpt-4o-mini-transcribe model with vocabulary hints and text replacements. Requires uv (https://docs.astral.sh/uv/).","description":null,"topics":["Transcribe","Audio"],"tags":{"latest":"1.0.1"},"stats":{"comments":0,"downloads":6979,"installs":244,"stars":13,"versions":2},"createdAt":1767653242638,"updatedAt":1778485729679,"latestVersion":{"version":"1.0.1","createdAt":1767653277006,"changelog":"Added uv requirement to description","license":null},"metadata":null},{"ownerHandle":"vincent-big-fish","slug":"read-word","displayName":"Read Microsoft Word documents (.docx and .doc) with Chinese support","summary":"Read Microsoft Word documents (.docx and .doc) with Chinese support. Extract text, search keywords, and save as UTF-8 text files. No Microsoft Word installat...","description":null,"topics":["Document","Read","Word","Doc","Docx"],"tags":{"chinese":"1.0.0","doc":"1.0.0","document":"1.0.0","docx":"1.0.0","latest":"1.0.0","office":"1.0.0","read":"1.0.0","word":"1.0.0"},"stats":{"comments":0,"downloads":6978,"installs":124,"stars":0,"versions":1},"createdAt":1773995587157,"updatedAt":1778492056487,"latestVersion":{"version":"1.0.0","createdAt":1773995587157,"changelog":"read-word v1.0.0\n\n- Initial release with support for both .docx and legacy .doc Word formats\n- Full Chinese language encoding support\n- Keyword search across document paragraphs\n- Save extracted text as UTF-8 text files\n- No Microsoft Word installation required","license":"MIT-0"},"metadata":{"setup":[],"os":null,"systems":null}},{"ownerHandle":"xrowgmbh","slug":"xrowgmbh-self-improvement","displayName":"GitLab Agent Self Improvement","summary":"A skill for personal growth and self-improvement.","description":null,"topics":["Self Improvement"],"tags":{"latest":"1.114.1"},"stats":{"comments":0,"downloads":6971,"installs":29,"stars":0,"versions":157},"createdAt":1780504993244,"updatedAt":1792481361808,"latestVersion":{"version":"1.114.1","createdAt":1792481203436,"changelog":"- Removed the `skill-card.md` file.","license":"MIT-0"},"metadata":{"setup":[],"os":null,"systems":null}},{"ownerHandle":"ireact2code","slug":"ui-ux-pro-max-plus","displayName":"UI UX Pro Max","summary":"Professional UI/UX design resource library with searchable design patterns, color palettes, font pairings, chart types, and UX guidelines. Use when creating...","description":null,"topics":[],"tags":{"latest":"1.0.0"},"stats":{"comments":0,"downloads":6966,"installs":204,"stars":7,"versions":1},"createdAt":1771292469513,"updatedAt":1778491560329,"latestVersion":{"version":"1.0.0","createdAt":1771292469513,"changelog":"Initial release: 50+ UI styles, 100+ color palettes, typography guides, chart types, UX patterns, and component design system with Tailwind CSS examples. Bilingual (EN/ZH) documentation.","license":null},"metadata":null},{"ownerHandle":"ivangdavila","slug":"py","displayName":"Python","summary":"Writes, debugs, and reviews Python code — runtime traps, packaging, typing, async, tests, performance. Use when Python raises or misbehaves: ModuleNotFoundError, circular imports, AttributeError on None, UnboundLocalError, UnicodeDecodeError, mutable default arguments, `is` vs `==`, float rounding, naive vs aware datetimes, or a wrong answer with no exception; when pip, uv, poetry, venv, pyproject or a lockfile fight over dependencies, or a package installs but will not import; when threads, asyncio, multiprocessing or the GIL hang, deadlock, or leak memory; when pytest passes but should not, mocks patch the wrong module, or async tests never run; when mypy or pyright errors need clearing; when a script is slow, eats RAM, or gets OOM-killed; when subprocess calls hang or logs never appear; or when upgrading Python breaks the build. Not for library-specific problems — pandas, numpy, django, fastapi and flask have their own skills.","description":null,"topics":[],"tags":{"latest":"1.0.4"},"stats":{"comments":0,"downloads":6958,"installs":161,"stars":6,"versions":