126},"createdAt":1781081155612,"updatedAt":1792483915240,"latestVersion":{"version":"1.114.1","createdAt":1792481213011,"changelog":"- Removed `skill-card.md`.","license":"MIT-0"},"metadata":null},{"ownerHandle":"jimcollinson","slug":"x0x","displayName":"x0x","summary":"Secure computer-to-computer networking for AI agents — gossip broadcast, direct messaging, CRDTs, group encryption. Post-quantum encrypted, NAT-traversing. Everything you need to build any decentralized application.","description":null,"topics":[],"tags":{"latest":"0.48.1"},"stats":{"comments":0,"downloads":6341,"installs":65,"stars":1,"versions":106},"createdAt":1775062630296,"updatedAt":1792301137611,"latestVersion":{"version":"0.48.1","createdAt":1792301029729,"changelog":"Update x0x to v0.48.1.","license":"MIT-0"},"metadata":{"setup":[],"os":null,"systems":null}},{"ownerHandle":"jdrhyne","slug":"context-recovery","displayName":"context-recovery","summary":"Recover missing conversation context after explicit compaction or truncation, or when the user explicitly asks to recover prior work. Use for requests such as \"where were we before compaction?\" when the current thread is insufficient. Do not trigger on a generic \"continue\" when the current thread already provides an actionable next step.","description":null,"topics":["context-recovery","conversation-history","provenance","continuity"],"tags":{"latest":"1.3.0"},"stats":{"comments":0,"downloads":6339,"installs":207,"stars":3,"versions":7},"createdAt":1769388499984,"updatedAt":1788095081435,"latestVersion":{"version":"1.3.0","createdAt":1788095035708,"changelog":"Constrain activation and recovery scope, treat recovered material as untrusted, surface provenance and conflicts, and gate cross-source actions and persistence.","license":"MIT-0"},"metadata":{"setup":[],"os":null,"systems":null}},{"ownerHandle":"ivangdavila","slug":"codex","displayName":"Codex","summary":"Use Codex safely for repo-aware coding with explicit approvals, sandbox choices, MCP boundaries, and PR-ready verification workflows.","description":null,"topics":["Coding"],"tags":{"latest":"1.0.0"},"stats":{"comments":0,"downloads":6333,"installs":138,"stars":1,"versions":1},"createdAt":1773337303612,"updatedAt":1778491865024,"latestVersion":{"version":"1.0.0","createdAt":1773337303612,"changelog":"Initial release with repo-safe execution, approval and sandbox guidance, MCP and cloud guardrails, and review-ready handoff workflows.","license":"MIT-0"},"metadata":{"setup":[{"key":"~/codex/","required":true},{"key":"~/.codex/config.toml","required":true}],"os":["linux","darwin","win32"],"systems":null}},{"ownerHandle":"ivangdavila","slug":"developer","displayName":"Developer","summary":"Works as a software developer day to day: turning a ticket into merged, shipped, supported code inside a codebase someone else wrote. Use when landing in an unfamiliar repo and hunting for where the change goes; when scoping, splitting, or estimating work; when a bug has to go from report to verified fix; when tests are missing, slow, or flaky; when a pull request is too big to review or a review has stalled; when a dependency upgrade breaks the build; when a schema change or backfill must ship without downtime; when something works locally but fails in CI or production; when a release needs a rollback plan or a flag; when on call and mitigation has to come before root cause; or when deciding what is reversible. Covers environment parity, security on your own diff, and new services. Not for isolation technique (`debugging`), the transformation catalog (`refactoring`), review analysis (`review-code`), or Git mechanics (`git`).","description":null,"topics":["Developer","Debugging","Software Development"],"tags":{"latest":"1.0.2"},"stats":{"comments":0,"downloads":6328,"installs":183,"stars":11,"versions":3},"createdAt":1770673442162,"updatedAt":1785141722186,"latestVersion":{"version":"1.0.2","createdAt":1785140543601,"changelog":"Clearer disclosure of what is stored and where","license":"MIT-0"},"metadata":{"setup":[],"os":["linux","darwin","win32"],"systems":null}},{"ownerHandle":"brennerspear","slug":"vercel-deployment","displayName":"Vercel","summary":"Deploy and manage Vercel projects, including linking repositories, env vars, and domains.","description":null,"topics":["Deploy"],"tags":{"latest":"1.0.0"},"stats":{"comments":0,"downloads":6323,"installs":121,"stars":0,"versions":1},"createdAt":1772058076403,"updatedAt":1778993277769,"latestVersion":{"version":"1.0.0","createdAt":1772058076403,"changelog":"Auto-publish from CI","license":null},"metadata":null},{"ownerHandle":"huihui-hb","slug":"tavily-search-1-0-0","displayName":"Tavily Search 1.0.0","summary":"AI-optimized web search using Tavily API providing concise, relevant results and optional deep or topic-specific queries for AI agents.","description":null,"topics":["Web Search"],"tags":{"latest":"1.0.0"},"stats":{"comments":0,"downloads":6321,"installs":223,"stars":3,"versions":1},"createdAt":1771074878552,"updatedAt":1778489533630,"latestVersion":{"version":"1.0.0","createdAt":1771074878552,"changelog":"Initial release of Tavily Search skill.\n\n- Provides AI-optimized web search via the Tavily API, designed for AI agents.\n- Supports search with options for number of results, deep search, topic selection (general/news), and date filtering for news.\n- Allows extracting clean content from specific URLs.\n- Requires a TAVILY_API_KEY for operation.","license":null},"metadata":{"setup":[{"key":"TAVILY_API_KEY","required":true}],"os":null,"systems":null}},{"ownerHandle":"plgonzalezrx8","slug":"context-manager","displayName":"Smart Context Manager","summary":"AI-powered context management for OpenClaw sessions","description":null,"topics":["Context Management"],"tags":{"latest":"1.0.3","latest-beta":"1.0.0-b"},"stats":{"comments":0,"downloads":6318,"installs":194,"stars":5,"versions":3},"createdAt":1769537087447,"updatedAt":1778485857338,"latestVersion":{"version":"1