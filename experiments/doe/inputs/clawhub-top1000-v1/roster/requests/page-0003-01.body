nstalls":310,"stars":14,"versions":2},"createdAt":1769445465505,"updatedAt":1778485857338,"latestVersion":{"version":"2.1.0","createdAt":1771297371403,"changelog":"Add Security category to signal detection, fix agent_mappings.md root-level agents, add Memory integration guidance, consistency fixes across reference files","license":null},"metadata":null},{"ownerHandle":"dongchun2008","slug":"eastmoney-stock","displayName":"Eastmoney Stock","summary":"查询东方财富股票数据，包括个股行情、涨跌幅、成交量等。用于回答股票相关问题。","description":null,"topics":["Stock","股票"],"tags":{"latest":"1.0.0"},"stats":{"comments":0,"downloads":8835,"installs":262,"stars":3,"versions":1},"createdAt":1772925042828,"updatedAt":1778491768590,"latestVersion":{"version":"1.0.0","createdAt":1772925042828,"changelog":"Initial release of eastmoney-stock.\n\n- Query real-time stock data from Eastmoney, including price, change percentage, and volume.\n- Supports A-shares, Hong Kong stocks (add .HK), and US stocks (add .N).\n- Provides top gainers/losers and watchlist queries.\n- Designed to answer natural language stock questions in Chinese.\n- Data may be delayed by a few minutes.","license":null},"metadata":null},{"ownerHandle":"ivangdavila","slug":"graphic-design","displayName":"Graphic Design","summary":"Support design understanding from basic visuals to professional production and theory.","description":null,"topics":["Graphic Design"],"tags":{"latest":"1.0.0"},"stats":{"comments":0,"downloads":8822,"installs":283,"stars":15,"versions":1},"createdAt":1770760812056,"updatedAt":1778486994957,"latestVersion":{"version":"1.0.0","createdAt":1770760812056,"changelog":"Initial release","license":null},"metadata":{"setup":[],"os":["linux","darwin","win32"],"systems":null}},{"ownerHandle":"infra403","slug":"6551-twitter-to-binance-square","displayName":"Twitter To Binance Square","summary":"Auto-mirror Twitter/X content to Binance Square. Monitors specified Twitter accounts or topics, fetches new tweets, transforms content, and posts to Binance...","description":null,"topics":[],"tags":{"latest":"0.1.0"},"stats":{"comments":0,"downloads":8804,"installs":321,"stars":1,"versions":1},"createdAt":1772884514763,"updatedAt":1787937285497,"latestVersion":{"version":"0.1.0","createdAt":1772884514763,"changelog":"Initial release of the Twitter to Binance Square Auto-Mirror Skill.\n\n- Automatically fetches and transforms tweets from specified Twitter accounts, hashtags, or keywords.\n- Posts transformed tweets to Binance Square, with support for deduplication and configurable intervals.\n- Provides robust content transformation (translation, hashtag management, tool/source attribution).\n- Includes a flexible JSON configuration schema and state file for managing posted tweets.\n- Supports command-based invocation for easy automation.","license":null},"metadata":null},{"ownerHandle":"liuhean2021","slug":"baidu-web-search","displayName":"baidu web search","summary":"Use Baidu Qianfan web search API for real-time web retrieval. Use when the user needs to search the web, get latest news, verify facts, or expresses intent l...","description":null,"topics":["Web Search","网络搜索","Search The Web"],"tags":{"latest":"2.1.0"},"stats":{"comments":0,"downloads":8771,"installs":275,"stars":2,"versions":6},"createdAt":1771944604859,"updatedAt":1778491628548,"latestVersion":{"version":"2.1.0","createdAt":1774539780300,"changelog":"**Summary:**  \n重大安全架构调整，新增 Node.js 纯 JS 实现，支持更多平台，严控密钥访问与输出。\n\n- 新增 Node.js 入口 `scripts/search.js`，从原 MJS 迁移为 JS 实现，提升兼容性\n- 增加 `config.example.json` 示例与 `package.json`，方便本地配置和依赖管理\n- 删除 `scripts/search.mjs`，全面切换至 JS 版本\n- 按优先级支持环境变量 `BAIDU_API_KEY` 和 `config.json` 两种配置方式\n- 极大强化安全规则，严禁任何调用方读取/输出 API Key，每次搜索均通过专用脚本入口完成\n- 文档全面更新，明确适配本地、自托管与主流平台，细化安全与配置指引","license":"MIT-0"},"metadata":{"setup":[{"key":"BAIDU_API_KEY","required":true}],"os":null,"systems":null}},{"ownerHandle":"solomon4github","slug":"multi-search-engine-2-0-1","displayName":"Multi Search Engine 2.0.1","summary":"Multi search engine integration with 17 engines (8 CN + 9 Global). Supports advanced search operators, time filters, site search, privacy engines, and Wolfra...","description":null,"topics":["Privacy"],"tags":{"latest":"1.0.0"},"stats":{"comments":0,"downloads":8755,"installs":286,"stars":9,"versions":1},"createdAt":1772543153534,"updatedAt":1778994841470,"latestVersion":{"version":"1.0.0","createdAt":1772543153534,"changelog":"- Initial release of multi-search-engine v2.0.1.\n- Integrates 17 search engines: 8 domestic (China) and 9 international/global.\n- Supports advanced search operators (site, filetype, quotes, exclude, OR) and time filters.\n- Adds privacy-focused search engines (DuckDuckGo, Startpage, Brave, Qwant).\n- Enables use of DuckDuckGo bangs and WolframAlpha knowledge queries.\n- No API keys required for any engine.","license":null},"metadata":null},{"ownerHandle":"parthpandya1729","slug":"obsidian-ontology-sync","displayName":"Obsidian Ontology Sync","summary":"Bidirectional sync between Obsidian PKM (human-friendly notes) and structured ontology (machine-queryable graph). Automatically extracts entities and relatio...","description":null,"topics":["Sync","Cron"],"tags":{"latest":"1.0.1"},"stats":{"comments":0,"downloads":8743,"installs":274,"stars":15,"versions":2},"createdAt":1772194564394,"updatedAt":1778491660149,"latestVersion":{"version":"1.0.1","createdAt":1772195130337,"changelog":"Security update: Removed all sensitive personal/company/project information from examples and replaced with generic placeholders","license":null},"metadata":{"setup":[],"os":null,"systems":null}},{"ownerHandle":"byungkyu","slug":"kit","displayName":"kit","summary":"Kit (formerly ConvertKit) API integration with managed OAuth. Manage email subscribers, forms, tags, sequences, broadcasts, custom fields, purchase records, and webhooks. Webhook creation sends Kit account events to a URL you supply, and the purchase endpoints expose customer and order data. Use this skill when users want to manage their email marketing lists, create or update subscribers, manage tags, or work with email sequences and broadcasts. For other third party apps, use the api-gateway skill (https://clawhub.ai/byungkyu/api-gateway). Calls run through the `maton` CLI with OAuth login, or over raw HTTP with a Maton API key where the CLI cannot be installed. Every call is authenticated as the user's connection and reaches only what that connection's authorization allows, which the provider enforces on every request; the endpoints documented here are the ones this skill uses, and any other endpoint of this app needs the user to ask for it by name. Default to read and list calls, and confirm every write or new connection with the user. This file also documents the three constructs that turn a Kit connection into automation, in the order they are used: the connection (the first step), a hosted function that runs a Kit action through the Maton SDK, and a trigger that calls that function on a schedule or on an event. Those sections are the platform's own reference text, shared with the api-gateway skill, with Kit examples; they add no Kit capability - Kit is not an event source, a trigger cannot read Kit data, and the files under `references/<source>/triggers.md` are the platform's event catalogues for the sources Maton offers (time, Calendly, GitHub, Gmail, HubSpot, Linear, Notion, Slack, Stripe).","description":null,"topics":["Api Integration","Marketing","Email"],"tags":{"latest":"1.2.6"},"stats":{"comments":0,"downloads":8719,"installs":278,"stars":5,"versions":12},"createdAt":1770431974326,"updatedAt":1790938704457,"latestVersion":{"version":"1.2.6","createdAt":1790938554272,"changelog":"Simplify the login instructions to the code flow (maton login prints a link; finish with maton login --code <CODE>), drop the API Key subsection, and pin the Maton CLI install to 0.4.0.","license":"MIT-0"},"metadata":{"setup":[],"os":null,"systems":null}}],"nextCursor":"{\"v\":1,\"index\":\"by_active_stats_downloads\",\"key\":[{\"__undef\":1},8719,1790938704457,1773255959549.3965,\"r17dphz33qycr44ybkq7mcfpms82qcqm\"]}"}