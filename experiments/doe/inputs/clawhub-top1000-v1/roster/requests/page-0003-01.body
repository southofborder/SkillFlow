tup":[],"os":null,"systems":null}},{"ownerHandle":"staticai","slug":"android-adb","displayName":"ADB Connection","summary":"Control Android devices via ADB with support for UI layout analysis (uiautomator) and visual feedback (screencap). Use when you need to interact with Android apps, perform UI automation, take screenshots, or run complex ADB command sequences.","description":null,"topics":[],"tags":{"latest":"1.0.0"},"stats":{"comments":0,"downloads":8963,"installs":269,"stars":13,"versions":1},"createdAt":1770159228342,"updatedAt":1778486013286,"latestVersion":{"version":"1.0.0","createdAt":1770159228342,"changelog":"Initial release of android-automation skill.\n\n- Control Android devices via ADB, with support for UI layout analysis using uiautomator and visual feedback via screencap.\n- Includes guidance for connecting devices via USB and wireless debugging on Android 11+.\n- Provides example commands for launching apps, interacting with UI elements (tap, text input, key events, swipe), and visual verification through screenshots.\n- Offers tips for advanced workflows including UI hierarchy analysis and reliable input methods.","license":null},"metadata":null},{"ownerHandle":"mnetfairy","slug":"insurance-advisor-china","displayName":"insurance-advisor-china","summary":"中国大陆AI保险顾问。为个人和家庭提供全方位的保险咨询、产品对比、方案设计、投保指导。当用户询问保险配置、保险方案、产品对比、重疾险/医疗险/寿险/意外险/储蓄险推荐、保费计算、保障缺口分析、需求分析、核保合规、理赔等问题时使用。","description":null,"topics":[],"tags":{"advisor":"1.8.144","ai":"1.8.144","china":"1.8.144","family-protection":"1.8.144","financial":"1.0.0","insurance":"1.8.144","latest":"2.0.190","medical":"1.8.144","product-comparison":"1.8.144"},"stats":{"comments":0,"downloads":8951,"installs":72,"stars":1,"versions":253},"createdAt":1776478519391,"updatedAt":1792431669180,"latestVersion":{"version":"2.0.190","createdAt":1792431320128,"changelog":"auto publish v2.0.190","license":"MIT-0"},"metadata":null},{"ownerHandle":"ziwenwang28","slug":"feishu-file-sender","displayName":"Feishu File Sender","summary":"飞书文件发送器 — 补齐飞书渠道缺失的文件投递能力，通过飞书 OpenAPI 上传并发送 agent 生成的本地文件。| Feishu File Sender — Upload & send files via Feishu OpenAPI, filling the channel's missing file...","description":null,"topics":["Feishu","飞书"],"tags":{"latest":"1.0.9"},"stats":{"comments":0,"downloads":8949,"installs":284,"stars":9,"versions":10},"createdAt":1771866670634,"updatedAt":1778491620713,"latestVersion":{"version":"1.0.9","createdAt":1772047314694,"changelog":"Docs: update bilingual description and bump to v1.0.9","license":null},"metadata":{"setup":[{"key":"~/.openclaw/openclaw.json","required":true}],"os":null,"systems":null}},{"ownerHandle":"infra403","slug":"opennews-2","displayName":"Opennews","summary":"Real-time crypto, equities, macro, and financial market news aggregator — 85+ data sources across 6 categories covering digital assets, U.S. stocks, semiconductors, AI infrastructure, supply chains, commodities, rates, policy, and market-moving social/news signals. Sources include Bloomberg, Reuters","description":null,"topics":[],"tags":{"latest":"0.1.1"},"stats":{"comments":0,"downloads":8945,"installs":322,"stars":0,"versions":2},"createdAt":1772090317881,"updatedAt":1791779317414,"latestVersion":{"version":"0.1.1","createdAt":1791779208917,"changelog":"Sync existing infra403/opennews-2 from https://github.com/6551Team/opennews-mcp, main commit e329f36187e4a51a0878823e4fdd4d8f42134e80, directory openclaw-skill/opennews. Replace outdated SKILL.md and package.json with exact upstream bytes, including current news categories, market coverage and API documentation. Excludes only generated skill-card.md. Preserve display name Opennews, owner and slug. No example commands or upstream scripts executed.","license":"MIT-0"},"metadata":{"setup":[],"os":["darwin","linux","win32"],"systems":null}},{"ownerHandle":"infra403","slug":"opentwitter-2","displayName":"Opentwitter","summary":"Twitter/X and meme evidence data via the 6551 API. Supports user profiles, tweet search, user twee