    "russellfei/file-manager": {
      "source_tree_sha256": "db58ca195efc3f9b7446aef9d915583b8714214363149db1e7108bae8d7b31af",
      "reviewer_kind": "assistant_source_review",
      "reviewer_id": "calibration-source-screening-agent",
      "decision": "include",
      "reason": "Source-only review confirms two distinct material workflow features and available own-source content with exact physical quotations. Target outputs, registry scores, scan labels, gold judgments, and DOE conclusions were not used.",
      "features": [
        {
          "feature": "element_or_recipient_pairing",
          "reason": "Each source-relative path is paired with its corresponding target path in explicit copy or update action tuples.",
          "evidence": [
            {
              "path": "scripts/sync.py",
              "start_line": 73,
              "end_line": 95,
              "quote": "    # 复制或更新文件\n    for rel_path, src_file in source_files.items():\n        tgt_file = target_path / rel_path\n        \n        if rel_path in target_files:\n            # 文件存在，检查是否需要更新\n            src_size = src_file.stat().st_size\n            tgt_size = tgt_file.stat().st_size\n            \n            if src_size != tgt_size:\n                actions.append(('update', src_file, tgt_file))\n            else:\n                # 大小相同，检查哈希\n                src_hash = calculate_hash(src_file)\n                tgt_hash = calculate_hash(tgt_file)\n                if src_hash is None or tgt_hash is None:\n                    stats['skipped'] += 1\n                elif src_hash != tgt_hash:\n                    actions.append(('update', src_file, tgt_file))\n                else:\n                    stats['skipped'] += 1\n        else:\n            actions.append(('copy', src_file, tgt_file))"
            }
          ]
        },
        {
          "feature": "conditions_or_retries",
          "reason": "Preview mode returns without changes; actual synchronization proceeds only after an explicit yes confirmation.",
          "evidence": [
            {
              "path": "scripts/sync.py",
              "start_line": 118,
              "end_line": 126,
              "quote": "    if dry_run:\n        print(\"\\n这是预览模式。使用 --execute 执行实际同步。\")\n        return\n\n    # 确认执行\n    confirm = input(\"\\n确认执行同步? (yes/no): \")\n    if confirm.lower() != 'yes':\n        print(\"操作已取消\")\n        return"
            }
          ]
        }
      ],
      "source_closure": {
        "status": "complete_for_static_audit",
        "reason": "All four operation scripts, shared utils.py, requirements, and best-practices guide are retained. User file trees, quarantine/backup directories, and hash values are runtime inputs/outputs. Features explicitly marked not implemented are not treated as current implementations.",
        "local_reference_decisions": []
      }
    },
    "jaaneek/x-search": {
      "source_tree_sha256": "18aff2ffcf0a3f352b05094463cc9e363fbe642cab380e4f14313a3a245d9d83",
      "reviewer_kind": "assistant_source_review",
      "reviewer_id": "calibration-source-screening-agent",
      "decision": "include",
      "reason": "Source-only review confirms two distinct material workflow features and available own-source content with exact physical quotations. Target outputs, registry scores, scan labels, gold judgments, and DOE conclusions were not used.",
      "features": [
        {
          "feature": "versions_or_transformations",
          "reason": "Response formatting builds a distinct joined-text result and extracts title-to-URL citation records from message annotations.",
          "evidence": [
            {
              "path": "scripts/search.py",
              "start_line": 182,
              "end_line": 202,
              "quote": "    message = next((o for o in outputs if isinstance(o, dict) and o.get(\"type\") == \"message\"), None)\n    content_blocks = _safe_get(message, \"content\", [])\n    if not isinstance(content_blocks, list):\n        content_blocks = []\n\n    text = \"\\n\\n\".join(\n        c.get(\"text\", \"\")\n        for c in content_blocks\n        if isinstance(c, dict) and c.get(\"text\")\n    )\n    annotations = [\n        a\n        for c in content_blocks if isinstance(c, dict)\n        for a in (c.get(\"annotations\") or []) if isinstance(a, dict)\n    ]\n\n    citations = [\n        {\"text\": a.get(\"title\", \"\"), \"url\": a[\"url\"]}\n        for a in annotations\n        if a.get(\"type\") == \"url_citation\" and a.get(\"url\")\n    ]"
            }
          ]
        },
        {
          "feature": "conditions_or_retries",
          "reason": "Validation rejects simultaneous include/exclude handle filters, empty lists, malformed handles, and oversized handle selections before search.",
          "evidence": [
            {
              "path": "scripts/search.py",
              "start_line": 98,
              "end_line": 118,
              "quote": "def validate(options: dict) -> None:\n    handles = options[\"handles\"]\n    exclude = options[\"exclude\"]\n    from_date = options[\"from_date\"]\n    to_date = options[\"to_date\"]\n\n    if handles is not None and exclude is not None:\n        die(\"--handles and --exclude cannot be used together.\")\n\n    if handles is not None and len(handles) == 0:\n        die(\"--handles value is empty.\")\n\n    if exclude is not None and len(exclude) == 0:\n        die(\"--exclude value is empty.\")\n\n    for h in (handles or []) + (exclude or []):\n        if not HANDLE_RE.match(h):\n            die(f'\"{h}\" is not a valid X handle (letters, numbers, underscores, max 15 chars).')\n\n    if handles and len(handles) > MAX_HANDLES:\n        die(f\"--handles accepts at most {MAX_HANDLES} handles, got {len(handles)}.\")"
            }
          ]
        }
      ],
      "source_closure": {
        "status": "complete_for_static_audit",
        "reason": "The invoked scripts/search.py is retained, and its local implementation uses standard Python modules. xAI, the API key, query/filters, returned posts, and citations are external/runtime interfaces. The retained tests do not count as operational complexity evidence.",
        "local_reference_decisions": []
      }
    },
