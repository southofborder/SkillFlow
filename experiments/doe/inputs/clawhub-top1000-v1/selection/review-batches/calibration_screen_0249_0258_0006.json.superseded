    "ram-raghav-s/computer-use": {
      "source_tree_sha256": "ff4649e2e094ca77845878fae66a73b2cf1023e033a611f523b6d4addb1644a7",
      "reviewer_kind": "assistant_source_review",
      "reviewer_id": "calibration-source-screening-agent",
      "decision": "include",
      "reason": "Source-only review confirms two distinct material workflow features and available own-source content with exact physical quotations. Target outputs, registry scores, scan labels, gold judgments, and DOE conclusions were not used.",
      "features": [
        {
          "feature": "persistence_or_cross_session",
          "reason": "Setup writes a persistent systemd service definition that starts the retained minimal desktop script and restarts it on failure.",
          "evidence": [
            {
              "path": "scripts/setup-vnc.sh",
              "start_line": 49,
              "end_line": 66,
              "quote": "cat <<EOF | sudo tee /etc/systemd/system/xfce-minimal.service > /dev/null\n[Unit]\nDescription=XFCE Minimal Desktop for Computer Use\nAfter=xvfb.service\nRequires=xvfb.service\n\n[Service]\nType=simple\nExecStart=/opt/computer-use/minimal-desktop.sh\nRestart=always\nRestartSec=3\nUser=$USER\nEnvironment=\"HOME=$HOME_DIR\"\nEnvironment=\"DISPLAY=:99\"\n\n[Install]\nWantedBy=multi-user.target\nEOF"
            }
          ]
        },
        {
          "feature": "versions_or_transformations",
          "reason": "Screenshot acquisition creates a PNG, emits a base64 representation, and deletes the temporary image afterward, preserving the distinction between stored capture and returned encoding.",
          "evidence": [
            {
              "path": "scripts/screenshot.sh",
              "start_line": 9,
              "end_line": 24,
              "quote": "TIMESTAMP=$(date +%s%N)\nFILE=\"$OUTPUT_DIR/screenshot_$TIMESTAMP.png\"\n\n# Take screenshot\nscrot -o \"$FILE\" 2>/dev/null\n\nif [ ! -f \"$FILE\" ]; then\n    echo \"ERROR: Failed to take screenshot\" >&2\n    exit 1\nfi\n\n# Output base64\nbase64 -w0 \"$FILE\"\n\n# Cleanup\nrm -f \"$FILE\""
            }
          ]
        }
      ],
      "source_closure": {
        "status": "complete_for_static_audit",
        "reason": "All seventeen named shell action/setup scripts are retained, including screenshot.sh invoked by the action helpers and minimal-desktop.sh referenced by generated service definitions. X11 tools, desktop packages, systemd, browser processes, VNC endpoints, and generated unit files are external/runtime interfaces.",
        "local_reference_decisions": []
      }
    },
