    "byungkyu/youtube-api-skill": {
      "source_tree_sha256": "4e6114a5c74ee00f1ffa63bad61f6eb60d22287185dce15f61b11aab9c72fdb4",
      "reviewer_kind": "assistant_source_review",
      "reviewer_id": "calibration-source-screening-agent",
      "decision": "include",
      "reason": "Source-only review confirms two distinct material workflow features with exact physical quotations. This decision does not use target outputs, registry ratings, scanner labels, or DOE judgments; human reference verification remains pending.",
      "features": [
        {
          "feature": "conditions_or_retries",
          "reason": "Connection creation and mutations are gated on user approval, while multiple connections or profiles require explicit target selection.",
          "evidence": [
            {
              "path": "SKILL.md",
              "start_line": 891,
              "end_line": 897,
              "quote": "- **Connection creation requires explicit user approval.** Ask the user to confirm they intend to authorize YouTube access before running `maton connection create youtube`. Never create connections on the agent's own initiative.\n- **Always specify the target.** Use `--connection` when the user has multiple connections for this app, and `-p/--profile` when they have multiple Maton accounts. Do not let an ambiguous default decide where a write lands.\n\n### Operations\n\n- **Default to read/list calls.** Retrieve or list resources first to verify identifiers, account context, and current state before proposing any change.\n- **All operations that modify data require explicit user approval.** Before executing any POST, PUT, PATCH, or DELETE call, confirm the target resource, payload, and intended effect with the user. This includes sending messages, creating records, modifying content, deleting resources, and triggering workflows."
            }
          ]
        },
        {
          "feature": "persistence_or_cross_session",
          "reason": "The explicitly requested destination workflow continuously forwards matching events until deletion. The source distinguishes optional standing automation from ordinary read-only event inspection; it is not enabled by every YouTube task.",
          "evidence": [
            {
              "path": "SKILL.md",
              "start_line": 684,
              "end_line": 688,
              "quote": "> **Destination policy for this skill.** Destinations here stay on `api.maton.ai` or `*.maton.app`; a third-party host is out of policy unless the user names that exact host, is told what will flow to it and how often, and approves that destination on its own. YouTube-derived data — the records this connection can read — must never be placed in a destination's payload or body template; a destination carries the source's event fields only. Each create or update is its own approval: show the destination host, the payload fields, and that delivery is persistent before running it.\n\n> **⚠ Persistent data forwarding:** A destination causes all matching trigger events to be automatically and continuously delivered to the specified URL. This is a standing egress channel, not an API call: once created it keeps pushing mail contents, CRM records, payment events, or form submissions off-platform until someone deletes it. Before proceeding, confirm with the user: the exact destination URL and who controls that host, what event data flows there, that delivery is persistent and automatic for all future matching events, and whether any credential would sit in the headers or body template. The user must confirm after seeing all four.\n>\n> - **Create one only when the user asked for ongoing forwarding to a specific URL they control.** To read events, use `maton trigger event list` or `maton trigger event watch` — neither needs a destination. Never add a destination as an incidental step of a larger task, and never as a way to \"see\" or \"collect\" event data."
            }
          ]
        }
      ],
      "source_closure": {
        "status": "complete_for_static_audit",
        "reason": "SKILL.md and the nine source-specific event catalogues are retained. references/{source}/triggers.md is a parameterized notation whose concrete catalogues are present. The Maton CLI, SDK, connected APIs, and any separately requested user handler are explicit external interfaces; no missing skill-owned script is required.",
        "local_reference_decisions": [
          {
            "target": "references/{source}/triggers.md",
            "classification": "illustrative_or_optional",
            "reason": "This is a parameterized catalogue pathname; all nine concrete source catalogues named by SKILL.md are retained.",
            "evidence": [
              {
                "path": "SKILL.md",
                "start_line": 607,
                "end_line": 607,
                "quote": "Refer to `maton trigger create --help` for possible flags and values. Additionally, each source's event types and their `parameters` are documented at `references/{source}/triggers.md` (e.g. [google-mail](references/google-mail/triggers.md)). Besides the app sources, the special [`time`](references/time/triggers.md) source fires on a cron schedule (`schedule.elapsed`) and needs no active connection."
              }
            ]
          }
        ]
      }
    },
    "anotb/homeassistant-skill": {
      "source_tree_sha256": "ffa59b152227e8e1b67135a5dbdd9210874cfe5dec7a98cf12c235d42c342293",
      "reviewer_kind": "assistant_source_review",
      "reviewer_id": "calibration-source-screening-agent",
      "decision": "include",
      "reason": "Source-only review confirms two distinct material workflow features with exact physical quotations. This decision does not use target outputs, registry ratings, scanner labels, or DOE judgments; human reference verification remains pending.",
      "features": [
        {
          "feature": "versions_or_transformations",
          "reason": "The REST reader serializes results as JSON and replaces echoed token substrings inside JSON strings before returning printable output; this explicit local mechanism does not establish complete redaction.",
          "evidence": [
            {
              "path": "scripts/ha_read.py",
              "start_line": 23,
              "end_line": 27,
              "quote": "def safe_json(value, token):\n    \"\"\"Redact echoed credentials inside JSON strings while preserving valid JSON.\"\"\"\n    output = json.dumps(value, ensure_ascii=True, indent=2)\n    return re.sub(r'\"(?:\\\\.|[^\"\\\\])*\"',\n                  lambda match: json.dumps(json.loads(match[0]).replace(token, \"[REDACTED]\")), output)"
            }
          ]
        },
        {
          "feature": "conditions_or_retries",
          "reason": "The reader rejects paths outside its read allowlist and rejects calendar queries without an exact calendar entity identifier.",
          "evidence": [
            {
              "path": "scripts/ha_read.py",
