    "ivangdavila/market-research": {
      "source_tree_sha256": "78af9934ecffb4ba6fba9ebe4e02ca4b70110f78a65bda7c658fe4bca17e37be",
      "reviewer_kind": "assistant_source_review",
      "reviewer_id": "calibration-source-screening-agent",
      "decision": "include",
      "reason": "Source-only review confirms two distinct material workflow features with exact physical quotations. This decision does not use target outputs, registry ratings, scanner labels, or DOE judgments; human reference verification remains pending.",
      "features": [
        {
          "feature": "versions_or_transformations",
          "reason": "Market sizing separates broad, reachable, and realistically obtainable estimates and requests formulas and assumptions instead of forwarding a single raw market figure.",
          "evidence": [
            {
              "path": "SKILL.md",
              "start_line": 67,
              "end_line": 77,
              "quote": "### 2. Size the Market in Layers, Not in Headlines\n\nNever stop at a single big number. Separate:\n\n| Layer | Question | Failure Mode |\n|-------|----------|--------------|\n| **TAM** | How large is the broad category? | Sounds exciting but too abstract |\n| **SAM** | Which part is actually reachable for this product and customer? | Overstates opportunity |\n| **SOM** | What can realistically be won in a specific window? | Turns fantasy into planning |\n\nWhenever possible, show the formula, assumptions, and confidence level. A smaller defensible number is better than a huge vague one."
            }
          ]
        },
        {
          "feature": "conditions_or_retries",
          "reason": "Decision type selects the required evidence bar, and a major conclusion is withheld when its claim, evidence, confidence, and invalidation condition cannot all be stated.",
          "evidence": [
            {
              "path": "evidence-grading.md",
              "start_line": 13,
              "end_line": 30,
              "quote": "## Minimum Standard by Decision\n\n| Decision Type | Minimum Bar |\n|---------------|-------------|\n| Kill or continue an idea | Medium confidence from multiple source families |\n| Pricing recommendation | Medium-to-high confidence plus direct customer evidence |\n| Market entry recommendation | High confidence on demand, competition, and reachability |\n| Expansion timing | High confidence on segment fit and local constraints |\n\n## Output Rule\n\nEvery major conclusion should include:\n- the claim\n- the supporting evidence\n- the confidence level\n- what would invalidate it\n\nIf you cannot state all four clearly, the conclusion is not ready."
            }
          ]
        }
      ],
      "source_closure": {
        "status": "complete_for_static_audit",
        "reason": "All three named competitor-analysis, validation, and evidence-grading reference files are retained. Market data, interviews, and optional related skills are external task inputs, with no required missing bundled source.",
        "local_reference_decisions": []
      }
    },
