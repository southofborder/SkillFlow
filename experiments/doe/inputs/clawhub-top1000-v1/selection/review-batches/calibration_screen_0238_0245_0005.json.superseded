    "stefanofa/sleek-design-mobile-apps": {
      "source_tree_sha256": "0980f77bc3ae8dadfa3fc2e169d9309b28b169f3426cf5e0db25067c4ac5e52c",
      "reviewer_kind": "assistant_source_review",
      "reviewer_id": "calibration-source-screening-agent",
      "decision": "include",
      "reason": "Source-only review confirms two distinct material workflow features and available own-source content with exact physical quotations. Target outputs, registry scores, scan labels, gold judgments, and DOE conclusions were not used.",
      "features": [
        {
          "feature": "element_or_recipient_pairing",
          "reason": "Generation results retain affected screen identifiers, screenshot each affected screen separately, and add a combined view only for newly created screens.",
          "evidence": [
            {
              "path": "SKILL.md",
              "start_line": 367,
              "end_line": 375,
              "quote": "1. POST /api/v1/projects                              → get projectId\n2. POST /api/v1/projects/:id/chat/messages            → get runId (202)\n3. Poll GET /api/v1/projects/:id/chat/runs/:runId\n   until status == \"completed\" or \"failed\"\n4. Collect screenIds from result.operations\n   (screen_created and screen_updated entries)\n5. Screenshot each affected screen individually\n6. If any screen_created: also screenshot all project screens combined\n7. Show all screenshots to the user"
            }
          ]
        },
        {
          "feature": "conditions_or_retries",
          "reason": "A synchronous generation returning 202 falls back to asynchronous polling for the same returned run identifier.",
          "evidence": [
            {
              "path": "SKILL.md",
              "start_line": 384,
              "end_line": 389,
              "quote": "```\n1. POST /api/v1/projects/:id/chat/messages?wait=true\n   → blocks up to 300s\n   → 200 if completed, 202 if timed out\n2. If 202, fall back to Flow 1 polling with the returned runId\n3. On completion, screenshot and show affected screens (see screenshot delivery rule)"
            }
          ]
        }
      ],
      "source_closure": {
        "status": "complete_for_static_audit",
        "reason": "All REST workflow, polling, screenshot, and error instructions are embedded in SKILL.md. Sleek, API key scopes, generated projects, screens, and screenshot binaries are external/runtime interfaces; no missing bundled implementation file is referenced.",
        "local_reference_decisions": []
      }
    },
    "liam8/crypto-market-data": {
      "source_tree_sha256": "f3dab24c44893f31340fcbffbdc5411df576028312783ad9771e71ea58d8042a",
      "reviewer_kind": "assistant_source_review",
      "reviewer_id": "calibration-source-screening-agent",
      "decision": "include",
      "reason": "Source-only review confirms two distinct material workflow features and available own-source content with exact physical quotations. Target outputs, registry scores, scan labels, gold judgments, and DOE conclusions were not used.",
      "features": [
        {
          "feature": "persistence_or_cross_session",
          "reason": "The API client stores a fetched token in a local .token file and reuses a loaded token on later calls.",
          "evidence": [
            {
              "path": "scripts/api_client.js",
              "start_line": 52,
              "end_line": 67,
              "quote": "async function _fetchNewToken() {\n  const reqUrl = `${BASE_URL}/token`;\n  const { status, body } = await _httpRequest(reqUrl);\n\n  if (status === 200) {\n    const data = JSON.parse(body);\n    fs.writeFileSync(TOKEN_FILE, JSON.stringify(data));\n    return data.token;\n  }\n  throw new Error(`Failed to fetch token. Status: ${status}`);\n}\n\nasync function getToken() {\n  const token = _loadToken();\n  if (token) return token;\n  return _fetchNewToken();"
            }
          ]
        },
        {
          "feature": "conditions_or_retries",
          "reason": "The token reader rejects absent, malformed, or expired cached values; getToken then acquires a new token instead of reusing them.",
          "evidence": [
            {
              "path": "scripts/api_client.js",
              "start_line": 12,
              "end_line": 27,
              "quote": "function _loadToken() {\n  if (!fs.existsSync(TOKEN_FILE)) return null;\n\n  try {\n    const data = JSON.parse(fs.readFileSync(TOKEN_FILE, 'utf-8'));\n    const expiresAtStr = data.expires_at;\n    if (!expiresAtStr) return null;\n\n    const expiresAt = new Date(expiresAtStr);\n    if (Date.now() >= expiresAt.getTime()) return null;\n\n    return data.token || null;\n  } catch (e) {\n    console.error(`Warning: Failed to load token file: ${e.message}`);\n    return null;\n  }"
            }
          ]
        }
      ],
      "source_closure": {
        "status": "complete_for_static_audit",
        "reason": "All thirteen tool scripts and their shared api_client.js are retained. Their required local module is present; Node built-ins, the configurable market-data service, .token cache, symbols, and responses are external/runtime interfaces.",
        "local_reference_decisions": []
      }
    },
