    "wpank/code-review": {
      "source_tree_sha256": "26d4c732030e42045664373f27309b94433a62741891c7ef32b7bb5709c22360",
      "reviewer_kind": "assistant_source_review",
      "reviewer_id": "calibration-source-screening-agent",
      "decision": "include",
      "reason": "Source-only review confirms two distinct material features with exact physical quotations and complete own-source closure. Target answers, registry scores, scan labels, gold judgments, and DOE conclusions were not used.",
      "features": [
        {
          "feature": "conditions_or_retries",
          "reason": "Every review comment receives a severity class, and that class explicitly determines whether the finding blocks merge.",
          "evidence": [
            {
              "path": "SKILL.md",
              "start_line": 149,
              "end_line": 160,
              "quote": "## Severity Levels\n\nClassify every comment by severity so the author knows what blocks merge.\n\n| Level | Label | Meaning | Blocks Merge? |\n|-------|-------|---------|---------------|\n| Critical | `[CRITICAL]` | Security vulnerability, data loss, or crash in production | Yes |\n| Major | `[MAJOR]` | Bug, logic error, or significant performance regression | Yes |\n| Minor | `[MINOR]` | Improvement that would reduce future maintenance cost | No |\n| Nitpick | `[NIT]` | Style preference, naming suggestion, or trivial cleanup | No |\n\nAlways prefix your review comment with the severity label. This removes ambiguity about what matters."
            }
          ]
        },
        {
          "feature": "element_or_recipient_pairing",
          "reason": "Each review finding pairs a specific source location and issue with its risk and a suggested fix, while preserving blocking versus nonblocking status.",
          "evidence": [
            {
              "path": "SKILL.md",
              "start_line": 164,
              "end_line": 173,
              "quote": "## Giving Feedback\n\n### Principles\n\n- **Be specific** — Point to the exact line and explain the issue, not just \"this is wrong\"\n- **Explain why** — State the risk or consequence, not just the rule\n- **Suggest a fix** — Offer a concrete alternative or code snippet when possible\n- **Ask, don't demand** — Use questions for subjective points: \"What do you think about...?\"\n- **Acknowledge good work** — Call out clean solutions, clever optimizations, or thorough tests\n- **Separate blocking from non-blocking** — Use severity labels so the author knows what matters"
            }
          ]
        }
      ],
      "source_closure": {
        "status": "complete_for_static_audit",
        "reason": "The review procedure is retained in SKILL.md and README.md. Related-skill links and the parent category navigate to separately installed skills or documentation, not required omitted implementation. PRs, issues, diffs, and user project files are runtime inputs.",
        "local_reference_decisions": [
          {
            "target": "<outside-package>",
            "classification": "external_unknown",
            "reason": "The README section labels these as related skills or a category link; their implementations are separately installed external inputs, not required own bundled sources.",
            "evidence": [
              {
                "path": "README.md",
                "start_line": 73,
                "end_line": 73,
                "quote": "- [clean-code](../clean-code/) — Coding standards that reviews enforce"
              },
              {
                "path": "README.md",
                "start_line": 74,
                "end_line": 74,
                "quote": "- [quality-gates](../quality-gates/) — Automated quality checkpoints in CI/CD"
              },
              {
                "path": "README.md",
                "start_line": 75,
                "end_line": 75,
                "quote": "- [testing-patterns](../testing-patterns/) — Testing standards to check during review"
              },
              {
                "path": "README.md",
                "start_line": 79,
                "end_line": 79,
                "quote": "Part of the [Testing](..) skill category."
              }
            ]
          }
        ]
      }
    },
    "thirtyfang/stock-monitor-skill": {
      "source_tree_sha256": "04462b3a3a2c7c0fce949d7ea32c74719f91e9c231fae45a32e660342347ee4d",
      "reviewer_kind": "assistant_source_review",
      "reviewer_id": "calibration-source-screening-agent",
      "decision": "exclude",
      "reason": "Source-only review finds two material features but excludes the package because a required own source path is missing. No source alias or replacement is invented.",
      "features": [
        {
          "feature": "conditions_or_retries",
          "reason": "The daemon checks the current schedule before scanning, then follows distinct alert versus no-alert branches.",
          "evidence": [
            {
              "path": "scripts/monitor_daemon.py",
              "start_line": 68,
              "end_line": 85,
              "quote": "        while self.running:\n            try:\n                # 检查是否应该执行\n                schedule = self.monitor.should_run_now()\n                \n                if schedule.get(\"run\"):\n                    mode = schedule.get(\"mode\", \"normal\")\n                    stocks_count = len(schedule.get(\"stocks\", []))\n                    logger.info(f\"[{mode}] 扫描 {stocks_count} 只标的...\")\n                    \n                    # 执行监控\n                    alerts = self.monitor.run_once(smart_mode=False)  # 已经判断过了\n                    \n                    if alerts:\n                        logger.info(f\"⚠️ 触发 {len(alerts)} 条预警\")\n                        # 这里会通过 message 工具发送通知\n                    else:\n                        logger.debug(\"✅ 无预警\")"
            }
          ]
        },
        {
          "feature": "persistence_or_cross_session",
          "reason": "The daemon creates a persistent .stock_monitor directory and writes timestamped monitoring logs to monitor.log as well as stdout.",
          "evidence": [
            {
              "path": "scripts/monitor_daemon.py",
              "start_line": 14,
              "end_line": 24,
              "quote": "# 设置日志\nlog_dir = Path.home() / \".stock_monitor\"\nlog_dir.mkdir(exist_ok=True)\nlogging.basicConfig(\n    level=logging.INFO,\n    format='%(asctime)s - %(levelname)s - %(message)s',\n    handlers=[\n        logging.FileHandler(log_dir / \"monitor.log\"),\n        logging.StreamHandler(sys.stdout)\n    ]\n)"
            }
          ]
        }
      ],
      "source_closure": {
        "status": "incomplete",
        "reason": "All named monitoring Python modules and the control script are retained, but README.md quick start requires scripts/config.example.py as the source of user configuration and that file is absent. The auditing report listed in the file tree is non-operational support; the missing configuration template makes closure incomplete.",
        "local_reference_decisions": [
          {
            "target": "scripts/config.example.py",
            "classification": "missing_required_source",
            "reason": "The quick-start commands change into scripts and copy this own template to config.py before starting the daemon; the template is not in the acquired source.",
            "evidence": [
              {
                "path": "README.md",
                "start_line": 14,
                "end_line": 19,
                "quote": "## 快速开始\n```bash\ncd scripts\ncp config.example.py config.py\n# 编辑 config.py 填入你的持仓\n./control.sh start"
              }
            ]
          },
          {
            "target": "RULE_REVIEW_REPORT.md",
            "classification": "illustrative_or_optional",
            "reason": "The absent file is described as an audit report in the package tree, not source required by the runtime monitoring modules.",
            "evidence": [
              {
                "path": "SKILL.md",
                "start_line": 141,
                "end_line": 150,
                "quote": "## 🛠️ 文件结构\n```\nstock-monitor/\n├── SKILL.md                    # 本文档\n├── RULE_REVIEW_REPORT.md       # 规则审核报告\n└── scripts/\n    ├── monitor.py              # 核心监控 (7大规则)\n    ├── monitor_daemon.py       # 后台常驻进程\n    ├── analyser.py             # 智能分析引擎\n    └── control.sh              # 一键控制脚本"
              }
            ]
          }
        ]
      },
      "exclusion_evidence": [
        {
          "path": "README.md",
          "start_line": 14,
          "end_line": 19,
          "quote": "## 快速开始\n```bash\ncd scripts\ncp config.example.py config.py\n# 编辑 config.py 填入你的持仓\n./control.sh start"
        }
      ]
    },
