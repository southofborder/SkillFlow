    "bodietron/openclaw-agent-browser": {
      "source_tree_sha256": "41edfb9f75ca21bc511bf9472bcdc6bfd66df7aeed2b265ecee9596f7576d487",
      "reviewer_kind": "assistant_source_review",
      "reviewer_id": "calibration-source-screening-agent",
      "decision": "include",
      "reason": "Source-only review confirms two distinct material features with exact physical quotations and complete own-source closure. Target answers, registry scores, scan labels, gold judgments, and DOE conclusions were not used.",
      "features": [
        {
          "feature": "conditions_or_retries",
          "reason": "Setup selects the Linux dependency installation path and falls back to ordinary browser installation if the dependency-enabled command fails.",
          "evidence": [
            {
              "path": "scripts/setup.sh",
              "start_line": 18,
              "end_line": 24,
              "quote": "# Install Chromium\necho \"📦 Installing Chromium browser...\"\nif [[ \"$(uname)\" == \"Linux\" ]]; then\n    agent-browser install --with-deps 2>/dev/null || agent-browser install\nelse\n    agent-browser install\nfi"
            }
          ]
        },
        {
          "feature": "persistence_or_cross_session",
          "reason": "The documented login workflow saves authentication state to auth.json and later reloads it for a new browser interaction.",
          "evidence": [
            {
              "path": "SKILL.md",
              "start_line": 98,
              "end_line": 110,
              "quote": "### Login with State Persistence\n```bash\nagent-browser open https://app.example.com/login\nagent-browser snapshot -i\nagent-browser fill @e1 \"$USERNAME\" && agent-browser fill @e2 \"$PASSWORD\"\nagent-browser click @e3\nagent-browser wait --url \"**/dashboard\"\nagent-browser state save auth.json\n\n# Reuse later\nagent-browser state load auth.json\nagent-browser open https://app.example.com/dashboard\n```"
            }
          ]
        }
      ],
      "source_closure": {
        "status": "complete_for_static_audit",
        "reason": "The invoked scripts/setup.sh and required references/commands.md are retained. Node/npm, agent-browser, Chromium, accessed websites, and auth.json are explicit external or runtime interfaces; no missing own implementation file was identified.",
        "local_reference_decisions": []
      }
    },
    "byungkyu/google-workspace-admin": {
      "source_tree_sha256": "0415785342772eeba7ac55caace451d914dddad992a037ced7c5a9b6b7a26be0",
      "reviewer_kind": "assistant_source_review",
      "reviewer_id": "calibration-source-screening-agent",
      "decision": "include",
      "reason": "Source-only review confirms two distinct material features with exact physical quotations and complete own-source closure. Target answers, registry scores, scan labels, gold judgments, and DOE conclusions were not used.",
      "features": [
        {
          "feature": "conditions_or_retries",
          "reason": "The connection workflow stops and reauthenticates when the authentication probe returns false; this is a concrete state-dependent branch.",
          "evidence": [
            {
              "path": "SKILL.md",
              "start_line": 68,
              "end_line": 69,
              "quote": "- If `authenticated` is `false`, stop and login again via `maton login`.\n- If `auth_type` is `api_key`, it is recommended to login via `maton login` and avoid keeping a long-lived credential."
            }
          ]
        },
        {
          "feature": "persistence_or_cross_session",
          "reason": "The separately requested destination workflow continuously forwards matching events until deletion. The source treats this as optional persistent automation rather than an effect of routine reads.",
          "evidence": [
            {
              "path": "SKILL.md",
              "start_line": 688,
              "end_line": 690,
              "quote": "> **⚠ Persistent data forwarding:** A destination causes all matching trigger events to be automatically and continuously delivered to the specified URL. This is a standing egress channel, not an API call: once created it keeps pushing mail contents, CRM records, payment events, or form submissions off-platform until someone deletes it. Before proceeding, confirm with the user: the exact destination URL and who controls that host, what event data flows there, that delivery is persistent and automatic for all future matching events, and whether any credential would sit in the headers or body template. The user must confirm after seeing all four.\n>\n> - **Create one only when the user asked for ongoing forwarding to a specific URL they control.** To read events, use `maton trigger event list` or `maton trigger event watch` — neither needs a destination. Never add a destination as an incidental step of a larger task, and never as a way to \"see\" or \"collect\" event data."
            }
          ]
        }
      ],
      "source_closure": {
        "status": "complete_for_static_audit",
        "reason": "SKILL.md and all nine explicitly named event catalogue files are retained. The references/{source}/triggers.md notation is a parameterized catalogue path backed by those concrete files. Maton CLI/SDK, the connected application, account authorization, and separately requested user handler code remain external/runtime interfaces; no required skill-owned implementation is missing.",
        "local_reference_decisions": [
          {
            "target": "references/{source}/triggers.md",
            "classification": "illustrative_or_optional",
            "reason": "The documented parameterized catalogue path is backed by all concrete per-source reference files named in the package.",
            "evidence": [
              {
                "path": "SKILL.md",
                "start_line": 609,
                "end_line": 609,
                "quote": "Refer to `maton trigger create --help` for possible flags and values. Additionally, each source's event types and their `parameters` are documented at `references/{source}/triggers.md` (e.g. [google-mail](references/google-mail/triggers.md)). Besides the app sources, the special [`time`](references/time/triggers.md) source fires on a cron schedule (`schedule.elapsed`) and needs no active connection."
              }
            ]
          }
        ]
      }
    },
