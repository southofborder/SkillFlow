end_line":null}]},{"id":"AS3","finding_id":"finding-52506164dd994fb9901978f8387e7cf5","category":"Agent Snooping","pattern":"Skill Enumeration","severity":"MEDIUM","confidence":0.8,"location":{"file":"references/examples.md","start_line":301,"end_line":null},"finding":"skills/docker-m1-fixes/SKILL.md","explanation":"Skill enumerates or reads other installed skills. Access to other skills' SKILL.md files or the skills directory reveals prompt instructions, capabilities, and secrets that should be invisible to peer skills.","remediation":"Remove all code or instructions that list or read other skills' files or directories. Skills should operate independently; cross-skill access is a privilege escalation.","code_snippet":"\nHistorical extraction example, not current platform advice. Before extracting or reusing it, check the exact image manifest, target platform, runtime/configuration, and representative build/run behavior. Do not generalize one image's missing ARM variant to all Apple Silicon builds. Creating or changing the skill also needs scoped approval.\n\n**File**: `skills/docker-m1-fixes/SKILL.md`\n\n```markdown\n---","intent":null,"tags":["Agent Snooping","llm-unconfirmed"],"evidence":{},"match_fingerprint":"484b7882992840f9a118f6865f03e9d39cd865fee5ea1ca29243562407237284","occurrences":[{"file":"references/examples.md","start_line":301,"end_line":null}]},{"id":"RA2","finding_id":"finding-62157a5f8156491eb1174937b7833cea","category":"Rogue Agent","pattern":"Session Persistence","severity":"MEDIUM","confidence":0.6,"location":{"file":"references/openclaw-integration.md","start_line":75,"end_line":null},"finding":"Create Learning Files\n\nCreate the `.learnings/` directory in your workspace:\n\n```bash\nmkdir -p ~/.openclaw/workspace/.learnings\n```\n\nOr in the skill directory:\n\n```bash\nmkdir -p ~/.openclaw","explanation":"Skill establishes unauthorized persistence across sessions via cron jobs, startup scripts, or state files. Session persistence allows an attacker to maintain access beyond the current interaction.","remediation":"Remove any persistence mechanisms (cron jobs, startup scripts, state files). Skills should not maintain state across sessions without explicit user consent.","code_snippet":"  `<workspace>/.learnings/ERRORS.md` (only if `.learnings/` exists — see\n  [Error Detection](#error-detection))\n\n### 3. Create Learning Files\n\nCreate the `.learnings/` directory in your workspace:\n","intent":null,"tags":["Rogue Agent","llm-unconfirmed"],"evidence":{},"match_fingerprint":"3fcf971141a3cc9de9e85413d694fbfcf3bb026a1edcf998f758d5b6dc7afeb6","occurrences":[{"file":"references/openclaw-integration.md","start_line":75,"end_line":null}]},{"id":"SQP-1","finding_id":"finding-efd28a7b456e4210baae190fa3bed6b7","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.94,"location":{"file":"references/openclaw-integration.md","start_line":287,"end_line":293},"finding":null,"explanation":"This markdown file explicitly defines detection triggers, and several listed triggers such as 'Knowledge gaps' and user corrections like 'No, that's wrong...' overlap with common conversational situations. The section does not provide scope limits, exclusions, or negative examples to clarify when these triggers should or should not apply.","remediation":"Narrow the trigger descriptions to specific, observable conditions tied to this integration, and add exclusions or negative examples. For example, distinguish between routine discussion and cases that should actually create or suggest a learning entry.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"references/openclaw-integration.md","start_line":287,"end_line":293}]},{"id":"EA2","finding_id":"finding-87fd9f88622345b58dfd2792206f3899","category":"Excessive Agency","pattern":"Autonomous Decision Making","severity":"MEDIUM","confidence":0.8,"location":{"file":"references/uninstall.md","start_line":11,"end_line":null},"finding":"automatically remove","explanation":"Skill enables autonomous high-impact decisions without human-in-the-loop verification. Critical operations (destructive commands, financial transactions, data deletion) should require explicit user confirmation.","remediation":"Add human-in-the-loop confirmation for destructive, irreversible, or high-impact operations. Never auto-execute commands that modify files, send data, or alter system state.","code_snippet":"> errors, corrections, and insights the skill captured for you. Review or\n> archive it before deleting anything. Content the skill *promoted* into\n> `SOUL.md`, `TOOLS.md`, or `AGENTS.md` is part of those files now — removing\n> the skill does not (and should not) automatically remove it.\n\n## Disable only\n","intent":null,"tags":["Excessive Agency","llm-unconfirmed"],"evidence":{},"match_fingerprint":"d8ef4ce188c03019afefd3c83b93fe0942e0cd269cc5ce4806d4b935f8aa3d9d","occurrences":[{"file":"references/uninstall.md","start_line":11,"end_line":null}]}],"suppressed_count":0,"suppressed":[],"metadata":{"has_executable_scripts":true,"skillspector_version":"2.11.2","llm_requested":true,"llm_available":true,"meta_analysis_applied":true,"inference_usage":[{"node":"mcp_tool_poisoning","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":4058,"completion_tokens":298,"cached_tokens":3840,"reasoning_tokens":0,"total_tokens":4356},{"node":"mcp_tool_poisoning","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":3097,"completion_tokens":268,"cached_tokens":2816,"reasoning_tokens":0,"total_tokens":3365},{"node":"mcp_tool_poisoning","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provi