{"schema":"clawhub.skill.verify.v1","ok":true,"decision":"pass","reasons":[],"slug":"self-improving-agent","displayName":"self-improving agent","pageUrl":"https://clawhub.ai/pskoett/skills/self-improving-agent","publisherHandle":"pskoett","publisherDisplayName":"pskoett","publisherProfileUrl":"https://clawhub.ai/pskoett","version":"4.0.3","resolvedFrom":"version","tag":null,"createdAt":1791095591470,"card":{"available":true,"path":"skill-card.md","url":"https://wry-manatee-359.convex.site/api/v1/skills/self-improving-agent/card?ownerHandle=pskoett&version=4.0.3","sha256":"4ed8d23b34571389d60f7e2884eb2f78e0f2b69ad52a9c67ea4840b21356c744","size":1939,"contentType":"text/markdown; charset=utf-8"},"artifact":{"sourceFingerprint":"32922b268db9bd0dc4ca62471ba29c74b76937cd68ef655196105f66b34ea499","bundleFingerprints":["b68cd504628c3d5cd24cee616811deca9a1bc6e386fe70da2e0aa19896a4773b","1873ef2a2c5fc3f0949443d91251b80382e8ad38bc2e2bc2a8b05f9e0a7199a3"],"files":[{"path":"CHANGELOG.md","size":8574,"sha256":"bc32689b7ce3325aa78927c4199820f490c56dde3a95e2525c29227ba8633e1f","contentType":"text/markdown"},{"path":"SKILL.md","size":25671,"sha256":"529b5aa692a5d050b42564ac7a01750fe30d2026db9daf4a6421bbfcfb30398a","contentType":"text/markdown"},{"path":"assets/FEATURE_REQUESTS.md","size":1654,"sha256":"9aaaa3cfd4147f41048d66554cea7c6bd7f240a2804508a8d134c67e2dbe2457","contentType":"text/markdown"},{"path":"assets/ERRORS.md","size":1819,"sha256":"64a70d87c4864041e5ccfc0f1ced176dd29c6dd169f5104b4bc3835ef565bdc0","contentType":"text/markdown"},{"path":"assets/SKILL-TEMPLATE.md","size":5199,"sha256":"0ee0abda9e3ea3707999e77ceff7e25f6c62a95d94b4ec7b08a9ef85c4188a26","contentType":"text/markdown"},{"path":"assets/LEARNINGS.md","size":3367,"sha256":"168b0dc92c8a9e930b676afbb133a8832cffa2419300c531f663fa7837456d6a","contentType":"text/markdown"},{"path":"scripts/extract-skill.sh","size":5293,"sha256":"d9af3d6f2cde0eeb3c0a85b898828656c1c6d9d51f61ba38f9801030424f5147","contentType":"text/x-sh"},{"path":"hooks/openclaw/handler.test.js","size":11022,"sha256":"c504172fc0a1c94f895d61f3e213a424f6314baaa42915dd7e66c97be7a4f7e3","contentType":"text/javascript"},{"path":"hooks/openclaw/handler.js","size":14816,"sha256":"68299601e121a150a9a112aab088cc828ba0e890bc1915c08a0c4523688bf86f","contentType":"text/javascript"},{"path":"hooks/openclaw/HOOK.md","size":3111,"sha256":"b99ef7fb3c2aa328c6da82a556fbd889ee8d2aad1163c009d0fd4de0e4bcd2df","contentType":"text/markdown"},{"path":"hooks/openclaw/handler.ts","size":15690,"sha256":"738c3bb9e0b9e5918bec10a1dbfa932016acaab273fc8c852ef6fc13eb817227","contentType":"application/octet-stream"},{"path":"references/uninstall.md","size":1891,"sha256":"c569a88473ac0187e0d9dde1686eb24efe4666d84af2a149b5fb8e99b7a99828","contentType":"text/markdown"},{"path":"references/examples.md","size":14876,"sha256":"6574b218d2c262a406a0201218a17ff26c89474f4e7196835d14c080d029dab4","contentType":"text/markdown"},{"path":"references/openclaw-integration.md","size":12086,"sha256":"a17a039d13d391c64e5704f547fd1a66e970c1a57cffab019ad0eba2470e97af","contentType":"text/markdown"},{"path":"references/maintenance-evals.md","size":6958,"sha256":"697ee16c1dba84be3e48f63d6419dfa301934f67782edb68a6e5e80917042550","contentType":"text/markdown"}]},"provenance":{"source":"unavailable","reason":"No server-resolved GitHub import provenance is stored for this version."},"security":{"status":"clean","passed":true,"rawStatus":"clean","verdict":"benign","confidence":"high","summary":"The skill is a disclosed local learning/memory workflow with optional hooks; it is not malicious, but users should understand it persists notes and can update workspace guidance files.","model":null,"checkedAt":1791100018829,"scannerReports":{"aig":{"version":"2.1.0","$schema":"https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/Schemata/sarif-schema-2.1.0.json","runs":[{"tool":{"driver":{"name":"aig-skill-scan","version":"0.2.2","informationUri":"https://github.com/Tencent/AI-Infra-Guard","rules":[{"id":"T01","name":"Skill Instruction Hijacking","shortDescription":{"text":"Alters the agent's current session goals or safety constraints when the skill is loaded"}},{"id":"T02","name":"Agent Memory Poisoning","shortDescription":{"text":"Writes attacker-controlled rules into persistent memory so they continue to affect future sessions"}},{"id":"T03","name":"Remote Payload Retrieval and Execution","shortDescription":{"text":"Fetches code from an external URL, allowing the effective payload to change after skill review"}},{"id":"T04","name":"Embedded Malicious Code","shortDescription":{"text":"Ships malicious scripts inside the skill package and executes them locally when invoked"}},{"id":"T05","name":"Unauthorized Access and Privilege Escalation","shortDescription":{"text":"Breaks least-privilege boundaries by obtaining permissions beyond the task's legitimate needs"}},{"id":"T06","name":"System Persistence","shortDescription":{"text":"Installs cross-session backdoors, hooks, services, or scheduled tasks that survive the skill run"}},{"id":"T07","name":"Tool Hijacking and Spoofing","shortDescription":{"text":"Modifies, wraps, spoofs, or replaces tools so legitimate-looking calls execute attacker logic"}},{"id":"T08","name":"Insecure Dependencies","shortDescription":{"text":"Introduces malicious packages or components through dependency confusion, typosquatting, or unsafe sources"}},{"id":"T09","name":"Insecure Skill Coding Practices","shortDescription":{"text":"Exposes exploitable flaws such as hardcoded secrets, command injection, plaintext sensitive data, or unsafe temp files"}},{"id":"other","name":"Other Risk","shortDescription":{"text":"Security issues not covered by the T01-T09 classification"}}]}},"results":[],"properties":{"securityScore":100,"primaryLanguage":"Markdown","llm":"gpt-5.6","startTime":1791099913.764458,"endTime":1791099971.846072}}]},"skillspector":{"skill":{"name":"self-improving-agent","source":"/tmp/clawhub-codex-scan-v5700q44en1d67wzqbnvr9g6x18fm3p0-s8eB8b/clawscan-skillspector-610845882/artifact","scanned_at":"2026-10-04T07:45:13.193095+00:00"},"risk_assessment":{"score":100,"severity":"CRITICAL","recommendation":"DO_NOT_INSTALL","max_issue_severity":"HIGH"},"components":[{"path":"CHANGELOG.md","type":"markdown","lines":194,"executable":false,"size_bytes":8574,"source_url":null,"source_identity":null,"source_digest":null},{"path":"SKILL.md","type":"markdown","lines":494,"executable":false,"size_bytes":25671,"source_url":null,"source_identity":null,"source_digest":null},{"path":"assets/ERRORS.md","type":"markdown","lines":57,"executable":false,"size_bytes":1819,"source_url":null,"source_identity":null,"source_digest":null},{"path":"assets/FEATURE_REQUESTS.md","type":"markdown","lines":50,"executable":false,"size_bytes":1654,"source_url":null,"source_identity":null,"source_digest":null},{"path":"assets/LEARNINGS.md","type":"markdown","lines":95,"executable":false,"size_bytes":3367,"source_url":null,"source_identity":null,"source_digest":null},{"path":"assets/SKILL-TEMPLATE.md","type":"markdown","lines":193,"executable":false,"size_bytes":5199,"source_url":null,"source_identity":null,"source_digest":null},{"path":"hooks/openclaw/HOOK.md","type":"markdown","lines":78,"executable":false,"size_bytes":3111,"source_url":null,"source_identity":null,"source_digest":null},{"path":"hooks/openclaw/handler.js","type":"javascript","lines":465,"executable":true,"size_bytes":14816,"source_url":null,"source_identity":null,"source_digest":null},{"path":"hooks/openclaw/handler.test.js","type":"javascript","lines":268,"executable":true,"size_bytes":11022,"source_url":null,"source_identity":null,"source_digest":null},{"path":"hooks/openclaw/handler.ts","type":"typescript","lines":482,"executable":true,"size_bytes":15690,"source_url":null,"source_identity":null,"source_digest":null},{"path":"references/examples.md","type":"markdown","lines":450,"executable":false,"size_bytes":14876,"source_url":null,"source_identity":null,"source_digest":null},{"path":"references/maintenance-evals.md","type":"markdown","lines":52,"executable":false,"size_bytes":6958,"source_url":null,"source_identity":null,"source_digest":null},{"path":"references/openclaw-integration.md","type":"markdown","lines":346,"executable":false,"size_bytes":12086,"source_url":null,"source_identity":null,"source_digest":null},{"path":"references/uninstall.md","type":"markdown","lines":55,"executable":false,"size_bytes":1891,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/extract-skill.sh","type":"shell","lines":221,"executable":true,"size_bytes":5293,"source_url":null,"source_identity":null,"source_digest":null}],"structured_summaries":[],"issues":[{"id":"TP4","finding_id":"finding-b665dd7eb9064e92a6a4f0918ca96636","category":"MCP Tool Poisoning","pattern":null,"severity":"HIGH","confidence":0.98,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"The declared purpose is note-taking and review of learnings, but the skill also includes installation, hook enablement, cross-session communication, promotion into workspace prompt files, and skill extraction workflows. This mismatch can cause agents or users to trust and auto-activate the skill in low-risk contexts while it actually performs broader state-changing operations across the workspace.","remediation":"Narrow the skill to its core logging/review function, or update the description and metadata so all behaviors are accurately disclosed. Prefer separating installation, hook automation, workspace-prompt promotion, and skill-extraction into separate explicitly named skills with independent approvals and permissions.","code_snippet":null,"intent":null,"tags":["ASI02","AML.T0080"],"evidence":{"code_path":"scripts/extract-skill.sh","code_start_line":1,"code_end_line":221,"actual_behavior_summary":"A shell script that scaffolds a new skill directory and SKILL.md template from a provided skill name, with optional dry-run and output-directory handling. It validates names/paths and writes files under a skills directory."},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"RA1","finding_id":"finding-bc554e30dfdb4e4b917efc783c375e6d","category":"Rogue Agent","pattern":"Self-Modification","severity":"HIGH","confidence":0.85,"location":{"file":"SKILL.md","start_line":199,"end_line":null},"finding":"write skill","explanation":"Skill modifies its own code, configuration, or behavior at runtime. Self-modification enables an agent to escalate privileges, disable safety constraints, or install persistent backdoors.","remediation":"Prevent the skill from modifying its own code, SKILL.md, or configuration files. Treat skill files as read-only at runtime.","code_snippet":"4. **Choose** `retain` (supported and useful, or explicitly provisional while blocked), `revise` (correct/narrow with evidence), `externalize` (replace volatile detail with a usable retrieval instruction), or `retire` (exclude from active guidance with an evidenced reason). Externalization names where to look, what to read/test, and what to do if inaccessible/conflicting; a vague “check docs” is insufficient. Verify that the retrieval path is usable before treating it as validated.\n5. **Record and propagate**: append a dated review note with the outcome, reason, evidence, and old → new claim when changed. Preserve original observations, resolution, promotion targets/dates, and prior reviews. Update affected promoted guidance using its source link; keep its source-learning ID beside the revised rule (or a retirement note pointing to the preserved history). Never inflate `Recurrence-Count`/`Last-Seen` just because a review ran.\n\nNever erase learning/promotion history or delete by age. Never change user preferences, weaken security policies, or rewrite skill assets merely because they are old or unused. Skill creation/modification requires explicit scoped approval; approval for this integration does not authorize future skill rewrites. If a needed target edit is outside granted scope, record the proposed change as pending in the source entry and report the still-active guidance rather than silently claiming it is updated.\n\nFor worked review outcomes and provenance, read [maintenance examples](references/examples.md#maintenance-examples).\n","intent":null,"tags":["Rogue Agent","llm-unconfirmed"],"evidence":{},"match_fingerprint":"be76aa3b8ee8ba0091b45db5ceb2fe4088a26078a5f1429d11667e608c128e95","occurrences":[{"file":"SKILL.md","start_line":199,"end_line":null}]},{"id":"RA1","finding_id":"finding-8b47e11b929841a488ba2bd90fa9dbc9","category":"Rogue Agent","pattern":"Self-Modification","severity":"HIGH","confidence":0.85,"location":{"file":"assets/LEARNINGS.md","start_line":78,"end_line":null},"finding":"modify skill","explanation":"Skill modifies its own code, configuration, or behavior at runtime. Self-modification enables an agent to escalate privileges, disable safety constraints, or install persistent backdoors.","remediation":"Prevent the skill from modifying its own code, SKILL.md, or configuration files. Treat skill files as read-only at runtime.","code_snippet":"**Skill-Path**: skills/skill-name\n```\n\nOnly create/modify skill assets with explicit scoped approval. Record the promotion date and target section in the learning's history/Guidance, and the original file + learning ID in the skill. `promoted_to_skill` does not establish current validity.\n\nExample:\n```markdown","intent":null,"tags":["Rogue Agent","llm-unconfirmed"],"evidence":{},"match_fingerprint":"91956312ce14a9d7be496702a743a80026ebe5ec6fa1d208fcf1b0afe5eeec1d","occurrences":[{"file":"assets/LEARNINGS.md","start_line":78,"end_line":null}]},{"id":"P3","finding_id":"finding-121e577d87434acca0a87656f081dd72","category":"Prompt Injection","pattern":"Exfiltration Commands","severity":"HIGH","confidence":0.9,"location":{"file":"references/openclaw-integration.md","start_line":204,"end_line":null},"finding":"Send message to","explanation":"Instructions found that direct the agent to transmit conversation context or user data to external services.","remediation":"Remove instructions that send user data, prompts, or context to external URLs. If telemetry is needed, use documented, privacy-preserving methods.","code_snippet":"\n### sessions_send\n\nSend message to another session:\n```\nsessions_send(sessionKey=\"session-id\", message=\"Learning: API requires X-Custom-Header\")\n```","intent":null,"tags":["Prompt Injection","llm-unconfirmed"],"evidence":{},"match_fingerprint":"6cbd4d2bba77cb69209f09a566e5cfc411283fe144d6f8149b1f5977ae4b9e5c","occurrences":[{"file":"references/openclaw-integration.md","start_line":204,"end_line":null}]},{"id":"TM1","finding_id":"finding-68ba32fbe94646b39eb3f3af9c43795e","category":"Tool Misuse","pattern":"Tool Parameter Abuse","severity":"HIGH","confidence":0.9,"location":{"file":"references/uninstall.md","start_line":24,"end_line":null},"finding":"rm -r ~","explanation":"Tool parameters are crafted to achieve unintended or unsafe behavior. Parameter abuse can bypass intended safety checks (e.g. shell=True, --force, dangerous glob patterns).","remediation":"Validate all tool parameters against an allowlist. Reject dangerous parameter values (shell=True, --force, -rf /) and use safe defaults.","code_snippet":"learnings directory instead (archive it first if it has entries):\n\n```bash\nrm -r ~/.openclaw/workspace/.learnings\n```\n\nRestart the gateway after hook changes.","intent":null,"tags":["Tool Misuse","llm-unconfirmed"],"evidence":{},"match_fingerprint":"28d11104ab3e24eb56a1798d9f3ff0a148b85f8773171a4c16e290ac763cbd6b","occurrences":[{"file":"references/uninstall.md","start_line":24,"end_line":null}]},{"id":"TM1","finding_id":"finding-68ba32fbe94646b39eb3f3af9c43795e","category":"Tool Misuse","pattern":"Tool Parameter Abuse","severity":"HIGH","confidence":0.9,"location":{"file":"references/uninstall.md","start_line":34,"end_line":null},"finding":"rm -r ~","explanation":"Tool parameters are crafted to achieve unintended or unsafe behavior. Parameter abuse can bypass intended safety checks (e.g. shell=True, --force, dangerous glob patterns).","remediation":"Validate all tool parameters against an allowlist. Reject dangerous parameter values (shell=True, --force, -rf /) and use safe defaults.","code_snippet":"learnings directory instead (archive it first if it has entries):\n\n```bash\nrm -r ~/.openclaw/workspace/.learnings\n```\n\nRestart the gateway after hook changes.","intent":null,"tags":["Tool Misuse","llm-unconfirmed"],"evidence":{},"match_fingerprint":"28d11104ab3e24eb56a1798d9f3ff0a148b85f8773171a4c16e290ac763cbd6b","occurrences":[{"file":"references/uninstall.md","start_line":34,"end_line":null}]},{"id":"TM1","finding_id":"finding-68ba32fbe94646b39eb3f3af9c43795e","category":"Tool Misuse","pattern":"Tool Parameter Abuse","severity":"HIGH","confidence":0.9,"location":{"file":"references/uninstall.md","start_line":37,"end_line":null},"finding":"rm -r ~","explanation":"Tool parameters are crafted to achieve unintended or unsafe behavior. Parameter abuse can bypass intended safety checks (e.g. shell=True, --force, dangerous glob patterns).","remediation":"Validate all tool parameters against an allowlist. Reject dangerous parameter values (shell=True, --force, -rf /) and use safe defaults.","code_snippet":"learnings directory instead (archive it first if it has entries):\n\n```bash\nrm -r ~/.openclaw/workspace/.learnings\n```\n\nRestart the gateway after hook changes.","intent":null,"tags":["Tool Misuse","llm-unconfirmed"],"evidence":{},"match_fingerprint":"28d11104ab3e24eb56a1798d9f3ff0a148b85f8773171a4c16e290ac763cbd6b","occurrences":[{"file":"references/uninstall.md","start_line":37,"end_line":null}]},{"id":"TM1","finding_id":"finding-68ba32fbe94646b39eb3f3af9c43795e","category":"Tool Misuse","pattern":"Tool Parameter Abuse","severity":"HIGH","confidence":0.9,"location":{"file":"references/uninstall.md","start_line":40,"end_line":null},"finding":"rm -r ~","explanation":"Tool parameters are crafted to achieve unintended or unsafe behavior. Parameter abuse can bypass intended safety checks (e.g. shell=True, --force, dangerous glob patterns).","remediation":"Validate all tool parameters against an allowlist. Reject dangerous parameter values (shell=True, --force, -rf /) and use safe defaults.","code_snippet":"learnings directory instead (archive it first if it has entries):\n\n```bash\nrm -r ~/.openclaw/workspace/.learnings\n```\n\nRestart the gateway after hook changes.","intent":null,"tags":["Tool Misuse","llm-unconfirmed"],"evidence":{},"match_fingerprint":"28d11104ab3e24eb56a1798d9f3ff0a148b85f8773171a4c16e290ac763cbd6b","occurrences":[{"file":"references/uninstall.md","start_line":40,"end_line":null}]},{"id":"TM1","finding_id":"finding-355d94535e4a4b6e9eb4bf1f32027f94","category":"Tool Misuse","pattern":"Tool Parameter Abuse","severity":"HIGH","confidence":0.85,"location":{"file":"references/uninstall.md","start_line":24,"end_line":null},"finding":"rm -r ~/.openclaw/workspace/.learnings","explanation":"Tool parameters are crafted to achieve unintended or unsafe behavior. Parameter abuse can bypass intended safety checks (e.g. shell=True, --force, dangerous glob patterns).","remediation":"Validate all tool parameters against an allowlist. Reject dangerous parameter values (shell=True, --force, -rf /) and use safe defaults.","code_snippet":"learnings directory instead (archive it first if it has entries):\n\n```bash\nrm -r ~/.openclaw/workspace/.learnings\n```\n\nRestart the gateway after hook changes.","intent":null,"tags":["Tool Misuse","llm-unconfirmed"],"evidence":{},"match_fingerprint":"4eec509dd39daf6feec17aea9319149944c218115e6820c12df20792e58c3168","occurrences":[{"file":"references/uninstall.md","start_line":24,"end_line":null}]},{"id":"TM1","finding_id":"finding-355d94535e4a4b6e9eb4bf1f32027f94","category":"Tool Misuse","pattern":"Tool Parameter Abuse","severity":"HIGH","confidence":0.85,"location":{"file":"references/uninstall.md","start_line":40,"end_line":null},"finding":"rm -r ~/.openclaw/workspace/.learnings","explanation":"Tool parameters are crafted to achieve unintended or unsafe behavior. Parameter abuse can bypass intended safety checks (e.g. shell=True, --force, dangerous glob patterns).","remediation":"Validate all tool parameters against an allowlist. Reject dangerous parameter values (shell=True, --force, -rf /) and use safe defaults.","code_snippet":"learnings directory instead (archive it first if it has entries):\n\n```bash\nrm -r ~/.openclaw/workspace/.learnings\n```\n\nRestart the gateway after hook changes.","intent":null,"tags":["Tool Misuse","llm-unconfirmed"],"evidence":{},"match_fingerprint":"4eec509dd39daf6feec17aea9319149944c218115e6820c12df20792e58c3168","occurrences":[{"file":"references/uninstall.md","start_line":40,"end_line":null}]},{"id":"TM1","finding_id":"finding-8ae5fa90a81d4a2699251a8ad8e3c13b","category":"Tool Misuse","pattern":"Tool Parameter Abuse","severity":"HIGH","confidence":0.85,"location":{"file":"references/uninstall.md","start_line":34,"end_line":null},"finding":"rm -r ~/.openclaw/hooks/self-improvement","explanation":"Tool parameters are crafted to achieve unintended or unsafe behavior. Parameter abuse can bypass intended safety checks (e.g. shell=True, --force, dangerous glob patterns).","remediation":"Validate all tool parameters against an allowlist. Reject dangerous parameter values (shell=True, --force, -rf /) and use safe defaults.","code_snippet":"```bash\n# 1. Disable and remove the hook\nopenclaw hooks disable self-improvement\nrm -r ~/.openclaw/hooks/self-improvement\n\n# 2. Remove the skill\nrm -r ~/.openclaw/skills/self-improving-agent","intent":null,"tags":["Tool Misuse","llm-unconfirmed"],"evidence":{},"match_fingerprint":"0f171f3f3b82dd4219c6b573a791be83cb1145125e04ba920cb7c75af69d4585","occurrences":[{"file":"references/uninstall.md","start_line":34,"end_line":null}]},{"id":"TM1","finding_id":"finding-0202a57c08e74a02a863ef0d1b6aab42","category":"Tool Misuse","pattern":"Tool Parameter Abuse","severity":"HIGH","confidence":0.85,"location":{"file":"references/uninstall.md","start_line":37,"end_line":null},"finding":"rm -r ~/.openclaw/skills/self-improving-agent","explanation":"Tool parameters are crafted to achieve unintended or unsafe behavior. Parameter abuse can bypass intended safety checks (e.g. shell=True, --force, dangerous glob patterns).","remediation":"Validate all tool parameters against an allowlist. Reject dangerous parameter values (shell=True, --force, -rf /) and use safe defaults.","code_snippet":"rm -r ~/.openclaw/hooks/self-improvement\n\n# 2. Remove the skill\nrm -r ~/.openclaw/skills/self-improving-agent\n\n# 3. Optional — remove captured learnings (REVIEW FIRST, this is your data)\nrm -r ~/.openclaw/workspace/.learnings","intent":null,"tags":["Tool Misuse","llm-unconfirmed"],"evidence":{},"match_fingerprint":"e2ac8e44f59501b5a9e123e3f2c08068cf143b53f609c73e8babee8f3397c180","occurrences":[{"file":"references/uninstall.md","start_line":37,"end_line":null}]},{"id":"LP3","finding_id":"finding-65e59c923f244fbcaeae7da7a5ba11ab","category":"MCP Least Privilege","pattern":null,"severity":"MEDIUM","confidence":0.91,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"The skill instructs use of shell commands, git clone/cp, OpenClaw installers, optional hooks, and cross-session features, but it does not declare any explicit tool or permission scope. That means a host agent may invoke filesystem, environment, or network-capable actions without a machine-readable boundary, increasing the chance of over-privileged execution or unsafe auto-enablement.","remediation":"Add explicit tool/permission metadata describing the minimum required capabilities, such as filesystem write access limited to `.learnings/` and optional network access only for installation flows. Split install/hook/session-sharing behaviors into clearly gated, opt-in sections or separate skills so routine learning capture does not imply broader privileges.","code_snippet":null,"intent":null,"tags":["ASI02"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"SQP-1","finding_id":"finding-d183787928894fddb12bdef2db0c2bea","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.94,"location":{"file":"SKILL.md","start_line":3,"end_line":3},"finding":null,"explanation":"The activation description covers many normal situations such as failed commands, user corrections, missing capabilities, outdated knowledge, and better approaches. Because these are common during ordinary work, the skill may trigger frequently and opportunistically, causing persistent writes and workflow changes in contexts where the user did not intend memory capture or review behavior.","remediation":"Tighten activation criteria so the skill runs only on explicit user request or after a clear workspace-level opt-in. Add exclusions for sensitive tasks, transient troubleshooting, and situations where persistence or promotion to workspace guidance has not been approved.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":3,"end_line":3}]},{"id":"RA2","finding_id":"finding-5e9528086be54db997f05bb84ffe424e","category":"Rogue Agent","pattern":"Session Persistence","severity":"MEDIUM","confidence":0.84,"location":{"file":"SKILL.md","start_line":94,"end_line":null},"finding":"Create Learning Files\n\n```bash\nmkdir -p ~/.openclaw","explanation":"The skill persists data in `~/.openclaw/workspace/.learnings`, making captured information survive the current session and potentially affect future sessions. Persistent storage is part of the stated purpose, but it becomes risky because the same document also encourages broad automatic capture and later promotion into injected workspace guidance files.","remediation":"Require explicit workspace opt-in before creating persistent learning files, and default to project-local or session-local storage where possible. Add retention controls, clear review/consent steps before promotion to `AGENTS.md`/`TOOLS.md`/`SOUL.md`, and stronger guidance to avoid storing sensitive or user-derived content unless expressly authorized.","code_snippet":"    └── FEATURE_REQUESTS.md\n```\n\n### Create Learning Files\n\n```bash\nmkdir -p ~/.openclaw/workspace/.learnings","intent":null,"tags":["Rogue Agent"],"evidence":{},"match_fingerprint":"50cde7bc36af8896e3f183732f740907994866c8e17207da188f43630e3c2552","occurrences":[{"file":"SKILL.md","start_line":94,"end_line":null}]},{"id":"SQP-1","finding_id":"finding-8c96fa3b7bf0429a9e3af6888446ece4","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.9,"location":{"file":"SKILL.md","start_line":404,"end_line":429},"finding":null,"explanation":"The 'Automatically log when you notice' section directs autonomous capture of corrections, feature requests, knowledge gaps, and errors based on broad signals. In practice this creates implicit persistence of conversation-derived data and can over-collect sensitive operational context, especially combined with review/promotion flows and optional hooks.","remediation":"Make all automatic logging opt-in and scoped, with a clear default of no persistence unless enabled by the user or workspace policy. Add explicit data-minimization rules, sensitive-content exclusions, and confirmation prompts before creating or updating persistent records.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":404,"end_line":429}]},{"id":"SQP-1","finding_id":"finding-ccf6738129454f1bb0767d5daa543799","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.96,"location":{"file":"SKILL.md","start_line":414,"end_line":418},"finding":null,"explanation":"The feature-request trigger phrases are broad conversational patterns like 'Can you also...' and 'Is there a way to...', which commonly occur in normal dialogue and do not necessarily indicate consent to persistent logging. This can lead to silent retention of user intent or project details in `.learnings/FEATURE_REQUESTS.md` without a specific opt-in boundary.","remediation":"Require explicit confirmation before logging feature requests, especially for first use in a workspace. Replace phrase-based auto-detection with a narrow rule such as 'log only when the user explicitly asks to save this as a feature request'.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":414,"end_line":418}]},{"id":"RA2","finding_id":"finding-0c64371e40fb4baf93ca0f91d8523abd","category":"Rogue Agent","pattern":"Session Persistence","severity":"MEDIUM","confidence":0.6,"location":{"file":"CHANGELOG.md","start_line":180,"end_line":null},"finding":"mkdir -p ~/.openclaw","explanation":"Skill establishes unauthorized persistence across sessions via cron jobs, startup scripts, or state files. Session persistence allows an attacker to maintain access beyond the current interaction.","remediation":"Remove any persistence mechanisms (cron jobs, startup scripts, state files). Skills should not maintain state across sessions without explicit user consent.","code_snippet":"Enable the error sweep by creating the learnings directory:\n\n```bash\nmkdir -p ~/.openclaw/workspace/.learnings\n```\n\n## Testing","intent":null,"tags":["Rogue Agent","llm-unconfirmed"],"evidence":{},"match_fingerprint":"fad2b8c7e41f19282116c0a04b6bc3bd188a53c89e42eda3b43874fc44a36d17","occurrences":[{"file":"CHANGELOG.md","start_line":180,"end_line":null}]},{"id":"RA2","finding_id":"finding-0c64371e40fb4baf93ca0f91d8523abd","category":"Rogue Agent","pattern"