ze_bytes":23161,"source_url":null,"source_identity":null,"source_digest":null}],"structured_summaries":[],"issues":[{"id":"AE1","finding_id":"finding-41faec4067f34d899ec3ffcb4c4dc932","category":"analysis-evasion","pattern":null,"severity":"HIGH","confidence":1,"location":{"file":"SKILL.md","start_line":105,"end_line":null},"finding":"references/international-search.md (partial)","explanation":"Referenced artifact was not completely inspected","remediation":"Make the referenced artifact locally available and fully analyzable, or remove the reference.","code_snippet":"- `references/international-search.md` - International search guide","intent":null,"tags":["coverage","reference","target-disposition:partial"],"evidence":{},"match_fingerprint":"1f5acb515b8b013faa7cf84eceac36c79645ba9e78413a09709cdacff4a26a11","occurrences":[{"file":"SKILL.md","start_line":105,"end_line":null}]},{"id":"SQP-3","finding_id":"finding-ba8e1e166dc14f7b8d5b52ddcb17a7ef","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.89,"location":{"file":"CHANNELLOG.md","start_line":3,"end_line":45},"finding":null,"explanation":"The file presents all descriptive and instructional content in Chinese, including headings, feature descriptions, changelog entries, and usage examples. Under the policy rules, forcing a specific language without user opt-in or a documented justification is a natural-language policy violation.","remediation":"Provide a bilingual version of the documentation, add an explicit language-selection or localization note, or clearly document that this skill is intended for a Chinese-language audience and why that constraint is necessary.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"CHANNELLOG.md","start_line":3,"end_line":45}]},{"id":"SQP-2","finding_id":"finding-5df79657fe2b4a609f53c08de25d2235","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.94,"location":{"file":"SKILL.md","start_line":8,"end_line":55},"finding":null,"explanation":"The skill encourages users to issue searches through multiple third-party search engines but does not warn that search terms will be transmitted to external providers, potentially exposing sensitive queries, internal project names, credentials pasted by mistake, or other private data. In this context, the omission is security-relevant because the skill is specifically designed to route user input to many external domains, including engines with different privacy characteristics and jurisdictions.","remediation":"Add a prominent privacy and data-handling warning near the description and examples stating that all search queries are sent to third-party search engines and may be logged or profiled. Advise users not to search for secrets, internal-only data, personal information, or regulated content, and annotate which engines are privacy-oriented versus which may involve more tracking or different legal jurisdictions.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":8,"end_line":55}]},{"id":"SQP-2","finding_id":"finding-0c6941e286ce480986390ec92f75010f","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.92,"location":{"file":"references/international-search.md","start_line":164,"end_line":164},"finding":null,"explanation":"This markdown file documents the `kp=-1` DuckDuckGo parameter as '关闭安全搜索' and presents it as a normal option, but does not warn that it may expose the user to explicit, unsafe, or otherwise sensitive content. For markdown files, omission of warnings about behaviours affecting user safety or system/data integrity should be flagged when such risky behaviour is described.","remediation":"Add a clear warning near the parameter table stating that disabling safe search may return explicit, disturbing, or otherwise unsafe content, and recommend using it only with informed user consent.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"references/international-search.md","start_line":164,"end_line":164}]},{"id":"SQP-3","finding_id":"finding-933191b7a0894a36b07fcf3643ea7c10","category":null,"pattern":null,"severity":"LOW","confidence":0.82,"location":{"file":"config.json","start_line":4,"end_line":10},"finding":null,"explanation":"The config includes several CN-specific engines and regions, such as Baidu, Bing CN, and other China-focused providers, but provides no indication that users can opt into or out of this locale-specific routing. Under the policy, forcing a specific language or locale without user choice can be a natural-language policy concern even in configuration values.","remediation":"Document the locale behavior and provide an explicit user choice or selection mechanism for CN versus global engines. If the locale restriction is intentional, add clear justification in accompanying documentation or metadata.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"config.json","start_line":4,"end_line":10}]},{"id":"SQP-2","finding_id":"finding-6eeb7a2559044f60a58f483a22137b96","category":null,"pattern":null,"severity":"LOW","confidence":0.8,"location":{"file":"references/international-search.md","start_line":641,"end_line":641},"finding":null,"explanation":"The privacy advice suggests '使用Tor浏览器 + DuckDuckGo onion服务' for sensitive searches, but does not disclose that Tor usage may be restricted by some organizations or jurisdictions and can trigger monitoring or access limitations. In a markdown skill guide, recommending privacy-impacting network behaviour without contextual warning can leave users unaware of relevant risks.","remediation":"Add a brief note that Tor use may be restricted or monitored in some environments, and advise users to follow local law and organizational policy before using it.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"references/international-search.md","start_line":641,"end_line":641}]}],"suppressed_count":0,"suppressed":[],"metadata":{"has_executable_scripts":false,"skillspector_version":"2.11.2","llm_requested":true,"llm_available":true,"meta_analysis_applied":true,"inference_usage":[{"node":"semantic_developer_intent","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":1850,"completion_tokens":14,"cached_tokens":0,"reasoning_tokens":0,"total_tokens":1864},{"node":"semantic_developer_intent","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":2661,"completion_tokens":14,"cached_tokens":0,"reasoning_tokens":0,"total_tokens":2675},{"node":"semantic_developer_intent","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":1477,"completion_tokens":14,"cached_tokens":0,"reasoning_tokens":0,"total_tokens":1491},{"node":"semantic_developer_intent","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":1398,"completion_tokens":14,"cached_tokens":0,"reasoning_tokens":0,"total_tokens":1412},{"node":"semantic_developer_intent","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":1927,"completion_tokens":14,"cached_tokens":0,"reasoning_tokens":0,"total_tokens":1941},{"node":"semantic_developer_intent","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_