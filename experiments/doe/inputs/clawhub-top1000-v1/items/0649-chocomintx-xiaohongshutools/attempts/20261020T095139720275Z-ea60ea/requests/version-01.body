/encrypt/cookie/a1_and_webId.py","size":1645,"sha256":"193818c52062b767656a02a6748c0fd5957e3bd664d582ad83e6c16ac8e4914a","contentType":null},{"path":"scripts/request/web/encrypt/cookie/gid_webprofile_data.py","size":1846,"sha256":"08cf6088467a277cda2cfdc06955713d2ad7c3945230b4ac15b6dd665c116f60","contentType":null},{"path":"scripts/request/web/encrypt/cookie/websectiga.py","size":1969,"sha256":"41207df9187c01737a3a0513d91d26df05352995a71ace7a9966ac6714b49cd0","contentType":null},{"path":"scripts/request/web/apis/auth.py","size":5267,"sha256":"981c0d770cfb495e003da09904a9a9dba2a1e78b21c81e2fec9db13147af5a2a","contentType":null},{"path":"scripts/request/web/apis/comments.py","size":7459,"sha256":"8c82a786cad3c041e279fb520537b57fd805f3ca718a013ce1aea3e06aba4d54","contentType":null},{"path":"scripts/request/web/apis/note.py","size":9957,"sha256":"00480d06de8f5148f450c6136cb27d1d699c85393984c433732f1c00a8b4da35","contentType":null},{"path":"scripts/request/web/apis/user.py","size":753,"sha256":"21f9d8e241ea753c7d9b017dcdf73ad84f63a7c73ee30578484c35ae14858dcc","contentType":null},{"path":"scripts/request/web/apis/__init__.py","size":336,"sha256":"c417e8e3953d687e7f1ce1d0dd2132ced06c8353e64c56993455fb5912ac1a3e","contentType":null},{"path":"skill-card.md","size":2798,"sha256":"3b90001026d8b2b348d3f647997f3b315ae2e80b0256a0229f0d89fe5839fa4e","contentType":"text/markdown"}],"security":{"status":"suspicious","hasWarnings":true,"checkedAt":1789030459036,"model":null,"hasScanResult":true,"sha256hash":"9b79dc93b80b19197baf31ae217a438c6bec7f0b00fdaf3b6c0c6ecad9f55bd0","virustotalUrl":"https://www.virustotal.com/gui/file/9b79dc93b80b19197baf31ae217a438c6bec7f0b00fdaf3b6c0c6ecad9f55bd0","scanners":{"vt":{"status":"suspicious","verdict":"suspicious","normalizedStatus":"suspicious","analysis":"Type: OpenClaw Skill\nName: xiaohongshutools\nVersion: 0.1.0\n\nThe skill is designed for web scraping and interaction with XiaoHongShu, employing sophisticated reverse-engineering techniques to bypass anti-bot measures. While its functionality aligns with the stated purpose, the nature of web scraping, anti-bot bypass, and the capability to handle security challenges (like QR code logins) without clear malicious intent, classifies it as suspicious. There is no evidence of data exfiltration to unauthorized endpoints, persistence, or unauthorized remote control. The hardcoded path in SKILL.md and a hardcoded fingerprint example in scripts/request/web/encrypt/other/XhsFpGenerator.py are minor concerns but do not indicate malicious intent.","source":"palm","checkedAt":1779161029359},"skillspector":{"status":"suspicious","normalizedStatus":"suspicious","score":100,"severity":"CRITICAL","recommendation":"DO_NOT_INSTALL","issueCount":38,"checkedAt":1789030459036},"llm":{"status":"suspicious","verdict":"suspicious","normalizedStatus":"suspicious","confidence":"high","summary":"This XiaoHongShu automation skill needs Review because it uses session cookies, can change account state, and includes underdocumented engagement and anti-abuse handling code.","dimensions":[{"detail":"Network access to XiaoHongShu endpoints, proxy support, reverse-engineered request signing, browser fingerprint generation, and authenticated session handling are partly purpose-aligned, but the scope is broad and includes platform anti-abuse and engagement-manipulation behavior.","label":"Credentials","name":"environment_proportionality","rating":"concern"},{"detail":"No install hook or persistence mechanism was found, but the documentation tells users to install unpinned Python dependencies with pip, which leaves supply-chain and reproducibility risk.","label":"Install Mechanism","name":"install_mechanism","rating":"note"},{"detail":"SKILL.md discloses web_session use, follow, and like operations, but it does not clearly warn that cookies are account credentials, that social actions and comment deletion mutate account-visible state, or that phone numbers and telemetry are sent to XiaoHongShu endpoints.","label":"Instruction Scope","name":"instruction_scope","rating":"concern"},{"detail":"No OS-level persistence or background worker was found, but the code logs raw web_session cookies on several error paths and uses unrestricted eval() when reading local configuration, creating credential exposure and code-execution risk if the config is modified.","label":"Persistence & Privilege","name":"persistence_privilege","rating":"concern"},{"detail":"The stated scraping and interaction purpose broadly matches the API wrappers, but the artifact also includes underdocumented comment posting/deletion, a hidden add_note_readnum flow that submits metrics to increase reads, and QR security-challenge handling beyond ordinary data collection.","label":"Purpose & Capability","name":"purpose_capability","rating":"concern"}],"guidance":"Only install after reviewing the code and accepting the account and platform-policy risks. Treat web_session as a password-equivalent secret, avoid putting it in chats or logs, remove or disable the read-count metrics flow, add explicit confirmation for all follow/like/comment/delete actions, replace eval() config parsing, redact cookies from logs, and pin dependencies before use.","findings":"[TP4] expected: Downgraded as a chunk-level mismatch: the full artifact does contain note, comment, auth, and user API modules matching much of the declared XiaoHongShu toolkit, though some extra capabilities are underdocumented.\n[SDI-1] unexpected: Accepted for add_note_readnum: the code explicitly attempts to increase a note's read count by sending enter/exit metrics with randomized dwell behavior, which is not disclosed in SKILL.md and is not necessary for collection.\n[SDI-1] unexpected: Partially accepted for security-challenge handling: the generic request retry path invokes pass_scan_124 and resubmits blocked requests when sid/did are available, making anti-abuse handling implicit even though the current helper still requires external scan integration.\n[T09] unexpected: Accepted: xhs_session.py logs raw web_session values in muted, timeout, permission, banned, and blocked response branches, exposing an authentication cookie through logs.\n[AST2] unexpected: Accepted as unsafe coding practice: config.py calls eval() on values from web_encrypt_config.ini, which can become arbitrary Python execution if that local config is changed or replaced.\n[SDI-2] unexpected: Accepted: XhsFpGenerator.py overwrites generated fingerprint data with a static captured-looking object containing fixed a1, webId, URL, and browser-state fields.\n[SQP-2] expected: Accepted as under-disclosure rather than standalone maliciousness: authenticated social actions are part of the stated interaction toolkit, but the docs lack clear consent, logging, and account-impact warnings.\n[T08] unexpected: Accepted as a supply-chain note: pip install instructions use mutable package names without pinned versions or hashes; no evidence showed the named packages are currently malicious.\n[MP2] expected: Downgraded: the repeated pipe-delimited zero strings appear to be browser fingerprint/environment fields, not prompt or context-window stuffing instructions.","agenticRiskFindings":null,"riskSummary":null,"model":null,"checkedAt":1789030459036}}}}}