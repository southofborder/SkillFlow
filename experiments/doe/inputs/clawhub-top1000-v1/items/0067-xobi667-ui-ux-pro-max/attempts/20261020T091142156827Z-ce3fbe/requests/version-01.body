stacks/react-native.csv","size":10035,"sha256":"a08ca77fcf6b6d9531982dce465366296013bfcf12d2938ac72ad57cf0c4f085","contentType":"text/csv"},{"path":"data/stacks/react.csv","size":13016,"sha256":"b6e3eb0e4c9c01bd00ffb951d5ca224a19d488b4544c75436f48cf92ff12bf45","contentType":"text/csv"},{"path":"data/stacks/shadcn.csv","size":15921,"sha256":"395c2e415ef6f48a474acccdc8eb2c7258a6ed751a5037ba171a2d8823e02ded","contentType":"text/csv"},{"path":"data/stacks/svelte.csv","size":11063,"sha256":"bc8d158994a8bdf412830a9dd5e5a5534edd2f367a6e50e0ebd4d76f592dfa3f","contentType":"text/csv"},{"path":"data/stacks/swiftui.csv","size":10872,"sha256":"e87cb9eee208bb753bdab96d4a261c7f830c4317ee90ec098316b248fc32be85","contentType":"text/csv"},{"path":"data/stacks/vue.csv","size":11056,"sha256":"9b793c3f4eec85f77a758c09322f2b62f3b3ca549bb713ccf0849ef885934395","contentType":"text/csv"},{"path":"data/styles.csv","size":96553,"sha256":"ad3c3236134d833bda01a2faf31ddeaaa1dbd5005fa430dec571fa91b26e5fea","contentType":"text/csv"},{"path":"data/typography.csv","size":31877,"sha256":"64695e05ac335ba534aff396c4ba9241c642f80ea53b424251d2669b71c4772b","contentType":"text/csv"},{"path":"data/ui-reasoning.csv","size":31071,"sha256":"58fc52fff69f62709f8c7dd460de6f6693699ea820f24287f3301a427c2b554e","contentType":"text/csv"},{"path":"data/ux-guidelines.csv","size":18766,"sha256":"1870ee048f2a2bdd60709f8f7adf7f3b6dcad560bc005c8b2915a8ac8639820d","contentType":"text/csv"},{"path":"data/web-interface.csv","size":7472,"sha256":"10bfc24e09a6a15db8309e6ef9b6881e1d4af97dffb7c99418aefb8e30df7d54","contentType":"text/csv"},{"path":"references/upstream-README.md","size":23615,"sha256":"b8cca8dbb183bcf81c03a66a7ca5ad8b7259cd38bee2232cabb65c1b4acf435b","contentType":"text/markdown"},{"path":"references/upstream-skill-content.md","size":10051,"sha256":"4e495d54b006e2132248f21a7886e8c5400a2d09cddf478c0525582519a5ad3b","contentType":"text/markdown"},{"path":"scripts/__init__.py","size":0,"sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","contentType":"text/plain"},{"path":"scripts/core.py","size":10227,"sha256":"5459d1f04eea03dfb913742d0c03edc5065ac67f6227e4807fa87699662588cb","contentType":"text/plain"},{"path":"scripts/design_system.py","size":43778,"sha256":"1f8d1961c9166fe4772522d6458f6a1ec13a7c00ebfd5effa41c47e1c7cc9e7a","contentType":"text/plain"},{"path":"scripts/search.py","size":5383,"sha256":"8ef258d6aed922f4b813b5ac21e8f484dec71fede9409f949224d75adbd82df5","contentType":"text/plain"},{"path":"skill-card.md","size":2232,"sha256":"32cc46f36bea987ba9a3afe9b61a6a11693ac27d1206a996348b9a01080829ed","contentType":"text/markdown"}],"security":{"status":"suspicious","hasWarnings":true,"checkedAt":1789023085814,"model":null,"hasScanResult":true,"sha256hash":"723568514fbc12dcac9094d35ffa844d9904e27114e4982b9cba4620d6ed0c20","virustotalUrl":"https://www.virustotal.com/gui/file/723568514fbc12dcac9094d35ffa844d9904e27114e4982b9cba4620d6ed0c20","scanners":{"vt":{"status":"clean","verdict":"benign","normalizedStatus":"clean","analysis":"Type: OpenClaw Skill\nName: ui-ux-pro-max\nVersion: 0.1.0\n\nThe skill bundle is designed for UI/UX design intelligence and implementation guidance. The Python scripts (`core.py`, `design_system.py`, `search.py`) perform text searches on bundled CSV data and generate structured markdown design system files. While the `design_system.py` script can write files (`MASTER.md`, `pages/*.md`) to the current working directory or a specified output directory, this functionality is aligned with the stated purpose of 'persisting design system' and does not exhibit path traversal vulnerabilities due to `pathlib.Path` usage and basic sanitization. No evidence of data exfiltration, malicious execution, persistence, or obfuscation was found. Markdown instructions in `SKILL.md` and `references/upstream-skill-content.md` guide the AI agent to use the Python scripts for their intended purpose without attempting to subvert the agent's behavior.","source":"palm","checkedAt":1779160217405},"skillspector":{"status":"suspicious","normalizedStatus":"suspicious","score":100,"severity":"CRITICAL","recommendation":"DO_NOT_INSTALL","issueCount":93,"checkedAt":1789023085814},"llm":{"status":"suspicious","verdict":"suspicious","normalizedStatus":"suspicious","confidence":"medium","summary":"This is mostly a UI/UX helper skill, but its bundled docs and scripts include broad installation and file-writing behavior that should be reviewed before use.","dimensions":[{"detail":"Reading bundled assets and running a local Python search script is proportionate for the skill's purpose; package-manager examples in data files should still be treated as commands requiring user confirmation.","label":"Credentials","name":"environment_proportionality","rating":"note"},{"detail":"Bundled upstream installation docs recommend an unpinned global npm install of uipro-cli and include an option to initialize all supported AI assistants, which can modify multiple assistant environments without precise file-scope disclosure.","label":"Install Mechanism","name":"install_mechanism","rating":"concern"},{"detail":"Runtime guidance includes optional local script execution and upstream instructions that encourage generating and persisting design-system files, but the skill does not define clear permission boundaries or approval gates for writes.","label":"Instruction Scope","name":"instruction_scope","rating":"concern"},{"detail":"The --persist path writes and overwrites Markdown files using user-controlled output_dir, project name, and page name without containment checks, creating a path-traversal and unintended overwrite risk.","label":"Persistence & Privilege","name":"persistence_privilege","rating":"concern"},{"detail":"The stated purpose, bundled CSV guidance, and Python search/design-system scripts coherently support UI/UX design and frontend implementation guidance.","label":"Purpose & Capability","name":"purpose_capability","rating":"note"}],"guidance":"Install only if you are comfortable with a UI helper that may run local Python scripts and produce design-system files. Avoid the unpinned global CLI path unless you trust the current uipro-cli release, prefer scoped/offline installation, do not use all-assistant initialization casually, and review any --persist output path, project name, and page name before allowing writes.","findings":"[OH1] expected: The flagged dangerouslySetInnerHTML strings are instructional UI examples, including a bad example for unsanitized user input, not active model-output injection in the skill runtime.\n[PE3] expected: The .env and .env.local mentions are framework guidance about handling secrets, not code that reads credential files.\n[P1] expected: The phrase Override system appears in UX guidance about mobile gesture conflicts, not an attempt to override agent or system instructions.\n[TM2] expected: The sudo command chain is a visible Python prerequisite installation example, not hidden tool-chaining behavior.\n[P6] expected: The return rule matches are ordinary Python returns of CSV-derived UI rules, not system-prompt extraction.\n[LP3] expected: Bundled file reads and optional script execution fit the UI guidance purpose, but the lack of explicit execution/write boundaries contributes to review concern.\n[RP1] expected: The npx and @latest examples are frontend setup guidance, but they are mutable package-execution examples that users should approve and pin where practical.\n[T09] unexpected: The design-system persistence feature is purpose-aligned, but unsanitized path components and overwrite behavior are not necessary for that purpose.\n[T08] unexpected: The upstream README's unpinned global CLI install and all-assistant initialization are broader than needed for installing this reviewed skill package.","agenticRiskFindings":null,"riskSummary":null,"model":null,"checkedAt":1789023085814}}}}}