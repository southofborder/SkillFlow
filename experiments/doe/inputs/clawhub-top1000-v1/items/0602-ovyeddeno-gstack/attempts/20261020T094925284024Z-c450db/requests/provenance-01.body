d_line":81}]},{"id":"SDI-4","finding_id":"finding-5fbdf32c7fec42e895409eecbc485ebc","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"qa-only/SKILL.md","start_line":117,"end_line":121},"finding":null,"explanation":"The skill is framed as report-only QA, but its setup path can change the host by building tooling and installing dependencies. That mismatch can surprise users into allowing environment modification, and when combined with later curl-to-shell behavior it materially increases supply-chain and host-compromise risk.","remediation":"Separate environment setup from the QA skill. Require prerequisites to be installed out-of-band, or provide a distinct setup skill with explicit security warnings, consent gates, version pinning, and checksum/signature verification.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"qa-only/SKILL.md","start_line":117,"end_line":121}]},{"id":"SQP-2","finding_id":"finding-4175f73cefb147e6afb8ed6be1f197e7","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.99,"location":{"file":"qa-only/SKILL.md","start_line":120,"end_line":120},"finding":null,"explanation":"`curl -fsSL https://bun.sh/install | bash` downloads and executes a remote script directly in the user's shell. This is a classic supply-chain risk: compromise of the remote host, network path, or installer script can lead to arbitrary code execution on the machine running the skill.","remediation":"Do not pipe remote scripts to a shell. Instruct users to install Bun through trusted package managers or manually downloaded, checksum-verified artifacts; if automation is unavoidable, pin a specific version and verify signatures/checksums before execution.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"qa-only/SKILL.md","start_line":120,"end_line":120}]},{"id":"RA2","finding_id":"finding-1141057f8392446985f52d6bb91