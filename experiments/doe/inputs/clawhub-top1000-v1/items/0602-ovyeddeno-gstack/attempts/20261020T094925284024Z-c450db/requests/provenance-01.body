xtures/eval-baselines.json","type":"json","lines":7,"executable":false,"size_bytes":388,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/fixtures/qa-eval-checkout-ground-truth.json","type":"json","lines":43,"executable":false,"size_bytes":1666,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/fixtures/qa-eval-ground-truth.json","type":"json","lines":43,"executable":false,"size_bytes":1506,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/fixtures/qa-eval-spa-ground-truth.json","type":"json","lines":43,"executable":false,"size_bytes":1605,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/fixtures/review-eval-enum-diff.rb","type":"ruby","lines":30,"executable":true,"size_bytes":986,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/fixtures/review-eval-enum.rb","type":"ruby","lines":27,"executable":true,"size_bytes":759,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/fixtures/review-eval-vuln.rb","type":"ruby","lines":14,"executable":true,"size_bytes":406,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/gen-skill-docs.test.ts","type":"typescript","lines":321,"executable":true,"size_bytes":13011,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/helpers/eval-store.test.ts","type":"typescript","lines":548,"executable":true,"size_bytes":20321,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/helpers/eval-store.ts","type":"typescript","lines":681,"executable":true,"size_bytes":23680,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/helpers/llm-judge.ts","type":"typescript","lines":130,"executable":true,"size_bytes":4295,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/helpers/observability.test.ts","type":"typescript","lines":283,"executable":true,"size_bytes":10117,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/helpers/session-runner.test.ts","type":"typescript","lines":96,"executable":true,"size_bytes":3760,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/helpers/session-runner.ts","type":"typescript","lines":334,"executable":true,"size_bytes":10685,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/helpers/skill-parser.ts","type":"typescript","lines":206,"executable":true,"size_bytes":5766,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/skill-e2e.test.ts","type":"typescript","lines":1675,"executable":true,"size_bytes":67131,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/skill-llm-eval.test.ts","type":"typescript","lines":440,"executable":true,"size_bytes":17779,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/skill-parser.test.ts","type":"typescript","lines":179,"executable":true,"size_bytes":5436,"source_url":null,"source_identity":null,"source_digest":null},{"path":"test/skill-validation.test.ts","type":"typescript","lines":620,"executable":true,"size_bytes":23311,"source_url":null,"source_identity":null,"source_digest":null}],"structured_summaries":[],"issues":[{"id":"PE3","finding_id":"finding-d9e27a48a94d4554a8025cf7d3d00eba","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.97,"location":{"file":"ARCHITECTURE.md","start_line":98,"end_line":null},"finding":"Keychain","explanation":"Accessing the macOS Keychain to derive keys for decrypting browser cookies is credential-access behavior. Although the doc notes user approval prompts and in-memory handling, the capability can still expose authenticated sessions to the tool, which is highly sensitive in the context of an AI-driven browser agent.","remediation":"Eliminate Keychain-backed cookie import by default. Use explicit user-driven authentication inside the automation browser, or require a standalone privileged helper with separate consent, logging, domain restrictions, and a clear security boundary.","code_snippet":"\nCookies are the most sensitive data gstack handles. The design:\n\n1. **Keychain access requires user approval.** First cookie import per browser triggers a macOS Keychain dialog. The user must click \"Allow\" or \"Always Allow.\" gstack never silently accesses credentials.\n\n2. **Decryption happens in-process.** Cookie values are decrypted in memory (PBKDF2 + AES-128-CBC), loaded into the Playwright context, and never written to disk in plaintext. The cookie picker UI never displays cookie values — only domain names and counts.\n","intent":null,"tags":["Privilege Escalation"],"evidence":{},"match_fingerprint":"044e59b8cb232d8d2a59d6f4b1e8fe2b50ce1a35abe47e0398df30fd491b561c","occurrences":[{"file":"ARCHITECTURE.md","start_line":98,"end_line":null}]},{"id":"SDI-2","finding_id":"finding-a41580168e0643abac3c49f5cfa11596","category":null,"pattern":null,"severity":"HIGH","confidence":0.95,"location":{"file":"ARCHITECTURE.md","start_line":98,"end_line":110},"finding":null,"explanation":"The architecture explicitly includes direct access to the macOS Keychain and Chromium cookie databases to decrypt and import browser cookies. Even with local-only design and user approval, this materially expands the skill from QA automation into credential/session access, creating risk of account takeover or sensitive-session misuse if the agent or local process is abused.","remediation":"Remove automatic cookie decryption/import unless absolutely required. Prefer Playwright-managed login flows or explicit user-exported session artifacts; if retained, gate it behind a separate high-friction opt-in, per-use confirmation, strict domain allowlists, auditing, and manifest-level disclosure of credential access.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"ARCHITECTURE.md","start_line":98,"end_line":110}]},{"id":"PE3","finding_id":"finding-ead400f9e1824920bc6dac7925f563ce","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.88,"location":{"file":"ARCHITECTURE.md","start_line":110,"end_line":null},"finding":"Keychain","explanation":"This line confirms continued Keychain access in implementation details. While the use of explicit argument arrays reduces command injection risk, the underlying capability remains sensitive because it enables retrieval of secrets needed to unlock browser-session material.","remediation":"Keep the shell-safe invocation pattern, but redesign to avoid direct Keychain access where possible. If unavoidable, isolate the feature behind explicit opt-in, minimize supported browsers/domains, and record auditable consent events.","code_snippet":"\n### Shell injection prevention\n\nThe browser registry (Comet, Chrome, Arc, Brave, Edge) is hardcoded. Database paths are constructed from known constants, never from user input. Keychain access uses `Bun.spawn()` with explicit argument arrays, not shell string interpolation.\n\n## The ref system\n","intent":null,"tags":["Privilege Escalation"],"evidence":{},"match_fingerprint":"044e59b8cb232d8d2a59d6f4b1e8fe2b50ce1a35abe47e0398df30fd491b561c","occurrences":[{"file":"ARCHITECTURE.md","start_line":110,"end_line":null}]},{"id":"SDI-2","finding_id":"finding-e0169a0c5452487f815f1176593294ee","category":null,"pattern":null,"severity":"HIGH","confidence":0.97,"location":{"file":"BROWSER.md","start_line":69,"end_line":70},"finding":null,"explanation":"Documentation for `cookie-import-browser.ts` states it can decrypt Chromium cookies from real browsers, which can expose live authenticated sessions and sensitive tokens. In an agent skill context, this is especially dangerous because it enables access to accounts outside the narrow QA task boundary without reauthentication.","remediation":"Remove or hard-disable real-browser cookie decryption in the default build, or gate it behind a separate privileged tool with explicit user consent. Require domain allowlists, interactive approval, and warnings that existing browser credentials may be accessed.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"BROWSER.md","start_line":69,"end_line":70}]},{"id":"SDI-2","finding_id":"finding-3f2298a8c8e441b994962adeed967208","category":null,"pattern":null,"severity":"HIGH","confidence":0.98,"location":{"file":"CHANGELOG.md","start_line":15,"end_line":16},"finding":null,"explanation":"A '/document-release' capability that reads every doc file and rewrites project documentation is unrelated to headless browser QA and creates a strong avenue for unintended or adversarial repository modification. In agent contexts, broad autonomous write access to README, CONTRIBUTING, CHANGELOG, and architecture docs can be abused to alter audit trails, insert misleading instructions, or hide risky behavior.","remediation":"Move documentation-rewrite features into a separate explicitly scoped skill with limited write targets and mandatory user confirmation before changes. Add path allowlists, dry-run previews, and approval gates for any cross-repo documentation edits.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"CHANGELOG.md","start_line":15,"end_line":16}]},{"id":"YR1","finding_id":"finding-edae121354e74e8bb1f7ea3b70e15815","category":"YARA Match","pattern":"YARA rule 'agent_skill_destructive_autonomous_actions': Autonomous destructive filesystem, shell history, or repository actions in AI agent skills [agent_skills]","severity":"HIGH","confidence":0.75,"location":{"file":"CHANGELOG.md","start_line":113,"end_line":null},"finding":"git reset --hard; silently; non-interactive; silently","explanation":"YARA rule matched a known malware signature (reverse shell, backdoor, ransomware, C2 framework, or info stealer).","remediation":"Remove the malware payload or compromised file entirely. Investigate how it entered the skill and audit all other artifacts for additional indicators of compromise.","code_snippet":"-line replies.\n- **Greptile escalation detection** — explicit algorithm to detect prior GStack replies on comment threads and auto-escalate to Tier 2.\n- **Greptile severity re-ranking** — replies now include `**Suggested re-rank:**` when Greptile miscategorizes issue severity.\n- Static validation tests for `TODOS-format.md` references across skills.\n\n### Fixed\n- **`.gitignore` append failures silently swallowed** — `ensureStateDir()` bare `catch {}` replaced with ENOENT-only silence; non-ENOENT errors (EACCES, ENOSPC) logged to `.gstack/browse-server.log`.\n\n### Changed\n- `TODO.md` deleted — all items merged into `TODOS.md`.\n- `/ship` Step 3.75 and `/review` Step 5 now reference reply templates and escalation detection from `greptile-triage.md`.\n- `/ship` Step 6 commit ordering includes TODOS.md in the final commit alongside VERSION + CHANGELOG.\n- `/ship` Step 8 PR body includes TODOS section.\n\n## 0.3.7 — 2026-03-14\n\n### Added\n- **Screenshot element/region clipping** — `scre","intent":null,"tags":["YARA Match","llm-unconfirmed"],"evidence":{},"match_fingerprint":"be6b30c3b43717440b0f35c843a41235a5c27bb8c5205072583c23fb8396a04e","occurrences":[{"file":"CHANGELOG.md","start_line":113,"end_line":null}]},{"id":"YR1","finding_id":"finding-b457fcbd29324ab3943e3b4ccbbdddd1","category":"YARA Match","pattern":"YARA rule 'info_stealer': Information stealer patterns (credential harvesting, browser data theft) [malware]","severity":"HIGH","confidence":0.99,"location":{"file":"CHANGELOG.md","start_line":235,"end_line":null},"finding":"cookies from real Chromium browsers (Comet, Chrome, Arc, Brave, Edge","explanation":"The documented ability to extract cookies from real Chromium browsers matches information-stealer behavior because cookies can be used to hijack live authenticated sessions. In the context of an agent skill, this is more dangerous than in a traditional browser utility because the capability can be chained with navigation and automation to impersonate the user on external services.","remediation":"Eliminate browser cookie harvesting from the default skill set, or isolate it into a narrowly scoped tool requiring explicit user initiation, domain scoping, and prominent warnings. Ensure no background enumeration, persistence, or bulk export of browser credentials/cookies is possible.","code_snippet":"e QA examples, and revised demo transcript\n\n### Removed\n- `CONDUCTOR_PORT` magic offset (`browse_port = CONDUCTOR_PORT - 45600`)\n- Port scan range 9400-9409\n- Legacy fallback to `~/.claude/skills/gstack/browse/src/server.ts`\n- `DEVELOPING_GSTACK.md` (renamed to CONTRIBUTING.md)\n\n## 0.3.1 — 2026-03-12\n\n### Phase 3.5: Browser cookie import\n\n- `cookie-import-browser` command — decrypt and import cookies from real Chromium browsers (Comet, Chrome, Arc, Brave, Edge)\n- Interactive cookie picker web UI served from the browse server (dark theme, two-panel layout, domain search, import/remove)\n- Direct CLI import with `--domain` flag for non-interactive use\n- `/setup-browser-cookies` skill for Claude Code integration\n- macOS Keychain access with async 10s timeout (no event loop blocking)\n- Per-browser AES key caching (one Keychain prompt per browser per session)\n- DB lock fallback: copies locked cookie DB to /tmp for safe reads\n- 18 unit tests with encrypted cookie fixtures\n\n## 0.3.0 — 20","intent":null,"tags":["YARA Match"],"evidence":{},"match_fingerprint":"15c4b594ecd0f2834cb1cfa4257563e0c0e4ca05b7c4c843088cfdf10ad221f3","occurrences":[{"file":"CHANGELOG.md","start_line":235,"end_line":null}]},{"id":"PE3","finding_id":"finding-657291429371498e8b3fd09b2a5f9615","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.98,"location":{"file":"CHANGELOG.md","start_line":239,"end_line":null},"finding":"Keychain","explanation":"The changelog explicitly documents decrypting and importing cookies from installed Chromium browsers using macOS Keychain-derived secrets. In an agent skill, browser-cookie extraction is highly sensitive because it can expose authenticated sessions and enable account takeover across websites without user passwords.","remediation":"Remove browser cookie decryption/import from the skill unless it is absolutely required and separately consented to by the user. If retained, restrict it to explicit per-domain user approval, never cache decrypted material longer than needed, redact logs, and require strong consent prompts describing session-theft risk.","code_snippet":"- Interactive cookie picker web UI served from the browse server (dark theme, two-panel layout, domain search, import/remove)\n- Direct CLI import with `--domain` flag for non-interactive use\n- `/setup-browser-cookies` skill for Claude Code integration\n- macOS Keychain access with async 10s timeout (no event loop blocking)\n- Per-browser AES key caching (one Keychain prompt per browser per session)\n- DB lock fallback: copies locked cookie DB to /tmp for safe reads\n- 18 unit tests with encrypted cookie fixtures","intent":null,"tags":["Privilege Escalation"],"evidence":{},"match_fingerprint":"044e59b8cb232d8d2a59d6f4b1e8fe2b50ce1a35abe47e0398df30fd491b561c","occurrences":[{"file":"CHANGELOG.md","start_line":239,"end_line":null}]},{"id":"TM1","finding_id":"finding-88c8813c683a4c3f8f1cccaf172f32e3","category":"Tool Misuse","pattern":"Tool Parameter Abuse","severity":"HIGH","confidence":0.96,"location":{"file":"CHANGELOG.md","start_line":283,"end_line":null},"finding":"git reset --hard","explanation":"Using 'git fetch && git reset --hard' as part of upgrade behavior is destructive because it can discard local changes and forcibly rewrite a working tree. In an agent-operated environment, this is especially dangerous since users may not expect a QA skill to perform irreversible repository state changes during installation or updates.","remediation":"Replace hard resets with non-destructive update flows such as fetching into a separate clone, verifying cleanliness before update, and requiring explicit confirmation if local changes would be lost. Create backups or stashes automatically and present a diff/summary before any repo-altering operation.","code_snippet":"- Cap console/network buffers at 50k entries (ring buffer) instead of growing without bound\n- Fix disk flush stopping silently after buffer hits the 50k cap\n- Fix `ln -snf` in setup to avoid creating nested symlinks on upgrade\n- Use `git fetch && git reset --hard` instead of `git pull` for upgrades (handles force-pushes)\n- Simplify install: global-first with optional project copy (replaces submodule approach)\n- Restructured README: hero, before/after, demo transcript, troubleshooting section\n- Six skills (added `/retro`)","intent":null,"tags":["Tool Misuse"],"evidence":{},"match_fingerprint":"f21f5124192a6ca491d13034d2b1dcaae69642decbd659201773b11a2bc5c2a5","occurrences":[{"file":"CHANGELOG.md","start_line":283,"end_line":null}]},{"id":"TM1","finding_id":"finding-322bf36e9d1f4416bd22242f4fcb91e6","category":"Tool Misuse","pattern":"Tool Parameter Abuse","severity":"HIGH","confidence":0.87,"location":{"file":"CLAUDE.md","start_line":104,"end_line":null},"finding":"rm .claude/skills/gstack`)","explanation":"The instruction `rm .claude/skills/gstack` is a destructive filesystem operation presented inline without safeguards such as verifying the path, warning about consequences, or suggesting a backup. In this skill context, users or agents may execute commands verbatim, so even a narrowly targeted delete can cause loss of a locally installed skill or break active workflows.","remediation":"Replace the raw delete instruction with safer steps: first verify the symlink target, warn that removal affects the active local install, and prefer `mv` to a backup path or explicit unlinking only after confirmation. Document recovery steps if removal is necessary.","code_snippet":"symlink or a real copy. If it's a symlink to your working directory, be aware that:\n- Template changes + `bun run gen:skill-docs` immediately affect all gstack invocations\n- Breaking changes to SKILL.md.tmpl files can break concurrent gstack sessions\n- During large refactors, remove the symlink (`rm .claude/skills/gstack`) so the\n  global install at `~/.claude/skills/gstack/` is used instead\n\n**For plan reviews:** When reviewing plans that modify skill templates or the","intent":null,"tags":["Tool Misuse"],"evidence":{},"match_fingerprint":"f82a48179b3a35432a1950383f1508bca3198033bde807396fb74b016d9645ea","occurrences":[{"file":"CLAUDE.md","start_line":104,"end_line":null}]},{"id":"RA1","finding_id":"finding-ca4c1592971b41439c5361c85a668ee9","category":"Rogue Agent","pattern":"Self-Modification","severity":"HIGH","confidence":0.85,"location":{"file":"CLAUDE.md","start_line":107,"end_line":null},"finding":"modify skill","explanation":"Skill modifies its own code, configuration, or behavior at runtime. Self-modification enables an agent to escalate privileges, disable safety constraints, or install persistent backdoors.","remediation":"Prevent the skill from modifying its own code, SKILL.md, or configuration files. Treat skill files as read-only at runtime.","code_snippet":"- During large refactors, remove the symlink (`rm .claude/skills/gstack`) so the\n  global install at `~/.claude/skills/gstack/` is used instead\n\n**For plan reviews:** When reviewing plans that modify skill templates or the\ngen-skill-docs pipeline, consider whether the changes should be tested in isolation\nbefore going live (especially if the user is actively using gstack in other windows).\n","intent":null,"tags":["Rogue Agent","llm-unconfirmed"],"evidence":{},"match_fingerprint":"91956312ce14a9d7be496702a743a80026ebe5ec6fa1d208fcf1b0afe5eeec1d","occurrences":[{"file":"CLAUDE.md","start_line":107,"end_line":null}]},{"id":"TM1","finding_id":"finding-6cf6ef579edd4613bd5ab4b8a01e7deb","category":"Tool Misuse","pattern":"Tool Parameter Abuse","severity":"HIGH","confidence":0.95,"location":{"file":"CLAUDE.md","start_line":142,"end_line":null},"finding":"git reset --hard","explanation":"`git reset --hard origin/main` is a high-risk destructive command because it forcibly overwrites the working tree and index. In this repository's active-skill deployment workflow, an agent or user following documentation blindly could erase local development changes or deploy the wrong state, making the skill context more dangerous than a passive code comment.","remediation":"Add strong warnings and preconditions before this command: confirm the directory, inspect `git status`, and back up or stash local changes. Prefer safer alternatives such as `git switch`, `git pull --ff-only`, or a documented recovery/rollback process, reserving hard reset for explicitly confirmed break-glass scenarios.","code_snippet":"The active skill lives at `~/.claude/skills/gstack/`. After making changes:\n\n1. Push your branch\n2. Fetch and reset in the skill directory: `cd ~/.claude/skills/gstack && git fetch origin && git reset --hard origin/main`\n3. Rebuild: `cd ~/.claude/skills/gstack && bun run build`\n\nOr copy the binary directly: `cp browse/dist/browse ~/.claude/skills/gstack/browse/dist/browse`","intent":null,"tags":["Tool Misuse"],"evidence":{},"match_fingerprint":"f21f5124192a6ca491d13034d2b1dcaae69642decbd659201773b11a2bc5c2a5","occurrences":[{"file":"CLAUDE.md","start_line":142,"end_line":null}]},{"id":"PE3","finding_id":"finding-6f3fde6e97be427ea9f019e9c36efd33","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.6,"location":{"file":"CONTRIBUTING.md","start_line":106,"end_line":null},"finding":".env\n","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":"\n```bash\n# 1. Copy .env.example and add your API key\ncp .env.example .env\n# Edit .env → set ANTHROPIC_API_KEY=sk-ant-...\n\n# 2. Install deps (if you haven't already)","intent":null,"tags":["Privilege Escalation","contextual-triage","likely-benign-context","llm-unconfirmed"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"CONTRIBUTING.md","start_line":106,"end_line":null}]},{"id":"PE3","finding_id":"finding-c7f9aa12584240ac9c233c1193f75b23","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.6,"location":{"file":"CONTRIBUTING.md","start_line":107,"end_line":null},"finding":".env ","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":"```bash\n# 1. Copy .env.example and add your API key\ncp .env.example .env\n# Edit .env → set ANTHROPIC_API_KEY=sk-ant-...\n\n# 2. Install deps (if you haven't already)\nbun install","intent":null,"tags":["Privilege Escalation","llm-unconfirmed"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"CONTRIBUTING.md","start_line":107,"end_line":null}]},{"id":"PE3","finding_id":"finding-c7f9aa12584240ac9c233c1193f75b23","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.6,"location":{"file":"CONTRIBUTING.md","start_line":191,"end_line":null},"finding":".env ","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":"```bash\n# 1. Copy .env.example and add your API key\ncp .env.example .env\n# Edit .env → set ANTHROPIC_API_KEY=sk-ant-...\n\n# 2. Install deps (if you haven't already)\nbun install","intent":null,"tags":["Privilege Escalation","llm-unconfirmed"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"CONTRIBUTING.md","start_line":191,"end_line":null}]},{"id":"TM1","finding_id":"finding-d099d22dc09a440dbf2463fc9e7633b4","category":"Tool Misuse","pattern":"Tool Parameter Abuse","severity":"HIGH","confidence":0.85,"location":{"file":"CONTRIBUTING.md","start_line":268,"end_line":null},"finding":"rm .claude/skills/gstack","explanation":"Tool parameters are crafted to achieve unintended or unsafe behavior. Parameter abuse can bypass intended safety checks (e.g. shell=True, --force, dangerous glob patterns).","remediation":"Validate all tool parameters against an allowlist. Reject dangerous parameter values (shell=True, --force, -rf /) and use safe defaults.","code_snippet":"**To go back to the stable global install**, just remove the symlink:\n\n```bash\nrm .claude/skills/gstack\n```\n\nClaude Code falls back to `~/.claude/skills/gstack/` automatically.","intent":null,"tags":["Tool Misuse","llm-unconfirmed"],"evidence":{},"match_fingerprint":"878afaa8f0ff8f2b93f0ddcbf0caffb52f5ba736d9dac259a77bb6ba89bb8d1c","occurrences":[{"file":"CONTRIBUTING.md","start_line":268,"end_line":null}]},{"id":"YR1","finding_id":"finding-9a06b57679ce4c4eb9a9d82c1ddd6f5b","category":"YARA Match","pattern":"YARA rule 'info_stealer': Information stealer patterns (credential harvesting, browser data theft) [malware]","severity":"HIGH","confidence":0.86,"location":{"file":"README.md","start_line":27,"end_line":null},"finding":"cookies` | Session manager | Import cookies from your real browser (Comet, Chrome, Arc, Brave, Edge; cookies from your real browser (Comet, Chrome, Arc, Brave, Edge; cookies for staging.myapp.com from","explanation":"The cookie-import capability is a legitimate QA feature, but it matches information-stealer behavior because it imports decrypted browser cookies from real user browsers into another tool. In this context the feature is not necessarily malware, but it materially increases credential/session theft risk if abused, compromised, or used on sensitive accounts.","remediation":"Treat cookie import as a high-risk capability: add explicit consent and privacy warnings, limit supported domains/environments, document exactly how cookies are decrypted, stored, and cleared, and require strong guardrails such as ephemeral storage, audit logs, and easy session purge. Consider safer alternatives like test-account login flows or browser-profile isolation instead of importing real sessions.","code_snippet":"ll QA pass in 60 seconds. |\n| `/qa` | QA + fix engineer | Test app, find bugs, fix them with atomic commits, re-verify. Before/after health scores and ship-readiness summary. Three tiers: Quick, Standard, Exhaustive. |\n| `/qa-only` | QA reporter | Report-only QA testing. Same methodology as /qa but never fixes anything. Use when you want a pure bug report without code changes. |\n| `/setup-browser-cookies` | Session manager | Import cookies from your real browser (Comet, Chrome, Arc, Brave, Edge) into the headless session. Test authenticated pages without logging in manually. |\n| `/retro` | Engineering manager | Team-aware retro: your deep-dive + per-person praise and growth opportunities for every contributor. |\n| `/document-release` | Technical writer | Update README, ARCHITECTURE, CONTRIBUTING, and project docs to match what you just shipped. |\n\n## Demo: one feature, five modes\n\nI start almost every feature in plan mode. I describe what I want to build, then use `/plan-ceo-review` to","intent":null,"tags":["YARA Match"],"evidence":{},"match_fingerprint":"8a7a1aff5347a639c6207751014e1523ccd4b26ad3fde34a9722495c9d86637b","occurrences":[{"file":"README.md","start_line":27,"end_line":null}]},{"id":"TM1","finding_id":"finding-1d7a2bf0c92c477b95f98452dbabcb66","category":"Tool Misuse","pattern":"Tool Parameter Abuse","severity":"HIGH","confidence":0.85,"location":{"file":"README.md","start_line":112,"end_line":null},"finding":"rm -rf .claude/skills/gstack/.git","explanation":"The command `rm -rf .claude/skills/gstack/.git` is intentionally scoped, but it still encourages destructive deletion in a chained setup command. While not obviously malicious, it can be unsafe in automated or copied contexts and normalizes unrestricted recursive deletion instead of safer repository-handling practices.","remediation":"Use a safer copy/export process that excludes VCS metadata without deleting afterward, such as archiving/exporting the source tree or using copy options that omit `.git`. If deletion remains necessary, separate it into a clearly explained step with path verification.","code_snippet":"\n### Step 2: Add to your repo so teammates get it (optional)\n\n> Add gstack to this project: run `cp -Rf ~/.claude/skills/gstack .claude/skills/gstack && rm -rf .claude/skills/gstack/.git && cd .claude/skills/gstack && ./setup` then add a \"gstack\" section to this project's CLAUDE.md that says to use the /browse skill from gstack for all web browsing, never use mcp\\_\\_claude-in-chrome\\_\\_\\* tools, lists the available skills: /plan-ceo-review, /plan-eng-review, /review, /ship, /browse, /qa, /setup-browser-cookies, /retro, /document-release, and tells Claude that if gstack skills aren't working, run `cd .claude/skills/gstack && ./setup` to build the binary and register skills.\n\nReal files get committed to your repo (not a submodule), so `git clone` just works. The binary and node\\_modules are gitignored — teammates just need to run `cd .claude/skills/gstack && ./setup` once to build (or `/browse` handles it automatically on first use).\n","intent":null,"tags":["Tool Misuse"],"evidence":{},"match_fingerprint":"8ec5171c48f4a2ffda18a92f9b5528e997035d9fd67c8e463002b3f98fa4df7e","occurrences":[{"file":"README.md","start_line":112,"end_line":null}]},{"id":"TM2","finding_id":"finding-a81afb51198341a0b82424adedd309da","category":"Tool Misuse","pattern":"Chaining Abuse","severity":"HIGH","confidence":0.87,"location":{"file":"README.md","start_line":112,"end_line":null},"finding":"&& rm -","explanation":"The setup command chains copy, delete, directory change, and execution in one line. Chaining destructive and executable operations reduces the chance a user notices an unsafe intermediate step and makes recovery harder if an early command acts on the wrong path.","remediation":"Split the chained command into numbered steps with explanations and verification points between them. Avoid combining file overwrite, deletion, and script execution in a single paste-ready line.","code_snippet":"\n### Step 2: Add to your repo so teammates get it (optional)\n\n> Add gstack to this project: run `cp -Rf ~/.claude/skills/gstack .claude/skills/gstack && rm -rf .claude/skills/gstack/.git && cd .claude/skills/gstack && ./setup` then add a \"gstack\" section to this project's CLAUDE.md that says to use the /browse skill from gstack for all web browsing, never use mcp\\_\\_claude-in-chrome\\_\\_\\* tools, lists the available skills: /plan-ceo-review, /plan-eng-review, /review, /ship, /browse, /qa, /setup-browser-cookies, /retro, /document-release, and tells Claude that if gstack skills aren't working, run `cd .claude/skills/gstack && ./setup` to build the binary and register skills.\n\nReal files get committed to your repo (not a submodule), so `git clone` just works. The binary and node\\_modules are gitignored — teammates just need to run `cd .claude/skills/gstack && ./setup` once to build (or `/browse` handles it automatically on first use).\n","intent":null,"tags":["Tool Misuse"],"evidence":{},"match_fingerprint":"da42bed49ba667f4edac8a3628fa28e5cc6bbc20fc757fb7d1ddbddd9a531ec0","occurrences":[{"file":"README.md","start_line":112,"end_line":null}]},{"id":"SC2","finding_id":"finding-323c02a501174832918c6f6d61f3eacd","category":"Supply Chain","pattern":"External Script Fetching","severity":"HIGH","confidence":0.96,"location":{"file":"README.md","start_line":629,"end_line":null},"finding":"curl -fsSL https://bun.sh/install | bash","explanation":"The README recommends `curl -fsSL https://bun.sh/install | bash`, which executes a remotely fetched script directly in the shell without verification or pinning. If the remote endpoint, transport, or served script is compromised, users could execute arbitrary code on their machine during installation.","remediation":"Replace pipe-to-shell installation guidance with a safer method: package-manager installs, downloading a version-pinned installer and verifying checksum/signature, or clearly documenting the trust implications. At minimum, separate download and review from execution and pin to a specific release.","code_snippet":"Run `/gstack-upgrade` — it updates both the global install and any vendored project copy automatically.\n\n**`bun` not installed?**\nInstall it: `curl -fsSL https://bun.sh/install | bash`\n\n## Upgrading\n","intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"e7c1bd5dac6d6024151481e2c2ae15f435382f837912f64adae5d7e7c01042c0","occurrences":[{"file":"README.md","start_line":629,"end_line":null}]},{"id":"TM1","finding_id":"finding-ce60c526e98a45beab624dc69c140977","category":"Tool Misuse","pattern":"Tool Parameter Abuse","severity":"HIGH","confidence":0.97,"location":{"file":"README.md","start_line":641,"end_line":null},"finding":"rm -rf ~","explanation":"This is another instance of the same global recursive deletion command. The risk remains high because the README encourages direct execution and the skill ecosystem may execute shell instructions with limited human scrutiny.","remediation":"Consolidate uninstall into a reviewed script or documented manual steps with confirmations, target verification, and non-destructive defaults.","code_snippet":"\nPaste this into Claude Code:\n\n> Uninstall gstack: remove the skill symlinks by running `for s in browse plan-ceo-review plan-eng-review review ship retro qa qa-only setup-browser-cookies document-release; do rm -f ~/.claude/skills/$s; done` then run `rm -rf ~/.claude/skills/gstack` and remove the gstack section from CLAUDE.md. If this project also has gstack at .claude/skills/gstack, remove it by running `for s in browse plan-ceo-review plan-eng-review review ship retro qa qa-only setup-browser-cookies document-release; do rm -f .claude/skills/$s; done && rm -rf .claude/skills/gstack` and remove the gstack section from the project CLAUDE.md too.\n\n## Development\n","intent":null,"tags":["Tool Misuse"],"evidence":{},"match_fingerprint":"26e22f4cfd2aa77cd384519bed5efdd6f6dba6aab2e61d67ae29c1cbcadc466e","occurrences":[{"file":"README.md","start_line":641,"end_line":null}]},{"id":"TM1","finding_id":"finding-0b7b5804f3ae4739a197debe72e9f194","category":"Tool Misuse","pattern":"Tool Parameter Abuse","severity":"HIGH","confidence":0.97,"location":{"file":"README.md","start_line":641,"end_line":null},"finding":"rm -f ~/.claude/skills/$s","explanation":"This is another instance of the same global recursive deletion command. The risk remains high because the README encourages direct execution and the skill ecosystem may execute shell instructions with limited human scrutiny.","remediation":"Consolidate uninstall into a reviewed script or documented manual steps with confirmations, target verification, and non-destructive defaults.","code_snippet":"\nPaste this into Claude Code:\n\n> Uninstall gstack: remove the skill symlinks by running `for s in browse plan-ceo-review plan-eng-review review ship retro qa qa-only setup-browser-cookies document-release; do rm -f ~/.claude/skills/$s; done` then run `rm -rf ~/.claude/skills/gstack` and remove the gstack section from CLAUDE.md. If this project also has gstack at .claude/skills/gstack, remove it by running `for s in browse plan-ceo-review plan-eng-review review ship retro qa qa-only setup-browser-cookies document-release; do rm -f .claude/skills/$s; done && rm -rf .claude/skills/gstack` and remove the gstack section from the project CLAUDE.md too.\n\n## Development\n","intent":null,"tags":["Tool Misuse"],"evidence":{},"match_fingerprint":"2f30a0a2331e861e8120a87317d0770953d53d4a32ad2711af98bef555eebbf0","occurrences":[{"file":"README.md","start_line":641,"end_line":null}]},{"id":"TM1","finding_id":"finding-3e54daf5d46c4fff9909dde4cb473212","category":"Tool Misuse","pattern":"Tool Parameter Abuse","severity":"HIGH","confidence":0.97,"location":{"file":"README.md","start_line":641,"end_line":null},"finding":"rm -rf ~/.claude/skills/gstack`","explanation":"This is another instance of the same global recursive deletion command. The risk remains high because the README encourages direct execution and the skill ecosystem may execute shell instructions with limited human scrutiny.","remediation":"Consolidate uninstall into a reviewed script or documented manual steps with confirmations, target verification, and non-destructive defaults.","code_snippet":"\nPaste this into Claude Code:\n\n> Uninstall gstack: remove the skill symlinks by running `for s in browse plan-ceo-review plan-eng-review review ship retro qa qa-only setup-browser-cookies document-release; do rm -f ~/.claude/skills/$s; done` then run `rm -rf ~/.claude/skills/gstack` and remove the gstack section from CLAUDE.md. If this project also has gstack at .claude/skills/gstack, remove it by running `for s in browse plan-ceo-review plan-eng-review review