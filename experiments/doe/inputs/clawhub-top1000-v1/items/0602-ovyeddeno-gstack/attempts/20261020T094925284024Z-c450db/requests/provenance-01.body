:"application/json"},{"path":"test/fixtures/qa-eval-spa-ground-truth.json","size":1605,"sha256":"eaad3ebe7819e0ff971412067395e09453f06299451b4c9deca69df806b7da90","contentType":"application/json"},{"path":"test/fixtures/review-eval-enum-diff.rb","size":986,"sha256":"8bf2973e31c4e8f5c1556d78a98a80f4f17ed42ea2db6efd3022d05bbdb434f8","contentType":"text/plain"},{"path":"test/fixtures/review-eval-enum.rb","size":759,"sha256":"187bce6ae3965282c0a009b8186dd28d49343512e47e07430a52d4f85ac3ed26","contentType":"text/plain"},{"path":"test/fixtures/review-eval-vuln.rb","size":406,"sha256":"6647dd1d8a20938b4220a1321b6e419d4b9bdd562189dde3873d7effc7940bf9","contentType":"text/plain"},{"path":"test/gen-skill-docs.test.ts","size":13011,"sha256":"95ddbd13ce17c9a44c2f4f7c7c45e1ac74202e486b4a200a3c16ed3ec3ac5341","contentType":"video/mp2t"},{"path":"test/helpers/eval-store.test.ts","size":20321,"sha256":"59b81e886ffe482d50f69b6127fb487487301a50cea185c4744d526f463ed44a","contentType":"video/mp2t"},{"path":"test/helpers/eval-store.ts","size":23680,"sha256":"05590b67420a0c4686454b0f26b4c26860b603ffeea82fb60d21cd3d8c1edc67","contentType":"video/mp2t"},{"path":"test/helpers/llm-judge.ts","size":4295,"sha256":"706079ee80337ffdf5bdbbfc6ec3a1be3290ba18afe850647f2f09dcdf56f9eb","contentType":"video/mp2t"},{"path":"test/helpers/observability.test.ts","size":10117,"sha256":"52ae5f069a2674f6dddde89f0d70adb092ab12fca8750804617e09ee6efbffb8","contentType":"video/mp2t"},{"path":"test/helpers/session-runner.test.ts","size":3760,"sha256":"32642aca0bc67e3418cb38f7e391069563014f82add26616adb34da1db49d0ee","contentType":"video/mp2t"},{"path":"test/helpers/session-runner.ts","size":10685,"sha256":"5217b988a518ff84c30a0339e46c7ef2429df2d07d447a230e9086b685073dac","contentType":"video/mp2t"},{"path":"test/helpers/skill-parser.ts","size":5766,"sha256":"6f40d1b7a96ae6269eda5c74a8bc792741465a125899da8333f176e27465ddec","contentType":"video/mp2t"},{"path":"test/skill-e2e.test.ts","size":67131,"sha256":"9f03e69b156e80b7a7f96599c5eee4447132531bd73a87ac22b12ffecedf245b","contentType":"video/mp2t"},{"path":"test/skill-llm-eval.test.ts","size":17779,"sha256":"8c33050592044a06d430f6152b0a3369f5b2dc6b8c338cca6bfab54de2747b66","contentType":"video/mp2t"},{"path":"test/skill-parser.test.ts","size":5436,"sha256":"e8fb66c6b897d3e4bf356223aaad418bdca8ec7380d18ad2162ef15045b212dd","contentType":"video/mp2t"},{"path":"test/skill-validation.test.ts","size":23311,"sha256":"db2da59ef778605f2ce372c1b66652dc6ac73911d6107abdee843322773c3923","contentType":"video/mp2t"}]},"provenance":{"source":"unavailable","reason":"No server-resolved GitHub import provenance is stored for this version."},"security":{"status":"suspicious","passed":false,"rawStatus":"suspicious","verdict":"suspicious","confidence":"high","summary":"This skill is a powerful QA/browser automation toolkit, but it also handles real browser sessions and self-updates in ways that need careful review before installation.","model":null,"checkedAt":1789192005285,"scannerReports":{"aig":{"version":"2.1.0","$schema":"https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/Schemata/sarif-schema-2.1.0.json","runs":[{"tool":{"driver":{"name":"aig-skill-scan","version":"0.2.1","informationUri":"https://github.com/Tencent/AI-Infra-Guard","rules":[{"id":"T01","name":"Skill Instruction Hijacking","shortDescription":{"text":"Alters the agent's current session goals or safety constraints when the skill is loaded"}},{"id":"T02","name":"Agent Memory Poisoning","shortDescription":{"text":"Writes attacker-controlled rules into persistent memory so they continue to affect future sessions"}},{"id":"T03","name":"Remote Payload Retrieval and Execution","shortDescription":{"text":"Fetches code from an external URL, allowing the effective payload to change after skill review"}},{"id":"T04","name":"Embedded Malicious Code","shortDescription":{"text":"Ships malicious scripts inside the skill package and executes them locally when invoked"}},{"id":"T05","name":"Unauthorized Access and Privilege Escalation","shortDescription":{"text":"Breaks least-privilege boundaries by obtaining permissions beyond the task's legitimate needs"}},{"id":"T06","name":"System Persistence","shortDescription":{"text":"Installs cross-session backdoors, hooks, services, or scheduled tasks that survive the skill run"}},{"id":"T07","name":"Tool Hijacking and Spoofing","shortDescription":{"text":"Modifies, wraps, spoofs, or replaces tools so legitimate-looking calls execute attacker logic"}},{"id":"T08","name":"Insecure Dependencies","shortDescription":{"text":"Introduces malicious packages or components through dependency confusion, typosquatting, or unsafe sources"}},{"id":"T09","name":"Insecure Skill Coding Practices","shortDescription":{"text":"Exposes exploitable flaws such as hardcoded secrets, command injection, plaintext sensitive data, or unsafe temp files"}},{"id":"other","name":"Other Risk","shortDescription":{"text":"Security issues not covered by the T01-T09 classification"}}]}},"results":[{"ruleId":"T03","level":"error","message":{"text":"Unverified Remote Code Execution Through Installation and Upgrade Workflows"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"SKILL.md"},"region":{"startLine":101,"endLine":106}}}],"partialFingerprints":{"primaryLocationLineHash":"4e38d13771ffcbe5"},"properties":{"description":"<![CDATA[\n## Vulnerability Details\n**File Location**: `SKILL.md:101-106`; duplicated in `browse/SKILL.md:101-106`, `setup-browser-cookies/SKILL.md:108-113`, `qa/SKILL.md:153-158`, `qa-only/SKILL.md:115-120`, and `README.md:629`; related upgrade behavior in `gstack-upgrade/SKILL.md:112-130`  \n**Vulnerability Type**: Remote payload retrieval and execution  \n**Risk Level**: High\n\n### Vulnerable Code\n\n```bash\nIf `NEEDS_SETUP`:\n1. Tell the user: \"gstack browse needs a one-time build (~10 seconds). OK to proceed?\" Then STOP and wait.\n2. Run: `cd <SKILL_DIR> && ./setup`\n3. If `bun` is not installed: `curl -fsSL https://bun.sh/install | bash`\n```\n\nThe upgrade workflow additionally retrieves mutable repository content and immediately executes it:\n\n```bash\ncd \"$INSTALL_DIR\"\nSTASH_OUTPUT=$(git stash 2>&1)\ngit fetch origin\ngit reset --hard origin/main\n./setup\n```\n\nFor vendored installations:\n\n```bash\nPARENT=$(dirname \"$INSTALL_DIR\")\nTMP_DIR=$(mktemp -d)\ngit clone --depth 1 https://github.com/garrytan/gstack.git \"$TMP_DIR/gstack\"\nmv \"$INSTALL_DIR\" \"$INSTALL_DIR.bak\"\nmv \"$TMP_DIR/gstack\" \"$INSTALL_DIR\"\ncd \"$INSTALL_DIR\" && ./setup\nrm -rf \"$INSTALL_DIR.bak\" \"$TMP_DIR\"\n```\n\n### Technical Analysis\n\nThe `curl | bash` pattern passes remotely retrieved content directly to a shell. No immutable version, expected digest, or cryptographic signature is verified before execution. Consequently, the effective code can change after the Skill package has been reviewed.\n\nThe upgrade workflow has the same trust-boundary problem: it resets the installation to the mutable `origin/main` branch or clones the current repository head and then immediately runs `./setup`. The workflow can also be configured to upgrade automatically, removing per-update user review.\n\nThe referenced `setup` executable is not present in the supplied artifact. Its behavior and privilege requirements therefore could not be audited, even though multiple instructions require its execution.\n\n### Attack Path\n\n1. An attacker compromises the Bun installation endpoint, its hosting account, the upstream gstack repository, or an authorized maintainer account.\n2. The attacker changes the served installer or the repository's mutable `main` branch.\n3. A user invokes setup, encounters the missing-Bun path, or has automatic gstack upgrades enabled.\n4. The agent pipes the changed installer into Bash or retrieves the changed repository and invokes `./setup`.\n5. The payload executes with all filesystem, network, credential, and process privileges available to the agent's operating-system account.\n\n### Impact Assessment\n\nSuccessful exploitation provides arbitrary code execution as the current user. The payload could read source repositories and user files, access environment credentials, modify Claude configuration and Skills, establish persistence, or transmit sensitive information. The blast radius includes both the current project and user-level locations accessible to the agent, including `~/.claude` and `~/.gstack`.\n]]>","severity":"High"},"fixes":[{"description":{"text":"<![CDATA[\n## Remediation Suggestions\n\n1. Remove direct `curl | bash` instructions. Download the installer to a temporary file, verify it, display its origin, and execute it only after explicit approval.\n2. Pin Bun to a specific release and verify a published SHA-256 digest or cryptographic signature.\n3. Upgrade from signed, immutable release tags or commit hashes rather than `origin/main`.\n4. Verify signed Git tags or release attestations before invoking any code from an update.\n5. Disable automatic execution of newly downloaded `./setup` code. Require approval after showing the exact version, commit, and verification result.\n6. Include every executable referenced by the Skill, particularly `setup` and update-check binaries, in the auditable artifact.\n7. Use a rollback process that does not delete the backup until setup and post-install integrity checks have completed successfully.\n]]>"}}]},{"ruleId":"T02","level":"warning","message":{"text":"Persistent Agent Steering Through Global and Project CLAUDE.md Modification"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"README.md"},"region":{"startLine":108,"endLine":112}}}],"partialFingerprints":{"primaryLocationLineHash":"b39580b94d4fdc72"},"properties":{"description":"<![CDATA[\n## Vulnerability Details\n**File Location**: `README.md:108-112`  \n**Vulnerability Type**: Persistent agent-state modification  \n**Risk Level**: Medium\n\n### Vulnerable Code\n\n```text\nInstall gstack: run `git clone https://github.com/garrytan/gstack.git ~/.claude/skills/gstack && cd ~/.claude/skills/gstack && ./setup` then add a \"gstack\" section to CLAUDE.md that says to use the /browse skill from gstack for all web browsing, never use mcp__claude-in-chrome__* tools, and lists the available skills: /plan-ceo-review, /plan-eng-review, /review, /ship, /browse, /qa, /qa-only, /setup-browser-cookies, /retro, /document-release. Then ask the user if they also want to add gstack to the current project so teammates get it.\n```\n\n```text\nAdd gstack to this project: run `cp -Rf ~/.claude/skills/gstack .claude/skills/gstack && rm -rf .claude/skills/gstack/.git && cd .claude/skills/gstack && ./setup` then add a \"gstack\" section to this project's CLAUDE.md that says to use the /browse skill from gstack for all web browsing, never use mcp__claude-in-chrome__* tools, lists the available skills: /plan-ceo-review, /plan-eng-review, /review, /ship, /browse, /qa, /setup-browser-cookies, /retro, /document-release, and tells Claude that if gstack skills aren't working, run `cd .claude/skills/gstack && ./setup` to build the binary and register skills.\n```\n\n### Technical Analysis\n\nThe installation instructions do more than register commands. They direct the agent to place durable rules in global or project-level `CLAUDE.md` files, including a blanket requirement to route all web browsing through gstack and a prohibition against alternative browser tools.\n\nBecause `CLAUDE.md` is loaded by future agent sessions, these rules survive the installation conversation and influence unrelated later tasks. The project-local variant can also affect teammates after the configuration is committed. This creates a persistent control channel that magnifies the consequences of any later compromise of gstack's browser binary or update process.\n\n### Attack Path\n\n1. A user follows the supplied installation prompt.\n2. The agent edits a global or project `CLAUDE.md` with mandatory gstack tool-selection rules.\n3. Future sessions load those persistent instructions without the user explicitly selecting gstack for each task.\n4. Unrelated browsing operations are redirected through gstack, including its persistent browser, cookie-import, and remote-upgrade paths.\n5. If gstack is later compromised, the persistent steering increases the number of sessions and tasks exposed to the compromised component.\n\n### Impact Assessment\n\nThe immediate impact is durable control over future agent tool selection rather than direct operating-system privilege escalation. Global modification affects future sessions for the user, while project modification can affect every agent or teammate honoring the committed instructions. It also reduces defense in depth by prohibiting alternative tools categorically.\n]]>","severity":"Medium"},"fixes":[{"description":{"text":"<![CDATA[\n## Remediation Suggestions\n\n1. Keep tool-selection guidance scoped to an explicit Skill invocation.\n2. Do not require blanket `ALWAYS` or `NEVER` rules for unrelated future browsing tasks.\n3. If persistent configuration is offered, show the exact proposed diff and obtain explicit, separate consent before writing it.\n4. Prefer a neutral entry that documents availability without forcing tool selection.\n5. Clearly distinguish global configuration from project-local configuration and warn that committed project instructions affect teammates.\n6. Provide a minimal, documented rollback command that removes only the inserted configuration block.\n]]>"}}]},{"ruleId":"T05","level":"error","message":{"text":"Sensitive Cookie-Picker APIs Bypass Bearer Authentication"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"browse/src/server.ts"},"region":{"startLine":307,"endLine":313}}}],"partialFingerprints":{"primaryLocationLineHash":"4ad722a495db2921"},"properties":{"description":"<![CDATA[\n## Vulnerability Details\n**File Location**: `browse/src/server.ts:307-313`; sensitive handlers in `browse/src/cookie-picker-routes.ts:75-165`  \n**Vulnerability Type**: Missing authentication on credential-management endpoints  \n**Risk Level**: High\n\n### Vulnerable Code\n\nThe server bypasses authentication for every cookie-picker path:\n\n```typescript\n// Cookie picker routes — no auth required (localhost-only)\nif (url.pathname.startsWith('/cookie-picker')) {\n  return handleCookiePickerRoute(url, req, browserManager);\n}\n```\n\nBearer authentication is applied only afterward:\n\n```typescript\n// All other endpoints require auth\nif (!validateAuth(req)) {\n  return new Response(JSON.stringify({ error: 'Unauthorized' }), {\n    status: 401,\n    headers: { 'Content-Type': 'application/json' },\n  });\n}\n```\n\nThe unauthenticated handler exposes browser and domain enumeration:\n\n```typescript\nif (pathname === '/cookie-picker/browsers' && req.method === 'GET') {\n  const browsers = findInstalledBrowsers();\n  return jsonResponse({\n    browsers: browsers.map(b => ({\n      name: b.name,\n      aliases: b.aliases,\n    })),\n  }, { port });\n}\n\nif (pathname === '/cookie-picker/domains' && req.method === 'GET') {\n  const browserName = url.searchParams.get('browser');\n  if (!browserName) {\n    return errorResponse(\"Missing 'browser' parameter\", 'missing_param', { port });\n  }\n  const result = listDomains(browserName);\n  return jsonResponse({\n    browser: result.browser,\n    domains: result.domains,\n  }, { port });\n}\n```\n\nIt also performs cookie decryption and imports credentials into the automated context:\n\n```typescript\nif (pathname === '/cookie-picker/import' && req.method === 'POST') {\n  let body: any;\n  try {\n    body = await req.json();\n  } catch {\n    return errorResponse('Invalid JSON body', 'bad_request', { port });\n  }\n\n  const { browser, domains } = body;\n  if (!browser) return errorResponse(\"Missing 'browser' field\", 'missing_param', { port });\n  if (!domains || !Array.isArray(domains) || domains.length === 0) {\n    return errorResponse(\"Missing or empty 'domains' array\", 'missing_param', { port });\n  }\n\n  const result = await importCookies(browser, domains);\n\n  const page = bm.getPage();\n  await page.context().addCookies(result.cookies);\n}\n```\n\n### Technical Analysis\n\nLocalhost binding limits network exposure but is not an authentication mechanism. Any process running as the user—or any other local process allowed to connect to the loopback port—can call these endpoints without possessing the random bearer token stored in the protected state file.\n\nThe project already implements a bearer token for privileged browser commands, but deliberately exempts the cookie-picker APIs even though those APIs access browser metadata, invoke macOS Keychain-backed decryption, import authentication cookies, and remove imported session state.\n\nThe CORS response header does not protect against native local clients. Furthermore, the handler does not validate the incoming `Origin` or `Host` before performing state-changing requests.\n\n### Attack Path\n\n1. A malicious local process scans the documented port range or observes the daemon's console output.\n2. It requests `/cookie-picker/browsers` to identify installed browsers.\n3. It requests `/cookie-picker/domains?browser=chrome` to enumerate domains with active cookies.\n4. It posts selected domains to `/cookie-picker/import`, triggering Keychain access and loading authenticated sessions into Playwright.\n5. It can then manipulate cookie state through `/cookie-picker/remove`, or combine the imported session with another browser-control weakness.\n6. No bearer token is required at any step.\n\n### Impact Assessment\n\nAn attacker can enumerate private browsing relationships and installed browsers, trigger credential-decryption workflows, place real authenticated sessions into the automated browser, and remove imported cookies. The code does not directly return plaintext values through the cookie-picker API, but it crosses a sensitive credential boundary and can facilitate account-session exposure when combined with browser command access or local filesystem access.\n]]>","severity":"High"},"fixes":[{"description":{"text":"<![CDATA[\n## Remediation Suggestions\n\n1. Require the existing bearer token on all `/cookie-picker` API routes, including browser and domain enumeration.\n2. If the HTML page itself must open without a manually supplied header, issue a short-lived, single-use capability URL and require that capability for every API request.\n3. Validate `Origin` and `Host` against the exact loopback origin and reject absent or unexpected browser origins where appropriate.\n4. Add CSRF tokens to all state-changing requests.\n5. Require explicit user confirmation immediately before each Keychain-backed import, identifying the browser and requested domains.\n6. Rate-limit failed authentication and sensitive operations.\n7. Avoid logging capability tokens or including them in persistent browser history.\n8. Add tests proving that unauthenticated requests to every cookie-picker API return `401` or `403`.\n]]>"}}]},{"ruleId":"T09","level":"error","message":{"text":"Cookies Command Returns Full Authentication Cookie Values"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"browse/src/read-commands.ts"},"region":{"startLine":273,"endLine":276}}}],"partialFingerprints":{"primaryLocationLineHash":"5be9ae90958159f6"},"properties":{"description":"<![CDATA[\n## Vulnerability Details\n**File Location**: `browse/src/read-commands.ts:273-276`  \n**Vulnerability Type**: Plaintext credential exposure  \n**Risk Level**: High\n\n### Vulnerable Code\n\n```typescript\ncase 'cookies': {\n  const cookies = await page.context().cookies();\n  return JSON.stringify(cookies, null, 2);\n}\n```\n\n### Technical Analysis\n\nPlaywright's `BrowserContext.cookies()` returns complete cookie records, including each cookie's plaintext `value`. The command serializes the records without redaction and returns them through the browser server to CLI stdout.\n\nThis behavior directly contradicts the project's stated design in `ARCHITECTURE.md`, which claims that the `cookies` command returns metadata with truncated values. Cookies imported from a user's real Chromium profile can include authenticated session identifiers, CSRF tokens, and other bearer credentials.\n\nBecause the browser is designed for AI-agent use, command output can enter model context, conversation transcripts, terminal logs, evaluation artifacts, or other observability systems.\n\n### Attack Path\n\n1. The user imports cookies from Chrome, Arc, Brave, Edge, or Comet into the persistent Playwright context.\n2. The agent or user invokes the documented `cookies` command.\n3. `page.context().cookies()` retrieves complete plaintext cookie values.\n4. The server serializes and returns all values to stdout.\n5. The credentials become part of the agent context or downstream logs.\n6. Anyone with access to those records can replay a still-valid bearer cookie against the corresponding service.\n\nA prompt-injected webpage could also attempt to influence the agent into running the command and disclosing its output during an otherwise legitimate QA workflow.\n\n### Impact Assessment\n\nThe exposed values may allow account-session takeover without a password or multi-factor authentication, depending on server-side session controls. Scope is limited to cookies currently present in the persistent Playwright context, but that context can contain real production sessions imported from the user's daily browser.\n]]>","severity":"High"},"fixes":[{"description":{"text":"<![CDATA[\n## Remediation Suggestions\n\n1. Return cookie metadata only by default: name, domain, path, expiry, `secure`, `httpOnly`, and `sameSite`.\n2. Omit the `value` field entirely rather than merely shortening it.\n3. If plaintext retrieval is genuinely required, place it behind an explicit, separately named command with a strong warning and immediate user confirmation.\n4. Prevent secret-bearing output from entering routine AI context.\n5. Add regression tests asserting that known cookie values never appear in command output.\n6. Update documentation to match actual behavior and treat documentation claims as enforceable security requirements.\n7. Consider separating imported production-authentication contexts from ordinary QA contexts.\n]]>"}}]},{"ruleId":"T09","level":"warning","message":{"text":"Persistent Browser Logs Store Potentially Sensitive Data Without Explicit Restrictive Permissions"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"browse/src/server.ts"},"region":{"startLine":95,"endLine":131}}}],"partialFingerprints":{"primaryLocationLineHash":"d78357a0897d9784"},"properties":{"description":"<![CDATA[\n## Vulnerability Details\n**File Location**: `browse/src/server.ts:95-131`; directory creation in `browse/src/config.ts:76-99`  \n**Vulnerability Type**: Insecure sensitive-data logging and filesystem permissions  \n**Risk Level**: Medium\n\n### Vulnerable Code\n\nThe daemon persists console messages, complete request URLs, and dialog content:\n\n```typescript\n// Console buffer\nconst newConsoleCount = consoleBuffer.totalAdded - lastConsoleFlushed;\nif (newConsoleCount > 0) {\n  const entries = consoleBuffer.last(Math.min(newConsoleCount, consoleBuffer.length));\n  const lines = entries.map(e =>\n    `[${new Date(e.timestamp).toISOString()}] [${e.level}] ${e.text}`\n  ).join('\\n') + '\\n';\n  await Bun.write(CONSOLE_LOG_PATH, (await Bun.file(CONSOLE_LOG_PATH).text().catch(() => '')) + lines);\n  lastConsoleFlushed = consoleBuffer.totalAdded;\n}\n\n// Network buffer\nconst newNetworkCount = networkBuffer.totalAdded - lastNetworkFlushed;\nif (newNetworkCount > 0) {\n  const entries = networkBuffer.last(Math.min(newNetworkCount, networkBuffer.length));\n  const lines = entries.map(e =>\n    `[${new Date(e.timestamp).toISOString()}] ${e.method} ${e.url} → ${e.status || 'pending'} (${e.duration || '?'}ms, ${e.size || '?'}B)`\n  ).join('\\n') + '\\n';\n  await Bun.write(NETWORK_LOG_PATH, (await Bun.file(NETWORK_LOG_PATH).text().catch(() => '')) + lines);\n  lastNetworkFlushed = networkBuffer.totalAdded;\n}\n\n// Dialog buffer\nconst newDialogCount = dialogBuffer.totalAdded - lastDialogFlushed;\nif (newDialogCount > 0) {\n  const entries = dialogBuffer.last(Math.min(newDialogCount, dialogBuffer.length));\n  const lines = entries.map(e =>\n    `[${new Date(e.timestamp).toISOString()}] [${e.type}] \"${e.message}\" → ${e.action}${e.response ? ` \"${e.response}\"` : ''}`\n  ).join('\\n') + '\\n';\n  await Bun.write(DIALOG_LOG_PATH, (await Bun.file(DIALOG_LOG_PATH).text().catch(() => '')) + lines);\n  lastDialogFlushed = dialogBuffer.totalAdded;\n}\n```\n\nThe storage directory is created without an explicit mode:\n\n```typescript\nexport function ensureStateDir(config: BrowseConfig): void {\n  try {\n    fs.mkdirSync(config.stateDir, { recursive: true });\n  } catch (err: any) {\n    if (err.code === 'EACCES') {\n      throw new Error(`Cannot create state directory ${config.stateDir}: permission denied`);\n    }\n    if (err.code === 'ENOTDIR') {\n      throw new Error(`Cannot create state directory ${config.stateDir}: a file exists at that path`);\n    }\n    throw err;\n  }\n}\n```\n\n### Technical Analysis\n\nNetwork URLs can contain access tokens, signed URLs, authorization codes, password-reset tokens, and sensitive query parameters. Console messages frequently contain application state or debugging credentials. Dialog responses can contain user-provided secrets.\n\nThe daemon writes these values to persistent files every second without redaction. While the bearer-token state file is explicitly created with mode `0600`, the log files and `.gstack` directory do not receive equivalent explicit permission hardening. Their effective permissions depend on the process umask and pre-existing directory state.\n\nAdding `.gstack/` to `.gitignore` prevents accidental Git commits but does not protect local confidentiality, backups, shared workspaces, or permissive filesystem environments.\n\n### Attack Path\n\n1. The persistent browser visits an authenticated application.\n2. The application emits a URL containing a signed token, logs a sensitive value to the console, or presents a dialog containing a secret response.\n3. The daemon copies the complete value into `.gstack/browse-network.log`, `.gstack/browse-console.log`, or `.gstack/browse-dialog.log`.\n4. The file persists after the relevant command and may remain after the daemon exits.\n5. Another local user, process, backup service, or workspace consumer reads the retained value where filesystem permissions permit.\n6. A still-valid token can then be replayed against the affected application.\n\n### Impact Assessment\n\nExposure is limited to information emitted by pages used during the browser session, but authenticated QA sessions can contain production-equivalent credentials and private application data. Depending on the logged token, exploitation could lead to session takeover, access to protected resources, or disclosure of proprietary information.\n]]>","severity":"Medium"},"fixes":[{"description":{"text":"<![CDATA[\n## Remediation Suggestions\n\n1. Create `.gstack` with mode `0700` and verify or repair the mode when the directory already exists.\n2. Create every log file with mode `0600`; do not rely on the ambient umask.\n3. Redact URL query strings and fragments by default, or retain only origin, path, method, status, size, and duration.\n4. Apply secret-pattern redaction to console and dialog content before both in-memory buffering and disk persistence.\n5. Disable persistent browser logging by default and require an explicit debugging option to enable it.\n6. Add file-size limits, rotation, and short retention periods.\n7. Delete logs when a session closes unless the user explicitly asks to preserve them.\n8. Document that console output and dialog responses may contain secrets, and add tests covering tokens in query parameters and console messages.\n]]>"}}]}],"properties":{"securityScore":0,"primaryLanguage":"TypeScript","llm":"gpt-5.6","startTime":1789191789.5500634,"endTime":1789191936.1047475}}]},"skillspector":{"skill":{"name":"gstack","source":"/tmp/clawhub-codex-scan-v571rgkhepan1hp5pnykaz68c58e86y6-lwDngf/clawscan-skillspector-2599101097/artifact","scanned_at":"2026-09-12T05:43:08.444891+00:00"},"risk_assessment":{"score":100,"severity":"CRITICAL","recommendation":"DO_NOT_INSTALL","max_issue_severity":"HIGH"},"components":[{"path":"ARCHITECTURE.md","type":"markdown","lines":355,"executable":false,"size_bytes":20441,"source_url":null,"source_identity":null,"source_digest":null},{"path":"BROWSER.md","type":"markdown","lines":258,"executable":false,"size_bytes":16159,"source_url":null,"source_identity":null,"source_digest":null},{"path":"CHANGELOG.md","type":"markdown","lines":295,"executable":false,"size_bytes":25875,"source_url":null,"source_identity":null,"source_digest":null},{"path":"CLAUDE.md","type":"markdown","lines":145,"executable":false,"size_bytes":7497,"source_url":null,"source_identity":null,"source_digest":null},{"path":"CONTRIBUTING.md","type":"markdown","lines":294,"executable":false,"size_bytes":13186,"source_url":null,"source_identity":null,"source_digest":null},{"path":"README.md","type":"markdown","lines":659,"executable":false,"size_bytes":31365,"source_url":null,"source_identity":null,"source_digest":null},{"path":"SKILL.md","type":"markdown","lines":443,"executable":false,"size_bytes":16491,"source_url":null,"source_identity":null,"source_digest":null},{"path":"TODOS.md","type":"markdown","lines":440,"executable":false,"size_bytes":15067,"source_url":null,"source_identity":null,"source_digest":null},{"path":"browse/SKILL.md","type":"markdown","lines":311,"executable":false,"size_bytes":12981,"source_url":null,"source_identity":null,"source_digest":null},{"path":"browse/src/browser-manager.ts","type"