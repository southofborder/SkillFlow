-2.1.0.json","runs":[{"tool":{"driver":{"name":"aig-skill-scan","version":"0.2.1","informationUri":"https://github.com/Tencent/AI-Infra-Guard","rules":[{"id":"T01","name":"Skill Instruction Hijacking","shortDescription":{"text":"Alters the agent's current session goals or safety constraints when the skill is loaded"}},{"id":"T02","name":"Agent Memory Poisoning","shortDescription":{"text":"Writes attacker-controlled rules into persistent memory so they continue to affect future sessions"}},{"id":"T03","name":"Remote Payload Retrieval and Execution","shortDescription":{"text":"Fetches code from an external URL, allowing the effective payload to change after skill review"}},{"id":"T04","name":"Embedded Malicious Code","shortDescription":{"text":"Ships malicious scripts inside the skill package and executes them locally when invoked"}},{"id":"T05","name":"Unauthorized Access and Privilege Escalation","shortDescription":{"text":"Breaks least-privilege boundaries by obtaining permissions beyond the task's legitimate needs"}},{"id":"T06","name":"System Persistence","shortDescription":{"text":"Installs cross-session backdoors, hooks, services, or scheduled tasks that survive the skill run"}},{"id":"T07","name":"Tool Hijacking and Spoofing","shortDescription":{"text":"Modifies, wraps, spoofs, or replaces tools so legitimate-looking calls execute attacker logic"}},{"id":"T08","name":"Insecure Dependencies","shortDescription":{"text":"Introduces malicious packages or components through dependency confusion, typosquatting, or unsafe sources"}},{"id":"T09","name":"Insecure Skill Coding Practices","shortDescription":{"text":"Exposes exploitable flaws such as hardcoded secrets, command injection, plaintext sensitive data, or unsafe temp files"}},{"id":"other","name":"Other Risk","shortDescription":{"text":"Security issues not covered by the T01-T09 classification"}}]}},"results":[],"properties":{"securityScore":100,"primaryLanguage":"Markdown","llm":"gpt-5.6","startTime":1789137945.534652,"endTime":1789138009.0863428}}]},"skillspector":{"skill":{"name":"novel-generator","source":"/tmp/clawhub-codex-scan-v573asdaq2j2rdkwrkw0x2q3x98e7y8p-SpWUGs/clawscan-skillspector-4211161551/artifact","scanned_at":"2026-09-11T14:45:43.898227+00:00"},"risk_assessment":{"score":72,"severity":"HIGH","recommendation":"DO_NOT_INSTALL","max_issue_severity":"HIGH"},"components":[{"path":".learnings/CHARACTERS.md","type":"markdown","lines":7,"executable":false,"size_bytes":196,"source_url":null,"source_identity":null,"source_digest":null},{"path":".learnings/ERRORS.md","type":"markdown","lines":7,"executable":false,"size_bytes":175,"source_url":null,"source_identity":null,"source_digest":null},{"path":".learnings/LOCATIONS.md","type":"markdown","lines":7,"executable":false,"size_bytes":185,"source_url":null,"source_identity":null,"source_digest":null},{"path":".learnings/PLOT_POINTS.md","type":"markdown","lines":7,"executable":false,"size_bytes":181,"source_url":null,"source_identity":null,"source_digest":null},{"path":".learnings/STORY_BIBLE.md","type":"markdown","lines":5,"executable":false,"size_bytes":106,"source_url":null,"source_identity":null,"source_digest":null},{"path":"README.md","type":"markdown","lines":129,"executable":false,"size_bytes":4304,"source_url":null,"source_identity":null,"source_digest":null},{"path":"SKILL.md","type":"markdown","lines":366,"executable":false,"size_bytes":12062,"source_url":null,"source_identity":null,"source_digest":null},{"path":"assets/CHAPTER-TEMPLATE.md","type":"markdown","lines":129,"executable":false,"size_bytes":3021,"source_url":null,"source_identity":null,"source_digest":null},{"path":"assets/LEARNINGS-TEMPLATE.md","type":"markdown","lines":151,"executable":false,"size_bytes":2904,"source_url":null,"source_identity":null,"source_digest":null},{"path":"assets/PROMPT-TEMPLATE.md","type":"markdown","lines":130,"executable":false,"size_bytes":3824,"source_url":null,"source_identity":null,"source_digest":null},{"path":"references/examples.md","type":"markdown","lines":293,"executable":false,"size_bytes":8728,"source_url":null,"source_identity":null,"source_digest":null},{"path":"references/plot-structures.md","type":"markdown","lines":203,"executable":false,"size_bytes":4907,"source_url":null,"source_identity":null,"source_digest":null},{"path":"references/prompt-guide.md","type":"markdown","lines":124,"executable":false,"size_bytes":3899,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/init-novel.sh","type":"shell","lines":154,"executable":true,"size_bytes":4166,"source_url":null,"source_identity":null,"source_digest":null}],"structured_summaries":[],"issues":[{"id":"TM1","finding_id":"finding-bf0dca23235149c5a41ee5002a2ab531","category":"Tool Misuse","pattern":"Tool Parameter Abuse","severity":"HIGH","confidence":0.95,"location":{"file":"scripts/init-novel.sh","start_line":78,"end_line":null},"finding":"rm -rf \"$OUTPUT_DIR\"/*.md","explanation":"Tool parameters are crafted to achieve unintended or unsafe behavior. Parameter abuse can bypass intended safety checks (e.g. shell=True, --force, dangerous glob patterns).","remediation":"Validate all tool parameters against an allowlist. Reject dangerous parameter values (shell=True, --force, -rf /) and use safe defaults.","code_snippet":"\nif [ \"$CLEAN\" = true ]; then\n    log_step \"清除旧的输出文件...\"\n    rm -rf \"$OUTPUT_DIR\"/*.md 2>/dev/null || true\n\n    log_step \"重置记忆文件...\"\n","intent":null,"tags":["Tool Misuse","llm-unconfirmed"],"evidence":{},"match_fingerprint":"3a594f9c4d3950ebb95decd75f2dd20b4be7e49a215add03249c306ce58eebe8","occurrences":[{"file":"scripts/init-novel.sh","start_line":78,"end_line":null}]},{"id":"SQP-3","finding_id":"finding-93681fb64e834747becf6f9540febdda","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.8,"location":{"file":"README.md","start_line":3,"end_line":3},"finding":null,"explanation":"The natural-language description presents the skill as a Chinese-language novel generator and all usage examples and instructions are in Chinese. There is no indication that users may choose another language or that the Chinese-only behavior is an intentional, documented locale constraint.","remediation":"State explicitly whether the skill supports multiple languages, or document that it is Chinese-specific and why. If possible, add an opt-in or language selection note so users are not forced into a single language unexpectedly.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"README.md","start_line":3,"end_line":3}]},{"id":"SQP-2","finding_id":"finding-5245761bfe1546799fcefa326759f768","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.89,"location":{"file":"README.md","start_line":46,"end_line":49},"finding":null,"explanation":"The README states that the skill will output chapter files and persist memory and error logs, but it does not clearly warn users that local files will be created and retained over time. In an agent-skill context, silent persistence can expose sensitive prompts, story ideas, personal data, or workspace contents to unintended retention and later reuse, especially if the agent runs in a shared repository or syncs files to version control.","remediation":"Add an explicit data-handling notice in the README and skill docs that describes what files are written, where they are stored, and how long they persist. Require user confirmation before creating or updating `.learnings/`, `output/`, or error-log files, and provide clear cleanup/delete instructions plus options to disable persistence or redirect storage to a safe location.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"README.md","start_line":46,"end_line":49}]},{"id":"SQP-1","finding_id":"finding-60493f069a0945128fe7e7702928cbf1","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.96,"location":{"file":"SKILL.md","start_line":3,"end_line":3},"finding":null,"explanation":"The activation description is very broad and matches generic creative-writing requests, which increases the chance the skill will auto-trigger in situations where the user did not specifically want file-writing, memory management, or multi-step workflow behavior. In this skill, that matters because activation can lead to reading and writing project files such as `.learnings/` and `output/`, expanding the skill’s operational scope beyond simple text generation.","remediation":"Narrow the trigger description to explicit opt-in scenarios, such as requests to create a long-form serialized novel with continuity tracking or chapter file output. Add clear exclusions for ordinary one-off story requests, and require confirmation before performing filesystem actions or initializing a workspace.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":3,"end_line":3}]},{"id":"SQP-3","finding_id":"finding-8dce4e2278644fdab095c358a5b7d34f","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.88,"location":{"file":"SKILL.md","start_line":9,"end_line":9},"finding":null,"explanation":"The metadata fixes the skill language to `zh-CN`, and the document consistently instructs Chinese-language operation without indicating that users may choose another language. This can violate language-choice policy when the skill is used in broader contexts not explicitly limited to a China-specific compliance or regional workflow.","remediation":"State that Chinese is the default output language but allow the user to choose another language or locale. If the skill is intended to be China-specific, document that limitation clearly and justify it in the description.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":9,"end_line":9}]},{"id":"SQP-2","finding_id":"finding-820108b7b9ed4c7bb63a3438c4380e32","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.97,"location":{"file":"SKILL.md","start_line":347,"end_line":349},"finding":null,"explanation":"The skill instructs use of an initialization script that clears prior `.learnings/` records, but it does not require an explicit warning, backup, or user confirmation before destructive action. This creates a real risk of accidental data loss, especially because `.learnings/` is the persistence mechanism for story continuity and may contain valuable prior work.","remediation":"Require an explicit confirmation step before any deletion or clearing of `.learnings/` content. Modify the script and documentation to create a timestamped backup, preview what will be removed, and offer a non-destructive reset mode that initializes a new workspace instead of erasing existing records.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":347,"end_line":349}]},{"id":"SQP-3","finding_id":"finding-f50244852acc45889d9dea8830323651","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"assets/LEARNINGS-TEMPLATE.md","start_line":1,"end_line":150},"finding":null,"explanation":"This markdown template is entirely written in Chinese and defines section headings and field values in Chinese, which implicitly constrains downstream skill use to a specific language. The file does not offer an opt-in, alternative locale, or justification that the skill is intended only for a Chinese-language context.","remediation":"Document that the template is specifically for Chinese-language workflows, or add a note allowing users to choose their preferred language/localization. If the skill is meant to be multilingual, provide equivalent templates or instructions for other languages.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"assets/LEARNINGS-TEMPLATE.md","start_line":1,"end_line":150}]},{"id":"SQP-3","finding_id":"finding-4cd761bcf2134774ace68a4c6f0a5f25","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.96,"location":{"file":"assets/PROMPT-TEMPLATE.md","start_line":1,"end_line":3},"finding":null,"explanation":"The file title and instructions are entirely in Chinese and direct the model to auto-complete prompts in that language. This imposes a specific language/locale by default, and the template does not provide any opt-in or alternative language selection for users.","remediation":"Add an explicit language-selection field or instruction, such as allowing the user to choose output language before generating the prompt. If Chinese-only use is intentional, document that constraint clearly and justify the locale restriction.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"assets/PROMPT-TEMPLATE.md","start_line":1,"end_line":3}]},{"id":"SQP-2","finding_id":"finding-ecaca0858a2940cf8efe46d36b95ee2d","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"scripts/init-novel.sh","start_line":76,"end_line":128},"finding":null,"explanation":"The --clean path performs destructive actions by deleting prior output markdown files and overwriting multiple memory files with no confirmation, backup, or dry-run safeguard. In an agent-integrated workflow, accidental invocation or misuse can cause irreversible loss of user-authored content and project state.","remediation":"Require an explicit confirmation step before destructive cleanup, especially in non-interactive agent contexts. Add a safer mode such as --yes or --force gated behind a warning, create timestamped backups of existing files before overwriting, and consider scoping cleanup to a per-novel workspace instead of shared output and learning files.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/init-novel.sh","start_line":76,"end_line":128}]},{"id":"SQP-3","finding_id":"finding-47b2488db6204fb2b2adadb0106d82b4","category":null,"pattern":null,"severity":"LOW","confidence":0.98,"location":{"file":"references/plot-structures.md","start_line":1,"end_line":203},"finding":null,"explanation":"SQP-3 applies to all file types and includes language or locale policy violations. This markdown file presents all instructions and content exclusively in Chinese, and nowhere indicates that the user may choose another language or that the skill is intentionally limited to a Chinese-language context.","remediation":"Add a clear language note offering multilingual use or user language preference, or document that this reference is intentionally Chinese-only for a justified region- or audience-specific purpose.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"references/plot-structures.md","start_line":1,"end_line":203}]},{"id":"SQP-3","finding_id":"finding-fb3be5bb20b241e5ae0e7f3717d29667","category":null,"pattern":null,"severity":"LOW","confidence":0.78,"location":{"file":"references/prompt-guide.md","start_line":1,"end_line":124},"finding":null,"explanation":"SQP-3 applies to all file types and covers natural-language policy violations such as forcing a specific language without user opt-in. This document presents all guidance in Chinese with no indication that users may choose another language or locale, which can amount to an implicit language constraint.","remediation":"State that the skill can respond in the user's preferred language, or explicitly mark the guide as Chinese-localized documentation for a region-specific audience. If the skill is intended to operate only in Chinese, document and justify that constraint clearly.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"references/prompt-guide.md","start_line":1,"end_line":124}]},{"id":"SQP-3","finding_id":"finding-9a9048777c7748038ded1c99819cf761","category":null,"pattern":null,"severity":"LOW","confidence":0.91,"location":{"file":"scripts/init-novel.sh","start_line":2,"end_line":153},"finding":null,"explanation":"All comments, usage text, logs, and prompts are presented only in Chinese, which imposes a specific language on users without any opt-in or documented locale limitation. Under the language/locale policy, a skill should either offer a language choice or clearly justify being region- or audience-specific.","remediation":"Add locale documentation stating that this skill is intended specifically for Chinese-language novel workflows, or provide a language selection/English fallback for user-facing messages and help text.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/init-novel.sh","start_line":2,"end_line":153}]}],"suppressed_count":0,"suppressed":[],"metadata":{"has_executable_scripts":true,"skillspector_version":"2.11.2","llm_requested":true,"llm_available":true,"meta_analysis_applied":true,"inference_usage":[{"node":"mcp_tool_poisoning","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":1671,"completion_tokens":287,"cached_tokens":0,"reasoning_tokens":0,"total_tokens":1958},{"node":"semantic_developer_intent","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":3052,"completion_tokens":14,"cached_tokens":0,"reasoning_tokens":0,"total_tokens":3066},{"node":"semantic_developer_intent","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provide