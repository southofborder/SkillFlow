l,"source_digest":null},{"path":"scripts/optimizer_core.py","type":"python","lines":166,"executable":true,"size_bytes":10217,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/token_tracker.py","type":"python","lines":7,"executable":true,"size_bytes":224,"source_url":null,"source_identity":null,"source_digest":null}],"structured_summaries":[],"issues":[{"id":"TP4","finding_id":"finding-a602ef86d23d4be4886b99811b7f46eb","category":"MCP Tool Poisoning","pattern":null,"severity":"HIGH","confidence":0.98,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"The declared description is for a passive auditing skill focused on identifying token waste and suggesting safe next steps. The supplied code does not implement analysis logic, inspection, reporting, or cost-review behavior. Instead, it is a thin command-line shim that prepends the argument 'route' and dispatches into optimizer.main(), which indicates an operational routing function. That is a materially different primary purpose from the declared auditing role, so this is a mismatch.","remediation":"Update the skill description to accurately reflect all capabilities, or remove undeclared functionality from the implementation.","code_snippet":null,"intent":null,"tags":["ASI02","AML.T0080","llm-unconfirmed"],"evidence":{"code_path":"scripts/model_router.py","code_start_line":1,"code_end_line":7,"actual_behavior_summary":"A Python shim that invokes optimizer.main() with an inserted 'route' CLI argument, acting as a model-routing command wrapper rather than performing token-waste analysis or reporting."},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"TP4","finding_id":"finding-96bd8cf255ca47048f6aee4877530760","category":"MCP Tool Poisoning","pattern":null,"severity":"HIGH","confidence":0.98,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"The declared purpose emphasizes a diagnostic, explanatory skill for reviewing token waste and recommending safe next steps without making changes. The supplied code does not implement such analysis directly; instead, it modifies argv to inject the subcommand 'budget' and then hands control to optimizer.main(). That indicates the code's real role is a command wrapper or migration shim into an optimizer/budget flow. Because this could execute optimization or budget-related behavior outside the narrowly declared read-only auditing purpose, the description does not accurately represent the code chunk's primary behavior.","remediation":"Update the skill description to accurately reflect all capabilities, or remove undeclared functionality from the implementation.","code_snippet":null,"intent":null,"tags":["ASI02","AML.T0080","llm-unconfirmed"],"evidence":{"code_path":"scripts/token_tracker.py","code_start_line":1,"code_end_line":7,"actual_behavior_summary":"The code is a Python shim that forcibly inserts the CLI argument 'budget' and invokes optimizer.main(), acting as a wrapper to run a budget/optimizer command rather than performing a read-only token-waste analysis itself."},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"PE3","finding_id":"finding-c4a645aa29df4ad89575efd8c2bd5470","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.6,"location":{"file":"SECURITY.md","start_line":52,"end_line":null},"finding":".env ","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":"\"\"\"Hermes file-only adapter. No Hermes imports, subprocesses, .env reads or writes.\"\"\"\nimport json\nfrom pathlib import Path\nfrom optimizer_core import VERSION, finding, safe_id","intent":null,"tags":["Privilege Escalation","llm-unconfirmed"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"SECURITY.md","start_line":52,"end_line":null}]},{"id":"PE3","finding_id":"finding-c4a645aa29df4ad89575efd8c2bd5470","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.6,"location":{"file":"references/HERMES.md","start_line":14,"end_line":null},"finding":".env ","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":"\"\"\"Hermes file-only adapter. No Hermes imports, subprocesses, .env reads or writes.\"\"\"\nimport json\nfrom pathlib import Path\nfrom optimizer_core import VERSION, finding, safe_id","intent":null,"tags":["Privilege Escalation","llm-unconfirmed"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"references/HERMES.md","start_line":14,"end_line":null}]},{"id":"PE3","finding_id":"finding-c4a645aa29df4ad89575efd8c2bd5470","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.6,"location":{"file":"scripts/hermes_adapter.py","start_line":1,"end_line":null},"finding":".env ","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":"\"\"\"Hermes file-only adapter. No Hermes imports, subprocesses, .env reads or writes.\"\"\"\nimport json\nfrom pathlib import Path\nfrom optimizer_core import VERSION, finding, safe_id","intent":null,"tags":["Privilege Escalation","llm-unconfirmed"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"scripts/hermes_adapter.py","start_line":1,"end_line":null}]},{"id":"LP3","finding_id":"finding-a22609de0d24485b9ad7596f1e027b94","category":"MCP Least Privilege","pattern":null,"severity":"MEDIUM","confidence":0.9,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"The skill explicitly instructs the agent to use Python and run read-only audits, but it declares no tool restrictions such as allowed-tools or permissions. That creates an unnecessary capability gap: a host may permit broader shell or file access than intended, and the skill relies only on natural-language boundaries like 'read-only' and 'never print raw configuration,' which are not enforcement mechanisms.","remediation":"Add an explicit minimal tool scope to the skill manifest, limiting it to only the required read-only capabilities (for example, file read and narrowly scoped command execution). Prefer a dedicated audit script with constrained arguments over general shell access, and document denied capabilities such as file write, network mutation, installs, and credential access.","code_snippet":null,"intent":null,"tags":["ASI02"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"EA2","finding_id":"finding-717fae4bc9da4171a1e884cb4c723f09","category":"Excessive Agency","pattern":"Autonomous Decision Making","severity":"MEDIUM","confidence":0.75,"location":{"file":"references/QUICKSTART.md","start_line":49,"end_line":null},"finding":"without asking","explanation":"Skill enables autonomous high-impact decisions without human-in-the-loop verification. Critical operations (destructive commands, financial transactions, data deletion) should require explicit user confirmation.","remediation":"Add human-in-the-loop confirmation for destructive, irreversible, or high-impact operations. Never auto-execute commands that modify files, send data, or alter system state.","code_snippet":"\n## Ambiguity examples\n\n- Host says OpenClaw, current agent ID known: audit that agent without asking runtime again.\n- Host says Hermes, active profile known: audit that profile; no exports questionnaire.\n- Both CLIs installed, no active-host evidence: ask which runtime/profile to inspect.\n- Hermes profile known, cron file absent: inspect config only and mark jobs not checked.","intent":null,"tags":["Excessive Agency","llm-unconfirmed"],"evidence":{},"match_fingerprint":"8dc77d3dce9ba1f2672e813265a1b1a0c8594866ef38a4e978bf4f4451795465","occurrences":[{"file":"references/QUICKSTART.md","start_line":49,"end_line":null}]},{"id":"SDI-4","finding_id":"finding-ca0e09527e444b0ab3f1ea675ee17d36","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.94,"location":{"file":"scripts/model_router.py","start_line":2,"end_line":6},"finding":null,"explanation":"The docstring states that 'explicit v4 arguments' are required, which implies callers must provide the needed arguments themselves. However, the wrapper inserts 'route' into sys.argv automatically before invoking main(), preserving implicit behavior rather than requiring fully explicit invocation.","remediation":"Update the docstring to accurately describe that this file is a compatibility shim that injects the 'route' subcommand, or remove the sys.argv insertion and require callers to pass the subcommand explicitly.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/model_router.py","start_line":2,"end_line":6}]},{"id":"AST4","finding_id":"finding-7f683928c7bc498082d7225060bec502","category":"Dangerous Code Execution","pattern":"subprocess module call","severity":"MEDIUM","confidence":0.7,"location":{"file":"scripts/optimizer.py","start_line":28,"end_line":28},"finding":"    result = subprocess.run(['openclaw', *args], capture_output=True, text=True, timeout=45, check=False)","explanation":"subprocess module calls execute external commands. Without careful input validation, this enables command injection.","remediation":"Use subprocess.run() with shell=False and an explicit argument list. Validate all inputs and avoid passing user-controlled data to commands.","code_snippet":"\ndef native(args, json_output=True):\n    # No shell, no arbitrary executable/command option, no auth probe or mutation.\n    result = subprocess.run(['openclaw', *args], capture_output=True, text=True, timeout=45, check=False)\n    if result.returncode:\n        raise ValueError('Native read command failed; inspect OpenClaw locally. Raw output withheld to protect secrets.')\n    if len(result.stdout) > MAX_BYTES:","intent":null,"tags":["Dangerous Code Execution","llm-unconfirmed"],"evidence":{},"match_fingerprint":"9d2de47185e43fa8c00008d46c3aef57e940f46c82ebc75d83ff12a3324853c6","occurrences":[{"file":"scripts/optimizer.py","start_line":28,"end_line":28}]},{"id":"OH3","finding_id":"finding-0da1586ddc834340bba24888948e5a5f","category":"Output Handling","pattern":"Unbounded Output","severity":"MEDIUM","confidence":0.6,"location":{"file":"scripts/optimizer_core.py","start_line":154,"end_line":null},"finding":"no truncation","explanation":"Output size or generation rate is not bounded. Unbounded output enables denial-of-service through resource exhaustion, log flooding, or context-window stuffing.","remediation":"Set explicit limits on output length, generation count, and rate. Use max_tokens and truncation to prevent unbounded output.","code_snippet":"        seen[normalized] = name\n        results.append(item)\n    return {'version': VERSION, 'files': sorted(results, key=lambda x: -x['char