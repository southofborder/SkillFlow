sources"}},{"id":"T09","name":"Insecure Skill Coding Practices","shortDescription":{"text":"Exposes exploitable flaws such as hardcoded secrets, command injection, plaintext sensitive data, or unsafe temp files"}},{"id":"other","name":"Other Risk","shortDescription":{"text":"Security issues not covered by the T01-T09 classification"}}]}},"results":[],"properties":{"securityScore":100,"primaryLanguage":"Markdown","llm":"gpt-5.6","startTime":1789202739.1779122,"endTime":1789202763.9415565}}]},"skillspector":{"skill":{"name":"read-word","source":"/tmp/clawhub-codex-scan-v579hzy22h019dpv69h9pkz9q98e9kqd-BQdVQ8/clawscan-skillspector-2060732980/artifact","scanned_at":"2026-09-12T08:45:38.442441+00:00"},"risk_assessment":{"score":37,"severity":"MEDIUM","recommendation":"CAUTION","max_issue_severity":"MEDIUM"},"components":[{"path":"README.md","type":"markdown","lines":44,"executable":false,"size_bytes":820,"source_url":null,"source_identity":null,"source_digest":null},{"path":"SKILL.md","type":"markdown","lines":198,"executable":false,"size_bytes":5173,"source_url":null,"source_identity":null,"source_digest":null},{"path":"__init__.py","type":"python","lines":35,"executable":true,"size_bytes":672,"source_url":null,"source_identity":null,"source_digest":null},{"path":"_meta.json","type":"json","lines":31,"executable":false,"size_bytes":652,"source_url":null,"source_identity":null,"source_digest":null},{"path":"read_word.py","type":"python","lines":236,"executable":true,"size_bytes":6880,"source_url":null,"source_identity":null,"source_digest":null},{"path":"requirements.txt","type":"text","lines":2,"executable":false,"size_bytes":34,"source_url":null,"source_identity":null,"source_digest":null}],"structured_summaries":[],"issues":[{"id":"SQP-3","finding_id":"finding-66b84a75a5054537b01771a5b9bd596d","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"README.md","start_line":3,"end_line":44},"finding":null,"explanation":"The README is written entirely in Chinese and explicitly emphasizes Chinese support, but does not offer any language choice or explain a region-specific requirement. This can violate a language/locale policy when users are not given an opt-in or alternative language option.","remediation":"Provide multilingual documentation or explicitly state that the skill is intended for Chinese-speaking users only with justification. If language preference matters, allow users to choose their preferred language or link to an English equivalent README.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"README.md","start_line":3,"end_line":44}]},{"id":"LP3","finding_id":"finding-188af69a8e4b45669af60c2ef298d486","category":"MCP Least Privilege","pattern":null,"severity":"MEDIUM","confidence":0.91,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"The skill advertises optional write behavior via `--output`, but the manifest does not declare a corresponding tool scope such as explicit write permissions or allowed-tools. This creates a trust and policy gap: users or orchestrators may assume the skill is read-only while it can write files, increasing the risk of unintended file creation or overwriting in local workflows.","remediation":"Add explicit permission metadata for file write capability in the skill manifest, and clearly scope it to user-specified output paths only. Document overwrite behavior, require explicit user consent for writes, and consider safeguards such as refusing to overwrite existing files unless a force flag is provided.","code_snippet":null,"intent":null,"tags":["ASI02"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"SQP-3","finding_id":"finding-5967d1890f934126a30a8eda603d9a5a","category":null,"pattern":null,"severity":"LOW","confidence":0.77,"location":{"file":"SKILL.md","start_line":3,"end_line":3},"finding":null,"explanation":"The description emphasizes Chinese support in a way that could be read as privileging a specific language/locale. Because the file does not explicitly state that other languages are also supported or that Chinese handling is optional, this can create a mild language-policy concern in natural-language documentation.","remediation":"Clarify that Chinese support is an added capability rather than a restriction, for example by stating that the skill works for general Word documents and includes enhanced handling for Chinese text.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":3,"end_line":3}]},{"id":"SQP-3","finding_id":"finding-afece4050910422cbeb3f61ba339a714","category":null,"pattern":null,"severity":"LOW","confidence":0.9,"location":{"file":"__init__.py","start_line":4,"end_line":13},"finding":null,"explanation":"This file's natural-language documentation and usage examples are entirely in Chinese, with no indication that language choice is optional or that the skill is region-specific. That can violate a language/locale policy requiring user choice or documented justification for a forced locale.","remediation":"Provide bilingual documentation or state that Chinese is the default with user opt-in. If the skill is intended only for a Chinese-language audience, document that scope and justification explicitly in the docstring or accompanying skill documentation.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"__init__.py","start_line":4,"end_line":13}]},{"id":"SQP-1","finding_id":"finding-4047debf82ae459082840f2459e20d83","category":null,"pattern":null,"severity":"LOW","confidence":0.77,"location":{"file":"_meta.json","start_line":4,"end_line":4},"finding":null,"explanation":"This manifest describes what the skill can do, but it does not provide any activation conditions, scope limits, or exclusion examples. In a manifest file, the absence of specific trigger phrasing or contextual constraints can make invocation behavior ambiguous for systems that rely on description text for routing.","remediation":"Add explicit invocation guidance or trigger constraints in the manifest/associated skill metadata, such as specific supported intents, example requests, and any exclusion conditions or negative examples.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"_meta.json","start_line":4,"end_line":4}]},{"id":"SQP-3","finding_id":"finding-79c33d2668b74dcb97d5fb53a3241f74","category":null,"pattern":null,"severity":"LOW","confidence":0.69,"location":{"file":"_meta.json","start_line":4,"end_line":4},"finding":null,"explanation":"The description explicitly highlights Chinese support, which may imply a locale-specific behavior preference without stating that language handling is optional or user-selected. While not severe, this can conflict with language/locale policy expectations when no opt-in or broader language choice is described.","remediation":"Clarify that Chinese handling is optional or additive, for example by stating that the skill supports multiple languages including Chinese, or that language-specific behavior is used only when requested by the user.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"_meta.json","start_line":4,"end_line":4}]},{"id":"SC1","finding_id":"finding-56514478e41b4e5bbea30d2349ca9c81","category":"Supply Chain","pattern":"Unpinned Dependencies","severity":"LOW","confidence":0.97,"location":{"file":"requirements.txt","start_line":1,"end_line":null},"finding":"python-docx>=0.8.11","explanation":"The dependency is specified with a lower bound only, which allows future installs to resolve to different versions over time and makes builds non-reproducible. In a document-parsing skill, this increases supply-chain and maintenance risk because a later vulnerable or incompatible release could be installed without review.","remediation":"Pin the dependency to an exact version or use a lockfile with hashes (for example via pip-tools, Poetry, or requirements.txt with == and --hash). Establish a review/update process so dependency versions are upgraded intentionally after security testing.","code_snippet":"python-docx>=0.8.11\nolefile>=0.46","intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"c287652c3706d151e0a01dfef4b7aa20ad8758e5575a8172287f5fa76eeb0b56","occurrences":[{"file":"requirements.txt","start_line":1,"end_line":null}]},{"id":"SC4","finding_id":"finding-2b78c6d5d8854050b7280f0c97dee2e9","category":"Supply Chain","pattern":"Unverifiable Dependency: python-docx has 2 known advisory(ies) (CVE-2016-5851 (Improper Restriction of XML External Entity Reference in python-docx); CVE-2016-5851 (python-docx before 0.8.6 allows context-dependent attackers to conduct XML Exter)), but the manifest does not pin a version, so it is unknown whether the installed release is affected","severity":"LOW","confidence":0.88,"location":{"file":"requirements.txt","start_line":1,"end_line":null},"finding":"python-docx","explanation":"python-docx has known historical advisories related to XML external entity handling, and because the manifest does not pin a version, it is impossible to verify from this file alone whether a safe release will be installed. This skill's purpose is to read untrusted Word documents, which makes parser/library vulnerabilities more relevant because attacker-supplied files are the direct input surface.","remediation":"Pin python-docx to a version confirmed to be patched against known XXE-related issues, and document the minimum safe version in the manifest or lockfile. In addition, review the document parsing path for safe XML handling and add dependency scanning in CI to detect vulnerable versions before release.","code_snippet":null,"intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"40e2269a235bdb713968e94ccbee31f06bcd8e52d328948e5240e430e45bf1df","occurrences":[{"file":"requirements.txt","start_line":1,"end_line":null}]},{"id":"SC1","finding_id":"finding-79dab4d326f145079222f6780b6ccc00","category":"Supply Chain","pattern":"Unpinned Dependencies","severity":"LOW","confidence":0.96,"location":{"file":"requirements.txt","start_line":2,"end_line":null},"finding":"olefile>=0.46\n","explanation":"This dependency is also unpinned, so installations are not reproducible and may pull in unexpected future releases. While not an immediate exploit by itself, it weakens supply-chain control and can expose the skill to newly introduced vulnerabilities or breakage.","remediation":"Pin olefile to a specific reviewed version or maintain a lockfile that records exact resolved versions and integrity hashes. Regularly audit and update the pinned version through a controlled dependency management process.","code_snippet":"python-docx>=0.8.11\nolefile>=0.46","intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"6e18e53c2bd03d858953626a4cd8923aa005790947d9b7ab441236d6d126011c","occurrences":[{"file":"requirements.txt","start_line":2,"end_line":null}]}],"suppressed_count":0,"suppressed":[],"metadata":{"has_executable_scripts":true,"skillspector_version":"2.11.2","llm_requested":true,"llm_available":true,"meta_analysis_applied":true,"inference_usage":[{"node":"mcp_tool_poisoning","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":507,"completion_tokens":202,"cached_tokens":0,"reasoning_tokens":0,"total_tokens":709},{"node":"mcp_tool_poisoning","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":2016,"complet