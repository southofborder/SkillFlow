{"skill":{"slug":"automate-excel","displayName":"Automate Excel"},"version":{"version":"0.1.3","createdAt":1772774736664,"changelog":"Initial public release with a comprehensive toolkit of Excel and CSV batch automation scripts.\n\n- Added 18+ command line scripts for Excel/CSV tasks: merging, conversion, deduplication, filtering, aggregation, validation, splitting, VLOOKUP, renaming sheets, formatting, and template fill.\n- Provided ready-to-use code samples and detailed usage guides in SKILL.md.\n- Included requirements.txt for easy dependency installation.\n- All scripts operate independently and support command line arguments for flexible batch processing.","changelogSource":"auto","license":null,"files":[{"path":"SKILL.md","size":8629,"sha256":"44090d00159a70aa607bca6bfc8637770f1c11be12fe0ff57a5ef392ce8bc42d","contentType":"text/plain"},{"path":"examples.md","size":5664,"sha256":"b66536d4c2840975963db14f11db927180e77bdbfd1afc3ae84e228fa7011bf2","contentType":"text/plain"},{"path":"reference.md","size":6110,"sha256":"93f3c679c0f9646f829578904bbd4d2fc9c0f7ac55f3cb61b3918b9bd6732131","contentType":"text/plain"},{"path":"requirements.txt","size":42,"sha256":"5c51994177be4eca9a434d998c236f52638423cfa1e1861ea1ec62bf828de898","contentType":"text/plain"},{"path":"scripts/_make_test_data.py","size":2083,"sha256":"e29d29bb10276af3ba6ac5a03425347e6b069957996966893dfcad65b9a489b2","contentType":"text/plain"},{"path":"scripts/aggregate_excel.py","size":2802,"sha256":"ec73efec6780d7e457fe48d21c40799f0b4287d5eddad105109b83c0e0756a29","contentType":"text/plain"},{"path":"scripts/csv_to_excel.py","size":2415,"sha256":"4bdc1803c0e1d9cd1479acf8e5463a8be857bf1c9115d8f93755be4633be30e3","contentType":"text/plain"},{"path":"scripts/deduplicate_excel.py","size":2079,"sha256":"78e4ac5855f0b1a4f815397bbcc7d914c7c5009008c2f5b2d4095149d476e0de","contentType":"text/plain"},{"path":"scripts/excel_to_csv.py","size":1438,"sha256":"c42a71ba2d2275a2d9b91be7f53a9edca3ad5bb017fa7cfaac9428c02423c