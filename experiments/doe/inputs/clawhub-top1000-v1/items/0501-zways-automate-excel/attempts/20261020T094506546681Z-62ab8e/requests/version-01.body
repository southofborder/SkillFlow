lain"},{"path":"skill-card.md","size":2379,"sha256":"95d817d73aa80c4c6fa6ea80cb231e702d6e087a3d8be2dc94690cb812f93b79","contentType":"text/markdown"}],"security":{"status":"suspicious","hasWarnings":true,"checkedAt":1789107619358,"model":null,"hasScanResult":true,"sha256hash":"291a007829e8cbebfb6900047eef940294ce627009c3ec9f021ac1ccbfdcf7a5","virustotalUrl":"https://www.virustotal.com/gui/file/291a007829e8cbebfb6900047eef940294ce627009c3ec9f021ac1ccbfdcf7a5","scanners":{"vt":{"status":"clean","verdict":null,"normalizedStatus":"clean","analysis":null,"source":"engines","checkedAt":1780085721991},"skillspector":{"status":"suspicious","normalizedStatus":"suspicious","score":71,"severity":"HIGH","recommendation":"DO_NOT_INSTALL","issueCount":31,"checkedAt":1789107619358},"llm":{"status":"suspicious","verdict":"suspicious","normalizedStatus":"suspicious","confidence":"high","summary":"This Excel automation skill is mostly coherent, but it can overwrite workbooks and can carry unsafe formula-like data into generated Excel files.","dimensions":[{"detail":"Local filesystem reads and writes are proportional to spreadsheet processing, and directory handling is limited to Excel files under user-provided paths; no network, credential, or profile access was found.","label":"Credentials","name":"environment_proportionality","rating":"note"},{"detail":"Installation uses standard Python dependencies from requirements files, with no remote payload retrieval found, but the dependencies are lower-bound only and not pinned or hash-verified.","label":"Install Mechanism","name":"install_mechanism","rating":"note"},{"detail":"The skill broadly activates for spreadsheet/table processing and includes write, merge, format, and batch workflows; user-directed paths are required, but overwrite and output-target confirmation is not consistently enforced by the scripts.","label":"Instruction Scope","name":"instruction_scope","rating":"note"},{"detail":"No background persistence, privilege escalation, or tool hijacking was found, but rename_sheets.py, format_conditional.py, and format_columns_as_text.py default to saving over the input workbook when --output is omitted.","label":"Persistence & Privilege","name":"persistence_privilege","rating":"note"},{"detail":"The scripts match the stated Excel automation purpose, but csv_to_excel.py and template_fill.py write untrusted CSV/template data into workbooks without neutralizing formula-like values, creating a spreadsheet formula-injection risk when outputs are opened.","label":"Purpose & Capability","name":"purpose_capability","rating":"concern"}],"guidance":"Review before installing if you will process untrusted CSV, Excel, or template data. Use explicit output paths, keep backups before formatting or renaming workbooks, avoid opening generated files from untrusted inputs unless formula-like values are escaped, and consider pinning dependencies before use in sensitive environments.","findings":"[SQP-1] expected: The trigger is broad for spreadsheet work, but it aligns with the skill purpose; agents should still confirm file paths and requested write actions before use.\n[SQP-2] expected: File creation and modification are core to this skill, and default overwrite behavior is disclosed in script help/reference for some tools, but it remains a user-control risk if invoked without explicit output choices.\n[SQP-3] unexpected: Chinese-only documentation and CLI text are a usability/localization limitation, not evidence of hidden or malicious behavior.\n[AST3] expected: The dynamic import is a fixed __import__(\"openpyxl\") call in a test-data generator, not user-controlled dynamic loading.\n[T09] unexpected: The CSV-to-Excel and template-fill scripts do not escape formula-like values, so untrusted spreadsheet data can become active formulas in generated workbooks.\n[T08] expected: The named dependencies are normal for Excel processing, but unpinned and unhashed requirements reduce reproducibility and supply-chain assurance.\n[SC1] expected: openpyxl, pandas, and xlrd are purpose-aligned dependencies, but version ranges are not pinned.\n[SC4] expected: Historical dependency advisory concerns are not evidence of malicious code in the artifact, but pinning reviewed versions would improve assurance.","agenticRiskFindings":null,"riskSummary":null,"model":null,"checkedAt":1789107619358}}}}}