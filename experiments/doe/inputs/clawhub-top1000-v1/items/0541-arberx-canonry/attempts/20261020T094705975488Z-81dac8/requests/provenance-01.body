eferences/server-side-traffic.md","start_line":482,"end_line":null}]},{"id":"E1","finding_id":"finding-43729710001f4b788a29a6a7ea03a3e3","category":"Data Exfiltration","pattern":"External Transmission","severity":"MEDIUM","confidence":0.6,"location":{"file":"references/server-side-traffic.md","start_line":687,"end_line":null},"finding":"curl -sS -o /dev/null -w '%{http_code}\\n' \\\n  \"https://www.example.com${CANONRY_QUEUE_SMOKE_PATH}?utm_source=chatgpt\"\n\nsleep 2\ncnry traffic sync <project> --source <source-id>\ncnry traffic events <pro","explanation":"Data is being sent to an external URL. This could be legitimate telemetry or data exfiltration. Manual review is recommended.","remediation":"Verify the destination URL is trusted and necessary. Remove or replace with documented APIs. Ensure no secrets, tokens, or PII are transmitted.","code_snippet":"```bash\nCANONRY_QUEUE_SMOKE_PATH=\"/canonry-cloudflare-queue-smoke/$(date -u +%Y%m%dT%H%M%SZ)\"\n\ncurl -sS -o /dev/null -w '%{http_code}\\n' \\\n  \"https://www.example.com${CANONRY_QUEUE_SMOKE_PATH}?utm_source=chatgpt\"\n\nsleep 2","intent":null,"tags":["Data Exfiltration","llm-unconfirmed"],"evidence":{},"match_fingerprint":"4e7768fc5030080517b7335f811d28826d307746043e55541c40a070ac7994bb","occurrences":[{"file":"references/server-side-traffic.md","start_line":687,"end_line":null}]},{"id":"RA2","finding_id":"finding-7afd41346aed4c8b989c15f64303f5f5","category":"Rogue Agent","pattern":"Session Persistence","severity":"MEDIUM","confidence":0.6,"location":{"file":"references/wordpress-integration.md","start_line":7,"end_line":null},"finding":"write page content, titles, slugs, and status\n- Audit pages for `noindex`, missing SEO title, missing meta description, missing schema, and thin content\n- Compare live vs staging for a page with `cnry","explanation":"Skill establishes unauthorized persistence across sessions via cron jobs, startup scripts, or state files. Session persistence allows an attacker to maintain access beyond the current interaction.","remediation":"Remove any persistence mechanisms (cron jobs, startup scripts, state files). Skills should not maintain state across sessions without explicit user consent.","code_snippet":"\n## What Canonry Automates\n\n- Read and write page content, titles, slugs, and status\n- Audit pages for `noindex`, missing SEO title, missing meta description, missing schema, and thin content\n- Compare live vs staging for a page with `cnry wordpress diff`\n- Update SEO meta when the site exposes writable REST meta fields","intent":null,"tags":["Rogue Agent","llm-unconfirmed"],"evidence":{},"match_fingerprint":"19d375920e252a72450fcf5160468f9802013cdf06b9892c2d07a9b71ff6ea38","occurrences":[{"file":"references/wordpress-integration.md","start_line":7,"end_line":null}]},{"id":"EA3","finding_id":"finding-130b0dcb6eb44fcaa92dc84ebd6d3322","category":"Excessive Agency","pattern":"Scope Creep","severity":"LOW","confidence":0.7,"location":{"file":"references/canonry-cli.md","start_line":1100,"end_line":null},"finding":"not limited to","explanation":"Skill's behavior or capabilities extend beyond its stated purpose. Scope creep allows an agent to perform actions unrelated to its documented functionality, increasing the attack surface.","remediation":"Limit the skill's scope to its documented purpose. Remove instructions that enable the agent to perform actions outside its stated functionality.","code_snippet":"\nEvery read command queries persisted DB rows, so a stale `lastSyncedAt` means the response is stale — always check `ga status` before drawing conclusions, and re-`ga sync` if the data is older than the analysis window. Use `--only ai`, `--only social` or `--only search-landing` to refresh just one slice when iterating.\n\n`ga search-landing-pages` reads GA4's Search Console collection, not Canonry's own GSC sync: its clicks come through the GA4 property's Search Console link and can differ from `google performance` for the same days. Active users is GA4's plain `activeUsers` from the same request, which is what GA4's report shows (not limited to Google organic sessions). Search Console data reaches GA4 about two days late, so the last days of each window are thin, exactly as in GA4. A property without a Search Console link is expected to read `unavailable` with Google's message in `error` (inferred, not yet observed from a live unlinked property); the previous snapshot stays readable beside that status.\n\n## Google Business Profile (Local AEO)\n","intent":null,"tags":["Excessive Agency","llm-unconfirmed"],"evidence":{},"match_fingerprint":"943d9aae8743c129fe98eb6cc5e984f5e35ceba0b44ce4ca00f42b97f0bf3eaf","occurrences":[{"file":"references/canonry-cli.md","start_line":1100,"end_line":null}]}],"suppressed_count":0,"suppressed":[],"metadata":{"has_executable_scripts":false,"skillspector_version":"2.11.2","llm_requested":true,"llm_available":true,"meta_analysis_applied":true,"inference_usage":[{"node":"semantic_developer_intent","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":10779,"completion_tokens":14,"cached_tokens":9984,"reasoning_tokens":0,"total_tokens":10793},{"node":"semantic_developer_intent","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":6386,"completion_tokens":14,"cached_tokens":5888,"reasoning_tokens":0,"total_tokens":6400},{"node":"semantic_developer_intent","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":5384,"completion_tokens":14,"cached_tokens":4864,"reasoning_tokens":0,"total_tokens":5398},{"node":"semantic_developer_intent","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source"