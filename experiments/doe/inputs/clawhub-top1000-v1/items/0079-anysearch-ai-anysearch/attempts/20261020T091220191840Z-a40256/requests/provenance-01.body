d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"scripts/anysearch_cli.py","start_line":24,"end_line":null}]},{"id":"PE3","finding_id":"finding-4341a29de14b4abf9d2031ae1a3ef34d","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.6,"location":{"file":"scripts/anysearch_cli.py","start_line":25,"end_line":null},"finding":".env ","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":"    sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding=\"utf-8\", errors=\"replace\")\n\ndef _load_env():\n    \"\"\"Load API keys from .env files near the skill.\n\n    The documented priority is:\n    --api_key > .env file > environment variable > anonymous.","intent":null,"tags":["Privilege Escalation","llm-unconfirmed"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"scripts/anysearch_cli.py","start_line":25,"end_line":null}]},{"id":"PE3","finding_id":"finding-4341a29de14b4abf9d2031ae1a3ef34d","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.6,"location":{"file":"scripts/anysearch_cli.py","start_line":531,"end_line":null},"finding":".env ","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":"    sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding=\"utf-8\", errors=\"replace\")\n\ndef _load_env():\n    \"\"\"Load API keys from .env files near the skill.\n\n    The documented priority is:\n    --api_key > .env file > environment variable > anonymous.","intent":null,"tags":["Privilege Escalation","llm-unconfirmed"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"scripts/anysearch_cli.py","start_line":531,"end_line":null}]},{"id":"PE3","finding_id":"finding-c3abc257305a42e28830d614fa6793c7","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.84,"location":{"file":"scripts/anysearch_cli.sh","start_line":50,"end_line":null},"finding":".env ","explanation":"The .env loader exports any non-empty key/value pair from .env or ../.env without validation, allowing untrusted repository content to set arbitrary environment variables for all subsequent subprocesses. In an agent/skill context, this broad environment injection is dangerous because variables like BASH_ENV, CURL_HOME, SSL_CERT_FILE, or proxy-related settings can alter curl/jq behavior, redirect traffic, weaken trust boundaries, or influence later tool execution beyond the intended API key configuration.","remediation":"Do not export arbitrary .env entries. Replace the generic export with an explicit allowlist of expected names, e.g. only ANYSEARCH_API_KEY and ANYSEARCH_API_BASE_URL, validate values, and ignore dangerous process-control variables. If configuration files must be supported, parse them into local shell variables instead of exporting them globally to child processes.","code_snippet":"        val=\"${val#\"${val%%[!\\\"\\']*}\"}\"\n        val=\"${val%\"${val##*[!\\\"\\']}\"}\"\n        val=\"$(_trim \"$val\")\"\n        # Skip empty values so an empty .env entry does not clobber a real\n        # environment variable.\n        [[ -n \"$key\" && -n \"$val\" ]] && export \"$key=$val\"\n      done < \"$env_path\"","intent":null,"tags":["Privilege Escalation"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"scripts/anysearch_cli.sh","start_line":50,"end_line":null}]},{"id":"PE3","finding_id":"finding-d7e559b68026464394e0653cc2fef950","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.98,"location":{"file":"scripts/shared/doc_spec.md","start_line":236,"end_line":null},"finding":".env ","explanation":"The instruction to save an auto-registered API key to .env causes the agent to collect and persist credentials locally, which fits credential access/storage behavior beyond the minimum needed for the skill. In an agent environment, this is more dangerous because local secret files may be readable by other tools, workflows, backups, or accidental repository commits, turning a transient token into a durable secret exposure risk.","remediation":"Prohibit automatic writing of credentials to local files. Keep returned API keys ephemeral unless the user explicitly opts in, use a dedicated secrets manager or platform credential store for any persistence, and redact keys from outputs, logs, and traces.","code_snippet":"---\n\n## Rate Limit Handling\n- On rate limit error with auto_registered api_key in response: present key to user for approval, then save to .env and retry\n- On anonymous quota exhausted: inform user that a key provides higher limits; suggest configuring one via .env or environment variable","intent":null,"tags":["Privilege Escalation"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"scripts/shared/doc_spec.md","start_line":236,"end_line":null}]},{"id":"PE3","finding_id":"finding-1d2d39c862194d569bbcfef26b9c844b","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.89,"location":{"file":"scripts/shared/doc_spec.md","start_line":237,"end_line":null},"finding":".env ","explanation":"Suggesting configuration via .env or environment variable is less severe than automatically writing secrets, but it still normalizes plaintext local secret storage without safety guidance. In isolation this is common practice, yet in an agent skill spec it can encourage insecure credential handling unless accompanied by warnings and safer alternatives.","remediation":"Retain environment-variable support but add secure-handling guidance: prefer platform secret injection or a credential store, warn that .env contains plaintext secrets, recommend .gitignore protection, and avoid instructing agents to create or modify .env automatically.","code_snippet":"\n## Rate Limit Handling\n- On rate limit error with auto_registered api_key in response: present key to user for approval, then save to .env and retry\n- On anonymous quota exhausted: inform user that a key provides higher limits; suggest configuring one via .env or environment variable","intent":null,"tags":["Privilege Escalation"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"scripts/shared/doc_spec.md","start_line":237,"end_line":null}]},{"id":"E2","finding_id":"finding-79feb1ac25954562a2606a50cb7f1266","category":"Data Exfiltration","pattern":"Env Variable Harvesting","severity":"HIGH","confidence":0.6,"location":{"file":"scripts/test_cli.py","start_line":213,"end_line":213},"finding":"os.environ.copy()","explanation":"Code enumerates, copies, or searches environment variables for secrets. Bulk environment access can collect credentials unrelated to the skill's stated purpose.","remediation":"Read only explicitly required environment variables by name. Avoid enumerating or copying the full environment, and never log or transmit credentials to untrusted destinations.","code_snippet":"\n\ndef run(command, args, base_url):\n    env = os.environ.copy()\n    env[\"ANYSEARCH_API_BASE_URL\"] = base_url\n    env.pop(\"ANYSEARCH_API_KEY\", None)\n    return subprocess.run(","intent":null,"tags":["Data Exfiltration","llm-unconfirmed"],"evidence":{},"match_fingerprint":"23b3d476caf63d859a2a3bade37548b7986b00b138b45df1b6a49782c4e2984b","occurrences":[{"file":"scripts/test_cli.py","start_line":213,"end_line":213}]},{"id":"EA2","finding_id":"finding-fd20ccd169e548f7b3250f39dbe0c6d1","category":"Excessive Agency","pattern":"Autonomous Decision Making","severity":"MEDIUM","confidence":0.85,"location":{"file":"README.md","start_line":11,"end_line":null},"finding":"no verification","explanation":"Advertising that the AI agent will complete registration automatically with 'no verification code required' encourages autonomous account creation with minimal user friction. In an agent ecosystem, reducing verification and promoting automatic completion increases the risk of unintended external actions, mistaken signup with the wrong identity, and silent transmission of personal data.","remediation":"Remove language that encourages automatic completion by default, and require explicit user confirmation before initiating registration. Add a consent checkpoint that states what data will be sent, what account will be created, and that anonymous use remains available.","code_snippet":"\n**[IMPORTANT!] Registration instructions can be found in this section: ### Register for an API Key (Recommended)**\n\nGet started in 30 seconds: Register with just an email address. The AI agent will complete the whole process automatically, no verification code required.\n\n[Jump to registration steps →](#register-for-an-api-key-recommended)\n","intent":null,"tags":["Excessive Agency"],"evidence":{},"match_fingerprint":"e632c41fa2bd2e83dae197a127308a9708429db61e7967e12888dfcd5ce5c64b","occurrences":[{"file":"README.md","start_line":11,"end_line":null}]},{"id":"E1","finding_id":"finding-0ce6e7751a9e4175a1569fae1d2b4191","category":"Data Exfiltration","pattern":"External Transmission","severity":"MEDIUM","confidence":0.6,"location":{"file":"README.md","start_line":24,"end_line":null},"finding":"curl -L -o anysearch-skill.zip https://github.com/anysearch-ai/anysearch-skill/archive/refs/tags/v3.1.1.zip\n# or: wget -O anysearch-skill.zip https://github.com/anysearch-ai/anysearch-skill/archive/re","explanation":"Data is being sent to an external URL. This could be legitimate telemetry or data exfiltration. Manual review is recommended.","remediation":"Verify the destination URL is trusted and necessary. Remove or replace with documented APIs. Ensure no secrets, tokens, or PII are transmitted.","code_snippet":"```bash\n# Download a pinned release (recommended). Replace v3.1.1 with the latest tag\n# from https://github.com/anysearch-ai/anysearch-skill/releases\ncurl -L -o anysearch-skill.zip https://github.com/anysearch-ai/anysearch-skill/archive/refs/tags/v3.1.1.zip\n# or: wget -O anysearch-skill.zip https://github.com/anysearch-ai/anysearch-skill/archive/refs/tags/v3.1.1.zip\n# (For the latest unreleased changes, use .../archive/refs/heads/main.zip instead.)\n","intent":null,"tags":["Data Exfiltration","llm-unconfirmed"],"evidence":{},"match_fingerprint":"edc83bd9fdbd3181461c3126bff10e248aa0656ad91d9898bb6eb02ccba3a77b","occurrences":[{"file":"README.md","start_line":24,"end_line":null}]},{"id":"EA2","finding_id":"finding-26e1af7908354bb598f15dd42570b4d8","category":"Excessive Agency","pattern":"Autonomous Decision Making","severity":"MEDIUM","confidence":0.89,"location":{"file":"README.md","start_line":55,"end_line":null},"finding":"no verification","explanation":"This instruction explicitly authorizes the agent to register the user and obtain credentials in a single call using a real email address. That is a true autonomy risk because it combines identity submission, third-party account creation, and secret retrieval in one agent-driven step, making accidental or unauthorized action more likely.","remediation":"Gate registration behind explicit opt-in and per-action confirmation, especially before transmitting a real email address or creating an external account. Separate the steps for consent, data submission, and key retrieval, and document a manual registration alternative.","code_snippet":"\n### Register for an API Key (Recommended)\n\nThe agent can register the user and obtain an API key in a **single call** — no verification code, no manual signup. Ask the user for a **real email address**: it becomes the account username.\n\n```bash\ncurl -s -X POST \"https://api.anysearch.com/v1/auth/email/register\" \\","intent":null,"tags":["Excessive Agency"],"evidence":{},"match_fingerprint":"e632c41fa2bd2e83dae197a127308a9708429db61e7967e12888dfcd5ce5c64b","occurrences":[{"file":"README.md","start_line":55,"end_line":null}]},{"id":"E1","finding_id":"finding-af10a3d55440454494dbf5c449ad6224","category":"Data Exfiltration","pattern":"External Transmission","severity":"MEDIUM","confidence":0.84,"location":{"file":"README.md","start_line":58,"end_line":null},"finding":"https://api.anysearch.com/","explanation":"The skill directs the agent to send a user's real email address to an external registration endpoint and automates account creation in a single call. In the skill context, this is sensitive because it causes transmission of personally identifiable information to a third party and encourages autonomous signup without strong consent or privacy warnings.","remediation":"Require explicit user consent immediately before sending the email, explain that the address will be transmitted to AnySearch for account creation, and provide a clear anonymous-use path as the default. Document retention/privacy expectations and avoid performing registration automatically unless the user expressly requests it.","code_snippet":"The agent can register the user and obtain an API key in a **single call** — no verification code, no manual signup. Ask the user for a **real email address**: it becomes the account username.\n\n```bash\ncurl -s -X POST \"https://api.anysearch.com/v1/auth/email/register\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"email\": \"you@example.com\"}'\n```","intent":null,"tags":["Data Exfiltration"],"evidence":{},"match_fingerprint":"4d9dcca063e6eccb6975dd7c397dfbdf03be908ca5675db3d3de0cdfaf6ae9b1","occurrences":[{"file":"README.md","start_line":58,"end_line":null}]},{"id":"SQP-2","finding_id":"finding-5e9fd1efdd6942a7933a9b974f55d60d","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.91,"location":{"file":"README.md","start_line":87,"end_line":90},"finding":null,"explanation":"The README explicitly instructs the agent to persist a one-time plaintext API key into a local `.env` file, but does not include meaningful warnings about secret handling, filesystem exposure, or least-privilege storage. In an agent context, this increases the chance that credentials are written automatically to insecure locations, later read by other tools, or accidentally committed/logged.","remediation":"Add explicit secret-handling guidance: prefer OS secret stores or ephemeral environment injection over writing to disk, warn that `.env` contains sensitive credentials, and require user confirmation before persisting keys. If `.env` storage is supported, document restrictive file permissions, gitignore requirements, and avoidance of logging or echoing the key.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"README.md","start_line":87,"end_line":90}]},{"id":"E1","finding_id":"finding-a3b64c8a36b34bd18ebbac3d5176c4e2","category":"Data Exfiltration","pattern":"External Transmission","severity":"MEDIUM","confidence":0.6,"location":{"file":"README_zh.md","start_line":24,"end_line":null},"finding":"curl -L -o anysearch-skill.zip https://github.com/anysearch-ai/anysearch-skill/archive/refs/tags/v3.1.1.zip\n# 或使用：wget -O anysearch-skill.zip https://github.com/anysearch-ai/anysearch-skill/archive/re","explanation":"Data is being sent to an external URL. This could be legitimate telemetry or data exfiltration. Manual review is recommended.","remediation":"Verify the destination URL is trusted and necessary. Remove or replace with documented APIs. Ensure no secrets, tokens, or PII are transmitted.","code_snippet":"```bash\n# 下载指定版本发布包（推荐）。请将 v3.1.1 替换为最新 tag\n# 最新 tag 见 https://github.com/anysearch-ai/anysearch-skill/releases\ncurl -L -o anysearch-skill.zip https://github.com/anysearch-ai/anysearch-skill/archive/refs/tags/v3.1.1.zip\n# 或使用：wget -O anysearch-skill.zip https://github.com/anysearch-ai/anysearch-skill/archive/refs/tags/v3.1.1.zip\n# （如需获取尚未发布的最新改动，请改用 .../archive/refs/heads/main.zip。）\n","intent":null,"tags":["Data Exfiltration","llm-unconfirmed"],"evidence":{},"match_fingerprint":"1e4449e6fd85c8dbd6b1cf234759831a612452da5192e6deb89d3d125f2453d6","occurrences":[{"file":"README_zh.md","start_line":24,"end_line":null}]},{"id":"SQP-2","finding_id":"finding-099a72ad83104e638124dc7f89829b73","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"README_zh.md","start_line":55,"end_line":90},"finding":null,"explanation":"The README instructs the agent to collect a real email address, transmit it to an external registration endpoint, receive a plaintext API key, and persist that secret to a local .env file. This creates privacy and secret-handling risk because it normalizes automatic credential enrollment and local storage without explicit consent, data-minimization guidance, or warnings about how long the email and key may remain on disk.","remediation":"Require explicit user consent before registration and before storing any credential. Prefer manual signup or a user-opened browser flow, explain what data is sent externally, avoid mandatory persistence, and store keys in a secure secret store instead of writing plaintext to .env by default.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"README_zh.md","start_line":55,"end_line":90}]},{"id":"E1","finding_id":"finding-75dfcae7447b405cac7cbf39f2b0c95f","category":"Data Exfiltration","pattern":"External Transmission","severity":"MEDIUM","confidence":0.93,"location":{"file":"README_zh.md","start_line":58,"end_line":null},"finding":"https://api.anysearch.com/","explanation":"This instruction sends a real user email address to a third-party registration API and initiates account creation automatically. In an agent context, external transmission of personal data is more sensitive because the skill encourages one-shot registration without emphasizing consent, privacy notice review, or alternative non-identifying flows.","remediation":"Obtain explicit consent before sending any personal data, clearly disclose the recipient and purpose, and prefer a user-driven registration flow. If anonymous mode exists, present it as the default privacy-preserving option rather than pushing automatic registration.","code_snippet":"智能体可以在**一次调用**中完成用户注册并获取 API key —— 无需验证码，无需手动注册。向用户索取一个**真实邮箱地址**：它将作为账户用户名。\n\n```bash\ncurl -s -X POST \"https://api.anysearch.com/v1/auth/email/register\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"email\": \"you@example.com\"}'\n```","intent":null,"tags":["Data Exfiltration"],"evidence":{},"match_fingerprint":"4d9dcca063e6eccb6975dd7c397dfbdf03be908ca5675db3d3de0cdfaf6ae9b1","occurrences":[{"file":"README_zh.md","start_line":58,"end_line":null}]},{"id":"P9","finding_id":"finding-49e93e814aea460584657f637284b8ff","category":"Prompt Injection","pattern":"Whitespace Padding","severity":"MEDIUM","confidence":0.7,"location":{"file":"README.md","start_line":94,"end_line":null},"finding":"U+0020 x90","explanation":"Large whitespace padding was detected (a block of blank lines or a long run of spaces). This can push injected instructions below or to the right of the visible area so a human reviewer never sees them while the agent still reads them. Manual review of the hidden content is recommended.","remediation":"Remove the large whitespace padding (blank-line blocks or long space runs) and review any content hidden below or to the right of it. Keep skill files compact and reviewable so no instructions can be concealed off-screen.","code_snippet":"\n错误处理（出错时 `code` 始终为 `-1`；根据 `message` 字符串分支处理）：\n\n| message                           | 处理方式                                                                                          |\n| --------------------------------- | --------------------------------------------------------------------------------------------------- |\n| `Invalid email address.`          | 请用户重新输入邮箱                                                                                  |\n| `email_already_registered`        | 邮箱已被占用 —— 告知用户在 `login_url` 登录；**不要**重试                          |","intent":null,"tags":["Prompt Injection","llm-unconfirmed"],"evidence":{},"match_fingerprint":"4b9fc95cce8fa0c1ade4d80d5e60e48c11e868e00bf84c742fcbe925080b223f","occurrences":[{"file":"README.md","start_line":94,"end_line":null}]},{"id":"P9","finding_id":"finding-49e93e814aea460584657f637284b8ff","category":"Prompt Injection","pattern":"Whitespace Padding","severity":"MEDIUM","confidence":0.7,"location":{"file":"README_zh.md","start_line":94,"end_line":null},"finding":"U+0020 x90","explanation":"Large whitespace padding was detected (a block of blank lines or a long run of spaces). This can push injected instructions below or to the right of the visible area so a human reviewer never sees them while the agent still reads them. Manual review of the hidden content is recommended.","remediation":"Remove the large whitespace padding (blank-line blocks or long space runs) and review any content hidden below or to the right of it. Keep skill files compact and reviewable so no instructions can be concealed off-screen.","code_snippet":"\n错误处理（出错时 `code` 始终为 `-1`；根据 `message` 字符串分支处理）：\n\n| message                           | 处理方式                                                                                          |\n| --------------------------------- | --------------------------------------------------------------------------------------------------- |\n| `Invalid email address.`          | 请用户重新输入邮箱                                                                                  |\n| `email_already_registered`        | 邮箱已被占用 —— 告知用户在 `login_url` 登录；**不要**重试                          |","intent":null,"tags":["Prompt Injection","llm-unconfirmed"],"evidence":{},"match_fingerprint":"4b9fc95cce8fa0c1ade4d80d5e60e48c11e868e00bf84c742fcbe925080b223f","occurrences":[{"file":"README_zh.md","start_line":94,"end_line":null}]},{"id":"P9","finding_id":"finding-cbaddba8c2b746ba901c96b09b517200","category":"Prompt Injection","pattern":"Whitespace Padding","severity":"MEDIUM","confidence":0.7,"location":{"file":"README_zh.md","start_line":96,"end_line":null},"finding":"U+0020 x82","explanation":"Large whitespace padding was detected (a block of blank lines or a long run of spaces). This can push injected instructions below or to the right of the visible area so a human reviewer never sees them while the agent still reads them. Manual review of the hidden content is recommended.","remediation":"Remove the large whitespace padding (blank-line blocks or long space runs) and review any content hidden below or to the right of it. Keep skill files compact and reviewable so no instructions can be concealed off-screen.","code_snippet":"\n| message                           | 处理方式                                                                                          |\n| --------------------------------- | --------------------------------------------------------------------------------------------------- |\n| `Invalid email address.`          | 请用户重新输入邮箱                                                                                  |\n| `email_already_registered`        | 邮箱已被占用 —— 告知用户在 `login_url` 登录；**不要**重试                          |\n| 包含 `Rate limited`           | 从 message 中读取重试秒数（例如 `\"Rate limited, retry after 300 seconds.\"`），等待后重试 |\n| 以 `Key creation failed.` 开头 | 账户已创建但 key 创建失败 —— 从 message 中提取邮箱和 URL（`\"Key creation failed. Your account <email> was created; sign in at <url>.\"`），告知用户在该地址登录并手动创建 key |","intent":null,"tags":["Prompt Injection","llm-unconfirmed"],"evidence":{},"match_fingerprint":"ecbd6228acb23f55373dca52d1d8bc50346b6a8898e5bd596cd1454a95674072","occurrences":[{"file":"README_zh.md","start_line":96,"end_line":null}]},{"id":"LP3","finding_id":"finding-883fe9c027c2448486b58944a3382108","category":"MCP Least Privilege","pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"The skill exposes broad capabilities—environment access, file read/write, network, and shell execution—without declaring an explicit tool scope or permission boundary. In a skill that is activated for common information-retrieval tasks, this increases the chance that an agent can be induced to perform filesystem or shell actions beyond simple search, especially because the document also instructs saving keys to disk and probing local runtimes.","remediation":"Add explicit permissions or allowed-tools metadata limiting the skill to the minimum required operations. Separate search-only functions from installation/configuration flows, and gate file writes, env access, and shell/runtime detection behind explicit user approval and narrower documented scope.","code_snippet":null,"intent":null,"tags":["ASI02"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"SQP-1","finding_id":"finding-845737f48596476588d3a52d5d9708ba","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.93,"location":{"file":"SKILL.md","start_line":20,"end_line":27},"finding":null,"explanation":"The trigger section is very broad—covering general information retrieval, fact-checking, web browsing, and uncertainty cases—which can cause frequent automatic activation. Because the skill also has network, shell, env, and file-write related operational instructions, over-triggering increases exposure to prompt-injection from web content and unnecessary credential or filesystem interactions.","remediation":"Narrow activation criteria to clearly defined search-specific scenarios and exclude generic requests by default. Require stronger routing conditions for vertical search and extraction, and document that file writes, runtime detection, or configuration steps must never occur during ordinary auto-activation without explicit user consent.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":20,"end_line":27}]},{"id":"SQP-2","finding_id":"finding-b2ca378e054e49a1959dc3c79b460f6a","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.89,"location":{"file":"scripts/anysearch_cli.ps1","start_line":310,"end_line":341},"finding":null,"explanation":"The script sends user-provided search queries and extraction URLs to a remote third-party API, but the CLI itself provides no inline warning, confirmation, or privacy notice at the point of use. In an agent/skill context, this can cause unintended disclosure of sensitive prompts, internal URLs, or user data because operators may assume the tool is local while it actually transmits content off-host.","remediation":"Add explicit user-facing disclosure in help text and command output that queries and URLs are transmitted to Anysearch's external service. Require confirmation or an opt-in flag for URL extraction and clearly document what data is sent, retained, and logged; additionally, validate/redact obviously sensitive inputs before transmission where feasible.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/anysearch_cli.ps1","start_line":310,"end_line":341}]},{"id":"SQP-3","finding_id":"finding-b4de0068518b46409100fe543a16a4b1","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.96,"location":{"file":"scripts/anysearch_cli.sh","start_line":2,"end_line":3},"finding":null,"explanation":"The script unconditionally exports LANG and LC_ALL to en_US.UTF-8, overriding the user's existing locale settings. This is a natural-language/locale policy concern because it enforces a specific locale without offering choice, opt-in, or justification in the file.","remediation":"Avoid overriding LANG/LC_ALL globally, or make the locale override optional and documented. Prefer setting only narrowly scoped locale variables for commands that require it, or honor existing user locale settings unless the user explicitly requests a specific locale.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/anysearch_cli.sh","start_line":2,"end_line":3}]},{"id":"EA4","finding_id":"finding-bac214a6915948aeb05a3bd06d43e267","category":"Excessive Agency","pattern":"Unbounded Resource Access","severity":"MEDIUM","confidence":0.75,"location":{"file":"scripts/anysearch_cli.sh","start_line":66,"end_line":null},"finding":"loop forever","explanation":"Skill allows unbounded resource consumption (API calls, storage, compute). Without rate limits or quotas, a compromised or misbehaving agent can cause denial-of-service or cost overruns.","remediation":"Set explicit rate limits, timeouts, and resource quotas for API calls, file operations, and compute. Implement circuit breakers for runaway loops.","code_snippet":"# `_need_val \"$@\"` from inside an arg loop ($1 = flag, $2 = its value). This is\n# required because on bash 3.2 `shift 2` past the end of the positional list\n# fails WITHOUT decrementing $#, which would otherwise spin a `while [[ $# -gt 0 ]]`\n# arg loop forever (100% CPU) on a trailing value-flag such as `search q --domain`.\n_need_val() {\n  if [[ $# -lt 2 ]]; then\n    echo \"Error: missing value for $1\" >&2","intent":null,"tags":["Excessive Agency","llm-unconfirmed"],"evidence":{},"match_fingerprint":"bf8606359f1586f62d6cc35460abf9efe79d8f62a4bb79e9135d3a7eb705940e","occurrences":[{"file":"scripts/anysearch_cli.sh","start_line":66,"end_line":null}]},{"id":"SDI-2","finding_id":"finding-90e07d2c04cb4309b18c259a5eae9dc5","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.96,"location":{"file":"scripts/shared/doc_spec.md","start_line":236,"end_line":237},"finding":null,"explanation":"The specification instructs the agent to take an API key received during runtime and persist it to a local .env file, which expands the skill’s scope from transient API use into local credential storage. Persisting credentials on disk increases the risk of accidental disclosure through logs, repository inclusion, other tools reading the file, or reuse outside the user’s intent, and this persistence is not necessary for basic search functionality.","remediation":"Do not instruct the agent to automatically save credentials to .env. Limit API keys to in-memory use for the current session unless the user explicitly requests persistence through a separate, consented configuration flow; if persistence is supported, require clear warning/confirmation, store via a secure secrets mechanism, and document handling and scope restrictions.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/shared/doc_spec.md","start_line":236,"end_line":237}]},{"id":"SQP-2","finding_id":"finding-5541efaa23a24bc1a55ca3ec030c9d1d","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"scripts/shared/doc_spec.md","start_line":236,"end_line":237},"finding":null,"explanation":"The doc tells the agent to save an API key to .env but provides no warning about credential sensitivity, local exposure, overwrite risk, or secure storage practices. That omission can lead agents or users to handle secrets unsafely, especially because .env files are commonly copied, committed, or accessed by unrelated processes.","remediation":"Remove automatic persistence guidance or add explicit credential-handling safeguards: require user approval, warn that .env stores plaintext secrets, recommend secure secret stores instead, and ensure .env entries are excluded from version control and not echoed in output or logs.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/shared/doc_spec.md","start_line":236,"end_line":237}]},{"id":"AST4","finding_id":"finding-d1f8498cc4654562b43631e7b8b82ca5","category":"Dangerous Code Execution","pattern":"subprocess module call","severity":"MEDIUM","confidence":0.7,"location":{"file":"scripts/test_cli.py","start_line":216,"end_line":225},"finding":"    return subprocess.run(\n        command + args,\n        cwd=ROOT,\n        env=env,\n        capture_output=True,\n        text=True,\n        encoding=\"utf-8\",\n        errors=\"replace\",\n        timeou","explanation":"subprocess module calls execute external commands. Without careful input validation, this enables command injection.","remediation":"Use subprocess.run() with shell=False and an explicit argument list. Validate all inputs and avoid passing user-controlled data to commands.","code_snippet":"    env = os.environ.copy()\n    env[\"ANYSEARCH_API_BASE_URL\"] = base_url\n    env.pop(\"ANYSEARCH_API_KEY\", None)\n    return subprocess.run(\n        command + args,\n        cwd=ROOT,\n        env=env,","intent":null,"tags":["Dangerous Code Execution","llm-unconfirmed"],"evidence":{},"match_fingerprint":"46c97a82101228dba3f477b713b8e868e9ad0f55043f3dede143ef096f3e3390","occurrences":[{"file":"scripts/test_cli.py","start_line":216,"end_line":225}]},{"id":"SQP-3","finding_id":"finding-59baf27107a446b29e8c8e8cf08653f3","category":null,"pattern":null,"severity":"LOW","confidence":0.8,"location":{"file":"README.md","start_line":5,"end_line":5},"finding":null,"explanation":"The language selector is written as `English | [简体中文]`, which implicitly prioritizes English as the default presentation. Under the stated policy, forcing a specific language without user opt-in can be a natural-language policy concern when no neutral language choice mechanism is offered.","remediation":"Present language selection more neutrally, such as offering equivalent choices without a default assumption, or state that users may choose their preferred language version.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"README.md","start_line":5,"end_line":5}]},{"id":"SQP-3","finding_id":"finding-afb5b44f73404eb186ed7aadfb3c580d","category":null,"pattern":null,"severity":"LOW","confidence":0.88,"location":{"file":"README_zh.md","start_line":5,"end_line":5},"finding":null,"explanation":"L005 将当前文档标注为“简体中文”，未在该文件内说明应根据用户偏好选择语言。按照规则，若技能内容强制特定语言而无用户选择或明确合理限定，可视为自然语言策略问题。","remediation":"在文档中明确说明应根据用户语言偏好选择 README 语言版本，或增加用户可选语言提示，例如注明“可使用英文或中文版本，按用户偏好选择”.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"README_zh.md","start_line":5,"end_line":5}]},{"id":"SQP-2","finding_id":"finding-f79702b867004ad6bfd3f560c7fd4e94","category":null,"pattern":null,"severity":"LOW","confidence":0.82,"location":{"file":"README_zh.md","start_line":174,"end_line":178},"finding":null,"explanation":"L174-L178 指导将推荐运行时写入 `<skill_dir>/runtime.conf`，L216 还要求替换现有文件。该行为会修改本地 skill 配置，文档虽描述了要执行的命令，但未以警告形式提醒会覆盖已有配置，符合 markdown 文件对可能影响系统完整性的行为缺少提示。","remediation":"在该步骤前增加简短提示，说明此操作会创建或覆盖 `<skill_dir>/runtime.conf`，如已有自定义配置应先备份或经用户确认后再执行。","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"README_zh.md","start_line":174,"end_line":178}]},{"id":"SC1","finding_id":"finding-14d58d2241124e11a489da1c281e1487","category":"Supply Chain","pattern":"Unpinned Dependencies","severity":"LOW","confidence":0.96,"location":{"file":"requirements.txt","start_line":4,"end_line":null},"finding":"requests>=2.20\n","explanation":"The dependency is specified as `requests>=2.20`, which allows installation of many different versions over time and does not guarantee a reviewed, known-safe release. This weakens build reproducibility and can inadvertently pull in a vulnerable or behavior-changing version, especially for a network-facing search tool that likely performs outbound HTTP requests.","remediation":"Pin the dependency to a specific vetted version or use a constrained range that excludes known-bad releases, e.g. `requests==<reviewed_version>` or `requests>=<safe_version>,<next_major>`. Maintain the lock/pin through regular dependency review and update workflows.","code_snippet":"# Dependency for the Python CLI (scripts/anysearch_cli.py).\n# The Node.js, Bash and PowerShell CLIs require nothing from this file.\n#   pip install -r requirements.txt\nrequests>=2.20","intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"88ef36e23c388fde283edf48adf131e249e40c8321bb4c49bc69c0a11f461e2d","occurrences":[{"file":"requirements.txt","start_line":4,"end_line":null}]},{"id":"SC4","finding_id":"finding-f12bfc3efdb14a33bdacc2dffc537a68","category":"Supply Chain","pattern":"Unverifiable Dependency: requests has 16 known advisory(ies) (CVE-2014-1830 (Exposure of Sensitive Information to an Unauthorized Actor in Requests); CVE-2024-47081 (Requests vulnerable to .netrc credentials leak via malicious URLs); CVE-2024-35195 (Requests `Session` object does not verify requests after making first request wi) +13 more), but the manifest does not pin a version, so it is unknown whether the installed release is affected","severity":"LOW","confidence":0.93,"location":{"file":"requirements.txt","start_line":4,"end_line":null},"finding":"requests","explanation":"Because `requests` is not pinned, it is not possible to verify whether deployments will receive a version affected by known advisories, including recent credential-leak and session-verification issues. In a skill that performs real-time search and URL fetching, use of an affected HTTP client could expose credentials, weaken transport security expectations, or otherwise increase risk when handling untrusted remote URLs.","remediation":"Pin `requests` to a specific non-vulnerable version after reviewing current advisories, and document/update that version as part of dependency management. Add automated dependency scanning and preferably a lockfile or equivalent reproducible build control so future installs do not drift into vulnerable releases.","code_snippet":null,"intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"09deeb6fdb55899e7b284b11a4a1f240e895ab350d9ef10d889ca4cada77cadd","occurrences":[{"file":"requirements.txt","start_line":4,"end_line":null}]},{"id":"SQP-3","finding_id":"finding-a6ca8d37ca664543bc59052cd6baa1f1","category":null,"pattern":null,"severity":"LOW","confidence":0.77,"location":{"file":"scripts/anysearch_cli.py","start_line":573,"end_line":576},"finding":null,"explanation":"The file exposes locale-affecting options with prescriptive examples like `cn`/`intl` and `zh-CN or en`, but does not clarify that language and region selection are optional user preferences. This can nudge downstream agent behavior toward imposing a locale choice rather than first confirming the user's desired language or region.","remediation":"Document that `--zone` and `--language` are optional user-controlled preferences and require explicit user choice before setting them automatically. If this skill is used by an agent, instruct the agent to preserve the user's current locale unless the user requests a different one.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/anysearch_cli.py","start_line":573,"end_line":576}]},{"id":"SDI-4","finding_id":"finding-5b7ace1fd213429db03b886a4f3edff6","category":null,"pattern":null,"severity":"LOW","confidence":0.96,"location":{"file":"scripts/anysearch_cli.py","start_line":593,"end_line":595},"finding":null,"explanation":"The get_sub_domains parser description says results are returned as a Markdown table with columns including domain, sub_domain, description, query_format, params_schema, and zone. However, the actual formatter builds heading-based sections and parameter bullet lists in _format_capabilities_response rather than any table structure, so the documentation actively misdescribes the command's behavior.","remediation":"Update the get_sub_domains description to match the actual heading/list output, or change _format_capabilities_response to render the documented Markdown table and include the promised fields.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/anysearch_cli.py","start_line":593,"end_line":595}]},{"id":"SDI-4","finding_id":"finding-052964cff5ec4867a3059e2e87f5c289","category":null,"pattern":null,"severity":"LOW","confidence":0.88,"location":{"file":"scripts/anysearch_cli.py","start_line":643,"end_line":645},"finding":null,"explanation":"The batch_search description states each query uses the same structure as search and explicitly lists domain and sub_domain. In code, _normalize_search_item only forwards query, tag/sub_domain, params, zone, language, and max_results; any injected or provided domain field is ignored unless a sub_domain/tag is also present, so the documented per-item structure does not match actual behavior.","remediation":"Either support domain semantics in batch_search consistently with search, or revise the batch_search help text to remove or qualify domain as a supported per-item field.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/anysearch_cli.py","start_line":643,"end_line":645}]},{"id":"SQP-2","finding_id":"finding-87b7cfc846644378b74e12df05399151","category":null,"pattern":null,"severity":"LOW","confidence":0.83,"location":{"file":"scripts/anysearch_cli.sh","start_line":147,"end_line":152},"finding":null,"explanation":"This shell script sends supplied search queries, extraction URLs, and possibly related parameters to a remote Anysearch API via curl, but the operational code does not include any explicit user-facing warning at the point of transmission. Although network access is central to the tool's purpose, the script itself lacks a print statement, prompt, or inline disclosure that user-provided content will be sent off-box.","remediation":"Add a brief user-visible notice in the CLI help or before request execution stating that provided queries/URLs and selected parameters are transmitted to the configured Anysearch API endpoint. If this is documented elsewhere, ensure the warning is easy to discover from this script's help output.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/anysearch_cli.sh","start_line":147,"end_line":152}]},{"id":"SQP-3","finding_id":"finding-6dd9cb6f99d1406fb1b11d225df95daa","category":null,"pattern":null,"severity":"LOW","confidence":0.77,"location":{"file":"scripts/shared/doc_spec.md","start_line":5,"end_line":5},"finding":null,"explanation":"The document states that CLI output remains Markdown for agent compatibility, and the specification overall is written as a fixed output convention without offering locale or language choice. Because the skill also exposes a --language option for results, the absence of any user opt-in or documented locale policy can create a language/locale policy concern if the agent is expected to adapt to user language preferences.","remediation":"Clarify that output language should follow the user's preference when possible, or explicitly document and justify any fixed locale/output-langu