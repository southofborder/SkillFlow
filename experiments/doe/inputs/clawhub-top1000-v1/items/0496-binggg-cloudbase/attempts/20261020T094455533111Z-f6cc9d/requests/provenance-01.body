"references/ai-model-web/SKILL.md","start_line":237,"end_line":null},"finding":".env.local ","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":"\nconst app = cloudbase.init({\n  env: \"<YOUR_ENV_ID>\",\n  accessKey: import.meta.env.VITE_PUBLISHABLE_KEY  // auto-provision via queryAppAuth / manageAppAuth, write to .env.local (see auth-web-cloudbase prerequisites)\n});\n\nconst auth = app.auth;","intent":null,"tags":["Privilege Escalation","llm-unconfirmed"],"evidence":{},"match_fingerprint":"021f7ffa4122cf8ed26ecae08a0a46ff9aa27fee40f717ab4c3bff5f82c6550e","occurrences":[{"file":"references/ai-model-web/SKILL.md","start_line":237,"end_line":null}]},{"id":"SQP-2","finding_id":"finding-b429037470e943e6813ce629185cf64f","category":null,"pattern":null,"severity":"HIGH","confidence":0.95,"location":{"file":"references/cloud-api-operations/references/calling-methods.md","start_line":106,"end_line":106},"finding":null,"explanation":"The document explicitly instructs exposing temporary credentials in plaintext with `reveal=true` and says to feed the returned STS secrets directly into SDKs. Even though STS credentials are temporary, disclosing them in conversational output or logs materially increases the risk of secret leakage, replay, and unauthorized cloud API access during their validity window.","remediation":"Remove or strongly gate plaintext secret disclosure guidance. Instruct users to retrieve temporary credentials only through secure secret-handling channels, avoid printing them in chat/logs, redact by default, and require explicit high-friction confirmation plus a warning that exposed credentials are sensitive and must not be pasted into shared transcripts.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"references/cloud-api-operations/references/calling-methods.md","start_line":106,"end_line":106}]},{"id":"PE3","finding_id":"finding-30150deaffe84aefa8eb9b235a981a72","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.6,"location":{"file":"references/cloudbase-agent/py/adapter-coze.md","start_line":122,"end_line":null},"finding":".env\n","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":"For production, use environment variables:\n\n```bash\n# .env\nCOZE_BOT_ID=bot_1234567890\nCOZE_API_KEY=sk-1234567890\nCOZE_BASE_URL=https://api.coze.com  # optional","intent":null,"tags":["Privilege Escalation","llm-unconfirmed"],"evidence":{},"match_fingerprint":"66ef81c27c03406fd9935e5fc86fc4126d7150c15b8d076fdc528d05cea7c7bf","occurrences":[{"file":"references/cloudbase-agent/py/adapter-coze.md","start_line":122,"end_line":null}]},{"id":"PE3","finding_id":"finding-30150deaffe84aefa8eb9b235a981a72","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.6,"location":{"file":"references/cloudbase-agent/py/adapter-langgraph.md","start_line":544,"end_line":null},"finding":".env\n","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":"For production, use environment variables:\n\n```bash\n# 