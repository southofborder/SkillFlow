{"skill":{"slug":"torchmarket","displayName":"Torch Market"},"version":{"version":"11.1.0","createdAt":1779233680500,"changelog":"- Updated SDK to torchsdk@^11.1.0 and all installation instructions.\n- Added new files: lib/torchsdk/events.d.ts, lib/torchsdk/events.js, and verification.md.\n- Removed VERIFICATION.md.\n- No user-facing functionality changes documented.","changelogSource":"user","license":"MIT-0","files":[{"path":"risk.md","size":24704,"sha256":"00941f4c91102d4c589e61b5a950f68af1d5c1a541f181a64976f946e5a919bf","contentType":"text/markdown"},{"path":"audit_sdk.md","size":62258,"sha256":"395ef5fbe7121fac9bfde4d0488dce16a86a5f76d8e996676e61835fddc096fa","contentType":"text/markdown"},{"path":"agent.json","size":12841,"sha256":"eeb37af79a5627dda69435385aac0bc1bbffb8f7050b69cc7d6b3732101dc973","contentType":"application/json"},{"path":"verification.md","size":27937,"sha256":"0583874d8286ba475043c58dd6739a303fa41353ce7d41c3dd150c7ce85dee90","contentType":"text/markdown"},{"path":"audit_program.md","size":95851,"sha256":"6473cddf458b3f2b33b13e4a528541e6ad2e29abde5f401ac23adbd1f480edd3","contentType":"text/markdown"},{"path":"SKILL.md","size":12019,"sha256":"ef529ef400cff66a30480e5c1e611da1df71a3c5e99a3878c27439d2829d9ef7","contentType":"text/markdown"},{"path":"lib/torchsdk/constants.js","size":6441,"sha256":"ceb8404e9bc6f1fb46521f0cd6ec4f17e8ddf54e303c2c0569f760f91e1bd6fa","contentType":"text/javascript"},{"path":"lib/torchsdk/constants.d.ts","size":1521,"sha256":"07d7e309f8c35f5fea89e7543ecb7627c4943d746828876067ae0e3b816d4ca4","contentType":"application/typescript"},{"path":"lib/torchsdk/events.js","size":2122,"sha256":"8af3de37098d8f093cdfe053c4f6e91e699b4d6761eefe4f0094cda96231eb8a","contentType":"text/javascript"},{"path":"lib/torchsdk/transactions.js","size":87077,"sha256":"1f7e396333c8fad567bf76174e96389b4e6a5dc2ffbbb2f2e41355716a47839a","contentType":"text/javascript"},{"path":"lib/torchsdk/tokens.js","size":53749,"sha256":"6607e68928e0b3b29ebfe08f83