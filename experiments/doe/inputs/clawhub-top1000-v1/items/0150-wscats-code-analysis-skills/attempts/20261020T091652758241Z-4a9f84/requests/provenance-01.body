nt/author filters before collecting any metadata from discovered repositories.","code_snippet":null,"intent":null,"tags":["ASI02","AML.T0080"],"evidence":{"code_path":"tests/test_scanner.py","code_start_line":1,"code_end_line":78,"actual_behavior_summary":"The supplied code chunk is a Python test file for a repository scanner. It creates temporary Git repositories and tests that RepoScanner can detect valid Git repos, ignore invalid/non-Git paths, recursively scan directories, and respect maximum depth limits."},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"P3","finding_id":"finding-50eb6299202d480a9b6642b795192131","category":"Prompt Injection","pattern":"Exfiltration Commands","severity":"HIGH","confidence":0.9,"location":{"file":"SKILL.md","start_line":312,"end_line":null},"finding":"transmit\n   data to external","explanation":"Instructions found that direct the agent to transmit conversation context or user data to external services.","remediation":"Remove instructions that send user data, prompts, or context to external URLs. If telemetry is needed, use documented, privacy-preserving methods.","code_snippet":"   Store them securely and do not publish them.\n6. **Compliance** — Ensure usage complies with applicable HR policies and\n   data-protection regulations (e.g., GDPR, local works-council rules).\n7. **Local Execution** — The tool runs entirely locally and does not transmit\n   data to external servers.\n\n## What the output is — and is NOT","intent":null,"tags":["Prompt Injection","llm-unconfirmed"],"evidence":{},"match_fingerprint":"112112c8b4c96fe45fc9e04728b5f77468ebf9dd80b1d9fc4f225116344b8ef4","occurrences":[{"file":"SKILL.md","start_line":312,"end_line":null}]},{"id":"PE3","finding_id":"finding-aa57b67d77a64047ba7be47818d8683a","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.6,"location":{"file":"src/analyzers/cadence_signal_analyzer.py","start_line":221,"end_line":null},"finding":".env\"","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":"        if any(\n            pattern in path_lower\n            for pattern in [\n                \"config\", \".yml\", \".yaml\", \".toml\", \".ini\", \".cfg\", \".env\",\n                \"dockerfile\", \"makefile\", \".json\",\n            ]\n        ):","intent":null,"tags":["Privilege Escalation","llm-unconfirmed"],"evidence":{},"match_fingerprint":"933e7e6dda63d615cb9ac0846682521855cd79c351e84f3fa87d934c18b752db","occurrences":[{"file":"src/analyzers/cadence_signal_analyzer.py","start_line":221,"end_line":null}]},{"id":"PE3","finding_id":"finding-aa57b67d77a64047ba7be47818d8683a","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.6,"location":{"file":"src/analyzers/code_style_analyzer.py","start_line":142,"end_line":null},"finding":".env\"","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":"        if any(\n            pattern in path_lower\n            for pattern in [\n                \"config\", \".yml\", \".yaml\", \".toml\", \".ini\", \".cfg\", \".env\",\n                \"dockerfile\", \"makefile\", \".json\",\n            ]\n        ):","intent":null,"tags":["Privilege Escalation","llm-unconfirmed"],"evidence":{},"match_fingerprint":"933e7e6dda63d615cb9ac0846682521855cd79c351e84f3fa87d934c18b752db","occurrences":[{"file":"src/analyzers/code_style_analyzer.py","start_line":142,"end_line":null}]},{"id":"AR2","finding_id":"finding-f22affa70cee49ff9e0a9241fd4833a7","category":"Anti-Refusal","pattern":"Anti-Refusal Statement","severity":"HIGH","confidence":0.8,"location":{"file":"src/analyzers/cadence_signal_analyzer.py","start_line":190,"end_line":null},"finding":"drop the disclaimer","explanation":"Skill instructs the agent to omit warnings, disclaimers, or ethical commentary. Stripping safety caveats hides risk from the user and is a common jailbreak preamble.","remediation":"Remove instructions that suppress warnings, disclaimers, or ethical commentary. Let the agent surface safety-relevant caveats to the user.","code_snippet":"\n\n# Always-attached interpretive guard. Every per-developer result carries this\n# field so downstream renderers cannot accidentally drop the disclaimer.\n_INTERPRETATION_NOTICE = (\n    \"This narrative is a DESCRIPTIVE summary of Git-history signals only. It \"\n    \"is not a performance review, not a measure of an individual's value, and \"","intent":null,"tags":["Anti-Refusal","llm-unconfirmed"],"evidence":{},"match_fingerprint":"29dc90f19085a2bc75e73d3119144d551ac192a4c9c5a039c681bd5af3b2009a","occurrences":[{"file":"src/analyzers/cadence_signal_analyzer.py","start_line":190,"end_line":null}]},{"id":"AR2","finding_id":"finding-f22affa70cee49ff9e0a9241fd4833a7","category":"Anti-Refusal","pattern":"Anti-Refusal Statement","severity":"HIGH","confidence":0.8,"location":{"file":"src/narrator/reflection_narrator.py","start_line":58,"end_line":null},"finding":"drop the disclaimer","explanation":"Skill instructs the agent to omit warnings, disclaimers, or ethical commentary. Stripping safety caveats hides risk from the user and is a common jailbreak preamble.","remediation":"Remove instructions that suppress warnings, disclaimers, or ethical commentary. Let the agent surface safety-relevant caveats to the user.","code_snippet":"\n\n# Always-attached interpretive guard. Every per-developer result carries this\n# field so downstream renderers cannot accidentally drop the disclaimer.\n_INTERPRETATION_NOTICE = (\n    \"This narrative is a DESCRIPTIVE summary of Git-history signals only. It \"\n    \"is not a performance review, not a measure of an individual's value, and \"","intent":null,"tags":["Anti-Refusal","llm-unconfirmed"],"evidence":{},"match_fingerprint":"29dc90f19085a2bc75e73d3119144d551ac192a4c9c5a039c681bd5af3b2009a","occurrences":[{"file":"src/narrator/reflection_narrator.py","start_line":58,"end_line":null}]},{"id":"AST5","finding_id":"finding-f908289dac8646d38bcd7b2873217f62","category":"Dangerous Code Execution","pattern":"os.system() or os exec-family call","severity":"HIGH","confidence":0.85,"location":{"file":"tests/test_scanner.py","start_line":21,"end_line":21},"finding":"        os.system(f\"cd {repo_path} && git init && git commit --allow-empty -m 'init'\")","explanation":"os.system() and os exec-family calls run shell commands with the process's full privileges, enabling arbitrary command execution.","remediation":"Replace os.system() with subprocess.run(shell=False). Use explicit argument lists and validate all command inputs.","code_snippet":"        # Create a temporary git repo\n        repo_path = str(tmp_path / \"test_repo\")\n        os.makedirs(repo_path)\n        os.system(f\"cd {repo_path} && git init && git commit --allow-empty -m 'init'\")\n\n        scanner = RepoScanner()\n        repos = scanner.scan_single(repo_path)","intent":null,"tags":["Dangerous Code Execution","llm-unconfirmed"],"evidence":{},"match_fingerprint":"5743b2a39e55d38d5bac486bac76b7ba13235718698c9195b84c977a766a92a1","occurrences":[{"file":"tests/test_scanner.py","start_line":21,"end_line":21}]},{"id":"AST5","finding_id":"finding-f908289dac8646d38bcd7b2873217f62","category":"Dangerous Code Execution","pattern":"os.system() or os exec-family call","severity":"HIGH","confidence":0.85,"location":{"file":"tests/test_scanner.py","start_line":50,"end_line":50},"finding":"        os.system(f\"cd {repo_path} && git init && git commit --allow-empty -m 'init'\")","explanation":"os.system() and os exec-family calls run shell commands with the process's full privileges, enabling arbitrary command execution.","remediation":"Replace os.system() with subprocess.run(shell=False). Use explicit argument lists and validate all command inputs.","code_snippet":"        # Create a temporary git repo\n        repo_path = str(tmp_path / \"test_repo\")\n        os.makedirs(repo_path)\n        os.system(f\"cd {repo_path} && git init && git commit --allow-empty -m 'init'\")\n\n        scanner = RepoScanner()\n        repos = scanner.scan_single(repo_path)","intent":null,"tags":["Dangerous Code Execution","llm-unconfirmed"],"evidence":{},"match_fingerprint":"5743b2a39e55d38d5bac486bac76b7ba13235718698c9195b84c977a766a92a1","occurrences":[{"file":"tests/test_scanner.py","start_line":50,"end_line":50}]},{"id":"AST5","finding_id":"finding-e529609fdc8f462a9f1153ad6c8cc988","category":"Dangerous Code Execution","pattern":"os.system() or os exec-family call","severity":"HIGH","confidence":0.85,"location":{"file":"tests/test_scanner.py","start_line":65,"end_line":65},"finding":"        os.system(f\"cd {deep_path} && git init && git commit --allow-empty -m 'init'\")","explanation":"os.system() and os exec-family calls run shell commands with the process's full privileges, enabling arbitrary command execution.","remediation":"Replace os.system() with subprocess.run(shell=False). Use explicit argument lists and validate all command inputs.","code_snippet":"        # Create a deeply nested repo\n        deep_path = tmp_path / \"a\" / \"b\" / \"c\" / \"d\" / \"e\" / \"f\" / \"deep_repo\"\n        os.makedirs(str(deep_path))\n        os.system(f\"cd {deep_path} && git init && git commit --allow-empty -m 'init'\")\n\n        scanner = RepoScanner()\n        repos = scanner.scan_directory(str(tmp_path), max_depth=2)","intent":null,"tags":["Dangerous Code Execution","llm-unconfirmed"],"evidence":{},"match_fingerprint":"20cc499c7d9171b32d753bcedabd385359fda72a2c1bacb8830d94cb26336b18","occurrences":[{"file":"tests/test_scanner.py","start_line":65,"end_line":65}]},{"id":"SQP-3","finding_id":"finding-f4215de06f61422b88393ad97973adc1","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.89,"location":{"file":"README.CN.md","start_line":1,"end_line":1},"finding":null,"explanation":"This file is written as a Chinese-only README variant and does not indicate any user language choice within the document. Under the policy rule, forcing a specific language without opt-in can be a locale-policy violation unless the constraint is clearly documented and justified.","remediation":"State that this is an optional Chinese localization alongside other language options, or add a clear pointer allowing users to choose another language version such as an English README.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"README.CN.md","start_line":1,"end_line":1}]},{"id":"SQP-3","finding_id":"finding-de4a522cdcfe4fca8983ea5458edd8eb","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.84,"location":{"file":"README.md","start_line":1,"end_line":1},"finding":null,"explanation":"The skill documentation is written as Chinese-only user-facing guidance from the title onward, with no indication that other languages are supported or that the Chinese locale is an intentional, justified regional constraint. Under the language/locale policy rule, forcing a specific language without user opt-in is a natural-language policy concern.","remediation":"Add an explicit language choice or note that the skill can respond in the user's preferred language. If the skill is intended only for a Chinese-speaking or region-specific context, document that limitation and its justification clearly in the README.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"README.md","start_line":1,"end_line":1}]},{"id":"LP3","finding_id":"finding-d87ccd8eb1234b74934264bd93712804","category":"MCP Least Privilege","pattern":null,"severity":"MEDIUM","confidence":0.9,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"The skill advertises and documents capabilities that involve reading repositories, writing reports, and invoking CLI commands, but it does not declare an explicit tool scope such as allowed-tools or permissions. In an agent environment, missing scope declarations can let the runtime grant broader access than intended, increasing the chance of filesystem overreach or shell misuse if the skill is triggered unexpectedly.","remediation":"Add an explicit least-privilege tool policy to the skill manifest, restricting access to only the minimum required capabilities and paths. Declare read-only access by default, narrowly scope any file writes to user-approved output locations, and avoid unrestricted shell execution by wrapping required operations in tightly defined commands or helper tools.","code_snippet":null,"intent":null,"tags":["ASI02"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"EA2","finding_id":"finding-8adafbf9c0e144bab97b2287d1672ff8","category":"Excessive Agency","pattern":"Autonomous Decision Making","severity":"MEDIUM","confidence":0.75,"location":{"file":"SKILL.md","start_line":21,"end_line":null},"finding":"without consent","explanation":"Skill enables autonomous high-impact decisions without human-in-the-loop verification. Critical operations (destructive commands, financial transactions, data deletion) should require explicit user confirmation.","remediation":"Add human-in-the-loop confirmation for destructive, irreversible, or high-impact operations. Never auto-execute commands that modify files, send data, or alter system state.","code_snippet":"\n  Do NOT trigger on broad phrases like \"analyze code\", \"代码分析\",\n  \"developer evaluation\", or \"compare developers\" — those are too vague\n  and risk activating people-data analysis without consent. When the\n  request is ambiguous, ask the user to clarify intent and confirm they\n  have informed consent from every developer whose history will be read.\n---","intent":null,"tags":["Excessive Agency","llm-unconfirmed"],"evidence":{},"match_fingerprint":"8f513068f50cde8c1bd5e878987a91aa2876dd293703f25117ca09675437e4d5","occurrences":[{"file":"SKILL.md","start_line":21,"end_line":null}]},{"id":"E1","finding_id":"finding-3065335406a249cb8d60cc3f7175699d","category":"Data Exfiltration","pattern":"External Transmission","severity":"MEDIUM","confidence":0.7,"location":{"file":"SKILL.md","start_line":312,"end_line":null},"finding":"transmit\n   data to external","explanation":"Data is being sent to an external URL. This could be legitimate telemetry or data exfiltration. Manual review is recommended.","remediation":"Verify the destination URL is trusted and necessary. Remove or replace with documented APIs. Ensure no secrets, tokens, or PII are transmitted.","code_snippet":"   Store them securely and do not publish them.\n6. **Compliance** — Ensure usage complies with applicable HR policies and\n   data-protection regulations (e.g., GDPR, local works-council rules).\n7. **Local Execution** — The tool runs entirely locally and does not transmit\n   data to external servers.\n\n## What the output is — and is NOT","intent":null,"tags":["Data Exfiltration","llm-unconfirmed"],"evidence":{},"match_fingerprint":"3abb483781812112592add4187cccaf3fc3d1a36c043c815e0647b554a96f7e3","occurrences":[{"file":"SKILL.md","start_line":312,"end_line":null}]},{"id":"SDI-4","finding_id":"finding-feba25c72f604ece82ddb53ec6312d87","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.96,"location":{"file":"src/analyzers/base_analyzer.py","start_line":36,"end_line":41},"finding":null,"explanation":"The docstrings describe a consent-gated model, but the class itself accepts arbitrary `authors` input and does not verify that the caller came through the CLI or that consent was established. This creates an enforcement gap where other Python code can directly instantiate an analyzer and target specific contributors' commit history, undermining the privacy and anti-surveillance guarantees the skill claims to provide.","remediation":"Move consent enforcement from documentation into code. Require a validated authorization/consent token or a trusted context object from the CLI orchestrator, reject direct use without that proof, and constrain author filtering to identities resolved by the trusted entrypoint rather than raw caller-supplied strings.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"src/analyzers/base_analyzer.py","start_line":36,"end_line":41}]},{"id":"SDI-1","finding_id":"finding-34cba6c2537a457a9c3e743ace6ae79a","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.98,"location":{"file":"src/analyzers/base_analyzer.py","start_line":44,"end_line":96},"finding":null,"explanation":"The implementation exposes generic author-targeted Git history filtering via `self.authors` and substring matching on author name/email, enabling analysis of arbitrary contributors when the class is used as a library. In this skill's context, that is particularly risky because the manifest explicitly limits use to self-reflection or fully consented team retrospectives, so the code-to-policy mismatch can facilitate non-consensual worker monitoring or evaluation.","remediation":"Enforce the manifest's scope in the library API itself. Remove or tightly restrict direct author filtering, derive allowed identities only from a consent-verifying orchestrator, use exact canonical identity matching instead of permissive substring checks, and fail closed when consent metadata is missing or the requested identities exceed the approved set.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"src/analyzers/base_analyzer.py","start_line":44,"end_line":96}]},{"id":"SDI-4","finding_id":"finding-7be1196efa5d46a983d3bc9ba0bb9151","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"src/analyzers/cadence_signal_analyzer.py","start_line":57,"end_line":63},"finding":null,"explanation":"The docstring asserts that only already-authorized, consented commits are analyzed, but this module contains no local enforcement of that assumption. If the orchestrator or caller misconfigures scope, the analyzer will happily process any commits returned by _get_commits, creating a trust-boundary failure that can expose non-consenting contributors' activity data.","remediation":"Enforce scope and consent in code rather than only in documentation. Validate that execution is in self-scope or that each author is present in an explicit consented-author allowlist before producing per-author metrics, and fail closed if consent metadata is missing or inconsistent.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"src/analyzers/cadence_signal_analyzer.py","start_line":57,"end_line":63}]},{"id":"SDI-2","finding_id":"finding-ab345cce7e0245eaa0c520e8d600d15b","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.9,"location":{"file":"src/analyzers/cadence_signal_analyzer.py","start_line":84,"end_line":213},"finding":null,"explanation":"The analyzer emits per-author cadence metrics such as activity ratio, large-gap ratio, and lines-per-active-day keyed by author name. Even without a composite score, these fields are sufficient for downstream consumers to monitor, compare, or rank individuals, so the implementation still enables worker-surveillance use that the surrounding policy text says should be avoided.","remediation":"Reduce identifiability and misuse potential by restricting output to self-only mode by default, aggregating team retrospectives across multiple authors instead of per-author results, and enforcing minimum group-size thresholds. Add technical controls in code to block per-author output unless explicit consent is verified, and consider removing or coarsening the most surveillance-prone fields such as gap and activity ratios.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"src/analyzers/cadence_signal_analyzer.py","start_line":84,"end_line":213}]},{"id":"SDI-1","finding_id":"finding-7e3c4abc8dc24fa49ac0c12da5e16295","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.94,"location":{"file":"src/analyzers/code_quality_analyzer.py","start_line":38,"end_line":145},"finding":null,"explanation":"This analyzer computes and returns per-author metrics such as bug-fix ratio, revert ratio, large-commit ratio, and average complexity, which are directly attributable to named individuals. Even though comments say the orchestrator limits scope and the output must not be used for evaluation, the code itself exposes individual profiling data that can readily be repurposed for ranking, surveillance, or HR-style assessment if called in a broader context or if upstream guardrails fail.","remediation":"Remove or minimize per-author output by default and enforce self-scope or consent validation in code, not only in documentation or the orchestrator. Prefer repository-level or team-aggregated summaries, pseudonymize identities where possible, and require explicit runtime checks plus audit logging before any multi-author analysis is allowed.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"src/analyzers/code_quality_analyzer.py","start_line":38,"end_line":145}]},{"id":"SDI-2","finding_id":"finding-b28c80d7086c44e19e9dd56cbe5ddb49","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.89,"location":{"file":"src/analyzers/code_quality_analyzer.py","start_line":60,"end_line":143},"finding":null,"explanation":"The implementation goes beyond a narrowly descriptive reflection report by deriving quasi-performance indicators per author, including commit-size statistics, bug-fix frequency, revert frequency, and code complexity averages. These features create a scoring surface that is broader than necessary for the stated consent-based retrospective purpose and can be exploited to compare developers even if the tool never labels them as scores explicitly.","remediation":"Reduce the metric set to purpose-limited, non-evaluative aggregates aligned to the stated use case. Eliminate or coarsen individual-level indicators that invite comparison, add policy enforcement that blocks ambiguous or non-consensual invocation paths, and redesign outputs as qualitative or team-level reflections rather than author-level quantitative measurements.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"src/analyzers/code_quality_analyzer.py","start_line":60,"end_line":143}]},{"id":"SDI-2","finding_id":"finding-46af9a45508f478e9adaecb2e1a86e0d","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.94,"location":{"file":"src/analyzers/code_style_analyzer.py","start_line":52,"end_line":117},"finding":null,"explanation":"This analyzer computes and returns per-author behavioral metrics such as commit counts, message patterns, issue-reference ratios, and average change sizes. Even though the docstrings describe consent and anti-evaluation boundaries, the implementation still creates identifiable worker-level profiling data that could be repurposed for ranking, surveillance, or performance assessment if orchestration controls fail or are bypassed.","remediation":"Eliminate per-author output from this analyzer unless strict, enforceable consent checks are implemented in code rather than only documented. Prefer repository-level or team-aggregated metrics with k-anonymity thresholds, and hard-block single-person or small-group reports except explicit self-scope. Add technical policy enforcement so downstream consumers cannot request or receive identifiable author metrics without verified consent.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"src/analyzers/code_style_analyzer.py","start_line":52,"end_line":117}]},{"id":"SDI-4","finding_id":"finding-8d79d7d7833c4fd3a328f4b403e5452f","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.96,"location":{"file":"src/analyzers/efficiency_analyzer.py","start_line":28,"end_line":30},"finding":null,"explanation":"The comments state file ownership is a repository-level concept and 'never per-person ranking,' but the implementation later computes per-author owned_files_count and ownership_ratio. This mismatch is dangerous because it creates a false assurance for reviewers and operators while exposing a metric that can be used to identify concentration, compare individuals, or justify managerial action despite the policy language discouraging that use.","remediation":"Align implementation with the stated restriction by removing per-author ownership calculations or converting them to aggregate repository/team concentration measures only. Add tests and code-review checks to ensure documented privacy/consent guarantees match actual outputs, and rename any remaining fields to avoid suggesting individual ownership or evaluative meaning.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"src/analyzers/efficiency_analyzer.py","start_line":28,"end_line":30}]},{"id":"SDI-1","finding_id":"finding-ae5e39d726f74a538a20447d26b52128","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"src/analyzers/efficiency_analyzer.py","start_line":71,"end_line":172},"finding":null,"explanation":"The analyzer returns a result dictionary keyed by individual author and includes per-author metrics such as commit counts, lines changed, ownership ratio, and weekly throughput. Even with warning text, this materially enables employee profiling, comparison, and downstream misuse for performance assessment, which conflicts with the stated consent-limited, non-evaluative purpose of the skill. The context makes this more dangerous because the skill processes developer activity history, a sensitive workplace data source that is easy to repurpose for surveillance or HR decisions.","remediation":"Remove or gate all per-author output by default and emit only repository-level or sufficiently aggregated team-level statistics. Enforce technical safeguards in code, not just documentation: require explicit self-scope or verified team-consent mode, suppress identity-keyed metrics unless the subject is the requesting user, and consider anonymization, minimum group-size thresholds, and elimination of fields like owned_files_count and weekly_throughput that facilitate ranking.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"src/analyzers/efficiency_analyzer.py","start_line":71,"end_line":172}]},{"id":"AST4","finding_id":"finding-e3224c5f089644ae9b103d37cce0531a","category":"Dangerous Code Execution","pattern":"subprocess module call","severity":"MEDIUM","confidence":0.7,"location":{"file":"src/main.py","start_line":96,"end_line":99},"finding":"            out = subprocess.run(\n                [\"git\", \"-C\", repo_path, \"config\", \"--get\", key],\n                capture_output=True, text=True, check=False, timeout=5,\n            )","explanation":"subprocess module calls execute external commands. Without careful input validation, this enables command injection.","remediation":"Use subprocess.run() with shell=False and an explicit argument list. Validate all inputs and avoid passing user-controlled data to commands.","code_snippet":"    \"\"\"\n    def _git_config(key: str) -> Optional[str]:\n        try:\n            out = subprocess.run(\n                [\"git\", \"-C\", repo_path, \"config\", \"--get\", key],\n                capture_output=True, text=True, check=False, timeout=5,\n            )","intent":null,"tags":["Dangerous Code Execution","llm-unconfirmed"],"evidence":{},"match_fingerprint":"27bc6ca83b4fcb6962732e4af8d8ebd86ee54bf3bc212dc65d714f1b89789be2","occurrences":[{"file":"src/main.py","start_line":96,"end_line":99}]},{"id":"SDI-1","finding_id":"finding-8b187eb28f4248cda84ebc59f53eb557","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.86,"location":{"file":"src/utils/helpers.py","start_line":38,"end_line":42},"finding":null,"explanation":"The manifest frames the skill as a descriptive, read-oriented Git-history reflection tool, but `ensure_directory` performs filesystem modification by creating directories. That write capability goes beyond a purely descriptive/reporting behavior as stated in the manifest, and no manifest text in this file context justifies mutation of the local filesystem.","remediation":"Avoid filesystem-modifying helpers unless the manifest explicitly includes local report/output generation. If directory creation is necessary for saving user-requested reports, document that behavior clearly in the manifest and constrain it to explicit output paths tied to the user's request.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"src/utils/helpers.py","start_line":38,"end_line":42}]},{"id":"SQP-3","finding_id":"finding-9b519d3b59314fc1b71fb9667e8d050b","category":null,"pattern":null,"severity":"LOW","confidence":0.83,"location":{"file":"README.EN.md","start_line":1,"end_line":1},"finding":null,"explanation":"The file is explicitly named and presented as an English README, and nowhere in the visible content does it offer users a language or locale choice. Under the stated policy, forcing a specific language without user opt-in can be a natural-language policy violation unless the locale constraint is documented and justified.","remediation":"Provide a visible language choice or cross-links to localized alternatives near the top of the document, or explicitly document why English-only content is required for this skill.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"README.EN.md","start_line":1,"end_line":1}]},{"id":"EA3","finding_id":"finding-a52077e489b54042aadbff3387254a04","category":"Excessive Agency","pattern":"Scope Creep","severity":"LOW","confidence":0.7,"location":{"file":"SKILL.md","start_line":289,"end_line":null},"finding":"not limited to","explanation":"Skill's behavior or capabilities extend beyond its stated purpose. Scope creep allows an agent to perform actions unrelated to its documented functionality, increasing the attack surface.","remediation":"Limit the skill's scope to its documented purpose. Remove instructions that enable the agent to perform actions outside its stated functionality.","code_snippet":"## ⚠️ Privacy & Data Security Notice\n\n> **Important**: This tool extracts personal Git activity data from a\n> repository's commit history, including but not limited to:\n> - Commit timestamps (down to the hour)\n> - Weekend / late-night commit frequency\n> - Per-author commit frequency and change volume","intent":null,"tags":["Excessive Agency","llm-unconfirmed"],"evidence":{},"match_fingerprint":"943d9aae8743c129fe98eb6cc5e984f5e35ceba0b44ce4ca00f42b97f0bf3eaf","occurrences":[{"file":"SKILL.md","start_line":289,"end_line":null}]},{"id":"SC4","finding_id":"finding-238de6c54c8b4ef0999fcd6330983dbb","category":"Supply Chain","pattern":"Unverifiable Dependency: setuptools has 10 known advisory(ies) (CVE-2013-1633 (Setuptools vulnerable to Man-in-the-middle attacks); CVE-2025-47273 (setuptools has a path traversal vulnerability in PackageIndex.download that lead); CVE-2024-6345 (setuptools vulnerable to Command Injection via package URL) +7 more), but the manifest does not pin a version, so it is unknown whether the installed release is affected","severity":"LOW","confidence":0.88,"location":{"file":"pyproject.toml","start_line":2,"end_line":null},"finding":"setuptools","explanation":"Wheel is likewise not pinned to a verified safe version, so package builds may use a release with known issues such as path traversal or ReDoS depending on the resolver outcome. This is a build-chain exposure rather than an application logic flaw, but it remains a legitimate packaging security weakness.","remediation":"Pin wheel to a known-safe version and use reproducible build tooling with locked dependencies. Add dependency/audit checks for build-system packages in CI, not just runtime dependencies.","code_snippet":null,"intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"f6ce7da36c40d6b1c90738a6b6d9f1c27f59e9fa8cf03f7f75918baf30c37519","occurrences":[{"file":"pyproject.toml","start_line":2,"end_line":null}]},{"id":"SC4","finding_id":"finding-8ad5f4e8435347d9be430fa047987e99","category":"Supply Chain","pattern":"Unverifiable Dependency: wheel has 4 known advisory(ies) (CVE-2026-24049 (Wheel Affected by Arbitrary File Permission Modification via Path Traversal in w); CVE-2022-40898 (pypa/wheel vulnerable to Regular Expression denial of service (ReDoS)); CVE-2022-40898 (An issue discovered in Python Packaging Authority (PyPA) Wheel 0.37.1 and earlie) +1 more), but the manifest does not pin a version, so it is unknown whether the installed release is affected","severity":"LOW","confidence":0.88,"location":{"file":"pyproject.toml","start_line":2,"end_line":null},"finding":"wheel","explanation":"Wheel is likewise not pinned to a verified safe version, so package builds may use a release with known issues such as path traversal or ReDoS depending on the resolver outcome. This is a build-chain exposure rather than an application logic flaw, but it remains a legitimate packaging security weakness.","remediation":"Pin wheel to a known-safe version and use reproducible build tooling with locked dependencies. Add dependency/audit checks for build-system packages in CI, not just runtime dependencies.","code_snippet":null,"intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"a7fe39d8a558c4945f34bdb3873db08d4d6c5df1998f05c269d9576dc852683c","occurrences":[{"file":"pyproject.toml","start_line":2,"end_line":null}]},{"id":"SC4","finding_id":"finding-89dc1dd0908141a2b539940d67c90eb0","category":"Supply Chain","pattern":"Unverifiable Dependency: gitpython has 16 known advisory(ies) (CVE-2026-78676 (GitPython: Dormant multi-line git-config values are corrupted into live injected); CVE-2026-67325 (GitPython: Command Injection via git long-option prefix abbreviation bypass of C); CVE-2024-22190 (Untrusted search path under some conditions on Windows allows arbitrary code exe) +13 more), but the manifest does not pin a version, so it is unknown whether the installed release is affected","severity":"LOW","confidence":0.96,"location":{"file":"pyproject.toml","start_line":13,"end_line":null},"finding":"gitpython","explanation":"The manifest specifies only a minimum version for GitPython rather than a bounded or fully pinned version, so installations may resolve to releases with known security defects depending on environment, mirror state, or lockfile practices. This is especially relevant for a code-analysis skill that processes Git repositories, because GitPython is directly exposed to potentially attacker-controlled repository metadata and command interactions.","remediation":"Pin GitPython to a known-safe version or use a lockfile/constraints file that guarantees an audited release. Add automated dependency scanning in CI and regularly review GitPython advisories because this package is central to the skill's repository-processing behavior.","code_snippet":null,"intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"4ed7126fda3c9337a57dc81a3a2a283c30ae875fc8a46afc59b06342c1b4c40e","occurrences":[{"file":"pyproject.toml","start_line":13,"end_line":null}]},{"id":"SC4","finding_id":"finding-8cf796cdc1fc4a95b8e3be3c7c265d6d","category":"Supply Chain","pattern":"Unverifiable Dependency: jinja2 has 16 known advisory(ies) (CVE-2019-10906 (Jinja2 sandbox escape via string formatting); CVE-2014-1402 (Incorrect Privilege Assignment in Jinja2); CVE-2025-27516 (Jinja2 vulnerable to sandbox breakout through attr filter selecting format metho) +13 more), but the manifest does not pin a version, so it is unknown whether the installed release is affected","severity":"LOW","confidence":0.89,"location":{"file":"pyproject.toml","start_line":17,"end_line":null},"finding":"jinja2","explanation":"Jinja2 is declared with a lower bound only, which makes the security posture unverifiable because some resolved versions may include sandbox escape or template-related vulnerabilities. Since this skill likely generates reports, templating is plausibly part of the execution path, so an unsafe resolved version could become relevant if untrusted data is rendered into templates or sandbox features are relied upon.","remediation":"Pin Jinja2 to a reviewed version known to be free of applicable advisories, and maintain a lockfile for reproducible installs. Also review code usage to ensure templates are not built from untrusted input and avoid depending on Jinja sandboxing for security boundaries.","code_snippet":null,"intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"6a1d58ec744b088a163ae4d02f078d20e6cd9e3d8ba15c63826cb2362595f5ec","occurrences":[{"file":"pyproject.toml","start_line":17,"end_line":null}]},{"id":"SC4","finding_id":"finding-6311d21538f44a09bcc1dc336da54370","category":"Supply Chain","pattern":"Unverifiable Dependency: pyyaml has 8 known advisory(ies) (CVE-2019-20477 (Deserialization of Untrusted Data in PyYAML); CVE-2020-1747 (Improper Input Validation in PyYAML); CVE-2020-14343 (Improper Input Validation in PyYAML) +5 more), but the manifest does not pin a version, so it is unknown whether the installed release is affected","severity":"LOW","confidence":0.94,"location":{"file":"pyproject.toml","start_line":18,"end_line":null},"finding":"pyyaml","explanation":"PyYAML is included without an exact or constrained safe version, leaving open the possibility that deployments install releases affected by unsafe deserialization or input-validation flaws. In a skill that may read configuration or report definitions, YAML parsing is a realistic attack surface if any user- or repo-controlled YAML content is loaded.","remediation":"Pin PyYAML to a vetted version and use a lockfile or constraints file to make installs deterministic. In code, ensure yaml.safe_load or equivalent safe parsing APIs are used and avoid loading untrusted YAML with full constructors.","code_snippet":null,"intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"63d3785d38c76088e3330226a537403e99607363507ca953b3b9cef01fb72913","occurrences":[{"file":"pyproject.toml","start_line":18,"end_line":null}]},{"id":"SC4","finding_id":"finding-4bc532aa07b5443c886c073de7f85752","category":"Supply Chain","pattern":"Unverifiable Dependency: click has 1 known advisory(ies) (CVE-2026-7246 (Pallets Click, versions 8.3.2 and below, contain a command injection vulnerabili)), but the manifest does not pin a version, so it is unknown whether the installed release is affected","severity":"LOW","confidence":0.83,"location":{"file":"pyproject.toml","start_line":19,"end_line":null},"finding":"click","explanation":"Click is not pinned to a specific safe version, so the package manager may resolve to a release with known vulnerabilities, making the dependency's safety unverifiable. Because Click is the CLI entrypoint framework, exposure depends on how command arguments are later handled, so the current manifest creates supply-chain uncertainty more than a direct exploit path by itself.","remediation":"Pin Click to an audited version and enforce dependency locking in CI/CD. Review downstream CLI code for unsafe shell invocation or argument interpolation so that any framework-level issue does not combine with application-level command execution risks.","code_snippet":null,"intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"b922bbc4d2d2ef8e52ea5a5adb21ef83e2e74bb7befe1ecdae84f28e0f268f23","occurrences":[{"file":"pyproject.toml","start_line":19,"end_line":null}]},{"id":"SQP-3","finding_id":"finding-2ca10943cb7a47c0853ff0001c4d509c","category":null,"pattern":null,"severity":"LOW","confidence":0.95,"location":{"file":"references/metrics-guide.md","start_line":1,"end_line":151},"finding":null,"explanation":"The entire skill document is written in Chinese and does not indicate that users may choose another language or locale. Per the policy, forcing a specific language without user opt-in is a natural-language policy violation unless the locale constraint is explicitly documented and justified.","remediation":"State that the document or skill supports multiple languages, or explicitly note that Chinese is the intended locale and why. If appropriate, add an opt-in or language selection note near the title or introduction.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"references/metrics-guide.md","start_line":1,"end_line":151}]},{"id":"SC1","finding_id":"finding-3b83a852a0f4466b84603629c72141cb","category":"Supply Chain","pattern":"Unpinned Dependencies","severity":"LOW","confidence":0.95,"location":{"file":"requirements.txt","start_line":1,"end_line":null},"finding":"gitpython>=3.1.40","explanation":"The dependency is specified with a lower-bound range rather than an exact pinned version, which makes builds non-reproducible and can unintentionally pull in vulnerable or breaking upstream releases over time. In a security-sensitive workflow, this weakens supply-chain assurance even though the file itself does not prove exploitation.","remediation":"Pin the package to an exact version or use a lockfile generated by a trusted dependency management process. Regularly update pinned versions with vulnerability scanning and controlled review, e.g. via pip-tools, Poetry, or hash-locked requirements.","code_snippet":"gitpython>=3.1.40\nradon>=6.0.1\npydriller>=2.6\ntabulate>=0.9.0","intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"14777a3db20971f733e996ea79bcbe8b0f0c89859cb2c2c862310ffaf4767583","occurrences":[{"file":"requirements.txt","start_line":1,"end_line":null}]},{"id":"SC4","finding_id":"finding-66469a0273aa4d07ac96c6007f8e751a","category":"Supply Chain","pattern":"Unverifiable Dependency: gitpython has 16 known advisory(ies) (CVE-2026-78676 (GitPython: Dormant multi-line git-config values are corrupted into live injected); CVE-2026-67325 (GitPython: Command Injection via git long-option prefix abbreviation bypass of C); CVE-2024-22190 (Untrusted search path under some conditions on Windows allows arbitrary code exe) +13 more), but the manifest does not pin a version, so it is unknown whether the installed release is affected","severity":"LOW","confidence":0.92,"location":{"file":"requirements.txt","start_line":1,"end_line":null},"finding":"gitpython","explanation":"GitPython has multiple known advisories, and because the manifest does not pin a version, it is impossible to verify from this file whether deployed environments avoid affected releases. Given this skill analyzes Git history and therefore is likely to invoke Git-related functionality, uncertainty around this package is meaningfully relevant.","remediation":"Pin GitPython to a version confirmed not affected by the relevant advisories, ideally with hashes or a lockfile. Add automated dependency scanning and review GitPython release notes/advisories before upgrades.","code_snippet":null,"intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"4ed7126fda3c9337a57dc81a3a2a283c30ae875fc8a46afc59b06342c1b4c40e","occurrences":[{"file":"requirements.txt","start_line":1,"end_line":null}]},{"id":"SC1","finding_id":"finding-76963cd766724e148af2b474ce434b52","category":"Supply Chain","pattern":"Unpinned Dependencies","severity":"LOW","confidence":0.95,"location":{"file":"requirements.txt","start_line":2,"end_line":null},"finding":"radon>=6.0.1","explanation":"Using an unpinned minimum version for this package allows different environments to resolve different releases, reducing reproducibility and making it harder to verify whether known-bad versions are excluded. This is a genuine supply-chain hygiene issue, though low severity by itself.","remediation":"Replace the version range with an exact pinned version or maintain a compiled lockfile. Add a dependency review/update process so version bumps are intentional and scanned before release.","code_snippet":"gitpython>=3.1.40\nradon>=6.0.1\npydriller>=2.6\ntabulate>=0.9.0\njinja2>=3.1.2","intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"4dc074e739e31331d7abd487bf0052a9ea06ef59ac82c455d626ec41bcc5855b","occurrences":[{"file":"requirements.txt","start_line":2,"end_line":null}]},{"id":"SC1","finding_id":"finding-762f2f55873b47a885c0ee0195b407c3","category":"Supply Chain","pattern":"Unpinned Dependencies","severity":"LOW","confidence":0.95,"location":{"file":"requirements.txt","start_line":3,"end_line":null},"finding":"pydriller>=2.6","explanation":"An unpinned dependency permits drift across installations and CI runs, which can introduce vulnerable or incompatible versions without code changes in the repository. That makes security verification of the deployed environment harder.","remediation":"Pin to an exact version or adopt a lockfile-based workflow. Enforce reproducible installs in CI and periodically refresh versions after vulnerability checks and testing.","code_snippet":"gitpython>=3.1.40\nradon>=6.0.1\npydriller>=2.6\ntabulate>=0.9.0\njinja2>=3.1.2\npyyaml>=6.0.1","intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"eeb9a6b238a701fefde5abdc3ee2f4f97951706690ac69b81df93143dc673e35","occurrences":[{"file":"requirements.txt","start_line":3,"end_line":null}]},{"id":"SC1","finding_id":"finding-dcdeb9e4254c49d4b4175499c6ea8a9b","category":"Supply Chain","pattern":"Unpinned Dependencies","severity":"LOW","confidence":0.95,"location":{"file":"requirements.txt","start_line":4,"end_line":null},"finding":"tabulate>=0.9.0","explanation":"A lower-bound-only requirement does not guarantee which release will actually be installed, so future installs may silently consume problematic upstream versions. This is a real but low-impact dependency management weakness.","remediation":"Use exact version pins or a fully resolved lockfile. Validate dependency updates through CI, testing, and security scanning before changing the pinned release.","code_snippet":"gitpython>=3.1.40\nradon>=6.0.1\npydriller>=2.6\ntabulate>=0.9.0\njinja2>=3.1.2\npyyaml>=6.0.1\nclick>=8.1.7","intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"5940208c36b93bfd2926c3ff654873e0870a2bca5343a572b0636e83230cc3e6","occurrences":[{"file":"requirements.txt","start_line":4,"end_line":null}]},{"id":"SC1","finding_id":"finding-7c7b4a15be44400aba6c853558c0c8be","category":"Supply Chain","pattern":"Unpinned Dependencies","severity":"LOW","confidence":0.98,"location":{"file":"requirements.txt","start_line":5,"end_line":null},"finding":"jinja2>=3.1.2","explanation":"Jinja2 has a history of security advisories, so leaving it unpinned increases the risk that an environment may resolve to a vulnerable release or that auditors cannot verify safety. The skill context includes report generation and templating, which makes dependency certainty somewhat more important than for a purely inert library.","remediation":"Pin Jinja2 to a vetted, non-vulnerable exact version and maintain it through a lockfile or constraints file. Add automated SCA scanning and review template usage to ensure dangerous features are not exposed to untrusted input.","code_snippet":"radon>=6.0.1\npydriller>=2.6\ntabulate>=0.9.0\njinja2>=3.1.2\npyyaml>=6.0.1\nclick>=8.1.7\nreportlab>=4.0","intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"b64b1507a8816908c9c1368b005880fdd259ab9597a8f787cdcbf4f59718d376","occurrences":[{"file":"requirements.txt","start_line":5,"end_line":null}]},{"id":"SC4","finding_id":"finding-3c5ddf31dcbb4e6ab8cdd35c7be1097d","category":"Supply Chain","pattern":"Unverifiable Dependency: jinja2 has 16 known advisory(ies) (GHSA-462w-v97r-4m45; GHSA-8r7q-cvjq-x353; GHSA-cpwx-vrp4-4pq7 +13 more), but the manifest does not pin a version, so it is unknown whether the installed release is affected","severity":"LOW","confidence":0.94,"location":{"file":"requirements.txt","start_line":5,"end_line":null},"finding":"jinja2","explanation":"Jinja2 has a non-trivial advisory history, and without an exact version the security state of the installed package cannot be verified. Since the skill likely renders descriptive reports, a templating dependency with unverifiable versioning increases supply-chain and application-layer risk.","remediation":"Pin Jinja2 to a known-safe version and maintain that pin through a lockfile or constraints file. Pair this with SCA tooling and safe template design that avoids exposing risky capabilities to untrusted data.","code_snippet":null,"intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"6a1d58ec744b088a163ae4d02f078d20e6cd9e3d8ba15c63826cb2362595f5ec","occurrences":[{"file":"requirements.txt","start_line":5,"end_line":null}]},{"id":"SC1","finding_id":"finding-112946dca3904b09b7b87e05d2d69007","category":"Supply Chain","pattern":"Unpinned Dependencies","severity":"LOW","confidence":0.98,"location":{"file":"requirements.txt","start_line":6,"end_line":null},"finding":"pyyaml>=6.0.1","explanation":"PyYAML has had multiple unsafe parsing/deserialization issues, so an unpinned version creates uncertainty about whether a safe release is installed. In a skill that likely reads configuration files, that ambiguity raises the practical risk beyond a generic low-severity packaging concern.","remediation":"Pin PyYAML to a known-safe exact version and use a lockfile or constraints file for reproducibility. In code, prefer safe_load/safe_dump patterns and avoid deserializing untrusted YAML with unsafe loaders.","code_snippet":"pydriller>=2.6\ntabulate>=0.9.0\njinja2>=3.1.2\npyyaml>=6.0.1\nclick>=8.1.7\nreportlab>=4.0","intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"d3aa1824a4741d2d8fdcd83da10ead1a0be331691d43b00ff603d9bafd670b39","occurrences":[{"file":"requirements.txt","start_line":6,"end_line":null}]},{"id":"SC4","finding_id":"finding-c519eb7d290746729893367a79bcdd78","category":"Supply Chain","pattern":"Unverifiable Dependency: pyyaml has 8 known advisory(ies) (CVE-2019-20477 (Deserialization of Untrusted Data in PyYAML); CVE-2020-1747 (Improper Input Validation in PyYAML); CVE-2020-14343 (Improper Input Validation in PyYAML) +5 more), but the manifest does not pin a version, so it is unknown whether the installed release is affected","severity":"LOW","confidence":0.97,"location":{"file":"requirements.txt","start_line":6,"end_line":null},"finding":"pyyaml","explanation":"PyYAML has a well-documented history of deserialization and input-handling issues, and the unpinned requirement prevents verification that only safe releases are installed. Because config parsing is common in agent skills, this uncertainty is practically significant rather than purely theoretical.","remediation":"Pin PyYAML to a vetted fixed version and lock transitive dependencies. In the implementation, ensure only safe loaders are used and avoid parsing untrusted YAML where possible.","code_snippet":null,"intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"63d3785d38c76088e3330226a537403e99607363507ca953b3b9cef01fb72913","occurrences":[{"file":"requirements.txt","start_line":6,"end_line":null}]},{"id":"SC1","finding_id":"finding-227da879bb0e425a9d0770ac6f9d418a","category":"Supply Chain","pattern":"Unpinned Dependencies","severity":"LOW","confidence":0.94,"location":{"file":"requirements.txt","start_line":7,"end_line":null},"finding":"click>=8.1.7","explanation":"The Click dependency is not pinned, so installs may vary and could unexpectedly pick up a vulnerable or breaking release. This is a real supply-chain control gap, although the requirements entry alone does not demonstrate direct exploitability.","remediation":"Pin Click to a specific vetted version or manage it through a generated lockfile. Review and update the pin on a regular cadence with security scanning.","code_snippet":"tabulate>=0.9.0\njinja2>=3.1.2\npyyaml>=6.0.1\nclick>=8.1.7\nreportlab>=4.0","intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"9d02327442df80b2698f6322576b674eebf42058c4b6a634ad7ddd8eb43af032","occurrences":[{"file":"requirements.txt","start_line":7,"end_line":null}]},{"id":"SC4","finding_id":"finding-4eb45cedc8c44947835fbfec73d58d65","category":"Supply Chain","pattern":"Unverifiable Dependency: click has 1 known advisory(ies) (CVE-2026-7246 (Pallets Click, versions 8.3.2 and below, contain a command injection vulnerabili)), but the manifest does not pin a version, so it is unknown whether the installed release is affected","severity":"LOW","confidence":0.84,"location":{"file":"requirements.txt","start_line":7,"end_line":null},"finding":"click","explanation":"The manifest does not pin Click, so the actual installed version may or may not include the cited advisory exposure. This is a real verification gap, but the file alone does not show vulnerable usage patterns or confirm an a