e":"text/javascript"},{"path":"tests/panels.test.js","size":5077,"sha256":"a934ed482fe6c6f5467385f27bfc49477b527ff850d63322b4773e4258526d44","contentType":"text/javascript"},{"path":"tests/privacy.test.js","size":2709,"sha256":"bc6628bb3aa28fe477869c15fc0df45e0849b64bb96280558a52b82ae648558f","contentType":"text/javascript"},{"path":"tests/projects-ui.test.js","size":13867,"sha256":"34a0850f605d8ceb8232f58e58b510f19e1cf8af2b00130544d4db207118a8d4","contentType":"text/javascript"},{"path":"tests/projects.test.js","size":16244,"sha256":"8f682a2916ec054b3b1a817e75ed8e214720c933008adc2c22a23e8175d27bb1","contentType":"text/javascript"},{"path":"tests/release.test.js","size":2863,"sha256":"4f51748ce416508757dafdee7c1b20abdecf2bbbb196bab0668523777e7b76bb","contentType":"text/javascript"},{"path":"tests/server.test.js","size":2990,"sha256":"5d77647873dfde8579c926045a0ac85ba743e83910e3abb31a6bd65d56bc0eed","contentType":"text/javascript"},{"path":"tests/session-detail-cache.test.js","size":2693,"sha256":"10cae0c50e207eebbb72b29561461342baf785c35f3bb2d9279d55a593ee89b8","contentType":"text/javascript"},{"path":"tests/session-selection.test.js","size":3350,"sha256":"900b8cc7b4007ebd49e2679ac3ba78440ad3c8762d67d7fe8c6ae0c84b863b35","contentType":"text/javascript"},{"path":"tests/sessions.test.js","size":3461,"sha256":"9a20b2594f811b02732467a1e727d295dc26ae9fa05a0a76ba387c63e3ab3e1d","contentType":"text/javascript"},{"path":"tests/state.test.js","size":2142,"sha256":"d2f67315e43b4eafd327dac229d23189dec4a2ce0caf5d23d80ee7dfe929a3dc","contentType":"text/javascript"},{"path":"tests/tokens.test.js","size":3793,"sha256":"137abf5d25fa2f2b2b4e7de2031e6db01bb37b5f3b4799645a79a978327c4a71","contentType":"text/javascript"},{"path":"tests/topic-classifier.test.js","size":9182,"sha256":"aed9f574b45bd43e5549a5345981cfe01b556a2e0a1fcf436419ce034b870c54","contentType":"text/javascript"},{"path":"tests/topics.test.js","size":3249,"sha256":"a25207c89b27004c73b4b5b98fb9aa56d513a54062538c121ffd513a6b6991b9","contentType":"text/javascript"},{"path":"tests/usage-report.test.js","size":3278,"sha256":"5b897db77dbdec6ae217d455bc7a76e835db3bb2667c30da263e235e37be0070","contentType":"text/javascript"},{"path":"tests/utils.test.js","size":2416,"sha256":"b3a4c7fa9699492749c0b7c368584f2298c0eb5fc2d9e46f329c36108cd0d9b6","contentType":"text/javascript"},{"path":"tests/work-graph.test.js","size":5699,"sha256":"b33cd205c862930d94395c7250a2e2886ed6bddb841c4e3a8223d9a0bd9522cd","contentType":"text/javascript"},{"path":"skill-card.md","size":1825,"sha256":"d3d7c3255024bb63f466a9b50a0e5715705b6ea1a99b884980fb5d6896bab2b1","contentType":"text/markdown"}],"security":{"status":"suspicious","hasWarnings":true,"checkedAt":1791285363308,"model":null,"hasScanResult":true,"sha256hash":"4da15d96b2b305670ec06e9f3444f266ec9d5715a2cf0f77c46e8fbb216f485f","virustotalUrl":"https://www.virustotal.com/gui/file/4da15d96b2b305670ec06e9f3444f266ec9d5715a2cf0f77c46e8fbb216f485f","scanners":{"vt":null,"skillspector":{"status":"suspicious","normalizedStatus":"suspicious","score":100,"severity":"CRITICAL","recommendation":"DO_NOT_INSTALL","issueCount":137,"checkedAt":1791285363308},"llm":{"status":"suspicious","verdict":"suspicious","normalizedStatus":"suspicious","confidence":"high","summary":"The skill is a coherent OpenClaw monitoring dashboard, but its default and proxy authentication behavior can expose sensitive dashboard data and job controls more broadly than the documentation implies.","dimensions":[{"detail":"The default unauthenticated HTTP server exposes sensitive monitoring endpoints, and optional job-control endpoints can mutate jobs if the jobs provider is configured.","label":"Credentials","name":"environment_proportionality","rating":"concern"},{"detail":"The declared install action is a disclosed shell start command, `node lib/server.js`; no hidden installer or remote payload execution was found in the skill instructions.","label":"Install Mechanism","name":"install_mechanism","rating":"note"},{"detail":"The documentation says the dashboard runs on localhost and claims a localhost default, but the server does not enforce the configured host and authentication defaults to none.","label":"Instruction Scope","name":"instruction_scope","rating":"concern"},{"detail":"The package writes local dashboard state such as privacy and operator settings, which is purpose-aligned, and no system-level persistence, service install, or backdoor behavior was found.","label":"Persistence & Privilege","name":"persistence_privilege","rating":"note"},{"detail":"Reading OpenClaw sessions, memory, usage, cron, vitals, and optional jobs data matches the stated command-center dashboard purpose, including local privacy controls.","label":"Purpose & Capability","name":"purpose_capability","rating":"note"}],"guidance":"Install only if you are comfortable running a local dashboard over your OpenClaw workspace data. Before use, bind it explicitly to loopback or a trusted interface, enable token-based authentication for any non-local access, and avoid relying on the Tailscale/Cloudflare/header-based modes unless the origin is unreachable except through a correctly configured trusted proxy.","findings":"[TP4] expected: The repeated SkillSpector privacy-settings concern corresponds to local dashboard privacy controls that read and write `privacy-settings.json`; this is expected for the advertised privacy-controls feature and was not evidence of hidden persistence.\n[T05] unexpected: The default unauthenticated server-binding concern is supported: auth mode defaults to `none`, sensitive APIs are served from the same process, and `server.listen(PORT)` does not enforce the configured localhost host despite documentation claiming a localhost bind.\n[T05] unexpected: The proxy-auth concern is supported: the Tailscale, Cloudflare, and IP allowlist modes trust request headers such as identity and forwarded-for headers without validating a trusted proxy source.","agenticRiskFindings":null,"riskSummary":null,"model":null,"checkedAt":1791285363308}}}}}