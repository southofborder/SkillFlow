.984409+00:00"},"risk_assessment":{"score":34,"severity":"MEDIUM","recommendation":"CAUTION","max_issue_severity":"HIGH"},"components":[{"path":"SKILL.md","type":"markdown","lines":100,"executable":false,"size_bytes":2361,"source_url":null,"source_identity":null,"source_digest":null}],"structured_summaries":[],"issues":[{"id":"YR4","finding_id":"finding-2dfd3e70abcb4cae83f67629f5af65d0","category":"YARA Match","pattern":"YARA rule 'agent_skill_mcp_tool_poisoning_metadata': MCP/tool metadata poisoning indicators in tool schemas or skill manifests [agent_skills]","severity":"HIGH","confidence":0.8,"location":{"file":"SKILL.md","start_line":8,"end_line":null},"finding":"description:; triggers:; 304502205c02c1ea86957276d0a274b909a4e0067db9ea8c5ca21de30747310b6f3dfabb022100cc035501daaa6e642da4c69ca11f72efa6fb970a6f5e26f711ebb9e3bf1ed3a9","explanation":"YARA rule matched a hack tool or exploit indicator (offensive tools, reconnaissance, privilege escalation, or exploit frameworks).","remediation":"Remove offensive tool references and exploit code. Legitimate agent skills should not contain penetration testing tools, exploit frameworks, or reconnaissance utilities.","code_snippet":"---\nAIGC:\n    ContentProducer: Minimax Agent AI\n    ContentPropagator: Minimax Agent AI\n    Label: AIGC\n    ProduceID: \"00000000000000000000000000000000\"\n    PropagateID: \"00000000000000000000000000000000\"\n    ReservedCode1: 304502205c02c1ea86957276d0a274b909a4e0067db9ea8c5ca21de30747310b6f3dfabb022100cc035501daaa6e642da4c69ca11f72efa6fb970a6f5e26f711ebb9e3bf1ed3a9\n    ReservedCode2: 3045022055ff431f1fac57a338871581c0d1ae5acd1b4c945ca1e40c60062b60cae4b531022100dd7076f1dbf9ed9d9cff03cb5b993b4f86f4988d6f289570a12a6eba8ef20409\ndescription: 浏览器智能控制。自动化操作、截图、填表、数据抓取。\nmetadata:\n    category: 生产力\n    emoji: \"\\U0001F310\"\n    triggers:\n        - 浏览器\n        - browser\n        - 自动化\n        - 截图\n        - 填表\n        - 抓取\nname: agent-browser\n---\n\n","intent":null,"tags":["YARA Match","llm-unconfirmed"],"evidence":{},"match_fingerprint":"14e3dcb8a54ba09bcb881a627a23676786b8650dddf8068dc56a8b67d965f5c0","occurrences":[{"file":"SKILL.md","start_line":8,"end_line":null}]},{"id":"SQP-1","finding_id":"finding-de3a075e9dc1454ab96bf8c47579bbbb","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.96,"location":{"file":"SKILL.md","start_line":14,"end_line":20},"finding":null,"explanation":"The trigger list is very broad and includes generic terms like 'browser', 'automation', 'screenshot', and 'scrape' that commonly appear in ordinary user requests. This can cause the skill to activate outside a narrowly intended context, increasing the chance that powerful browser capabilities are invoked unintentionally or in response to ambiguous prompts.","remediation":"Narrow the trigger phrases to more specific, capability-scoped terms such as 'use browser automation skill' or 'agent-browser screenshot'. Add explicit activation boundaries in metadata and require intent disambiguation before enabling browser actions for generic requests.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":14,"end_line":20}]},{"id":"SQP-1","finding_id":"finding-4b8249fa35314aef92cc191f2e4bd06b","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.91,"location":{"file":"SKILL.md","start_line":77,"end_line":79},"finding":null,"explanation":"The usage guidance says users can 'directly tell me' broad actions like opening pages, taking screenshots, and filling forms, but it does not define when the skill should or should not take over. In a skill with browser control, scraping, login support, and script execution, vague invocation rules raise the risk of over-broad activation and unintended sensitive actions.","remediation":"Document clear invocation criteria, exclusions, and confirmation requirements. Require explicit user opt-in for login flows, form submission, data extraction from authenticated pages, and any action using browser_evaluate or other high-risk browser controls.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":77,"end_line":79}]}],"suppressed_count":0,"suppressed":[],"metadata":{"has_executable_scripts":false,"skillspector_version":"2.11.2","llm_requested":true,"llm_available":true,"meta_analysis_applied":true,"inference_usage":[{"node":"semantic_developer_intent","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":2392,"completion_tokens":14,"cached_tokens":0,"reasoning_tokens":0,"total_tokens":2406},{"node":"semantic_quality_policy","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":2467,"completion_tokens":304,"cached_tokens":0,"reasoning_tokens":0,"total_tokens":2771},{"node":"semantic_security_discovery","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":1999,"completion_tokens":14,"cached_tokens":0,"reasoning_tokens":0,"total_tokens":2013},{"node":"meta_analyzer","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":2257,"completion_tokens":562,"cached_tokens":0,"reasoning_tokens":0,"total_tokens":2819}],"llm_calls_attempted":4,"llm_calls_succeeded":4},"execution_successful":true,"analysis_completeness":{"total_components":1,"scanned_components":1,"coverage_percent":100,"is_complete":false,"status":"partial","execution_successful":true,"fully_inspected_files":1,"partially_inspected_files":0,"entirely_uninspected_files":0,"ledger_exceptions":[{"outcome":"partial","phase":"ref