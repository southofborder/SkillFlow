[{"tool":{"driver":{"name":"aig-skill-scan","version":"0.2.1","informationUri":"https://github.com/Tencent/AI-Infra-Guard","rules":[{"id":"T01","name":"Skill Instruction Hijacking","shortDescription":{"text":"Alters the agent's current session goals or safety constraints when the skill is loaded"}},{"id":"T02","name":"Agent Memory Poisoning","shortDescription":{"text":"Writes attacker-controlled rules into persistent memory so they continue to affect future sessions"}},{"id":"T03","name":"Remote Payload Retrieval and Execution","shortDescription":{"text":"Fetches code from an external URL, allowing the effective payload to change after skill review"}},{"id":"T04","name":"Embedded Malicious Code","shortDescription":{"text":"Ships malicious scripts inside the skill package and executes them locally when invoked"}},{"id":"T05","name":"Unauthorized Access and Privilege Escalation","shortDescription":{"text":"Breaks least-privilege boundaries by obtaining permissions beyond the task's legitimate needs"}},{"id":"T06","name":"System Persistence","shortDescription":{"text":"Installs cross-session backdoors, hooks, services, or scheduled tasks that survive the skill run"}},{"id":"T07","name":"Tool Hijacking and Spoofing","shortDescription":{"text":"Modifies, wraps, spoofs, or replaces tools so legitimate-looking calls execute attacker logic"}},{"id":"T08","name":"Insecure Dependencies","shortDescription":{"text":"Introduces malicious packages or components through dependency confusion, typosquatting, or unsafe sources"}},{"id":"T09","name":"Insecure Skill Coding Practices","shortDescription":{"text":"Exposes exploitable flaws such as hardcoded secrets, command injection, plaintext sensitive data, or unsafe temp files"}},{"id":"other","name":"Other Risk","shortDescription":{"text":"Security issues not covered by the T01-T09 classification"}}]}},"results":[],"properties":{"securityScore":100,"primaryLanguage":"Markdown","llm":"gpt-5.6","startTime":1789193623.1209004,"endTime":1789193641.4790447}}]},"skillspector":{"skill":{"name":"personal-productivity","source":"/tmp/clawhub-codex-scan-v578qrhr5096zzeyrr8ajvst7d8e9sx1-6wIgYL/clawscan-skillspector-3226446686/artifact","scanned_at":"2026-09-12T06:13:42.363118+00:00"},"risk_assessment":{"score":32,"severity":"MEDIUM","recommendation":"CAUTION","max_issue_severity":"MEDIUM"},"components":[{"path":"SKILL.md","type":"markdown","lines":161,"executable":false,"size_bytes":4851,"source_url":null,"source_identity":null,"source_digest":null},{"path":"index.js","type":"javascript","lines":363,"executable":true,"size_bytes":7328,"source_url":null,"source_identity":null,"source_digest":null},{"path":"package.json","type":"json","lines":15,"executable":false,"size_bytes":350,"source_url":null,"source_identity":null,"source_digest":null}],"structured_summaries":[],"issues":[{"id":"SQP-1","finding_id":"finding-dace79a8120542d8b9070eebb9f50cef","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.92,"location":{"file":"SKILL.md","start_line":3,"end_line":3},"finding":null,"explanation":"The trigger description is broad enough to activate on many ordinary conversations about productivity, focus, planning, or procrastination. Overbroad routing can cause the wrong skill to take control, leading to irrelevant guidance, prompt-surface expansion, and reduced reliability of downstream behavior even if the skill is not overtly malicious.","remediation":"Narrow the trigger criteria to explicit user intents, examples, and boundaries. Specify required keywords or scenarios, define exclusions, and document when the base assistant should answer without invoking this skill.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":3,"end_line":3}]},{"id":"SQP-3","finding_id":"finding-341ceed968704683b1f36842e1cfc8b4","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"index.js","start_line":2,"end_line":356},"finding":null,"explanation":"SQP-3 applies to all file types. The natural-language strings throughout the file are Chinese-only, and the skill introduces itself and responds in Chinese without any opt-in or alternative language path, which can violate language/locale choice expectations.","remediation":"Offer bilingual responses or detect and respect the user's language preference. If the skill is intended only for Chinese-speaking users, document that locale scope explicitly in the skill description or manifest.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"index.js","start_line":2,"end_line":356}]},{"id":"SQP-3","finding_id":"finding-8f35bcef9aaa4faaa7c373f4b6bff553","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.9,"location":{"file":"package.json","start_line":4,"end_line":4},"finding":null,"explanation":"The package description is entirely in Chinese, which indicates the skill is presented as Chinese-language-specific without any stated user choice or opt-in. Under the policy, language constraints should either be optional for the user or clearly justified as region-specific.","remediation":"Add language choice or explicitly document that the skill supports multiple languages. If the skill is intentionally Chinese-only, state that constraint clearly and justify it as a region- or audience-specific skill.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"package.json","start_line":4,"end_line":4}]},{"id":"SQP-3","finding_id":"finding-80a010795c8349488d834338c8d583d9","category":null,"pattern":null,"severity":"LOW","confidence":0.88,"location":{"file":"SKILL.md","start_line":3,"end_line":12},"finding":null,"explanation":"The skill is presented primarily in Chinese without clearly stating language scope or offering a language fallback. This can cause misrouting or user confusion when invoked for users expecting another language, which may degrade safety-relevant comprehension of advice and instructions.","remediation":"Document the supported language(s) explicitly in metadata and add a language-selection or fallback behavior. If the skill is intended for Chinese only, state that constraint clearly and instruct the system to avoid invoking it for users who are interacting in other languages.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":3,"end_line":12}]},{"id":"SQP-2","finding_id":"finding-39fe8e186df74aaea94ae985e3eaf996","category":null,"pattern":null,"severity":"LOW","confidence":0.83,"location":{"file":"index.js","start_line":14,"end_line":23},"finding":null,"explanation":"This is a code file, so SQP-2 applies. The matcher activates on broad terms such as '忙', '计划', '日程', and '事', but there is no confirmation prompt, logging, or inline disclosure explaining that ordinary conversation may trigger the skill; this is a user-impacting behavior in a conversational agent even though it is not destructive.","remediation":"Add a brief user-facing disclosure in comments/README or narrow the matching logic. Prefer explicit activation phrases or add a confirmation step before returning guidance when only broad keywords matched.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"index.js","start_line":14,"end_line":23}]}],"suppressed_count":0,"suppressed":[],"metadata":{"has_executable_scripts":true,"skillspector_version":"2.11.2","llm_requested":true,"llm_available":true,"meta_analysis_applied":true,"inference_usage":[{"node":"mcp_tool_poisoning","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":2513,"completion_tokens":273,"cached_tokens":0,"reasoning_tokens":0,"total_tokens"