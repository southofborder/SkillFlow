:"2026-10-12T04:37:07.589969+00:00"},"risk_assessment":{"score":29,"severity":"MEDIUM","recommendation":"CAUTION","max_issue_severity":"MEDIUM"},"components":[{"path":"SKILL.md","type":"markdown","lines":578,"executable":false,"size_bytes":17678,"source_url":null,"source_identity":null,"source_digest":null},{"path":"package.json","type":"json","lines":6,"executable":false,"size_bytes":122,"source_url":null,"source_identity":null,"source_digest":null}],"structured_summaries":[],"issues":[{"id":"SDI-1","finding_id":"finding-c2b466c5c0994b5084ee209eb165f6ff","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"SKILL.md","start_line":3,"end_line":3},"finding":null,"explanation":"The manifest description presents the skill as generic Twitter/X and meme evidence retrieval, but the body also exposes watchlist management and real-time monitoring capabilities. This mismatch can mislead users or calling agents about the surveillance-like functionality, reducing informed consent and increasing the chance the skill is invoked in contexts where persistent monitoring is inappropriate.","remediation":"Update the manifest description to explicitly disclose monitoring/watchlist features, including follower-event tracking, deleted-tweet retrieval, and real-time subscriptions. Add a concise privacy/sensitivity notice in the top-level metadata/description so users and orchestrators can make informed trust decisions before invocation.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":3,"end_line":3}]},{"id":"E1","finding_id":"finding-cc065ff829e04e398b941cf13019522a","category":"Data Exfiltration","pattern":"External Transmission","severity":"MEDIUM","confidence":0.6,"location":{"file":"SKILL.md","start_line":12,"end_line":null},"finding":"curl\n    primaryEnv: OPENNEWS_TOKEN\n    emoji: \"\\U0001F426\"\n    install:\n      - id: curl\n        kind: brew\n        formula: