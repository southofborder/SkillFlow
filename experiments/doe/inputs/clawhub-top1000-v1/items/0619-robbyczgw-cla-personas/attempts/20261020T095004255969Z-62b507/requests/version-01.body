e7d09df9a028f27f0e902993aee79a5571cdd01bd72","contentType":"text/markdown"},{"path":"data/zen.md","size":1140,"sha256":"ab2d95ad7ebbac64549a7a159ff6e97a179f620a466c596a0e9989430a598397","contentType":"text/markdown"},{"path":"scripts/__pycache__/persona.cpython-312.pyc","size":12932,"sha256":"2c56be8e9fbd4ee5a5b0e49f797b9b9042a2a71b2894f845cf488a85a93901eb","contentType":"application/octet-stream"},{"path":"scripts/persona.py","size":10012,"sha256":"9f8659e73b0f9b34810f1780351935a9c7b216823ebf5853e166e046048195e6","contentType":"application/octet-stream"},{"path":"skill.json","size":1254,"sha256":"6234faf830f410955c5b49dbb4959651e305d2d45f9606c2f2ce0dc9a9e59eff","contentType":"application/json"},{"path":"skill-card.md","size":2894,"sha256":"b7e051e4682390c7d8368b0a6b716d55cd78ab21b8b05f85850afad584ff416e","contentType":"text/markdown"}],"security":{"status":"clean","hasWarnings":true,"checkedAt":1788193192526,"model":null,"hasScanResult":true,"sha256hash":"ad0f4818629d269da4af120012a1c8251da614be571515ff77aed5e5c639175d","virustotalUrl":"https://www.virustotal.com/gui/file/ad0f4818629d269da4af120012a1c8251da614be571515ff77aed5e5c639175d","scanners":{"vt":{"status":"clean","verdict":null,"normalizedStatus":"clean","analysis":null,"source":"engines","checkedAt":1788192907288},"skillspector":{"status":"suspicious","normalizedStatus":"suspicious","score":52,"severity":"HIGH","recommendation":"DO_NOT_INSTALL","issueCount":14,"checkedAt":1788193192526},"llm":{"status":"clean","verdict":"benign","normalizedStatus":"clean","confidence":"high","summary":"This skill is a disclosed persona switcher that reads bundled persona prompts and saves only local persona state, with some usability cautions around broad triggers and German-language personas.","dimensions":[{"detail":"The declared Python requirement is proportionate to the CLI helper, which uses fixed bundled persona filenames and a fixed local state path rather than broad filesystem access.","label":"Credentials","name":"environment_proportionality","rating":"ok"},{"detail":"The package consists of markdown docs, persona data, a Python helper, and an included generated pyc file; no install hooks, package-manager scripts, downloads, or API-key setup were found.","label":"Install Mechanism","name":"install_mechanism","rating":"note"},{"detail":"Natural-language activation phrases such as \"switch to\" and \"activate\" are broad, and many persona prompts are written in German, so users may see unexpected persona or language changes if the host trigger matching is loose.","label":"Instruction Scope","name":"instruction_scope","rating":"note"},{"detail":"Activation persists the current persona and short history in ~/.openclaw/persona-state.json; this is documented, low impact, and reversible with the reset command.","label":"Persistence & Privilege","name":"persistence_privilege","rating":"note"},{"detail":"The artifacts consistently describe 20 built-in personas and a small CLI for listing, showing, activating, checking, and resetting them; inspected code matches that purpose and showed no unrelated network, credential, or destructive behavior.","label":"Purpose & Capability","name":"purpose_capability","rating":"ok"}],"guidance":"Install only if you want an assistant that can switch into persistent persona modes. Prefer explicit /personas commands, check the active persona if responses seem unusual, and be aware that several personas may answer in German and that medical/legal personas are educational only.","findings":"[LP3] expected: The file reads and writes are real, but they are limited to bundled persona markdown and a documented OpenClaw state file; this is a transparency note rather than a security hold.\n[SQP-1] expected: Persona switching by user phrase is part of the skill design, but the documented phrases are broad enough that users should prefer explicit /personas commands to avoid accidental switches.\n[SQP-3] expected: The German persona text can steer responses into German and may surprise non-German users, but it is visible bundled prompt content and not hidden access, execution, or exfiltration.","agenticRiskFindings":null,"riskSummary":null,"model":null,"checkedAt":1788193192526}}}}}