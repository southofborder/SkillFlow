{"skill":{"slug":"personas","displayName":"Clawdbot Personas"},"version":{"version":"2.3.0","createdAt":1788192669765,"changelog":"OpenClaw 2.0 compatibility: corrected frontmatter, automations CLI, and documentation. Verified against a live OpenClaw 2026.8.1 install.","changelogSource":"user","license":"MIT-0","files":[{"path":"CHANGELOG.md","size":2223,"sha256":"5baebe1040fd38b3dc2e784f54b90462aab44b38be7ce13b0e6d18f78d5cff31","contentType":"text/markdown"},{"path":"FAQ.md","size":1052,"sha256":"f372d1486bf793327fa376a9fe3775d15f29da39c88e3ee24eb19ab2876cd0be","contentType":"text/markdown"},{"path":"LICENSE","size":1062,"sha256":"e12033f72dc2e8d7dbbcf99ff45646cb8a9c20200f7536581e64afac52c29a8d","contentType":"application/octet-stream"},{"path":"OVERVIEW.md","size":870,"sha256":"1bbf82ae9b0c41bd4200346a56a74f8342eb05574c138f9904e931c436f7c098","contentType":"text/markdown"},{"path":"README.md","size":1854,"sha256":"d30cf2e7c5c1ee4cbdd1d6592082dbcdab71188e3381d00074166f1c92453451","contentType":"text/markdown"},{"path":"SKILL.md","size":2358,"sha256":"4e5ea75a22ff5ae2d3897b7c38f1871e8267e9b923dc16931a4b969ef19af7f1","contentType":"text/markdown"},{"path":"SUMMARY.md","size":1575,"sha256":"8b6e389ee8925f8b463406b3838fa7b84c8154a9f9e67cc41deb27b0c91b15c0","contentType":"text/markdown"},{"path":"data/cami.md","size":3380,"sha256":"d8db883e40f3a780951a838983d352d8362492b362b8e9b665bb1c25284b8d4c","contentType":"text/markdown"},{"path":"data/career-coach.md","size":1932,"sha256":"b19213f175078bd52f7b82198f7e180c3425c1bb863524771eeeca48ca3ac7e3","contentType":"text/markdown"},{"path":"data/chameleon-agent.md","size":4119,"sha256":"8f01b80a7e39fa97307ead2b7c0dd9a9075356a78c98866758e0fd91b61eb36d","contentType":"text/markdown"},{"path":"data/chef-marco.md","size":1095,"sha256":"6e14c84b2de7da6f76099b11dcf45aa0f9351e8dad819a16c36d907869ae203e","contentType":"text/markdown"},{"path":"data/cyberguard.md","size":1872,"sha256":"b3a553794830974bf003fbb7f88b414096193be11202540579c