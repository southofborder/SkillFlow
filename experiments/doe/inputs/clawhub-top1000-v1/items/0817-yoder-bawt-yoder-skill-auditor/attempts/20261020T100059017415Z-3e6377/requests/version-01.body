{"skill":{"slug":"yoder-skill-auditor","displayName":"Yoder Skill Auditor"},"version":{"version":"3.1.0","createdAt":1771258895953,"changelog":"Security advisory remediation: removed self-allowlist, excluded test fixtures, removed auto-install, documented pattern filters, added warnings","changelogSource":"user","license":null,"files":[{"path":"CHANGELOG.md","size":5650,"sha256":"9507dd29ea4bef2375475a2f1cea13d434ea2773467fc017585871bed70adf7e","contentType":"text/markdown"},{"path":"SKILL.md","size":6709,"sha256":"b4a29b9ed71795789ddf6d2d1a57a8f64340cfb8bfb2cc05ad339c2fed5a5d52","contentType":"text/markdown"},{"path":"TEST-FIXTURES-WARNING.md","size":1731,"sha256":"b9c32b82b20e2dd188eede9bddf69df522b0610a9e7c60233a153f5d59506743","contentType":"text/markdown"},{"path":"allowlist.json","size":2807,"sha256":"9b09b8fea3b4313af8b869d373fbd9bf21f8c35e4b26f9eabbb99d5272a5709c","contentType":"application/json"},{"path":"audit-all.sh","size":2555,"sha256":"20e111a285c726b61b853d57e8583fcef253c128809f72768bf21af32fa40f31","contentType":"application/x-sh"},{"path":"audit.sh","size":35773,"sha256":"007e15cb38ee96df53f43a6511c8abd28579e11db3654602a9408b1ebb9d863d","contentType":"application/x-sh"},{"path":"benchmark.sh","size":3028,"sha256":"4d1f430200bf69e7a60df351ae7d1d781f90de34660b3f7c55b3b314338fcf87","contentType":"application/x-sh"},{"path":"diff-audit.sh","size":3536,"sha256":"62b23347e382c194e8e7058295e411c07fe970db060ae8d0c56afec7586dba2d","contentType":"application/x-sh"},{"path":"inspect.sh","size":3931,"sha256":"918aaa7d74d1a86c794b6021ca857252737f169565c683681aeca80abf1e8fb7","contentType":"application/x-sh"},{"path":"report.sh","size":3506,"sha256":"420c0e4d411156207c7242d15bfb6c88c7e7495dc05271e2d5108b499539ef4f","contentType":"application/x-sh"},{"path":"skill.json","size":1201,"sha256":"b6787957a90d0dc556ff0563a6db51898e277cf06ad42cc0a9f1e13b8d1f3f71","contentType":"application/json"},{"path":"test.sh","size":4566,"sha256":"4a34ffed3be5009172c77da84b3a61af8b2