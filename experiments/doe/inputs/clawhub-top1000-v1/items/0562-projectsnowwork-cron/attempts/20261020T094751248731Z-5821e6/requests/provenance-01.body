e":"Embedded Malicious Code","shortDescription":{"text":"Ships malicious scripts inside the skill package and executes them locally when invoked"}},{"id":"T05","name":"Unauthorized Access and Privilege Escalation","shortDescription":{"text":"Breaks least-privilege boundaries by obtaining permissions beyond the task's legitimate needs"}},{"id":"T06","name":"System Persistence","shortDescription":{"text":"Installs cross-session backdoors, hooks, services, or scheduled tasks that survive the skill run"}},{"id":"T07","name":"Tool Hijacking and Spoofing","shortDescription":{"text":"Modifies, wraps, spoofs, or replaces tools so legitimate-looking calls execute attacker logic"}},{"id":"T08","name":"Insecure Dependencies","shortDescription":{"text":"Introduces malicious packages or components through dependency confusion, typosquatting, or unsafe sources"}},{"id":"T09","name":"Insecure Skill Coding Practices","shortDescription":{"text":"Exposes exploitable flaws such as hardcoded secrets, command injection, plaintext sensitive data, or unsafe temp files"}},{"id":"other","name":"Other Risk","shortDescription":{"text":"Security issues not covered by the T01-T09 classification"}}]}},"results":[],"properties":{"securityScore":100,"primaryLanguage":"Python","llm":"gpt-5.6","startTime":1789161476.606439,"endTime":1789161504.2758152}}]},"skillspector":{"skill":{"name":"cron","source":"/tmp/clawhub-codex-scan-v570vcxk9723wtddd6zawz43kn8e77x5-LZK4qG/clawscan-skillspector-1198027789/artifact","scanned_at":"2026-09-11T21:17:55.416204+00:00"},"risk_assessment":{"score":57,"severity":"HIGH","recommendation":"DO_NOT_INSTALL","max_issue_severity":"HIGH"},"components":[{"path":"SKILL.md","type":"markdown","lines":44,"executable":false,"size_bytes":1553,"source_url":null,"source_identity":null,"source_digest":null},{"path":"references/philosophy.md","type":"markdown","lines":6,"executable":false,"size_bytes":234,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/add_job.py","type":"python","lines":94,"executable":true,"size_bytes":3126,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/init_storage.py","type":"python","lines":52,"executable":true,"size_bytes":1342,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/lib/schedule.py","type":"python","lines":72,"executable":true,"size_bytes":2249,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/lib/storage.py","type":"python","lines":73,"executable":true,"size_bytes":1908,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/list_jobs.py","type":"python","lines":22,"executable":true,"size_bytes":471,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/next_run.py","type":"python","lines":28,"executable":true,"size_bytes":707,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/pause_job.py","type":"python","lines":36,"executable":true,"size_bytes":874,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/resume_job.py","type":"python","lines":45,"executable":true,"size_bytes":1207,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/show_job.py","type":"python","lines":25,"executable":true,"size_bytes":589,"source_url":null,"source_identity":null,"source_digest":null},{"path":"skill.json","type":"json","lines":20,"executable":false,"size_bytes":525,"source_url":null,"source_identity":null,"source_digest":null}],"structured_summaries":[],"issues":[{"id":"TP4","finding_id":"finding-1d68f6c4182c4657a5737027851f38de","category":"MCP Tool Poisoning","pattern":null,"severity":"HIGH","confidence":0.96,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"The declared behavior substantially overstates what the implementation actually does, creating a trust gap between user/operator expectations and real functionality. Security-relevant mismatches can cause users to rely on nonexistent schedule management, pause/resume, or recurrence controls, which may lead to missed actions, unintended execution assumptions, or unsafe downstream agent decisions.","remediation":"Align the description with the actual implementation, or implement the missing features before advertising them. Add tests that verify every claimed capability in `SKILL.md`, and gate release on documentation-to-behavior consistency checks.","code_snippet":null,"intent":null,"tags":["ASI02","AML.T0080"],"evidence":{"code_path":"scripts/lib/schedule.py","code_start_line":1,"code_end_line":72,"actual_behavior_summary":"A small local scheduling utility that parses HH:MM time strings and computes the next execution time for daily, weekly, monthly, or minute-interval schedules."},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"LP3","finding_id":"finding-867f7d6801a3494099c115b901925276","category":"MCP Least Privilege","pattern":null,"severity":"MEDIUM","confidence":0.85,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"The skill advertises local file-backed behavior and references multiple local storage paths, but it does not declare any explicit tool scope or permissions boundary. In an agent environment, undeclared file read/write capability weakens least-privilege guarantees and can cause the skill to receive broader filesystem access than users or orchestrators expect.","remediation":"Add explicit permission metadata such as `permissions` or `allowed-tools` that limits the skill to the minimum required file operations and, if supported, restrict access to the specific cron storage directory. Document exactly which files may be read or written and fail closed if broader access is unavailable.","code_snippet":null,"intent":null,"tags":["ASI02"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"SQP-1","finding_id":"finding-34a77f279b5b4f5190bc1665d5976fa5","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.94,"location":{"file":"SKILL.md","start_line":3,"end_line":3},"finding":null,"explanation":"The activation text is overly broad and can cause the skill to trigger on a wide range of ordinary scheduling-related conversations, even when the user did not intend to invoke persistent or file-writing behavior. In context, this is more dangerous because the skill presents itself as managing recurring jobs and local state, so over-invocation can lead to inappropriate schedule creation, modification, or exposure of stored schedule data.","remediation":"Narrow the routing description to explicit, high-intent cases such as creating, modifying, pausing, resuming, or listing recurring jobs. Require confirmation before any persistent action and separate informational date-calculation use cases from stateful schedule-management actions.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":3,"end_line":3}]},{"id":"SQP-3","finding_id":"finding-f5f017d49aa34e34917c2e44d718e58f","category":null,"pattern":null,"severity":"LOW","confidence":0.96,"location":{"file":"scripts/add_job.py","start_line":29,"end_line":29},"finding":null,"explanation":"The CLI defaults `--timezone` to `Asia/Tokyo`, which imposes a specific locale behavior even when the user does not choose one. Under the policy, forced language/locale settings should either be optional by default or clearly justified as region-specific.","remediation":"Remove the hardcoded locale default, require the user to specify a timezone explicitly, or document and justify why the skill is region-specific. Alternatively, detect and use the user's existing system timezone rather than forcing `Asia/Tokyo`.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/add_job.py","start_line":29,"end_line":29}]},{"id":"SQP-2","finding_id":"finding-9cf826eaf4dc403b9b845caadccae92a","category":null,"pattern":null,"severity":"LOW","confidence":0.87,"location":{"file":"scripts/lib/storage.py","start_line":24,"end_line":29},"finding":null,"explanation":"This helper writes JSON data to files under the user's home directory using a temporary file and atomic replace, which affects persistent user data. The code contains no confirmation prompt, logging, print statement, or explanatory comment/docstring disclosing that these writes occur.","remediation":"Add a brief docstring or comment explaining that the function writes persistent state under ~/.openclaw/workspace/memory/cron, or emit a user-visible log/message at higher-level call sites before saving data.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/lib/storage.py","start_line":24,"end_line":29}]},{"id":"SQP-2","finding_id":"finding-dbaae076416046288f7cbc060b262338","category":null,"pattern":null,"severity":"LOW","confidence":0.84,"location":{"file":"scripts/lib/storage.py","start_line":42,"end_line":45},"finding":null,"explanation":"The save_jobs function updates metadata and writes jobs data to disk, changing persistent state in the user's home directory. There is no user-facing warning, logging, or inline documentation in this file describing this behavior.","remediation":"Document in a docstring or comment that save_jobs persists job state locally, or ensure calling code provides a visible notice when job data is saved.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/lib/storage.py","start_line":42,"end_line":45}]},{"id":"SQP-2","finding_id":"finding-405441b0f6cf4ae784855f1edea6e78b","category":null,"pattern":null,"severity":"LOW","confidence":0.84,"location":{"file":"scripts/lib/storage.py","start_line":58,"end_line":61},"finding":null,"explanation":"The save_runs function updates metadata and stores run history on disk, which is a persistent write affecting user data. This file does not include any warning, log message, or explanatory documentation for that operation.","remediation":"Add a docstring/comment stating that run history is stored locally, or provide a user-visible notice in the calling flow before persisting run data.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/lib/storage.py","start_line":58,"end_line":61}]},{"id":"SQP-2","finding_id":"finding-fae7f1193f9e4a45a219b6fe48a0668d","category":null,"pattern":null,"severity":"LOW","confidence":0.82,"location":{"file":"scripts/lib/storage.py","start_line":72,"end_line":73},"finding":null,"explanation":"The save_stats function writes statistics data to a file in the user's home directory, creating or modifying persistent local state. No prompt, logging, or explanatory comment/docstring is present in this code to disclose that behavior.","remediation":"Add a short docstring or comment describing the local persistence of stats data, or ensure higher-level code surfaces a visible notice when stats are saved.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/lib/storage.py","start_line":72,"end_line":73}]}],"suppressed_count":0,"suppressed":[],"metadata":{"has_executable_scripts":true,"skillspector_version":"2.11.2","llm_requested":true,"llm_available":true,"meta_analysis_applied":true,"inference_usage":[{"node":"mcp_tool_poisoning","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":1110,"completion_tokens":235,"cached_tokens":0,"reasoning_tokens":0,"total_tokens":1345},{"node":"mcp_tool_poisoning","request_kind":"struct