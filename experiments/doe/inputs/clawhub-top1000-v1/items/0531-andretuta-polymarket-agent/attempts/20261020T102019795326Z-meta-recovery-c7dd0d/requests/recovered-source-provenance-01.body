5","name":"Unauthorized Access and Privilege Escalation","shortDescription":{"text":"Breaks least-privilege boundaries by obtaining permissions beyond the task's legitimate needs"}},{"id":"T06","name":"System Persistence","shortDescription":{"text":"Installs cross-session backdoors, hooks, services, or scheduled tasks that survive the skill run"}},{"id":"T07","name":"Tool Hijacking and Spoofing","shortDescription":{"text":"Modifies, wraps, spoofs, or replaces tools so legitimate-looking calls execute attacker logic"}},{"id":"T08","name":"Insecure Dependencies","shortDescription":{"text":"Introduces malicious packages or components through dependency confusion, typosquatting, or unsafe sources"}},{"id":"T09","name":"Insecure Skill Coding Practices","shortDescription":{"text":"Exposes exploitable flaws such as hardcoded secrets, command injection, plaintext sensitive data, or unsafe temp files"}},{"id":"other","name":"Other Risk","shortDescription":{"text":"Security issues not covered by the T01-T09 classification"}}]}},"results":[],"properties":{"securityScore":100,"primaryLanguage":"Python","llm":"gpt-5.6","startTime":1789800385.4365015,"endTime":1789800478.4690385}}]},"skillspector":{"skill":{"name":"polymarket-agent","source":"/tmp/clawhub-codex-scan-v573reeb71773kw17bj9dq9x1h8eqgrz-LNW94y/clawscan-skillspector-1473144251/artifact","scanned_at":"2026-09-19T06:46:24.768426+00:00"},"risk_assessment":{"score":100,"severity":"CRITICAL","recommendation":"DO_NOT_INSTALL","max_issue_severity":"HIGH"},"components":[{"path":"CHANGELOG.md","type":"markdown","lines":258,"executable":false,"size_bytes":13863,"source_url":null,"source_identity":null,"source_digest":null},{"path":"README.md","type":"markdown","lines":123,"executable":false,"size_bytes":4103,"source_url":null,"source_identity":null,"source_digest":null},{"path":"SECURITY.md","type":"markdown","lines":265,"executable":false,"size_bytes":13723,"source_url":null,"source_identity":null,"source_digest":null},{"path":