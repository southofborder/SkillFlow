_bytes":4546,"source_url":null,"source_identity":null,"source_digest":null},{"path":"polymarket_agent/trading.py","type":"python","lines":358,"executable":true,"size_bytes":12229,"source_url":null,"source_identity":null,"source_digest":null},{"path":"polymarket_agent/whales.py","type":"python","lines":313,"executable":true,"size_bytes":10588,"source_url":null,"source_identity":null,"source_digest":null},{"path":"pyproject.toml","type":"toml","lines":53,"executable":false,"size_bytes":1788,"source_url":null,"source_identity":null,"source_digest":null},{"path":"requirements.txt","type":"text","lines":44,"executable":false,"size_bytes":2168,"source_url":null,"source_identity":null,"source_digest":null},{"path":"tests/test_guardrails.py","type":"python","lines":356,"executable":true,"size_bytes":15711,"source_url":null,"source_identity":null,"source_digest":null},{"path":"tests/test_journal.py","type":"python","lines":203,"executable":true,"size_bytes":8947,"source_url":null,"source_identity":null,"source_digest":null},{"path":"tests/test_whales.py","type":"python","lines":321,"executable":true,"size_bytes":14442,"source_url":null,"source_identity":null,"source_digest":null}],"structured_summaries":[],"issues":[{"id":"TP4","finding_id":"finding-8c522acf17c14c468ec13ae12699a503","category":"MCP Tool Poisoning","pattern":null,"severity":"HIGH","confidence":0.95,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"The skill description emphasizes research with optional trading, but the documented behavior includes sensitive key custody operations: reading secrets from environment variables, prompting for passphrases, decrypting keys for signing, and deleting keystore files. That mismatch can cause operators or users to enable the skill under a lower-risk assumption than is warranted, which is especially dangerous because compromise or misuse could lead to irreversible financial loss.","remediation":"Make the high-risk wallet and key-management behavior explicit in the top-level description and metadata, including that the skill handles private keys and can sign real-money transactions. Prefer splitting wallet custody/trading into a separate clearly labeled skill, disable insecure env-key paths by default, and require explicit privileged permissions and user confirmation before any secret-handling or signing operations are available.","code_snippet":null,"intent":null,"tags":["ASI02","AML.T0080"],"evidence":{"code_path":"polymarket_agent/keystore.py","code_start_line":1,"code_end_line":261,"actual_behavior_summary":"The code chunk implements private-key and keystore management for a Polymarket/Polygon wallet: validating private keys, encrypting and storing them in a local keystore, loading/decrypting them from disk or environment variables, prompting for passphrases, warning about insecure env-based key usage, and deleting/redacting stored credentials."},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"PE3","finding_id":"finding-263ec7851c704c9285b6d73732f0bcd6","category":"Privilege Escalation","pattern":"Credential Access","severity":"HIGH","confidence":0.7,"location":{"file":"tests/test_guardrails.py","start_line":263,"end_line":null},"finding":"secrets.env","explanation":"Code accesses credential files (SSH keys, AWS credentials, etc.). This could indicate credential theft attempts.","remediation":"Remove references to credential paths. Use environment variables or secrets managers. For docs, use placeholder paths (e.g., /path/to/config). Never load .env or token files in production code paths.","code_snippet":"    def test_unknown_keys_are_rejected(self):\n        from polymarket_agent.config import ConfigError, _coerce\n\n        for bad in (\"../../secrets.env\", \"gateway.token\", \"__proto__\"):\n            with self.assertRaises(ConfigError):\n                _coerce(bad, \"x\")\n","intent":null,"tags":["Privilege Escalation","llm-unconfirmed"],"evidence":{},"match_fingerprint":"e701e85b6a5cb666e3a76e41f410da650a6625636882526540c6a36f23e1492c","occurrences":[{"file":"tests/test_guardrails.py","start_line":263,"end_line":null}]},{"id":"E2","finding_id":"finding-f476c7d7b1df43269b6b7045977b3c8b","category":"Data Exfiltration","pattern":"Env Variable Harvesting","severity":"HIGH","confidence":0.6,"location":{"file":"tests/test_journal.py","start_line":172,"end_line":172},"finding":"dict(os.environ)","explanation":"Code enumerates, copies, or searches environment variables for secrets. Bulk environment access can collect credentials unrelated to the skill's stated purpose.","remediation":"Read only explicitly required environment variables by name. Avoid enumerating or copying the full environment, and never log or transmit credentials to untrusted destinations.","code_snippet":"        )\n        holder = subprocess.Popen(\n            [sys.executable, \"-c\", script],\n            stdout=subprocess.PIPE, text=True, env=dict(os.environ),\n        )\n        try:\n            self.assertEqual(holder.stdout.readline().strip(), \"LOCKED\")","intent":null,"tags":["Data Exfiltration","llm-unconfirmed"],"evidence":{},"match_fingerprint":"585dfe66dcf8dd59e27929295d3eb32cf81458b5bd468cd9bf20325fec8ad8d4","occurrences":[{"file":"tests/test_journal.py","start_line":172,"end_line":172}]},{"id":"LP3","finding_id":"finding-84e4f31a072e4e3894b3b9bec46e3ba7","category":"MCP Least Privilege","pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"The skill advertises capabilities that include shell, network, environment access, and file writes, but it does not declare any explicit tool scope or allowed-tools boundary. For a skill that can touch wallet material, schedule jobs, and invoke trading commands, missing scope declarations increases the blast radius of prompt-injection, misuse, or accidental tool invocation because the runtime has no documented least-privilege constraints.","remediation":"Add explicit permissions/allowed-tools metadata that limits the skill to the minimum required commands and resources. Separate read-only research actions from wallet/trading actions into distinct scoped tools or skills, and restrict filesystem paths, environment variable exposure, and shell/network access as narrowly as possible.","code_snippet":null,"intent":null,"tags":["ASI02"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"RA2","finding_id":"finding-122b123186bf4dad9d2eb7fb4e04d644","category":"Rogue Agent","pattern":"Session Persistence","severity":"MEDIUM","confidence":0.6,"location":{"file":"polymarket_agent/cli.py","start_line":68,"end_line":null},"finding":"write the existing keystore.\"),\n) -> None:\n    \"\"\"Create the ENCRYPTED wallet keystore (interactive wizard).\n\n    The private key is read hidden, encrypted with scrypt+AES and written with\n    0600 pe","explanation":"Skill establishes unauthorized persistence across sessions via cron jobs, startup scripts, or state files. Session persistence allows an attacker to maintain access beyond the current interaction.","remediation":"Remove any persistence mechanisms (cron jobs, startup scripts, state files). Skills should not maintain state across sessions without explicit user consent.","code_snippet":"\n@app.command(rich_help_panel=\"Setup\")\ndef setup(\n    force: bool = typer.Option(False, \"--force\", help=\"Overwrite the existing keystore.\"),\n) -> None:\n    \"\"\"Create the ENCRYPTED wallet keystore (interactive wizard).\n","intent":null,"tags":["Rogue Agent","llm-unconfirmed"],"evidence":{},"match_fingerprint":"e3f03b70990463a3ec3f24704e30558137654d491764fe2c0abfaa79dc927fc8","occurrences":[{"file":"polymarket_agent/cli.py","start_line":68,"end_line":null}]},{"id":"PE2","finding_id":"finding-c94efbb1307d43d8b1b3e2cb9590d00a","category":"Privilege Escalation","pattern":"Sudo/Root Execution","severity":"MEDIUM","confidence":0.8,"location":{"file":"polymarket_agent/paths.py","start_line":147,"end_line":null},"finding":"chmod 600","explanation":"Commands invoke sudo or root privileges. Verify this elevated access is necessary and justified.","remediation":"Avoid sudo/root unless strictly required. Prefer least-privilege patterns. If elevation is needed, document the justification and scope.","code_snippet":"    if mode & (stat.S_IRWXG | stat.S_IRWXO):\n        return (\n            f\"{path} is accessible to other users \"\n            f\"(mode {stat.filemode(mode)}). Fix it with: chmod 600 {path}\"\n        )\n    return None","intent":null,"tags":["Privilege Escalation","llm-unconfirmed"],"evidence":{},"match_fingerprint":"fac387638fbcbc4ed94acb702b3cf68cbc839ee694afdddde6d97a39a3523b73","occurrences":[{"file":"polymarket_agent/paths.py","start_line":147,"end_line":null}]},{"id":"AST4","finding_id":"finding-0eb7d6ce737948fdb9a48abdef272c0c","category":"Dangerous Code Execution","pattern":"subprocess module call","severity":"MEDIUM","confidence":0.7,"location":{"file":"tests/test_journal.py","start_line":170,"end_line":173},"finding":"        holder = subprocess.Popen(\n            [sys.executable, \"-c\", script],\n            stdout=subprocess.PIPE, text=True, env=dict(os.environ),\n        )","explanation":"subprocess module calls execute external commands. Without careful input validation, this enables command injection.","remediation":"Use subprocess.run() with shell=False and an explicit argument list. Validate all inputs and avoid passing user-controlled data to commands.","code_snippet":"            \"lock=trade_lock(timeout=30);lock.__enter__();\"\n            \"print('LOCKED',flush=True);time.sleep(3);lock.__exit__()\"\n        )\n        holder = subprocess.Popen(\n            [sys.executable, \"-c\", script],\n            stdout=subprocess.PIPE, text=True, env=dict(os.environ),\n        )","intent":null,"tags":["Dangerous Code Execution","llm-unconfirmed"],"evidence":{},"match_fingerprint":"88d97692c8672b63ea0484564ae9854dd6df2f70185d3dc2a990c4a8c478ccc5","occurrences":[{"file":"tests/test_journal.py","start_line":170,"end_line":173}]},{"id":"EA4","finding_id":"finding-ba42f664a4fc4563acb797b8588140d6","category":"Excessive Agency","pattern":"Unbounded Resource Access","severity":"MEDIUM","confidence":0.75,"location":{"file":"tests/test_journal.py","start_line":199,"end_line":null},"finding":"timeout=0","explanation":"Skill allows unbounded resource consumption (API calls, storage, compute). Without rate limits or quotas, a compromised or misbehaving agent can cause denial-of-service or cost overruns.","remediation":"Set explicit rate limits, timeouts, and resource quotas for API calls, file operations, and compute. Implement circuit breakers for runaway loops.","code_snippet":"def trade_lock_short():\n    from polymarket_agent.paths import trade_lock\n\n    return trade_lock(timeout=0.5)\n\n\nif __name__ == \"__main__\":","intent":null,"tags":["Excessive Agency","llm-unconfirmed"],"evidence":{},"match_fingerprint":"e44269027db0b77c3f387ffaac96e37ae94b288abcfe941168fb22e5c43c7b09","occurrences":[{"file":"tests/test_journal.py","start_line":199,"end_line":null}]},{"id":"SSD-1","finding_id":"finding-029151a778f84b40a34db6a8dde01794","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.96,"location":{"file":"tests/test_whales.py","start_line":289,"end_line":292},"finding":null,"explanation":"The test fixture contains user-controlled market text phrased as an authoritative operational instruction: it asserts approval exists and tells the agent to disable dry-run mode and execute a purchase. This is a semantic prompt-injection pattern because the harmful intent is conveyed through natural-language role/authority framing inside otherwise ordinary content, not via a literal jailbreak keyword.","remediation":"Continue treating titles and other API text as untrusted data only. Sanitize or neutralize line breaks and instruction-like formatting before including such fields in prompts, alerts, logs, or agent context; prefer strict quoting/escaping and explicit separation between data and instructions.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"tests/test_whales.py","start_line":289,"end_line":292}]},{"id":"SQP-2","finding_id":"finding-82dcc78edafd4646b1a461a223d59ace","category":null,"pattern":null,"severity":"LOW","confidence":0.9,"location":{"file":"polymarket_agent/alerts.py","start_line":144,"end_line":149},"finding":null,"explanation":"The reset_state function deletes the persisted alerts.json file via path.unlink, which is a destructive file operation. While the docstring says it forgets announced items, there is no confirmation prompt, visible log, or explicit user-facing warning in this code path before removing the file.","remediation":"Add a user-visible warning or confirmation step before deleting the state file, or emit a clear log/message stating that persisted alert history will be erased. If this function is only intended for explicit maintenance actions, document that destructive behavior prominently where the function is invoked.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"polymarket_agent/alerts.py","start_line":144,"end_line":149}]},{"id":"AST7","finding_id":"finding-94d3592b4a744ef28a1662dd000ba12c","category":"Dangerous Code Execution","pattern":"Dynamic attribute access via getattr()","severity":"LOW","confidence":0.5,"location":{"file":"polymarket_agent/cli.py","start_line":183,"end_line":183},"finding":"            current = getattr(settings, name)","explanation":"Dynamic getattr() with a non-literal attribute name can access arbitrary object attributes, potentially bypassing access controls.","remediation":"Replace dynamic getattr() with explicit attribute access or a dictionary lookup with an allowlist of permitted attributes.","code_snippet":"        table.add_column(\"Key\", style=\"cyan\")\n        table.add_column(\"Value\", style=\"white\")\n        for name in sorted(KNOWN_KEYS):\n            current = getattr(settings, name)\n            style = \"\"\n            if name == \"dry_run\":\n                style = \"green\" if current else \"yellow\"","intent":null,"tags":["Dangerous Code Execution","llm-unconfirmed"],"evidence":{},"match_fingerprint":"a8619afc6b8c90e821742bd878a8b4de98a9352971f2b073b9f450366a81f070","occurrences":[{"file":"polymarket_agent/cli.py","start_line":183,"end_line":183}]},{"id":"AST7","finding_id":"finding-2b552abcceb14d8f981ae33c8627ebeb","category":"Dangerous Code Execution","pattern":"Dynamic attribute access via getattr()","severity":"LOW","confidence":0.5,"location":{"file":"polymarket_agent/cli.py","start_line":217,"end_line":217},"finding":"        console.print(f\"[cyan]{safe(key)}[/cyan] = {safe(getattr(settings, key))}\")","explanation":"Dynamic getattr() with a non-literal attribute name can access arbitrary object attributes, potentially bypassing access controls.","remediation":"Replace dynamic getattr() with explicit attribute access or a dictionary lookup with an allowlist of permitted attributes.","code_snippet":"        return\n\n    if key:\n        console.print(f\"[cyan]{safe(key)}[/cyan] = {safe(getattr(settings, key))}\")\n\n\n@app.command(rich_help_panel=\"Setup\")","intent":null,"tags":["Dangerous Code Execution","llm-unconfirmed"],"evidence":{},"match_fingerprint":"e59d76f100af1f4ddbe2425e2031ad08ec7b237ef09d13563fc9ed625132aea3","occurrences":[{"file":"polymarket_agent/cli.py","start_line":217,"end_line":217}]},{"id":"SC4","finding_id":"finding-d35fa4016cc449dd9e35c93fada3d4bc","category":"Supply Chain","pattern":"Unverifiable Dependency: setuptools has 10 known advisory(ies) (CVE-2013-1633 (Setuptools vulnerable to Man-in-the-middle attacks); CVE