cc4b92add7d8d56253cd6a77b2f8e2aaaaf","contentType":"text/markdown"},{"path":"_meta.json","size":752,"sha256":"37f524cfead035e5aa3ca202431789fd20cd46a5a4d2c20e4ea34233f14fa766","contentType":"application/json"}]},"provenance":{"source":"unavailable","reason":"No server-resolved GitHub import provenance is stored for this version."},"security":{"status":"clean","passed":true,"rawStatus":"clean","verdict":"benign","confidence":"high","summary":"This is a disclosed productivity helper with local scripts and workflow templates, with no evidence of hidden execution, exfiltration, or system persistence.","model":null,"checkedAt":1789423333881,"scannerReports":{"aig":{"version":"2.1.0","$schema":"https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/Schemata/sarif-schema-2.1.0.json","runs":[{"tool":{"driver":{"name":"aig-skill-scan","version":"0.2.1","informationUri":"https://github.com/Tencent/AI-Infra-Guard","rules":[{"id":"T01","name":"Skill Instruction Hijacking","shortDescription":{"text":"Alters the agent's current session goals or safety constraints when the skill is loaded"}},{"id":"T02","name":"Agent Memory Poisoning","shortDescription":{"text":"Writes attacker-controlled rules into persistent memory so they continue to affect future sessions"}},{"id":"T03","name":"Remote Payload Retrieval and Execution","shortDescription":{"text":"Fetches code from an external URL, allowing the effective payload to change after skill review"}},{"id":"T04","name":"Embedded Malicious Code","shortDescription":{"text":"Ships malicious scripts inside the skill package and executes them locally when invoked"}},{"id":"T05","name":"Unauthorized Access and Privilege Escalation","shortDescription":{"text":"Breaks least-privilege boundaries by obtaining permissions beyond the task's legitimate needs"}},{"id":"T06","name":"System Persistence","shortDescription":{"text":"Installs cross-session backdoors, hooks, services, or scheduled tasks that survive the skill run"}},{"id":"T07","name":"Tool Hijacking and Spoofing","shortDescription":{"text":"Modifies, wraps, spoofs, or replaces tools so legitimate-looking calls execute attacker logic"}},{"id":"T08","name":"Insecure Dependencies","shortDescription":{"text":"Introduces malicious packages or components through dependency confusion, typosquatting, or unsafe sources"}},{"id":"T09","name":"Insecure Skill Coding Practices","shortDescription":{"text":"Exposes exploitable flaws such as hardcoded secrets, command injection, plaintext sensitive data, or unsafe temp files"}},{"id":"other","name":"Other Risk","shortDescription":{"text":"Security issues not covered by the T01-T09 classification"}}]}},"results":[],"properties":{"securityScore":100,"primaryLanguage":"Markdown","llm":"gpt-5.6","startTime":1789423251.3129113,"endTime":1789423284.1684554}}]},"skillspector":{"skill":{"name":"productivity-automation-kit","source":"/tmp/clawhub-codex-scan-v57dyrza8x9he2fqg414z877dh8edzzm-VZmQy0/clawscan-skillspector-3183300647/artifact","scanned_at":"2026-09-14T22:00:50.410889+00:00"},"risk_assessment":{"score":100,"severity":"CRITICAL","recommendation":"DO_NOT_INSTALL","max_issue_severity":"HIGH"},"components":[{"path":"README.md","type":"markdown","lines":74,"executable":false,"size_bytes":1615,"source_url":null,"source_identity":null,"source_digest":null},{"path":"SKILL.md","type":"markdown","lines":498,"executable":false,"size_bytes":16407,"source_url":null,"source_identity":null,"source_digest":null},{"path":"_meta.json","type":"json","lines":24,"executable":false,"size_bytes":752,"source_url":null,"source_identity":null,"source_digest":null},{"path":"references/workflow-templates.md","type":"markdown","lines":138,"executable":false,"size_bytes":3120,"source_url":null,"source_identity":null,"source_digest":null},{"path":"run.sh","type":"shell","lines":21,"executable":true,"size_bytes":511,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/data_automation.py","type":"python","lines":201,"executable":true,"size_bytes":6997,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/schedule_planner.py","type":"python","lines":186,"executable":true,"size_bytes":6934,"source_url":null,"source_identity":null,"source_digest":null},{"path":"scripts/task_reminder.sh","type":"shell","lines":46,"executable":true,"size_bytes":1299,"source_url":null,"source_identity":null,"source_digest":null}],"structured_summaries":[],"issues":[{"id":"TP4","finding_id":"finding-9340fe79fc8444a98ffe589e903f70c4","category":"MCP Tool Poisoning","pattern":null,"severity":"HIGH","confidence":0.95,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"声明描述覆盖了多个生产力与自动化场景，包括日程管理、任务提醒、工作流模板和自动化机会识别；但代码只处理本地数据文件的加载、清洗、去重、统计与报告输出，没有任何与日历、提醒、任务追踪、计划安排或工作流编排相关的逻辑。虽然“数据整理自动化”这一子项与代码相符，但整体声明显著夸大了能力范围，导致描述与实际行为存在实质性不匹配。","remediation":"Update the skill description to accurately reflect all capabilities, or remove undeclared functionality from the implementation.","code_snippet":null,"intent":null,"tags":["ASI02","AML.T0080","llm-unconfirmed"],"evidence":{"code_path":"scripts/data_automation.py","code_start_line":1,"code_end_line":201,"actual_behavior_summary":"代码实际实现的是一个命令行数据整理脚本：从 JSON/CSV 读取数据，按配置校验字段，清洗字符串、去重、计算数值统计指标，生成 Markdown 报告并将结果保存到本地目录。"},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"TP4","finding_id":"finding-b713813cba51466ea7053336d5d2b45c","category":"MCP Tool Poisoning","pattern":null,"severity":"HIGH","confidence":0.88,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"代码的核心功能与“日程管理助手”相符，但与声明的更广泛“效率自动化工具箱”存在明显差距。该脚本只做任务录入、时间块排程、周计划模板生成和本地JSON保存，没有工作流自动化、流程模板编排、提醒通知、数据整理/清洗等功能。虽然描述中包含“日程管理”这一子项，代码确实覆盖了这一部分，但整体声明将技能包装为多功能自动化工具箱，而实际代码仅实现其中较窄的一部分，因此属于描述与实际行为不完全一致的能力夸大型 mismatch。","remediation":"Update the skill description to accurately reflect all capabilities, or remove undeclared functionality from the implementation.","code_snippet":null,"intent":null,"tags":["ASI02","AML.T0080","llm-unconfirmed"],"evidence":{"code_path":"scripts/schedule_planner.py","code_start_line":1,"code_end_line":186,"actual_behavior_summary":"代码实际实现的是一个本地日程规划脚本：添加任务、按优先级/能量需求生成每日和每周计划、输出Top 3任务，并可将日程保存为JSON文件。"},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"LP3","finding_id":"finding-526ac147f8b0426a8db95c732e39fa56","category":"MCP Least Privilege","pattern":null,"severity":"MEDIUM","confidence":0.7,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"Without declared permissions the skill's intent is opaque and cannot be validated.","remediation":"Declare the skill's tool scope: for Claude Code / Agent Skills SKILL.md, list the tools the skill may invoke in the 'allowed-tools' frontmatter field; for MCP server manifests, add a 'permissions' list naming the required capabilities.","code_snippet":null,"intent":null,"tags":["ASI02","llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"SQP-1","finding_id":"finding-09ddf78f5908482ea2ac1aea7dadbe56","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"SKILL.md","start_line":5,"end_line":5},"finding":null,"explanation":"The trigger phrases are broad, generic productivity terms that overlap with ordinary conversation, increasing the chance of unintended skill activation. In an automation-oriented skill, accidental invocation can expose user task context, create files, or launch suggested workflows without the user intending to use this skill.","remediation":"Use narrower invocation phrases unique to this skill, and require a confirmation step before performing any automation-related action. Avoid common phrases like generic productivity help or daily reminders as direct triggers.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":5,"end_line":5}]},{"id":"SQP-3","finding_id":"finding-040e592157994b578b3e00baa85523d6","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.84,"location":{"file":"SKILL.md","start_line":5,"end_line":5},"finding":null,"explanation":"The manifest description and trigger phrases are entirely in Chinese, and the skill content is presented as if Chinese is the required operating language. There is no indication that users may choose another language or opt in to this locale, which can violate language-choice policy for generally applicable skills.","remediation":"State that the skill supports multiple languages or explicitly ask the user which language they prefer before proceeding. If the skill is intentionally Chinese-only, document that constraint clearly and justify the locale limitation.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":5,"end_line":5}]},{"id":"E1","finding_id":"finding-cc43f0b37b4e4a57b215649905993470","category":"Data Exfiltration","pattern":"External Transmission","severity":"MEDIUM","confidence":0.89,"location":{"file":"SKILL.md","start_line":359,"end_line":null},"finding":"https://api.example.com/","explanation":"The embedded Bash example performs an external HTTPS request and includes an Authorization bearer token header, which is a genuine external transmission pattern. In the context of a productivity skill that claims no external API access by default, this is more dangerous because users may not expect network egress or token use from included automation snippets.","remediation":"Document all external transmission behavior prominently and mark the snippet as optional. Require users to supply and review endpoints explicitly, minimize transmitted data, and recommend secret handling safeguards such as environment validation and token scoping.","code_snippet":"# Step 1: 数据采集\nlog \"采集数据...\"\nDATA=$(curl -s -H \"Authorization: Bearer $API_TOKEN\" \\\n  \"https://api.example.com/endpoint\" || echo \"\")\n\n# Step 2: 数据验证\nif [ -z \"$DATA\" ]; then","intent":null,"tags":["Data Exfiltration"],"evidence":{},"match_fingerprint":"88f1946300c8ae45d5ea7e81f2b6d4309a13082e928b6f7d1215d273945a1431","occurrences":[{"file":"SKILL.md","start_line":359,"end_line":null}]},{"id":"SQP-1","finding_id":"finding-f73aa7c96976409a945ca24fa75b2f3b","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.91,"location":{"file":"SKILL.md","start_line":462,"end_line":469},"finding":null,"explanation":"The quick-start examples use highly ambiguous natural-language requests such as planning work or setting reminders, which are common across many benign assistant interactions. This raises the risk of the skill being selected unexpectedly, especially because it spans broad productivity domains and may steer users into automations they did not request.","remediation":"Make invocation examples more specific to the skill name or require explicit opt-in language. Add disambiguation prompts when requests could map to multiple skills or native assistant features.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":462,"end_line":469}]},{"id":"SDI-4","finding_id":"finding-ec36e28948194afb9384a744d8ca89e2","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.97,"location":{"file":"SKILL.md","start_line":475,"end_line":484},"finding":null,"explanation":"The skill's safety section claims it will not access external APIs unless explicitly authorized, yet the embedded Bash template performs a curl request with an API bearer token. This inconsistency can mislead users and downstream agents into trusting the skill's privacy posture while executing networked behavior that transmits data externally.","remediation":"Correct the safety statement to accurately disclose that sample automations may call external APIs when configured. Gate all network examples behind explicit user consent language, require endpoint review, and clearly label the Bash snippet as an optional example rather than default behavior.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":475,"end_line":484}]},{"id":"SDI-4","finding_id":"finding-3a13a1b466ed4f299a2f127d1dcdbc2e","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.96,"location":{"file":"SKILL.md","start_line":475,"end_line":479},"finding":null,"explanation":"The document states it will not automatically send messages to third parties, but multiple workflow templates include sending emails, notifications, and social-media publishing. Misrepresenting outbound communication behavior can cause users to enable automations without understanding that data or content may be transmitted externally.","remediation":"Align the privacy/safety section with the documented workflows. Explicitly state which templates may send email, notifications, or social posts, and require opt-in confirmation before using any outbound communication step.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":475,"end_line":479}]},{"id":"SQP-3","finding_id":"finding-6b23511ea86341ebb1eea1a901f88fab","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.92,"location":{"file":"_meta.json","start_line":5,"end_line":14},"finding":null,"explanation":"The manifest’s user-facing description and features are entirely in Chinese, with no indication that the skill supports other languages or that it is intentionally limited to a Chinese-speaking audience. This can violate language/locale policy when a skill imposes a language without user opt-in or explicit justification.","remediation":"Add a documented language/locale note explaining that the skill is intended for Chinese users, or provide multilingual/locale-choice support in the manifest and related skill documentation.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"_meta.json","start_line":5,"end_line":14}]},{"id":"SDI-2","finding_id":"finding-df3a59cc55444b9a98c3492d0afc1be3","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.87,"location":{"file":"references/workflow-templates.md","start_line":110,"end_line":138},"finding":null,"explanation":"The manifest describes workflow templates, schedule management, task reminders, and data organization automation. This template goes beyond that scope by modeling automated multi-platform social media publishing, which is a distinct marketing/distribution capability not clearly encompassed by the stated purpose.","remediation":"Remove the social media publishing template from this skill, or update the manifest to explicitly declare social content publishing/marketing automation as part of the skill's intended scope.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"references/workflow-templates.md","start_line":110,"end_line":138}]},{"id":"SQP-3","finding_id":"finding-aa79b1a1c2f1482b9f3eb0431689dfdb","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"scripts/schedule_planner.py","start_line":3,"end_line":5},"finding":null,"explanation":"The module docstring is entirely in Chinese, and the script's labels/messages are also hard-coded in Chinese, which indicates the skill forces a specific language for interaction. The policy allows locale constraints only when users are given a choice or the regional limitation is clearly documented and justified, neither of which appears here.","remediation":"Add explicit language/locale selection support, or document that the skill is intended only for a Chinese-speaking context and justify that constraint. If multilingual use is expected, externalize user-facing strings and allow the user to choose the output language.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/schedule_planner.py","start_line":3,"end_line":5}]},{"id":"SQP-3","finding_id":"finding-799f6fccc20840ce8fe0294450644435","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"scripts/task_reminder.sh","start_line":2,"end_line":46},"finding":null,"explanation":"Multiple comments and runtime messages are written only in Chinese, including status output and error text shown to the user. This enforces a specific language/locale experience without opt-in or documented justification, which matches the language-policy violation criteria.","remediation":"Make user-facing messages configurable by locale, or provide at least a documented language selection mechanism. If the skill is intentionally Chinese-only, document that restriction clearly and justify the locale scope.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/task_reminder.sh","start_line":2,"end_line":46}]},{"id":"SQP-3","finding_id":"finding-db35568cf9134c0bbff1d5d517069b0f","category":null,"pattern":null,"severity":"LOW","confidence":0.91,"location":{"file":"README.md","start_line":1,"end_line":74},"finding":null,"explanation":"The file presents operational documentation largely in Chinese, including headings, comments, and module descriptions, but does not indicate that the skill is region-specific or provide an English-only/Chinese-only opt-in. Per the policy, forcing a specific language or locale without user choice can be a natural-language policy violation.","remediation":"State the supported documentation language(s) explicitly and offer a language choice or separate localized READMEs, unless the skill is intentionally region-specific and that constraint is documented.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"README.md","start_line":1,"end_line":74}]},{"id":"SQP-2","finding_id":"finding-9f3dac71e68e45429feedce35bee0744","category":null,"pattern":null,"severity":"LOW","confidence":0.82,"location":{"file":"README.md","start_line":10,"end_line":16},"finding":null,"explanation":"This markdown file provides commands for `data_automation.py` and `schedule_planner.py` that produce output files such as `result.json`, `cleaned.json`, and `schedule.json`, but it does not warn users that running them may create or overwrite local files. For markdown files, user-facing documentation should disclose behaviors that could affect user data or system state.","remediation":"Add a brief warning near the quick-start and usage examples stating that these commands create or overwrite output files, and advise users to verify paths or back up existing files before running them.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"README.md","start_line":10,"end_line":16}]},{"id":"SQP-3","finding_id":"finding-9c6352a6541143549984ea4a927e8690","category":null,"pattern":null,"severity":"LOW","confidence":0.89,"location":{"file":"references/workflow-templates.md","start_line":1,"end_line":138},"finding":null,"explanation":"This markdown file contains user-facing natural-language instructions and examples only in Chinese, which can constitute a language/locale policy issue when no opt-in or justification is provided. The file does not indicate that the skill is intended exclusively for Chinese-speaking users or a China-specific environment.","remediation":"Add a note that the document is intended for a Chinese-language audience, or provide a multilingual option such as an English version or explicit language selection guidance.","code_snippet":null,"intent":null,"tags":["llm-unconfirm