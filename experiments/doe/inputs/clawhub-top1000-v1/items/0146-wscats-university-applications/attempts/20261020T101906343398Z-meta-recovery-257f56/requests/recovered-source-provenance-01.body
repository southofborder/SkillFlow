{"schema":"clawhub.skill.verify.v1","ok":false,"decision":"fail","reasons":["security.status_not_clean"],"slug":"university-applications","displayName":"命理大师","pageUrl":"https://clawhub.ai/wscats/skills/university-applications","publisherHandle":"wscats","publisherDisplayName":"enoyao","publisherProfileUrl":"https://clawhub.ai/wscats","version":"1.2.10","resolvedFrom":"version","tag":null,"createdAt":1780444802523,"card":{"available":true,"path":"skill-card.md","url":"https://wry-manatee-359.convex.site/api/v1/skills/university-applications/card?ownerHandle=wscats&version=1.2.10","sha256":"42b15a0c9095d99ff1eeec49958cdd2a1255f4217ac69bd809353c31fad04415","size":3844,"contentType":"text/markdown; charset=utf-8"},"artifact":{"sourceFingerprint":"8a56c174465b6ebb6ba8766c89652e523bebfff7215c49907eb94bc3e8d4d93d","bundleFingerprints":["3b35c72d88036e8eea5d5f1ab152cde371229d441342519da7676557a76c383c","be6cbe24ba1d7bed838f66b90320396151d64a161a2a9f914335c59f355fb959"],"files":[{"path":"README.md","size":7788,"sha256":"884f2ead8259c159df899ba51e2bef7095a00fd396027c57d7ee6a49dba96478","contentType":"text/markdown"},{"path":"SKILL.md","size":22680,"sha256":"8b5572d47819a3a87b36fe77e80b225f0d3f1a7bb2d8f7ea393c4d4ab4ecccbf","contentType":"text/markdown"},{"path":"_meta.json","size":167,"sha256":"54233fd063b3f22901c7606831519f3c7ada44f37cc5efb136a49fbab697ef74","contentType":"application/json"},{"path":"data/profiles/template.json","size":2848,"sha256":"abb89ae6c7aafce5ec9c57f07c77a364aa8340e1e406e42e4db09ece4bd1f135","contentType":"application/json"},{"path":"liuyao/index.html","size":54494,"sha256":"6e12b83a92bd654673f18e0b8c08c921a90773d84a7c802952299ea4ab71b09a","contentType":"text/html"},{"path":"package-lock.json","size":2807,"sha256":"70da3fc46485d021f529102d961f3d89f467be442aed01f9605e98a3a859367b","contentType":"application/json"},{"path":"package.json","size":1689,"sha256":"55862e0b68eb4259378320f8064705e0cc52b73011a416ae3c775335db791389","contentType":"application/json"},{"path":"references/astrology-framework.md","size":1794,"sha256":"e20b7a36125731a29620b4b04614b77ed220f85fb25620275c34dbd3107d5f8c","contentType":"text/markdown"},{"path":"references/bazi-framework.md","size":3197,"sha256":"c395f8f11a73d6f265935ad08a5f60dab5d98d7d65687a352f4495f8b640ab1c","contentType":"text/markdown"},{"path":"references/chinese-methods.md","size":5998,"sha256":"ed83b337b19ae61ea750fe42a059278ec34275249b139015553a3b88b512fa70","contentType":"text/markdown"},{"path":"references/dao-mysticism-framework.md","size":1894,"sha256":"724a6ebd8d1316634d29b03814c088a526b326eae9827688925f23f8201f626f","contentType":"text/markdown"},{"path":"references/dressing-framework.md","size":6828,"sha256":"bf4321b302253b640a0f8f60bf77ec567b8cc07d7d66469c21f6614705e5dbe2","contentType":"text/markdown"},{"path":"references/fengshui-and-timing-framework.md","size":3484,"sha256":"eeeac969f832f62e346f66f615c6c342c937fb5d60e2def855d8b4955a19589b","contentType":"text/markdown"},{"path":"references/intake-and-routing.md","size":7045,"sha256":"515f1fad3501a303ff1c8f2f5d5e1b62bbb0165a0b11efa51541bb3884a1b49f","contentType":"text/markdown"},{"path":"references/naming-framework.md","size":6181,"sha256":"354b26df77226b395b83d9b93e70d4a0740fc637556ff257635b15757d78a3f4","contentType":"text/markdown"},{"path":"references/numerology-framework.md","size":2781,"sha256":"3b42e40c21d67b5ea4fd6bfedb24f47e99f2fd1943e4a3631cf69c4ba0544033","contentType":"text/markdown"},{"path":"references/output-templates.md","size":16526,"sha256":"a793e25e4510cdff058753e64f1d45f0de72e342473f6bd07d62dd3df0dc64cb","contentType":"text/markdown"},{"path":"references/palmistry-framework.md","size":4984,"sha256":"5ad7b0c0a7e18285bed478ef6e5bb40372257a4f983ea6b12071c68f36bb93eb","contentType":"text/markdown"},{"path":"references/physiognomy-framework.md","size":6210,"sha256":"a21db240fb2b29b1bf10d7e1c98b552640c93c5bd531e911172831b5aa054207","contentType":"text/markdown"},{"path":"references/preparation.md","size":4334,"sha256":"7763d2274d9967943d79f1ae4fe148b2cb77b9b7846844decca6f2d22c504fa2","contentType":"text/markdown"},{"path":"references/qimen-calculation-rules.md","size":5130,"sha256":"409b76f0ce6a0215670520ed9d3e14cc4f22337981cfead5217cfd47d43e4f68","contentType":"text/markdown"},{"path":"references/qimen-framework.md","size":2985,"sha256":"a7a70996a72c8c210cad2612c7476f82b60c9f60f3899acb118668fcba1f2b72","contentType":"text/markdown"},{"path":"references/qimen-interpretation-guide.md","size":4774,"sha256":"ec608c15476983802d7ba2b447cbc088825ab7c32e173a3dd8a0273ef0c63fd5","contentType":"text/markdown"},{"path":"references/relationship-and-timing.md","size":2201,"sha256":"cd48fda8c67f47a6d148e406755bddf1b8086f951b4ba7a4aa23b515fd92d45e","contentType":"text/markdown"},{"path":"references/safety-and-ethics.md","size":2920,"sha256":"d0b78be6a1fb1ff9afd8e4832fc9da60aad8544f60cc989d41366e808cdd167f","contentType":"text/markdown"},{"path":"references/tarot-framework.md","size":4409,"sha256":"be0cc0bffb0caec3d482fe454e75aa9a88881862c916e593eb45ca53c8d879c4","contentType":"text/markdown"},{"path":"references/western-methods.md","size":2322,"sha256":"e967e8253a3586514fae973e6348288902306ea07a707f6c808ef2d2002cca0d","contentType":"text/markdown"},{"path":"references/yijing-divination-framework.md","size":3416,"sha256":"f80b7dbff246dcaf9d9f7328106355297ec06225aadd12de1b941630a14b3d72","contentType":"text/markdown"},{"path":"references/ziwei-framework.md","size":2116,"sha256":"7883faf25c230e459be230db475705158e01b07d2af5bced874897cda5667062","contentType":"text/markdown"},{"path":"scripts/bazi-analysis.js","size":36188,"sha256":"c882375af46c09a1baeb721584e145f294f6eddfa712509a61d0f520b2a371d4","contentType":"text/javascript"},{"path":"scripts/daily-fortune.js","size":8034,"sha256":"28a924931043a302846d386b71e339ab0199aa5cb0e41283ea1c104e239966a6","contentType":"text/javascript"},{"path":"scripts/daily-push.js","size":35161,"sha256":"e2313804dc2c639110e6518d035d0d6777ed6b8c9403fa6ebbf4943c568874ec","contentType":"text/javascript"},{"path":"scripts/feixing.py","size":7351,"sha256":"f5efe5aac3536dc5fbfcdf80bd7fb25d08917c1007115dd9470f3ea025786f75","contentType":"text/plain"},{"path":"scripts/fengshui.js","size":12240,"sha256":"c4a93ac90e6957b63e4237496e9426dda648294b81cde27e097ccdfbcf0d3471","contentType":"text/javascript"},{"path":"scripts/jieqi.js","size":4804,"sha256":"0e7c329337ad0cf9dc9b08d2890667551d9cddd998b43f8e0da29954eb7eb6c5","contentType":"text/javascript"},{"path":"scripts/liuyao.js","size":10259,"sha256":"ed58787b4bca5828897f761c132ba1bbd7fb2fe7e87189b9353f37e803f9b04e","contentType":"text/javascript"},{"path":"scripts/marriage.js","size":14737,"sha256":"566b698588a8ae8f56c3dc3eefb0fde2c130a3bb48e7ace46df58e4bbce2c194","contentType":"text/javascript"},{"path":"scripts/meihua.js","size":11448,"sha256":"f52b2243f891649a51ce124ef6ec71a6d4b3157481014683508de2d9a4823c65","contentType":"text/javascript"},{"path":"scripts/preference-tracker.js","size":11053,"sha256":"3be43601578a5235cfe596f19c9abbd54c1ec3722340a73b3abc37053f7c8989","contentType":"text/javascript"},{"path":"scripts/profile.js","size":16201,"sha256":"00c5306f0a3f97bfe8ccd085711d370440799f6bcdf81601ca612cd9791ef9fd","contentType":"text/javascript"},{"path":"scripts/push-toggle.js","size":16452,"sha256":"ef6c78f0a0607acb5c3c2d746f364fb984095aec3941216a19a55bf6bf457973","contentType":"text/javascript"},{"path":"scripts/qimen.js","size":11996,"sha256":"b6807e3cbfbd96e3bd758d7715a2e7af0c38ca8d2ce562d225f837e02edf2df4","contentType":"text/javascript"},{"path":"scripts/register.js","size":15492,"sha256":"f768c0e42b0aeb473aadf6dcce352f30b61cfa7bb7004ad31e331563ab5d7095","contentType":"text/javascript"},{"path":"scripts/zhuanshi.js","size":22487,"sha256":"d854eff588235cb9ffc92424339400d3ada711642165551abd06e19e5910cdc3","contentType":"text/javascript"},{"path":"scripts/ziwei.js","size":69430,"sha256":"b127539ddc085001ca23ebba6cc58c7d063612369317f1c435bca3ca01b5fb3a","contentType":"text/javascript"}]},"provenance":{"source":"unavailable","reason":"No server-resolved GitHub import provenance is stored for this version."},"security":{"status":"suspicious","passed":false,"rawStatus":"suspicious","verdict":"suspicious","confidence":"high","summary":"This is mostly a disclosed local astrology skill, but it needs Review because several input-handling bugs could expose or modify local JSON files or a browser-entered API key.","model":null,"checkedAt":1789176079643,"scannerReports":{"aig":{"version":"2.1.0","$schema":"https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/Schemata/sarif-schema-2.1.0.json","runs":[{"tool":{"driver":{"name":"aig-skill-scan","version":"0.2.1","informationUri":"https://github.com/Tencent/AI-Infra-Guard","rules":[{"id":"T01","name":"Skill Instruction Hijacking","shortDescription":{"text":"Alters the agent's current session goals or safety constraints when the skill is loaded"}},{"id":"T02","name":"Agent Memory Poisoning","shortDescription":{"text":"Writes attacker-controlled rules into persistent memory so they continue to affect future sessions"}},{"id":"T03","name":"Remote Payload Retrieval and Execution","shortDescription":{"text":"Fetches code from an external URL, allowing the effective payload to change after skill review"}},{"id":"T04","name":"Embedded Malicious Code","shortDescription":{"text":"Ships malicious scripts inside the skill package and executes them locally when invoked"}},{"id":"T05","name":"Unauthorized Access and Privilege Escalation","shortDescription":{"text":"Breaks least-privilege boundaries by obtaining permissions beyond the task's legitimate needs"}},{"id":"T06","name":"System Persistence","shortDescription":{"text":"Installs cross-session backdoors, hooks, services, or scheduled tasks that survive the skill run"}},{"id":"T07","name":"Tool Hijacking and Spoofing","shortDescription":{"text":"Modifies, wraps, spoofs, or replaces tools so legitimate-looking calls execute attacker logic"}},{"id":"T08","name":"Insecure Dependencies","shortDescription":{"text":"Introduces malicious packages or components through dependency confusion, typosquatting, or unsafe sources"}},{"id":"T09","name":"Insecure Skill Coding Practices","shortDescription":{"text":"Exposes exploitable flaws such as hardcoded secrets, command injection, plaintext sensitive data, or unsafe temp files"}},{"id":"other","name":"Other Risk","shortDescription":{"text":"Security issues not covered by the T01-T09 classification"}}]}},"results":[{"ruleId":"T09","level":"error","message":{"text":"Path Traversal Enables File Access Outside the Profile Directory"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"scripts/profile.js"},"region":{"startLine":53,"endLine":78}}}],"partialFingerprints":{"primaryLocationLineHash":"2d7161e3b4c4bfd3"},"properties":{"description":"<![CDATA[\n## Vulnerability Details\n\n**File Location**: `scripts/profile.js:53-78`; related unsafe construction also occurs in `scripts/register.js:266-274`  \n**Vulnerability Type**: Path traversal through an unsanitized user identifier  \n**Risk Level**: High\n\n### Vulnerable Code\n\n```javascript\nfunction getProfilePath(userId) {\n  return path.join(PROFILES_DIR, `${userId}.json`);\n}\n\nfunction loadProfile(userId) {\n  const filePath = getProfilePath(userId);\n  if (!fs.existsSync(filePath)) {\n    return null;\n  }\n  const data = fs.readFileSync(filePath, 'utf8');\n  return JSON.parse(data);\n}\n\nfunction saveProfile(userId, data) {\n  const filePath = getProfilePath(userId);\n  const profile = {\n    ...data,\n    userId,\n    updatedAt: new Date().toISOString().split('T')[0]\n  };\n  fs.writeFileSync(filePath, JSON.stringify(profile, null, 2), 'utf8');\n  return profile;\n}\n```\n\nThe registration script independently uses the same unsafe pattern:\n\n```javascript\nfunction saveProfile(userId, profile) {\n  const dir = path.join(__dirname, '../data/profiles');\n  if (!fs.existsSync(dir)) {\n    fs.mkdirSync(dir, { recursive: true });\n  }\n\n  const filePath = path.join(dir, `${userId}.json`);\n  fs.writeFileSync(filePath, JSON.stringify(profile, null, 2), 'utf8');\n  return filePath;\n}\n```\n\n### Technical Analysis\n\nThe `userId` command-line value is concatenated into a filename without validation. `path.join()` normalizes traversal components but does not enforce that the resulting path remains under `data/profiles`.\n\nFor example, a value containing `../` can cause the resolved filename to point outside the intended profile directory. The forced `.json` suffix restricts the target to a JSON-named path, but it does not prevent traversal.\n\nThe unsafe path is reused by profile read, write, rename, and deletion operations. Consequently, the vulnerability is not limited to data disclosure: depending on the invoked command, it can overwrite, rename, or delete accessible JSON files outside the profile directory.\n\nThis exceeds the minimum filesystem privileges required for local profile management, which should be confined to `data/profiles`.\n\n### Attack Path\n\n1. An attacker gains the ability to supply a `userId` argument to a profile or registration command.\n2. The attacker supplies a traversal identifier, such as `../../target`.\n3. The application constructs a path equivalent to `data/profiles/../../target.json`.\n4. `path.join()` resolves the traversal outside `data/profiles`.\n5. Depending on the command:\n   - `show` or `load` reads and parses the external JSON file.\n   - `save` or `register` overwrites the external JSON file.\n   - `delete --yes --purge` can remove the external JSON file.\n   - Default soft deletion can rename the external JSON file.\n6. The operation executes with the filesystem privileges of the Skill process.\n\n### Impact Assessment\n\nAn attacker can access JSON files writable or readable by the Skill process outside the declared profile directory. Potential effects include:\n\n- Disclosure of JSON configuration or application data.\n- Destructive overwrite of JSON files.\n- Rename or deletion of JSON files through profile deletion.\n- Integrity loss or denial of service for other applications using those files.\n\nThe vulnerability does not itself grant operating-system privilege escalation, and the `.json` suffix limits the directly addressable filenames. Its scope is nevertheless broader than the Skill's legitimate profile-storage needs.\n  ]]>","severity":"High"},"fixes":[{"description":{"text":"<![CDATA[\n## Remediation Suggestions\n\n1. Apply a strict allowlist to every `userId` before using it in a path:\n\n```javascript\nfunction validateUserId(userId) {\n  if (!/^[A-Za-z0-9_-]{1,64}$/.test(userId)) {\n    throw new Error('Invalid user ID');\n  }\n  return userId;\n}\n```\n\n2. Resolve and verify containment rather than relying only on `path.join()`:\n\n```javascript\nconst PROFILE_ROOT = path.resolve(__dirname, '../data/profiles');\n\nfunction getProfilePath(userId) {\n  const safeId = validateUserId(userId);\n  const target = path.resolve(PROFILE_ROOT, `${safeId}.json`);\n\n  if (!target.startsWith(PROFILE_ROOT + path.sep)) {\n    throw new Error('Profile path escapes the profile directory');\n  }\n\n  return target;\n}\n```\n\n3. Use this single validated helper in `profile.js`, `register.js`, `marriage.js`, `preference-tracker.js`, `push-toggle.js`, and `daily-push.js`.\n\n4. Reject absolute paths, path separators, null bytes, dot segments, and identifiers longer than the documented maximum.\n\n5. Add tests covering `../`, `..\\`, absolute paths, encoded separators, empty identifiers, and excessively long values.\n\n6. Run the Skill under a dedicated account with filesystem access limited to its own data directory.\n  ]]>"}}]},{"ruleId":"T09","level":"warning","message":{"text":"DOM-Based Cross-Site Scripting Through the Divination Question"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"liuyao/index.html"},"region":{"startLine":1073,"endLine":1095}}}],"partialFingerprints":{"primaryLocationLineHash":"93feb22f7badc2af"},"properties":{"description":"<![CDATA[\n## Vulnerability Details\n\n**File Location**: `liuyao/index.html:1073-1095`; additional unsafe fallback sinks at `liuyao/index.html:1219-1232` and `1270-1275`  \n**Vulnerability Type**: DOM-based cross-site scripting through unsafe `innerHTML` interpolation  \n**Risk Level**: Medium\n\n### Vulnerable Code\n\n```javascript\nfunction showResult(){\n  const card=document.getElementById('resultCard');\n  card.classList.add('visible');\n  setTimeout(()=>card.scrollIntoView({behavior:'smooth',block:'start'}),120);\n  const info=getGuaInfo(yaoResults);\n  const q=document.getElementById('questionInput').value.trim();\n  renderDiagram(info,q);\n  document.getElementById('speechText').textContent=\n    (q?`仙家所问「${q}」，`:'')\n    +`六爻已落，上${info.upper.name}下${info.lower.name}，卦象已现。雪儿这便为仙家细细道来……`;\n  callLLM(info,q);\n}\n\nfunction renderDiagram(info,q){\n  const lh=yao3=>yao3.map(y=>y\n    ?`<div class=\"gua-l-yang\"></div>`\n    :`<div class=\"gua-l-yin\"><span></span><span></span></div>`\n  ).join('');\n  document.getElementById('guaDiagram').innerHTML=`\n    <div class=\"gua-part\">\n      <div class=\"gua-part-label\">上卦</div>\n      <div class=\"gua-lines-block\">${lh([info.yao6[3],info.yao6[4],info.yao6[5]])}</div>\n      <div class=\"gua-sym\">${info.upper.sym}</div>\n      <div class=\"gua-name-sm\">${info.upper.name}·${info.upper.nature}</div>\n    </div>\n    <div class=\"gua-center-label\">\n      <div class=\"gua-full-name\">${info.upper.name}${info.lower.name===info.upper.name?'为'+info.upper.nature:''}卦</div>\n      ${q?`<div class=\"gua-question-sm\">「${q}」</div>`:''}\n    </div>\n    <div class=\"gua-part\">\n      <div class=\"gua-part-label\">下卦</div>\n      <div class=\"gua-lines-block\">${lh([info.yao6[0],info.yao6[1],info.yao6[2]])}</div>\n      <div class=\"gua-sym\">${info.lower.sym}</div>\n      <div class=\"gua-name-sm\">${info.lower.name}·${info.lower.nature}</div>\n    </div>`;\n}\n```\n\nThe same question also enters HTML fallback output:\n\n```javascript\nout.innerHTML=offlineFallback(info,question);\n```\n\n```javascript\nfunction offlineFallback(info,question){\n  const q=question?`仙家所问「${question}」，`:'';\n```\n\n### Technical Analysis\n\nThe question is controlled by the user through `questionInput`. Although one display path correctly uses `textContent`, `renderDiagram()` embeds the same value directly into an `innerHTML` template.\n\nThe browser therefore parses the question as markup rather than displaying it strictly as text. A payload containing an element with an event handler can execute JavaScript when the resulting HTML is rendered. The offline fallback also incorporates the question into a string that is assigned to `innerHTML`, creating an additional execution path.\n\nThe fixed hexagram fields are drawn from static data and are not the principal concern. The exploitable source is the unescaped question value.\n\n### Attack Path\n\n1. A victim enters or pastes attacker-controlled content into the question field.\n2. The victim completes the divination workflow.\n3. `showResult()` reads the content into `q`.\n4. `renderDiagram()` interpolates `q` into an HTML template.\n5. The template is assigned to `guaDiagram.innerHTML`.\n6. The browser parses attacker-supplied markup.\n7. An event-handler payload or equivalent active HTML executes in the page's origin.\n\nA similar path exists when the offline fallback is rendered through `out.innerHTML`.\n\n### Impact Assessment\n\nSuccessful exploitation permits arbitrary JavaScript execution in the context of the divination page. The injected script can:\n\n- Read or modify all data present in the page.\n- Alter divination results or consent messages.\n- Read the API-key input while the user has entered a key.\n- Initiate network requests using page-accessible data.\n- Access same-origin resources if the file is hosted by a web server.\n- Persist through origin storage if the hosting context permits it.\n\nWhen opened directly as an isolated local file, browser restrictions may reduce access to other resources, but page data and user-entered credentials remain exposed.\n  ]]>","severity":"Medium"},"fixes":[{"description":{"text":"<![CDATA[\n## Remediation Suggestions\n\n1. Never concatenate the question into `innerHTML`.\n2. Create the question node and assign its content through `textContent`:\n\n```javascript\nconst questionNode = document.createElement('div');\nquestionNode.className = 'gua-question-sm';\nquestionNode.textContent = `「${q}」`;\ncontainer.appendChild(questionNode);\n```\n\n3. Construct the complete diagram through DOM methods, or keep only trusted static markup in `innerHTML` and insert all user-controlled values afterward through `textContent`.\n\n4. Change the offline fallback to return plain text and render it with `textContent`.\n\n5. If limited rich text is genuinely required, sanitize it with a maintained allowlist-based sanitizer and disallow event handlers, scripts, dangerous URLs, SVG, MathML, and inline styles.\n\n6. Avoid inserting `err.message` through `innerHTML`; render error details with `textContent`.\n\n7. Add a restrictive Content Security Policy that blocks inline scripts and event handlers. This should be defense in depth rather than a substitute for safe DOM construction.\n\n8. Add regression tests using payloads containing HTML elements, event handlers, SVG payloads, quotes, and closing tags.\n  ]]>"}}]},{"ruleId":"T09","level":"warning","message":{"text":"Sensitive Profile Files Are Created Without Explicit Owner-Only Permissions"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"scripts/profile.js"},"region":{"startLine":70,"endLine":78}}}],"partialFingerprints":{"primaryLocationLineHash":"508ca688ace37204"},"properties":{"description":"<![CDATA[\n## Vulnerability Details\n\n**File Location**: `scripts/profile.js:70-78`; the same pattern occurs in `scripts/register.js:266-274`, `scripts/preference-tracker.js:44-50`, and `scripts/push-toggle.js:65-71`  \n**Vulnerability Type**: Insecure local storage permissions for sensitive personal data  \n**Risk Level**: Medium\n\n### Vulnerable Code\n\n```javascript\nfunction saveProfile(userId, data) {\n  const filePath = getProfilePath(userId);\n  const profile = {\n    ...data,\n    userId,\n    updatedAt: new Date().toISOString().split('T')[0]\n  };\n  fs.writeFileSync(filePath, JSON.stringify(profile, null, 2), 'utf8');\n  return profile;\n}\n```\n\nThe registration path also omits an explicit mode:\n\n```javascript\nfunction saveProfile(userId, profile) {\n  const dir = path.join(__dirname, '../data/profiles');\n  if (!fs.existsSync(dir)) {\n    fs.mkdirSync(dir, { recursive: true });\n  }\n\n  const filePath = path.join(dir, `${userId}.json`);\n  fs.writeFileSync(filePath, JSON.stringify(profile, null, 2), 'utf8');\n  return filePath;\n}\n```\n\n### Technical Analysis\n\nProfile files contain names, user identifiers, dates and times of birth, birth locations, astrology data, family-member information, preferences, routing channels, and optional interaction history.\n\nThe files are written without an explicit mode, so their effective permissions depend on the process umask and pre-existing file permissions. In a permissively configured environment, this can create group-readable or world-readable files. Rewriting an existing file also does not correct an already unsafe mode.\n\nThe project already uses an explicit `0600` mode for one output in `daily-push.js`, demonstrating that owner-only permissions are technically feasible.\n\n### Attack Path\n\n1. The Skill runs on a shared host or under a permissive process umask.\n2. A user registers or updates a profile.\n3. `writeFileSync()` creates the profile without an explicit restrictive mode.\n4. The resulting file is readable by another local account or service sharing the group.\n5. That account reads the stored personal and family information directly from `data/profiles`.\n\n### Impact Assessment\n\nThe vulnerability can disclose sensitive personal and family data to other local users or co-located services. Exposed information can include:\n\n- Full names and platform identifiers.\n- Exact birth dates and times.\n- Birth locations.\n- Family relationships and family-member data.\n- Interaction preferences and push-routing metadata.\n- Derived astrology profiles.\n\nThe issue does not create remote access by itself. Its practical scope depends on host tenancy, umask configuration, directory permissions, and the account under which the Skill runs.\n  ]]>","severity":"Medium"},"fixes":[{"description":{"text":"<![CDATA[\n## Remediation Suggestions\n\n1. Create the profile directory with owner-only permissions:\n\n```javascript\nfs.mkdirSync(PROFILES_DIR, {\n  recursive: true,\n  mode: 0o700\n});\nfs.chmodSync(PROFILES_DIR, 0o700);\n```\n\n2. Write profile files with mode `0600`:\n\n```javascript\nfs.writeFileSync(\n  filePath,\n  JSON.stringify(profile, null, 2),\n  { encoding: 'utf8', mode: 0o600 }\n);\nfs.chmodSync(filePath, 0o600);\n```\n\n3. Apply the same helper consistently in every script that creates or updates profile data.\n\n4. Add a migration step that audits and corrects permissions on existing profile files.\n\n5. Use atomic writes: write to an owner-only temporary file in the same directory, synchronize it if required, and rename it over the destination.\n\n6. Run the Skill under a dedicated operating-system account and prevent unrelated services from reading its data directory.\n\n7. Document the sensitivity, retention period, backup exposure, and deletion behavior of profile files.\n  ]]>"}}]},{"ruleId":"other","level":"note","message":{"text":"Google Fonts Is Contacted by Default Despite the Declared Offline Network Policy"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"liuyao/index.html"},"region":{"startLine":10,"endLine":11}}}],"partialFingerprints":{"primaryLocationLineHash":"b28078de18ad59cd"},"properties":{"description":"<![CDATA[\n## Vulnerability Details\n\n**File Location**: `liuyao/index.html:10-11`  \n**Vulnerability Type**: Undisclosed default third-party network request  \n**Risk Level**: Low\n\n### Vulnerable Code\n\n```html\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=ZCOOL+XiaoWei&display=swap\" rel=\"stylesheet\">\n```\n\n### Technical Analysis\n\nThe HTML document actively establishes a connection to Google Fonts and loads a remote stylesheet whenever the page is opened. This contradicts the declarations in `SKILL.md` and `README.md` that Google Fonts is commented out or disabled by default.\n\nThe request is not necessary for the core divination functionality because the documentation states that system fonts provide an offline alternative. It therefore exceeds the minimum network access needed for the default feature set.\n\nThe request does not transmit stored profile files or the optional LLM API key. It does, however, disclose ordinary network metadata to a third party without the user first enabling an online feature.\n\n### Attack Path\n\n1. A user opens `liuyao/index.html` expecting default offline operation.\n2. The browser processes the active `preconnect` and stylesheet elements.\n3. The browser contacts Google infrastructure.\n4. Google receives request metadata before the user enables or consents to the optional LLM feature.\n\n### Impact Assessment\n\nThe third party may receive:\n\n- The user's public IP address.\n- Request time and frequency.\n- Browser and transport metadata.\n- Potential referrer information, depending on browser and hosting behavior.\n\nThis is a privacy and policy-compliance issue rather than code execution or credential exfiltration. It also makes the interface unsuitable for strictly offline or network-restricted deployments unless the links are removed.\n  ]]>","severity":"Low"},"fixes":[{"description":{"text":"<![CDATA[\n## Remediation Suggestions\n\n1. Remove or comment out both Google Fonts links in the distributed file.\n2. Prefer bundled local fonts or the documented system-font fallback.\n3. If remote fonts remain available, make them an explicit opt-in setting rather than a default request.\n4. Accurately update `README.md` and `SKILL.md` if any default network dependency is intentionally retained.\n5. Apply an appropriate referrer policy and restrictive Content Security Policy.\n6. Add an automated test that opens the default page in a monitored browser and verifies that it makes no external requests.\n  ]]>"}}]}],"properties":{"securityScore":0,"primaryLanguage":"Markdown","llm":"gpt-5.6","startTime":1789175892.8201668,"endTime":1789176026.826634}}]},"skillspector":{"skill":{"name":"unknown","source":"/tmp/clawhub-codex-scan-v571wfk93gd0k6456n54bzk55x8e9mhv-KRifKL/clawscan-skillspector-2832557886/artifact","scanned_at":"2026-09-12T01:18:11.236286+00:00"},"risk_assessment":{"score":100,"severity":"CRITICAL","recommendation":"DO_NOT_INSTALL","max_issue_severity":"HIGH"},"components":[{"path":"README.md","type":"markdown","lines":203,"executable":false,"size_bytes":7788,"source_url":null,"source_identity":null,"source_digest":null},{"path":"SKILL.md","type":"markdown","lines":475,"executable":false,"size_bytes":22680,"source_url":null,"source_identity":null,"source_digest":null},{"path":"_meta.json","type":"json","lines":9,"executable":false,"size_bytes":167,"source_url":null,"source_identity":null,"source_digest":null},{"path":"data/profiles/template.json","type":"json","lines":106,"executable":false,"size_bytes":2848,"source_url":null,"source_identity":null,"source_digest":null},{"path":"liuyao/index.html","type":"other","lines":1328,"executable":false,"size_bytes":54494,"source_url":null,"source_identity":null,"source_digest":null},{"path":"package-lock.json","type":"json","lines":84,"executable":false,"size_bytes":2807,"sourc