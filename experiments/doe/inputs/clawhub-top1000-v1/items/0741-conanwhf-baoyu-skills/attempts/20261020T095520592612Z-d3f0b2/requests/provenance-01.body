baoyu-md/src/extensions/toc.ts","start_line":4,"end_line":4},"finding":null,"explanation":"The file contains user-facing natural-language documentation only in Chinese ('marked 插件：支持 [TOC] 语法，自动生成嵌套目录'). Per the policy, forcing a specific language without offering a choice can be a locale/language policy violation. There is no indication in this file that the language choice is optional or justified as region-specific.","remediation":"Provide bilingual comments/documentation, or document that the skill/package is intentionally Chinese-language only for a specific audience or locale. If applicable, add an explicit note offering language choice in surrounding documentation.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"packages/baoyu-md/src/extensions/toc.ts","start_line":4,"end_line":4}]},{"id":"SQP-3","finding_id":"finding-f5c50fc109854b1887a33ba4e2289107","category":null,"pattern":null,"severity":"LOW","confidence":0.96,"location":{"file":"packages/baoyu-md/src/themes/default.css","start_line":2,"end_line":4},"finding":null,"explanation":"This CSS file contains natural-language comments entirely in Chinese, including the theme description and formatting guidance. For an organizational policy that disallows forcing a specific language without user opt-in, embedding instructions only in one language can violate the language/locale policy because no alternative or opt-in is offered.","remediation":"Provide bilingual comments or translate user-facing/instructional comments to the project's standard language, or document that this file is intentionally region-specific.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"packages/baoyu-md/src/themes/default.css","start_line":2,"end_line":4}]},{"id":"SQP-2","finding_id":"finding-f4d8b08ce0eb47a980c2f7fae275a105","category":null,"pattern":null,"severity":"LOW","confidence":0.89,"location":{"file":"scripts/sync-clawhub.mjs","start_line":61,"end_line":65},"finding":null,"explanation":"The script loads a token from the user's config and uses it for authenticated registry requests, including `whoami`, resolve, and publish calls. The code performs the credentialed action silently from the user's perspective and does not document or warn that stored credentials will be used for outbound requests.","remediation":"Add a visible notice in code comments, CLI help, or runtime output that the script uses the stored ClawHub token from config for authenticated network requests, and document how to override or disable this behavior.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"scripts/sync-clawhub.mjs","start_line":61,"end_line":65}]},{"id":"SQP-3","finding_id":"finding-b994867d3ad04362b969dfc8756540aa","category":null,"pattern":null,"severity":"LOW","confidence":0.88,"location":{"file":"skills/baoyu-article-illustrator/references/config/preferences-schema.md","start_line":111,"end_line":111},"finding":null,"explanation":"The example sets `language: zh`, which presents a specific locale as the configured output language. Because the surrounding documentation does not frame this as an opt-in, user-selected example or region-specific requirement, it may conflict with the policy against forcing a language without user choice.","remediation":"Clarify that `zh` is only an example of an optional user-selected language, or add wording that users may choose `zh`, `en`, `ja`, `ko`, or `auto` based on their preference.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-article-illustrator/references/config/preferences-schema.md","start_line":111,"end_line":111}]},{"id":"SQP-3","finding_id":"finding-660d85a8a07b4687b9bbb46ed90bb312","category":null,"pattern":null,"severity":"LOW","confidence":0.84,"location":{"file":"skills/baoyu-article-illustrator/references/styles/intuition-machine.md","start_line":31,"end_line":42},"finding":null,"explanation":"The file explicitly requires 'Bilingual callout labels (English + Chinese)' and later instructs to 'Use bilingual labels for key elements.' This imposes a specific language/locale output requirement rather than offering an opt-in or documenting why the constraint is necessary, which matches the policy-violation criterion for language or locale restrictions.","remediation":"Rephrase the guidance to make bilingual labeling optional or user-driven, such as 'use bilingual labels when requested by the user' or 'support English and Chinese labels as an option.' If the bilingual requirement is essential for a region-specific use case, document that justification clearly in the file.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-article-illustrator/references/styles/intuition-machine.md","start_line":31,"end_line":42}]},{"id":"SQP-2","finding_id":"finding-2a12a560a4db41ad92c500a58cbbd243","category":null,"pattern":null,"severity":"LOW","confidence":0.89,"location":{"file":"skills/baoyu-comic/SKILL.md","start_line":249,"end_line":263},"finding":null,"explanation":"The markdown specifies blocking first-time setup, reading preferences, and saving EXTEND.md under either the project directory or $HOME, which affects persistent user configuration data. There is no explicit user-facing warning in the description that the skill stores preferences on disk and may write into the home directory.","remediation":"Document clearly in SKILL.md that first-time setup creates and updates EXTEND.md preference files, including a possible path under $HOME, and advise the user before saving persistent preferences.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-comic/SKILL.md","start_line":249,"end_line":263}]},{"id":"SQP-3","finding_id":"finding-fc2df146cfdb4f9abd2b3c9b4d3a8584","category":null,"pattern":null,"severity":"LOW","confidence":0.89,"location":{"file":"skills/baoyu-comic/references/analysis-framework.md","start_line":164,"end_line":164},"finding":null,"explanation":"The description states that `user_language` is determined by a fixed precedence chain `(from EXTEND.md > --lang > source_language)`, which operationalizes language selection rather than explicitly offering the user a choice. Under the policy, locale/language constraints should either be opt-in or clearly justified; this wording does not present an explicit user choice in the file itself.","remediation":"Document that the user may choose the output language explicitly, and clarify fallback behavior only applies when no preference is provided. For example, state that the comic will use the user's requested language when specified, otherwise fall back to detected or source language.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-comic/references/analysis-framework.md","start_line":164,"end_line":164}]},{"id":"SQP-3","finding_id":"finding-5555f3eb4e95491ba40a7174daa27c57","category":null,"pattern":null,"severity":"LOW","confidence":0.78,"location":{"file":"skills/baoyu-comic/references/art-styles/ink-brush.md","start_line":3,"end_line":7},"finding":null,"explanation":"The file describes the style specifically as 'Chinese ink brush' and 'rooted in East Asian aesthetics' without indicating that this cultural/locale framing is optional or user-selected. Under the stated policy, forcing a specific language or locale without opt-in can be a natural-language policy concern.","remediation":"Clarify that this is an optional art style the user may choose, or document the intended region/cultural scope and why the constraint is appropriate. For example, add wording such as 'Use when the user requests a Chinese ink-brush aesthetic.'","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-comic/references/art-styles/ink-brush.md","start_line":3,"end_line":7}]},{"id":"SQP-3","finding_id":"finding-2e3457c701d5405194a97071e1397441","category":null,"pattern":null,"severity":"LOW","confidence":0.88,"location":{"file":"skills/baoyu-comic/references/art-styles/ligne-claire.md","start_line":3,"end_line":3},"finding":null,"explanation":"The document mixes an English markdown structure with a Chinese style label at L03, indicating a language-specific presentation without offering any user choice or noting that the file is intentionally locale-specific. Under the stated policy, forcing a specific language without opt-in can be a natural-language policy violation.","remediation":"Document that this reference is intentionally bilingual or locale-specific, or provide an explicit language choice/opt-in in the surrounding skill documentation.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-comic/references/art-styles/ligne-claire.md","start_line":3,"end_line":3}]},{"id":"SQP-3","finding_id":"finding-f9794148ce9a43bca142b0c9212a07aa","category":null,"pattern":null,"severity":"LOW","confidence":0.79,"location":{"file":"skills/baoyu-comic/references/config/preferences-schema.md","start_line":122,"end_line":135},"finding":null,"explanation":"This markdown schema includes a `language` field that supports multiple languages, but the full example sets `language: zh` and uses only Chinese character names and labels in the example content without explaining whether this locale is optional or region-specific. Because SQP-3 covers natural-language locale policy concerns, this could be read as steering output toward a specific language absent an explicit opt-in statement in the example context.","remediation":"Clarify in the example or field description that `language` is user-selectable and optional, for example by stating that `zh` is only an example value and that users should choose their preferred language or use `auto`.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-comic/references/config/preferences-schema.md","start_line":122,"end_line":135}]},{"id":"SQP-3","finding_id":"finding-0a82bffe3a7841cbaf5a014a8e1a384e","category":null,"pattern":null,"severity":"LOW","confidence":0.76,"location":{"file":"skills/baoyu-comic/references/ohmsha-guide.md","start_line":9,"end_line":10},"finding":null,"explanation":"The natural-language content specifies default character identities as 大雄 and 哆啦A梦, which imposes a particular locale/cultural framing by default. The file does not indicate that users may opt into alternative localized defaults, so this can be read as forcing a specific language/locale presentation.","remediation":"Add a note that character defaults are examples and should be localized to the user's requested language/region, or explicitly offer alternative defaults based on user preference.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-comic/references/ohmsha-guide.md","start_line":9,"end_line":10}]},{"id":"SQP-3","finding_id":"finding-d526c89cfa7149a8a6f512eb33cb13d8","category":null,"pattern":null,"severity":"LOW","confidence":0.89,"location":{"file":"skills/baoyu-comic/references/presets/shoujo.md","start_line":3,"end_line":3},"finding":null,"explanation":"Line L003 presents the preset description in bilingual form, which imposes specific language choices in the skill content without any stated user opt-in or justification for the locale mix. Under the policy for natural-language violations, language or locale constraints should either be optional for the user or clearly documented as intentional and necessary.","remediation":"Add a note that the preset supports multiple languages by user preference, or provide separate localized versions with an explicit language-selection mechanism. If bilingual output is required for a specific audience, document that constraint clearly in the file.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-comic/references/presets/shoujo.md","start_line":3,"end_line":3}]},{"id":"SQP-3","finding_id":"finding-6a7578a795ce4181b73c1bbe2a24dd43","category":null,"pattern":null,"severity":"LOW","confidence":0.81,"location":{"file":"skills/baoyu-comic/references/presets/wuxia.md","start_line":103,"end_line":110},"finding":null,"explanation":"The preset explicitly centers 'Chinese elements' and 'Chinese historical fiction' as quality markers and intended use without any opt-in or note that this locale/cultural framing is optional. Under the policy, forcing a specific language/locale or cultural localization without user choice can be a natural-language policy concern.","remediation":"Clarify that Chinese cultural elements are used only when the user requests wuxia-specific styling, or add language/locale choice guidance such as making these elements optional based on user intent.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-comic/references/presets/wuxia.md","start_line":103,"end_line":110}]},{"id":"SDI-2","finding_id":"finding-721998f32c874ed483a679534548c799","category":null,"pattern":null,"severity":"LOW","confidence":0.8,"location":{"file":"skills/baoyu-comic/references/workflow.md","start_line":425,"end_line":445},"finding":null,"explanation":"These instructions require reading another skill's SKILL.md, detecting supported flags such as --ref or --sessionId, and selecting an invocation strategy accordingly. That cross-skill introspection/orchestration is not obvious from a skill described only as '漫画生成' and represents an extra control-plane capability beyond the narrow stated purpose.","remediation":"Document this orchestration behavior in the manifest/skill docs, or refactor so the comic skill relies on a fixed declared image-generation interface instead of dynamically inspecting other installed skills.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-comic/references/workflow.md","start_line":425,"end_line":445}]},{"id":"SQP-2","finding_id":"finding-718515501db548efbd1b844e61385fd2","category":null,"pattern":null,"severity":"LOW","confidence":0.84,"location":{"file":"skills/baoyu-cover-image/references/config/preferences-schema.md","start_line":31,"end_line":31},"finding":null,"explanation":"This markdown file documents a preference `quick_mode: false  # Skip confirmation when true`, which changes behavior in a way that may affect user control and system integrity. The schema describes the option but does not include a user-facing caution about enabling it or when it is safe to use.","remediation":"Add a brief warning near `quick_mode` in the schema and field reference stating that enabling it bypasses the confirmation step and should only be used when the user is comfortable with automatic execution/review skipping.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-cover-image/references/config/preferences-schema.md","start_line":31,"end_line":31}]},{"id":"SQP-2","finding_id":"finding-e4e65e8ff8c9402284f0d1d7deddcefb","category":null,"pattern":null,"severity":"LOW","confidence":0.87,"location":{"file":"skills/baoyu-cover-image/references/workflow/reference-images.md","start_line":17,"end_line":20},"finding":null,"explanation":"This markdown file instructs the skill to copy a user-supplied image into `refs/` and create a companion `.md` file, which are user-data-affecting filesystem writes. The document does not include any warning or disclosure to the user that local files will be created or copied as part of this workflow.","remediation":"Add a brief warning in the skill documentation that processing a provided reference path will copy the image into `refs/` and create a metadata description file there. If appropriate, note the destination and that this is done to enable reference-based generation.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-cover-image/references/workflow/reference-images.md","start_line":17,"end_line":20}]},{"id":"SQP-2","finding_id":"finding-7a3dc3a836924dc08991a6b34f5a7c0b","category":null,"pattern":null,"severity":"LOW","confidence":0.9,"location":{"file":"skills/baoyu-cover-image/references/workflow/reference-images.md","start_line":40,"end_line":44},"finding":null,"explanation":"The markdown directs the skill to create `refs/extracted-style.md` when the user cannot provide a file path. That is a filesystem write affecting user/system state, but the documentation does not warn users that a new local file will be generated for extracted style information.","remediation":"Document this behavior explicitly, e.g. note that the skill will create `refs/extracted-style.md` to store extracted style details when no source file path is available.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-cover-image/references/workflow/reference-images.md","start_line":40,"end_line":44}]},{"id":"SQP-2","finding_id":"finding-818f19b99d97465e92c2a58590a57083","category":null,"pattern":null,"severity":"LOW","confidence":0.77,"location":{"file":"skills/baoyu-danger-gemini-web/scripts/gemini-webapi/constants.ts","start_line":2,"end_line":8},"finding":null,"explanation":"This code file defines multiple external HTTP endpoints, including Gemini, Google Accounts, and upload services, which indicates network communication that may transmit user or system data. There are no comments, docstrings, or user-visible disclosures in this file explaining that the skill contacts these remote services.","remediation":"Add a brief comment or docstring near the endpoint definitions or in the calling code/README clearly stating that the skill makes outbound requests to Google/Gemini services and may transmit prompts, uploads, or session-related data.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-danger-gemini-web/scripts/gemini-webapi/constants.ts","start_line":2,"end_line":8}]},{"id":"SQP-2","finding_id":"finding-75a363f447454825b1eddbdc9b095307","category":null,"pattern":null,"severity":"LOW","confidence":0.84,"location":{"file":"skills/baoyu-danger-gemini-web/scripts/gemini-webapi/types/image.ts","start_line":78,"end_line":78},"finding":null,"explanation":"The save method persists downloaded content to a local path using writeFile, but there is no unconditional user-facing notice, confirmation, or explanatory docstring/comment describing that local files will be created. The only message is a verbose-mode log after the write completes, which may be disabled.","remediation":"Document that this method writes files to disk and where they are stored, either through a docstring/comment and the skill README/SKILL.md or via a visible log/confirmation before saving. If appropriate, emit a non-verbose informational message before or during the write operation.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-danger-gemini-web/scripts/gemini-webapi/types/image.ts","start_line":78,"end_line":78}]},{"id":"SQP-2","finding_id":"finding-e4cb026d7f804452960dcd2ed44716db","category":null,"pattern":null,"severity":"LOW","confidence":0.78,"location":{"file":"skills/baoyu-danger-gemini-web/scripts/main.ts","start_line":468,"end_line":485},"finding":null,"explanation":"The script creates directories and saves generated or fetched images to a local path, which is a file-write operation. While the --image flag implies saving, the code does not emit any confirmation or warning about the resolved destination path before performing the write.","remediation":"Print a user-facing message before saving the image, including the fully resolved output path, or document this behavior prominently in the skill's markdown/README.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-danger-gemini-web/scripts/main.ts","start_line":468,"end_line":485}]},{"id":"SQP-2","finding_id":"finding-a7ef56f272664777b018ea10f47a721f","category":null,"pattern":null,"severity":"LOW","confidence":0.82,"location":{"file":"skills/baoyu-danger-x-to-markdown/scripts/cookies.ts","start_line":190,"end_line":193},"finding":null,"explanation":"The code pulls X authentication-related cookie values from environment variables such as X_AUTH_TOKEN and X_CT0, which are sensitive credentials. This file does not include a user-facing warning or inline disclosure that the skill will consume credential-bearing environment variables.","remediation":"Document or log clearly that the skill reads X cookie credentials from specific environment variables, and explain the security implications and expected handling of those values.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-danger-x-to-markdown/scripts/cookies.ts","start_line":190,"end_line":193}]},{"id":"SQP-3","finding_id":"finding-fca5acb13d7546de83e3fb77ba2c5269","category":null,"pattern":null,"severity":"LOW","confidence":0.96,"location":{"file":"skills/baoyu-danger-x-to-markdown/scripts/http.ts","start_line":97,"end_line":98},"finding":null,"explanation":"The code hard-codes both x-twitter-client-language and accept-language to \"en\", which imposes a specific language/locale. The policy allows locale constraints only when the user is given a choice or the limitation is clearly justified, neither of which is evident here.","remediation":"Make the language headers configurable based on user preference or omit them unless English is explicitly required and documented as a justified constraint.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-danger-x-to-markdown/scripts/http.ts","start_line":97,"end_line":98}]},{"id":"SDI-2","finding_id":"finding-4099cf52e2ec4094a8995e5016ecad15","category":null,"pattern":null,"severity":"LOW","confidence":0.87,"location":{"file":"skills/baoyu-danger-x-to-markdown/scripts/http.ts","start_line":112,"end_line":114},"finding":null,"explanation":"The stated purpose of this subskill is converting X posts to Markdown, which obviously justifies making HTTP requests to X and constructing request headers. However, reading process.env.X_CLIENT_TRANSACTION_ID to alter outbound requests is an additional credential/configuration capability not evident from the skill purpose alone, especially in a helper for content conversion.","remediation":"Avoid reading process environment variables inside this formatter/scraper helper. Pass any required transaction identifier explicitly from higher-level configuration, and document that capability in the skill description if it is truly required.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-danger-x-to-markdown/scripts/http.ts","start_line":112,"end_line":114}]},{"id":"SQP-2","finding_id":"finding-a3b9bc0583c943f190cb5e2995e7b533","category":null,"pattern":null,"severity":"LOW","confidence":0.79,"location":{"file":"skills/baoyu-danger-x-to-markdown/scripts/tweet-article.ts","start_line":94,"end_line":94},"finding":null,"explanation":"This TypeScript file performs a remote data retrieval via `fetchXArticle(articleId, cookieMap, false)` using tweet-derived identifiers and a cookie map, but the file contains no confirmation prompt, logging, comment, or docstring disclosing that network access will occur. For code files, outbound network operations that may transmit user or system data should have some visible disclosure unless clearly documented elsewhere in the skill description.","remediation":"Add a user-visible warning, log statement, or explanatory comment/docstring stating that the function may make a network request to X/Twitter using provided cookies to resolve article content. If this behavior is already documented in the skill README/SKILL.md, ensure that documentation is explicit and easy for users to see.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-danger-x-to-markdown/scripts/tweet-article.ts","start_line":94,"end_line":94}]},{"id":"SQP-2","finding_id":"finding-88ae55df130b4fdfb774b059cbc8f05c","category":null,"pattern":null,"severity":"LOW","confidence":0.87,"location":{"file":"skills/baoyu-danger-x-to-markdown/scripts/vendor/baoyu-chrome-cdp/src/index.test.ts","start_line":89,"end_line":96},"finding":null,"explanation":"This code invokes /bin/bash via spawn to launch a mock Chromium process, which is a subprocess execution covered by the missing-user-warnings rule for code files. Although it is test-only code, the file itself contains no comment, log, or other disclosure near the operation explaining that it will start an external shell process.","remediation":"Add a brief comment or visible test description warning that this helper launches a local shell subprocess to simulate Chromium, or emit a clear log message when the subprocess is started.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-danger-x-to-markdown/scripts/vendor/baoyu-chrome-cdp/src/index.test.ts","start_line":89,"end_line":96}]},{"id":"SC1","finding_id":"finding-09d982c8d73c461dac888b536d3138bb","category":"Supply Chain","pattern":"Unpinned Dependencies","severity":"LOW","confidence":0.4,"location":{"file":"packages/baoyu-md/package.json","