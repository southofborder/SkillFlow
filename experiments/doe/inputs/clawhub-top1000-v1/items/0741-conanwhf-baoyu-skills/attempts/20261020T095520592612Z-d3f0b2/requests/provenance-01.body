e3d493b897f794b0ee4d0e9","category":"Supply Chain","pattern":"Known Vulnerable Dependency: yaml==2.8.2 — 1 advisory(ies): CVE-2026-33532 (yaml is vulnerable to Stack Overflow via deeply nested YAML collections)","severity":"LOW","confidence":0.6,"location":{"file":"skills/baoyu-format-markdown/scripts/package-lock.json","start_line":1103,"end_line":null},"finding":"yaml==2.8.2","explanation":"Dependency has known vulnerabilities (CVEs). Using packages with unpatched security flaws exposes the environment to known exploits.","remediation":"Update the dependency to a patched version that addresses the known CVE. Check OSV (osv.dev) or NVD for details on the vulnerability.","code_snippet":null,"intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"d25428a56b1d15361ac8fc286e3b343dd66dbc4093126c446b1bfe8e48dd7e3f","occurrences":[{"file":"skills/baoyu-format-markdown/scripts/package-lock.json","start_line":1103,"end_line":null}]},{"id":"SC4","finding_id":"finding-33c597fd8e3d493b897f794b0ee4d0e9","category":"Supply Chain","pattern":"Known Vulnerable Dependency: yaml==2.8.2 — 1 advisory(ies): CVE-2026-33532 (yaml is vulnerable to Stack Overflow via deeply nested YAML collections)","severity":"LOW","confidence":0.6,"location":{"file":"skills/baoyu-format-markdown/scripts/package.json","start_line":10,"end_line":null},"finding":"yaml==2.8.2","explanation":"Dependency has known vulnerabilities (CVEs). Using packages with unpatched security flaws exposes the environment to known exploits.","remediation":"Update the dependency to a patched version that addresses the known CVE. Check OSV (osv.dev) or NVD for details on the vulnerability.","code_snippet":null,"intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"d25428a56b1d15361ac8fc286e3b343dd66dbc4093126c446b1bfe8e48dd7e3f","occurrences":[{"file":"skills/baoyu-format-markdown/scripts/package.json","start_line":10,"end_line":null}]},{"id":"SQP-2","finding_id":"finding-a0703b2f99f64d23bc2e6fa2b5a996bf","category":null,"pattern":null,"severity":"LOW","confidence":0.87,"location":{"file":"skills/baoyu-image-gen/references/config/first-time-setup.md","start_line":102,"end_line":119},"finding":null,"explanation":"This markdown file instructs the skill to save preferences either in the project directory or under the user's home directory, which affects local files and persists settings across projects. While it later confirms the save path, the description does not warn the user beforehand that setup will create or modify EXTEND.md in those locations.","remediation":"Add a brief user-facing warning near the save-location choice stating that the setup will create or update `.baoyu-skills/baoyu-image-gen/EXTEND.md` in the selected project or user path and persist preferences there.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-image-gen/references/config/first-time-setup.md","start_line":102,"end_line":119}]},{"id":"SQP-2","finding_id":"finding-9f3f29bd30454ea6a1d3abea983f1a0e","category":null,"pattern":null,"severity":"LOW","confidence":0.78,"location":{"file":"skills/baoyu-image-gen/scripts/main.ts","start_line":826,"end_line":828},"finding":null,"explanation":"This code performs filesystem writes by creating parent directories and saving generated image data, which can modify the user's filesystem. Although the CLI usage documents the --image output path, there is no confirmation prompt and no direct user-facing disclosure immediately before the write occurs about creating directories and overwriting or saving files.","remediation":"Add a user-facing notice before saving files, such as logging the target output path and whether directories will be created or files overwritten. If overwriting is possible, consider adding an explicit confirmation flag or prompt unless non-interactive mode is intended.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-image-gen/scripts/main.ts","start_line":826,"end_line":828}]},{"id":"SQP-3","finding_id":"finding-f1bdc477f34d474290e01482f9a8f149","category":null,"pattern":null,"severity":"LOW","confidence":0.92,"location":{"file":"skills/baoyu-image-gen/scripts/providers/dashscope.ts","start_line":14,"end_line":15},"finding":null,"explanation":"The constant negative prompt is written entirely in Chinese, which imposes a specific language in requests sent to the image model. The file does not provide user opt-in, locale selection, or justification that this provider is intentionally China/Chinese-specific, so this is a natural-language locale policy concern.","remediation":"Make the negative prompt language configurable, derive it from a user-selected locale, or document and justify that this provider requires Chinese-language prompts for model quality. If a default is needed, offer fallback/selection rather than forcing one language.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-image-gen/scripts/providers/dashscope.ts","start_line":14,"end_line":15}]},{"id":"SQP-2","finding_id":"finding-b3e0f62b7bb04d15957a9ce2e7722bf4","category":null,"pattern":null,"severity":"LOW","confidence":0.84,"location":{"file":"skills/baoyu-image-gen/scripts/providers/openai.ts","start_line":101,"end_line":111},"finding":null,"explanation":"The function sends the prompt content to the chat/completions API, which transmits user-provided data to an external service. In this file there is no confirmation, visible log/print, or explanatory comment/docstring disclosing that prompt contents leave the local environment.","remediation":"Add a clear user-facing notice, log message, or documentation statement that prompts are transmitted to the OpenAI API when generating images.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-image-gen/scripts/providers/openai.ts","start_line":101,"end_line":111}]},{"id":"SQP-2","finding_id":"finding-70adcb29e3a848edbd004062ebccc11c","category":null,"pattern":null,"severity":"LOW","confidence":0.85,"location":{"file":"skills/baoyu-image-gen/scripts/providers/openai.ts","start_line":143,"end_line":150},"finding":null,"explanation":"This request transmits user prompt data and generation settings to a remote API endpoint. The code does not provide any visible warning, confirmation, or inline documentation to disclose that user input is being sent off-box.","remediation":"Add a user-visible warning, confirmation, or explicit documentation indicating that prompts and related parameters are transmitted to the OpenAI image generation service.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-image-gen/scripts/providers/openai.ts","start_line":143,"end_line":150}]},{"id":"SQP-2","finding_id":"finding-3de1367a671240a08633c98afea9fe41","category":null,"pattern":null,"severity":"LOW","confidence":0.76,"location":{"file":"skills/baoyu-image-gen/scripts/providers/replicate.ts","start_line":14,"end_line":15},"finding":null,"explanation":"The skill reads REPLICATE_API_TOKEN from the environment, which is a sensitive credential access pattern covered by the warning requirement for code files. The file lacks any nearby comment or user-facing disclosure about the credential dependency or sensitivity, aside from an error only shown when the variable is missing.","remediation":"Add a short comment or user-facing note explaining that the skill requires a Replicate API token from the environment and that it will be used for authenticated requests. Including this in the skill documentation would also satisfy the warning requirement.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-image-gen/scripts/providers/replicate.ts","start_line":14,"end_line":15}]},{"id":"SQP-3","finding_id":"finding-3551311b47c045b690ee184c570c26ac","category":null,"pattern":null,"severity":"LOW","confidence":0.89,"location":{"file":"skills/baoyu-infographic/references/base-prompt.md","start_line":26,"end_line":26},"finding":null,"explanation":"The instruction 'Use the specified language for all text content' mandates a language choice but does not indicate that the user selected or can override that language. This can violate language/locale policy if the skill enforces a locale without explicit user opt-in or justification.","remediation":"Clarify that the language must come from explicit user selection or add fallback behavior that respects the user's preferred language. For example, state that the infographic should use the user's chosen language, and ask for confirmation if no preference is provided.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-infographic/references/base-prompt.md","start_line":26,"end_line":26}]},{"id":"SQP-3","finding_id":"finding-d3d6deb12f6a4eea9252fcf30023efa7","category":null,"pattern":null,"severity":"LOW","confidence":0.93,"location":{"file":"skills/baoyu-infographic/references/layouts/dense-modules.md","start_line":53,"end_line":53},"finding":null,"explanation":"The example subtitle is specified as \"X大维度全面解析...\", which imposes a Chinese-language output pattern in the template. This is a natural-language locale choice without any indication that the user can select another language or that the constraint is required for a region-specific use case.","remediation":"Make the subtitle example language-neutral or explicitly state that the language should match user preference. For example, replace the fixed Chinese example with a generic placeholder and note that creators should localize based on user or audience choice.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-infographic/references/layouts/dense-modules.md","start_line":53,"end_line":53}]},{"id":"SQP-3","finding_id":"finding-840bc01f82ac4640babf04343f355b95","category":null,"pattern":null,"severity":"LOW","confidence":0.82,"location":{"file":"skills/baoyu-infographic/references/styles/kawaii.md","start_line":3,"end_line":3},"finding":null,"explanation":"The phrase \"Japanese cute style\" specifies a particular language/cultural locale as the defining style instruction, but the file does not indicate that this locale is optional, user-selected, or required for a justified region-specific use case. This can be read as imposing a locale-specific output style without opt-in.","remediation":"Clarify that this is an optional style reference selected by the user, or rephrase to describe the visual traits without prescribing a specific locale unless there is a documented reason.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-infographic/references/styles/kawaii.md","start_line":3,"end_line":3}]},{"id":"SQP-3","finding_id":"finding-803919ad5cae4449901fe2e184260917","category":null,"pattern":null,"severity":"LOW","confidence":0.93,"location":{"file":"skills/baoyu-infographic/references/styles/retro-pop-grid.md","start_line":27,"end_line":27},"finding":null,"explanation":"The file explicitly states that decorative English text is acceptable for stylistic labels such as \"WARNING\", \"INFO\", and \"BEST\". This is a natural-language locale policy concern because it prescribes English labels without indicating user choice or a justified region-specific need.","remediation":"Allow decorative labels to match the user's selected language, or document that English labels are optional and require user opt-in when non-English output is desired.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-infographic/references/styles/retro-pop-grid.md","start_line":27,"end_line":27}]},{"id":"SQP-1","finding_id":"finding-147e2d57d3a141ab98cc87884fee8c55","category":null,"pattern":null,"severity":"LOW","confidence":0.88,"location":{"file":"skills/baoyu-markdown-to-html/SKILL.md","start_line":3,"end_line":3},"finding":null,"explanation":"The description lists several concrete trigger phrases, but then adds \"or needs styled HTML output from markdown,\" which is comparatively broad and could match many ordinary requests without clearly defining boundaries. There are no exclusion conditions or negative examples to clarify when this skill should not activate.","remediation":"Replace the broad fallback with narrower invocation criteria, such as explicit phrases or a constrained context. Add negative examples or exclusion rules to clarify requests that should not trigger this skill.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-markdown-to-html/SKILL.md","start_line":3,"end_line":3}]},{"id":"SQP-3","finding_id":"finding-5017bbe830f649c78964b43b29a4f80f","category":null,"pattern":null,"severity":"LOW","confidence":0.96,"location":{"file":"skills/baoyu-markdown-to-html/scripts/vendor/baoyu-md/src/extensions/infographic.ts","start_line":77,"end_line":77},"finding":null,"explanation":"The error message string shown to users is hard-coded in Chinese ('Infographic 渲染失败'), and the loading message later in the file is also Chinese-only. This creates a locale policy issue because the skill imposes a specific language in user-facing output without opt-in or justification.","remediation":"Externalize user-facing strings and provide localization or a language selection mechanism. If the skill is intentionally Chinese-only, document that locale restriction clearly in the skill description.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-markdown-to-html/scripts/vendor/baoyu-md/src/extensions/infographic.ts","start_line":77,"end_line":77}]},{"id":"SQP-3","finding_id":"finding-1d801b60b4644a28862cab8afa2944b1","category":null,"pattern":null,"severity":"LOW","confidence":0.95,"location":{"file":"skills/baoyu-markdown-to-html/scripts/vendor/baoyu-md/src/extensions/infographic.ts","start_line":109,"end_line":109},"finding":null,"explanation":"The renderer returns a user-visible placeholder text '正在加载 Infographic...' in Chinese only. Forcing a specific language in UI text without offering alternatives or documenting a regional scope violates the natural-language locale policy.","remediation":"Replace hard-coded locale-specific UI text with configurable or localized strings, or clearly document that the skill is intended only for Chinese-language users.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-markdown-to-html/scripts/vendor/baoyu-md/src/extensions/infographic.ts","start_line":109,"end_line":109}]},{"id":"SQP-3","finding_id":"finding-d1e41959a4e3496ea5648050c55eddf8","category":null,"pattern":null,"severity":"LOW","confidence":0.96,"location":{"file":"skills/baoyu-markdown-to-html/scripts/vendor/baoyu-md/src/extensions/plantuml.ts","start_line":181,"end_line":181},"finding":null,"explanation":"The loading message shown to users is fixed in Chinese, and later error output shown in rendered HTML is also Chinese. This imposes a specific language on end users without opt-in or any documented locale-specific scope.","remediation":"Externalize user-facing strings and provide localization or a configurable language option, or document that this skill is intentionally Chinese-language only if that constraint is required.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-markdown-to-html/scripts/vendor/baoyu-md/src/extensions/plantuml.ts","start_line":181,"end_line":181}]},{"id":"SQP-3","finding_id":"finding-39fdf6c61dd646da8db90e14c3f7003c","category":null,"pattern":null,"severity":"LOW","confidence":0.96,"location":{"file":"skills/baoyu-markdown-to-html/scripts/vendor/baoyu-md/src/extensions/plantuml.ts","start_line":209,"end_line":209},"finding":null,"explanation":"The returned fallback HTML displays a Chinese-only error message to users. Per the policy, forcing a specific language without opt-in or justification is a natural-language policy issue.","remediation":"Replace hardcoded Chinese text with configurable/localized messages, or clearly document and justify that the skill is intended only for Chinese-speaking users.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-markdown-to-html/scripts/vendor/baoyu-md/src/extensions/plantuml.ts","start_line":209,"end_line":209}]},{"id":"SQP-3","finding_id":"finding-9669ca4d0bba498a88a392a376aa7322","category":null,"pattern":null,"severity":"LOW","confidence":0.89,"location":{"file":"skills/baoyu-markdown-to-html/scripts/vendor/baoyu-md/src/extensions/ruby.ts","start_line":4,"end_line":17},"finding":null,"explanation":"The file’s natural-language comments are entirely in Chinese, including the feature description and usage notes, with no indication that the skill is intentionally region-specific or that alternative language support exists. Under the stated policy, forcing a specific language without opt-in or justification is a locale/language policy issue.","remediation":"Add an explicit justification that this extension is intended for a Chinese-language or CJK-focused markdown workflow, or provide bilingual comments/documentation so the language choice is not effectively forced.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-markdown-to-html/scripts/vendor/baoyu-md/src/extensions/ruby.ts","start_line":4,"end_line":17}]},{"id":"SQP-3","finding_id":"finding-643dea9b39c443fe89c76e1012df2d96","category":null,"pattern":null,"severity":"LOW","confidence":0.77,"location":{"file":"skills/baoyu-markdown-to-html/scripts/vendor/baoyu-md/src/themes/simple.css","start_line":2,"end_line":3},"finding":null,"explanation":"The file contains natural-language comments in Chinese describing the theme. Under the policy rule for language or locale constraints, this can be considered a language-specific choice with no opt-in or documented justification visible in the file.","remediation":"Use neutral bilingual comments, document that the skill/theme is intended for Chinese-speaking users, or provide language choice/justification in surrounding documentation.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-markdown-to-html/scripts/vendor/baoyu-md/src/themes/simple.css","start_line":2,"end_line":3}]},{"id":"SQP-2","finding_id":"finding-ac6e6af154c6492bb56a43fed65d8589","category":null,"pattern":null,"severity":"LOW","confidence":0.85,"location":{"file":"skills/baoyu-post-to-wechat/scripts/vendor/baoyu-md/src/extend-config.ts","start_line":38,"end_line":49},"finding":null,"explanation":"This code silently searches user-controlled config locations under the current working directory, XDG config home, and the user's home directory, then reads EXTEND.md from those paths. For code files, accessing user filesystem locations is a safety-relevant operation that should have some visible disclosure such as a comment, log message, or documented warning, but none appears in this file.","remediation":"Add a short comment or user-facing log/docstring explaining that the skill loads configuration from these filesystem locations, or document this behavior in the skill's markdown/README so users know local files will be read.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-post-to-wechat/scripts/vendor/baoyu-md/src/extend-config.ts","start_line":38,"end_line":49}]},{"id":"SQP-3","finding_id":"finding-98450cebe800456bb3df1eec6daef15b","category":null,"pattern":null,"severity":"LOW","confidence":0.81,"location":{"file":"skills/baoyu-post-to-wechat/scripts/vendor/baoyu-md/src/extensions/ruby.ts","start_line":4,"end_line":17},"finding":null,"explanation":"The file's natural-language comments are entirely in Chinese, which imposes a specific language on maintainers and reviewers without any visible opt-in or justification in this file. The policy explicitly flags language or locale constraints when a skill forces a specific language choice.","remediation":"Translate comments to a shared project language, or provide bilingual comments/documentation. If Chinese-only comments are intentional, document the locale/language requirement and justification clearly.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-post-to-wechat/scripts/vendor/baoyu-md/src/extensions/ruby.ts","start_line":4,"end_line":17}]},{"id":"SQP-3","finding_id":"finding-5492884af2504b89b5c5ff0c2b23fc6c","category":null,"pattern":null,"severity":"LOW","confidence":0.78,"location":{"file":"skills/baoyu-post-to-weibo/SKILL.md","start_line":3,"end_line":3},"finding":null,"explanation":"The manifest description is hard-wired to post to Weibo and includes Chinese-language platform-specific actions such as 微博 and 头条文章 without any note that this is a region/platform-specific skill or that the user is opting into that locale context. This can be read as imposing a specific platform/language context rather than offering a choice.","remediation":"Document that the skill is specifically for the Weibo platform and should only be used when the user explicitly requests Weibo posting, or add wording that confirms platform/language choice is user-driven.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-post-to-weibo/SKILL.md","start_line":3,"end_line":3}]},{"id":"SQP-2","finding_id":"finding-b302e4e3a8104754aa926e152125051c","category":null,"pattern":null,"severity":"LOW","confidence":0.82,"location":{"file":"skills/baoyu-post-to-weibo/scripts/copy-to-clipboard.ts","start_line":189,"end_line":249},"finding":null,"explanation":"This code writes user-supplied image or HTML content to the system clipboard across macOS, Linux, and Windows, and does so by invoking external tools such as `swift`, `wl-copy`, `xclip`, and `powershell.exe`. While the script's purpose implies clipboard interaction, there is no explicit user-facing warning in the operational paths that clipboard contents will be overwritten or that subprocesses will be launched.","remediation":"Add a brief user-visible notice before performing the copy, such as printing that the current clipboard will be replaced and which platform tool will be invoked. Alternatively, document this behavior clearly in a nearby comment/docstring or the skill's markdown description so the action is disclosed.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-post-to-weibo/scripts/copy-to-clipboard.ts","start_line":189,"end_line":249}]},{"id":"SQP-2","finding_id":"finding-6673510ffbcb40f891cfc1b824d8e294","category":null,"pattern":null,"severity":"LOW","confidence":0.77,"location":{"file":"skills/baoyu-post-to-weibo/scripts/paste-from-clipboard.ts","start_line":54,"end_line":55},"finding":null,"explanation":"The script uses osascript, xdotool, ydotool, and PowerShell SendKeys to control the user's desktop and inject keystrokes into applications. The file explains usage and logs execution, but it does not clearly warn that it will programmatically control the OS UI and act on the frontmost application, which can have unintended effects if focus is wrong.","remediation":"Add a comment, help text, or runtime warning that the script automates the desktop by sending keystrokes to the focused application and should only be run when the intended target window is active.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"skills/baoyu-post-to-weibo/scripts/paste-from-clipboard.ts","start_line":54,"end_line":55}]},{"id":"SC1","finding_id":"finding-f5991d64301a42dfb5563dbc52afbe73","category":"Supply Chain","pattern":"Unpinned Dependencies","severity":"LOW","confidence":0.4,"location":{"file":"packages/baoyu-md/package.json","start_line":10,"end_line":null},"finding":"\"fflate\": \"^0.8.2\"","explanation":"Dependencies lack version pinning, allowing potential malicious package updates. Consider pinning versions.","remediation":"Pin all dependency versions in requirements.txt or pyproject.toml. Use exact versions (==) or compatible ranges. Run pip-audit regularly.","code_snippet":"    \".\": \"./src/index.ts\"\n  },\n  \"dependencies\": {\n    \"fflate\": \"^0.8.2\",\n    \"front-matter\": \"^4.0.2\",\n    \"highlight.js\": \"^11.11.1\",\n    \"juice\": \"^11.0.1\",","intent":null,"tags":["Supply Chain"],"evidence":{},"match_fingerprint":"53ef33b45310fb68e9533b339a1f0fd64d582a20130376bff002332b89c4985f","occurrences":[{"file":"packages/baoyu-md/package.json","start_line":10,"end_line":null}]},{"id":"SC1","finding_id":"finding-f5991d64301a42dfb5563dbc52afbe73","category":"Supply Chain","pattern":"Unpinned Dependencies","severity":"LOW","confidence":0.4,"location":{"file":"skills/baoyu-markdown-to-html/scripts/vendor/baoyu-md/package.json","start_line":10,"end_line":null},"finding":"\"fflate\": \"^0.8.2\"","explanation":"Dependencies lack version pinning, allowing potential malicious package updates. Consider pinning versions.","remediation":"Pin all dependency versions in requirements.txt or pyproject.toml. Use exact versions (==) or compatible ranges. Run pip-audit regularly.","code_snippet":"    \".\": \"./src/index.ts\"\n  },\n  \"dependencies\": {\n    \"fflate\": \"^0.8.2\",\n    \"f