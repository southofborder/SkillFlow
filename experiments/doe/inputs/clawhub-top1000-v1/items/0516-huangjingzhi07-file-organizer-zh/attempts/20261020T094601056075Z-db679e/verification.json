line":232}]},{"id":"LP3","finding_id":"finding-ea3375a38b4c40dc870c2e31c7e41abc","category":"MCP Least Privilege","pattern":null,"severity":"MEDIUM","confidence":0.7,"location":{"file":"SKILL.md","start_line":1,"end_line":null},"finding":null,"explanation":"Without declared permissions the skill's intent is opaque and cannot be validated.","remediation":"Declare the skill's tool scope: for Claude Code / Agent Skills SKILL.md, list the tools the skill may invoke in the 'allowed-tools' frontmatter field; for MCP server manifests, add a 'permissions' list naming the required capabilities.","code_snippet":null,"intent":null,"tags":["ASI02","llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":1,"end_line":null}]},{"id":"SQP-2","finding_id":"finding-42f3e1a1c8af41008294b40569c2f958","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"SKILL.md","start_line":13,"end_line":17},"finding":null,"explanation":"The skill advertises '识别并清理重复文件' without warning that duplicate cleanup can delete or move user data incorrectly, especially when content-based matching is imperfect. In a file-management context, destructive operations are inherently risky because a mistaken cleanup can cause irreversible data loss.","remediation":"Add a clear warning in the description that duplicate cleanup may move or delete files and should be reviewed before execution. Default to preview/report-only mode, show the exact files to be removed, require explicit user confirmation, and support trash/recycle-bin moves plus easy rollback instead of permanent deletion.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":13,"end_line":17}]},{"id":"SQP-1","finding_id":"finding-a5d4d8517a9244a59883d51e771b8318","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.96,"location":{"file":"SKILL.md","start_line":18,"end_line":23},"finding":null,"explanation":"The trigger phrases are very broad, common words like '整理' and '分类' that can match many ordinary conversations unrelated to filesystem operations. This can cause accidental skill activation in the wrong context, increasing the chance of unintended file actions if the runtime grants the skill filesystem capabilities.","remediation":"Narrow the trigger phrases to explicit, high-intent commands such as '整理我的下载文件夹' or '按文件类型分类目录'. Add a confirmation step before any file modifications and require the user to specify a target directory explicitly.","code_snippet":null,"intent":null,"tags":[],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":18,"end_line":23}]},{"id":"SQP-3","finding_id":"finding-121ef2c1c0ab4e4c99d6a9ec52961369","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"index.js","start_line":145,"end_line":152},"finding":null,"explanation":"The description, activation keywords, and user-facing prompts are all hard-coded in Chinese, and activation depends on Chinese terms like `整理` and `分类`. This creates a language-policy issue because the skill forces a specific language experience without explicit user opt-in or a documented justification for being Chinese-only.","remediation":"Provide multilingual support or clearly document that the skill is Chinese-only and require user opt-in. At minimum, expand activation and response handling to support additional languages or configurable locale settings.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"index.js","start_line":145,"end_line":152}]},{"id":"SQP-3","finding_id":"finding-eb68bafb355548af9eff94fd853422c4","category":null,"pattern":null,"severity":"MEDIUM","confidence":0.95,"location":{"file":"package.json","start_line":4,"end_line":8},"finding":null,"explanation":"The description labels the skill as a Chinese version and the keywords are exclusively Chinese, indicating a language-specific constraint in the skill metadata. The file does not mention any user choice, opt-in, or justification for restricting the skill to Chinese, which can violate language/locale policy requirements.","remediation":"Document that the skill is intentionally region- or language-specific with a clear justification, or update the metadata to state that language selection is optional and user-controlled.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"package.json","start_line":4,"end_line":8}]},{"id":"SQP-3","finding_id":"finding-3de69e03d63d479a9f65326e9e62f655","category":null,"pattern":null,"severity":"LOW","confidence":0.87,"location":{"file":"SKILL.md","start_line":4,"end_line":6},"finding":null,"explanation":"The description and tags explicitly present the skill as a Chinese version, but the document does not state that language is selectable or optional. This can violate language/locale policy when a skill constrains interaction to a single language without offering user choice or documenting a justified regional limitation.","remediation":"State that Chinese is the default language while allowing users to choose another supported language, or explicitly document why the skill is intentionally limited to Chinese-only use.","code_snippet":null,"intent":null,"tags":["llm-unconfirmed"],"evidence":{},"match_fingerprint":null,"occurrences":[{"file":"SKILL.md","start_line":4,"end_line":6}]}],"suppressed_count":0,"suppressed":[],"metadata":{"has_executable_scripts":true,"skillspector_version":"2.11.2","llm_requested":true,"llm_available":true,"meta_analysis_applied":true,"inference_usage":[{"node":"mcp_tool_poisoning","request_kind":"structured_output","provider":"openai","model":"gpt-5.4-2026-03-05","model_source":"provider_response","usage_source":"provider_response","prompt_tokens":2305,"completion_tokens":237,"cached_tokens":0,"reasoning_tokens":0