ntType":"text/markdown"},{"path":"references/TESTING_AND_RELEASE.md","size":6429,"sha256":"69721774d8d676b92c3af5f229ca0d30f5b0e7b7223d08d83c38447a3dc6bdab","contentType":"text/markdown"},{"path":"skill-card.md","size":2132,"sha256":"9edddc0a4b1f2e4b8f387bfee4842abfdaec817f0f976629b3ee02eba474200d","contentType":"text/markdown"}],"security":{"status":"clean","hasWarnings":true,"checkedAt":1792124145268,"model":null,"hasScanResult":true,"sha256hash":"d01731cfe814a4efcd4b5f848605bc7422bd28249899cbedcf21f4f17c8f9b77","virustotalUrl":"https://www.virustotal.com/gui/file/d01731cfe814a4efcd4b5f848605bc7422bd28249899cbedcf21f4f17c8f9b77","scanners":{"vt":{"status":"clean","verdict":null,"normalizedStatus":"clean","analysis":null,"source":"engines","checkedAt":1792123611335},"skillspector":{"status":"suspicious","normalizedStatus":"suspicious","score":33,"severity":"MEDIUM","recommendation":"CAUTION","issueCount":2,"checkedAt":1792124145268},"llm":{"status":"clean","verdict":"benign","normalizedStatus":"clean","confidence":"high","summary":"This is a disclosed coding helper for building DCC-MCP integrations, with higher-risk service and UI-control topics scoped to the user’s project and operator controls.","dimensions":[{"detail":"The skill covers services, sidecars, gateways, UI automation, LAN exposure, and internal APIs, but repeatedly defaults to loopback/local work and requires operator-owned TLS, auth, allow-lists, scope, and shutdown controls for broader exposure.","label":"Credentials","name":"environment_proportionality","rating":"note"},{"detail":"No executable install script is shipped. Installation guidance emphasizes plan/execute/verify/status/uninstall, exact artifacts, hashes, lockfiles, and avoiding floating debug dependencies.","label":"Install Mechanism","name":"install_mechanism","rating":"ok"},{"detail":"The instructions route the agent to relevant local reference docs, typed core APIs, bounded tools, and explicit validation; the bundled dcc-cua/ui-control reference is task-scoped UI integration rather than broad peer-skill enumeration.","label":"Instruction Scope","name":"instruction_scope","rating":"note"},{"detail":"Persistence is described for jobs, feedback, recordings, registry state, and optional memory stores, but it is routed through bounded core mechanisms, operator-managed durable storage, and privacy-sensitive disablement rather than hidden or unbounded persistence.","label":"Persistence & Privilege","name":"persistence_privilege","rating":"note"},{"detail":"The stated purpose is to build or modernize DCC-MCP adapters and standalone studio MCP services; Bash/Read/Write/Edit are proportionate for source edits and validation in an owner project.","label":"Purpose & Capability","name":"purpose_capability","rating":"ok"}],"guidance":"Install this only if you want an agent to modify DCC-MCP adapter or internal-service projects. Review any generated service, gateway, UI-control, install, memory, or feedback changes before running them, and keep credentials in the owner’s secret store or environment as the skill itself recommends.","findings":"[AE1] expected: The referenced local documentation files were present and inspected; the wildcard reference is ordinary bundled guidance for this development skill, not remote payload retrieval or evasion.\n[AS3] expected: The scanner matched homepage/reference metadata and a scoped instruction to use the bundled UI skill for UI workflows; the artifact does not instruct broad enumeration or reading of arbitrary installed skills.","agenticRiskFindings":null,"riskSummary":null,"model":null,"checkedAt":1792124145268}}}}}