228cf86e3b9a37a332d5b584cbd073327db7982c7f888ba07713957a6","contentType":"text/markdown"}],"security":{"status":"clean","hasWarnings":true,"checkedAt":1790938141666,"model":null,"hasScanResult":true,"sha256hash":"58867a80d460c5985aae47a273db91f35bd75a504137a1873497fb74d391c33a","virustotalUrl":"https://www.virustotal.com/gui/file/58867a80d460c5985aae47a273db91f35bd75a504137a1873497fb74d391c33a","scanners":{"vt":{"status":"clean","verdict":null,"normalizedStatus":"clean","analysis":null,"source":"engines","checkedAt":1790938016675},"skillspector":{"status":"clean","normalizedStatus":"clean","score":0,"severity":"LOW","recommendation":"CAUTION","issueCount":0,"checkedAt":1790938141666},"llm":{"status":"clean","verdict":"benign","normalizedStatus":"clean","confidence":"high","summary":"This Google Forms skill is a disclosed Maton integration that uses managed OAuth and clearly requires user approval for writes, connections, hosted functions, and persistent automations.","dimensions":[{"detail":"The skill needs network access, a Maton account, OAuth authorization, and may access Google Forms data through the connected account; these are expected for its purpose and are disclosed.","label":"Credentials","name":"environment_proportionality","rating":"note"},{"detail":"Installation uses pinned Maton CLI/SDK package versions via npm, Homebrew, pip, or npm SDKs; this is proportionate for an API integration but users should trust the Maton tooling they install.","label":"Install Mechanism","name":"install_mechanism","rating":"note"},{"detail":"Instructions repeatedly limit default behavior to read/list calls, require explicit approval for writes and connection creation, and treat unrelated endpoints, local execution, and third-party destinations as out of scope unless the user asks specifically.","label":"Instruction Scope","name":"instruction_scope","rating":"ok"},{"detail":"OAuth tokens are stored in the OS credential store, and optional hosted functions/triggers/destinations can persist until deleted; the artifact discloses this and requires explicit user approval and cleanup guidance.","label":"Persistence & Privilege","name":"persistence_privilege","rating":"note"},{"detail":"The stated purpose is Google Forms access through Maton; documented capabilities cover reading forms and responses, creating forms/questions, and optional user-approved automation around those actions.","label":"Purpose & Capability","name":"purpose_capability","rating":"ok"}],"guidance":"Install only if you intend to use Maton for Google Forms. Review OAuth scopes, prefer read-only access when possible, confirm every write or automation before it runs, and be especially careful with triggers or destinations because they can create ongoing data forwarding.","findings":null,"agenticRiskFindings":null,"riskSummary":null,"model":null,"checkedAt":1790938141666}}}}}