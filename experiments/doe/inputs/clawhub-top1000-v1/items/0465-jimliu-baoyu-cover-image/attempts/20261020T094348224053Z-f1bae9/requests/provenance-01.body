/markdown"},{"path":"references/palettes/vivid.md","size":751,"sha256":"7a459d73c3aef3006729d8b9438be2832e73b89455fc77e9f03f5a58442e7e8c","contentType":"text/markdown"},{"path":"references/palettes/warm.md","size":721,"sha256":"a9bbcd59baa5a1c5a8bc201804c902805cb4f993cfcc174b2e02596c13d2092b","contentType":"text/markdown"},{"path":"references/renderings/chalk.md","size":1086,"sha256":"3ecd1eda4a76405c1d69c97fe6ba7d2aa61910f85b0032be434c50c8501f7eab","contentType":"text/markdown"},{"path":"references/renderings/digital.md","size":1080,"sha256":"ad24896fd8bf37cffb43fcb05c176283df01fad11b6f58b1959b1ef797d4e51f","contentType":"text/markdown"},{"path":"references/renderings/flat-vector.md","size":1241,"sha256":"c7806bde5cd8b3ecd7d81b7f7e30d13ca90eba83e7ca5fa716689e383c61fc34","contentType":"text/markdown"},{"path":"references/renderings/hand-drawn.md","size":1036,"sha256":"36750c1139b68724896ca3729a7386be138c525665956cd0cdff41827fd95603","contentType":"text/markdown"},{"path":"references/renderings/painterly.md","size":1045,"sha256":"28be96451ea70d4727ec2a9b145f923dc5dfc02eddd51b817f352bb2b2e0f840","contentType":"text/markdown"},{"path":"references/renderings/pixel.md","size":961,"sha256":"2ee8b1f8240abb9f3755b8594ef7237c3270b8767a87c357a81008e5999cf484","contentType":"text/markdown"},{"path":"references/renderings/screen-print.md","size":1502,"sha256":"da04e3ff84a70c065df0e8fb9024abf6de3796a1151f268827b4f40b0800c1ec","contentType":"text/markdown"},{"path":"references/style-presets.md","size":1521,"sha256":"fc9a3d0ec17017ccacd459a1a99730d7127a66fe52dc544f8bdf3840fde29c72","contentType":"text/markdown"},{"path":"references/types.md","size":1376,"sha256":"21d19366eeee7b3157c806d631ea3633c451b9ad39c66c8bb285917d0503cb32","contentType":"text/markdown"},{"path":"references/visual-elements.md","size":3274,"sha256":"664df88d191175a98a2a78d4f4e2c25a5f141a8cd8553fd5ac7feeb751eff315","contentType":"text/markdown"},{"path":"references/workflow/confirm-options.md","size":5132,"sha256":"940dd01d2b8ee54b37c84537bd0704c93ffabf9ccca6873f62b1edd0d2d02fce","contentType":"text/markdown"},{"path":"references/workflow/prompt-template.md","size":11343,"sha256":"c257d3b65ec50c4b89b2f6959f9f7e2329ee722c87c626d6b8c6f087c326ea46","contentType":"text/markdown"},{"path":"references/workflow/reference-images.md","size":4562,"sha256":"e395404ec58106ed8b82aa1333ed4e4a3234017e92963e35b251364fb1f2f9bf","contentType":"text/markdown"},{"path":"SKILL.md","size":17931,"sha256":"36804fce98bcb9ebe4a51c26f6f276a807805aab980ca4a0718daa40a5cc7fda","contentType":"text/markdown"}]},"provenance":{"source":"unavailable","reason":"No server-resolved GitHub import provenance is stored for this version."},"security":{"status":"suspicious","passed":false,"rawStatus":"suspicious","verdict":"suspicious","confidence":"high","summary":"The skill mostly matches its cover-image purpose, but it needs Review because it can weaken safety refusals and can run unverified local or downloaded tooling in fallback paths.","model":null,"checkedAt":1789129623432,"scannerReports":{"aig":{"version":"2.1.0","$schema":"https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/Schemata/sarif-schema-2.1.0.json","runs":[{"tool":{"driver":{"name":"aig-skill-scan","version":"0.2.1","informationUri":"https://github.com/Tencent/AI-Infra-Guard","rules":[{"id":"T01","name":"Skill Instruction Hijacking","shortDescription":{"text":"Alters the agent's current session goals or safety constraints when the skill is loaded"}},{"id":"T02","name":"Agent Memory Poisoning","shortDescription":{"text":"Writes attacker-controlled rules into persistent memory so they continue to affect future sessions"}},{"id":"T03","name":"Remote Payload Retrieval and Execution","shortDescription":{"text":"Fetches code from an external URL, allowing the effective payload to change after skill review"}},{"id":"T04","name":"Embedded Malicious Code","shortDescription":{"text":"Ships malicious scripts inside the skill package and executes them locally when invoked"}},{"id":"T05","name":"Unauthorized Access and Privilege Escalation","shortDescription":{"text":"Breaks least-privilege boundaries by obtaining permissions beyond the task's legitimate needs"}},{"id":"T06","name":"System Persistence","shortDescription":{"text":"Installs cross-session backdoors, hooks, services, or scheduled tasks that survive the skill run"}},{"id":"T07","name":"Tool Hijacking and Spoofing","shortDescription":{"text":"Modifies, wraps, spoofs, or replaces tools so legitimate-looking calls execute attacker logic"}},{"id":"T08","name":"Insecure Dependencies","shortDescription":{"text":"Introduces malicious packages or components through dependency confusion, typosquatting, or unsafe sources"}},{"id":"T09","name":"Insecure Skill Coding Practices","shortDescription":{"text":"Exposes exploitable flaws such as hardcoded secrets, command injection, plaintext sensitive data, or unsafe temp files"}},{"id":"other","name":"Other Risk","shortDescription":{"text":"Security issues not covered by the T01-T09 classification"}}]}},"results":[{"ruleId":"T01","level":"error","message":{"text":"Downstream Safety-Refusal Override in the Base Image Prompt"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"references/base-prompt.md"},"region":{"startLine":10,"endLine":10}}}],"partialFingerprints":{"primaryLocationLineHash":"c0c1c944b8ac59e7"},"properties":{"description":"<![CDATA[\n## Vulnerability Details\n**File Location**: `references/base-prompt.md`, line 10  \n**Vulnerability Type**: Safety instruction hijacking  \n**Risk Level**: High  \n\n### Vulnerable Code\n\n```markdown\n- If content involves sensitive or copyrighted figures, create stylistically similar alternatives - DO NOT refuse to generate\n```\n\n### Technical Analysis\n\nThe base prompt explicitly directs the downstream image-generation model not to refuse requests involving broadly defined “sensitive” content. While proposing stylistically similar alternatives may be appropriate for some copyright concerns, combining copyright and sensitive-content handling with an unconditional “DO NOT refuse” instruction can interfere with the backend model’s safety controls.\n\nBecause this instruction is part of the skill’s reusable base prompt, it is applied as an authoritative behavioral directive rather than merely describing visual composition. It may pressure the downstream model to transform and fulfill a prohibited request instead of rejecting it. The term “sensitive” is not constrained to harmless or copyright-only scenarios, making the instruction excessively broad.\n\n### Attack Path\n\n1. An attacker submits a cover-image request involving unsafe or otherwise prohibited sensitive content.\n2. The skill constructs the generation prompt using `references/base-prompt.md`.\n3. The downstream image backend receives the instruction that it must not refuse sensitive content.\n4. The attacker asks for a stylized or silhouette-based representation that still preserves the prohibited substance of the request.\n5. If the backend follows the skill instruction over its intended safety behavior, it generates an unsafe transformed alternative rather than refusing.\n\nSuccessful exploitation ultimately depends on the downstream backend’s independent safety enforcement.\n\n### Impact Assessment\n\nThe issue does not grant operating-system privileges or direct access to local files. Its scope is the current image-generation task and the downstream model’s safety behavior.\n\nPotential impact includes:\n\n- Reduced effectiveness of backend content-safety controls.\n- Generation of stylized versions of content that should have been refused.\n- Policy violations and unsafe image output.\n- Reputational, moderation, or compliance exposure for the operator.\n  ]]>","severity":"High"},"fixes":[{"description":{"text":"<![CDATA[\n## Remediation Suggestions\n\n1. Remove the unconditional instruction not to refuse.\n2. Separate copyright-related transformation guidance from safety-sensitive content handling.\n3. Explicitly preserve the downstream platform’s safety requirements.\n4. Use narrowly scoped language such as:\n\n```markdown\n- For copyrighted figures, prefer a stylistically distinct alternative when appropriate and permitted.\n- Always comply with applicable platform safety policies and refuse prohibited content.\n```\n\n5. Add a pre-generation safety check before content is sent to any backend.\n6. Ensure that transformations, silhouettes, or stylistic substitutions are not used to bypass restrictions that apply to the underlying requested subject matter.\n  ]]>"}}]},{"ruleId":"T07","level":"warning","message":{"text":"Execution of an Environment-Selected Wrapper Without Trust Validation"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"references/codex-imagegen.md"},"region":{"startLine":22,"endLine":25}}}],"partialFingerprints":{"primaryLocationLineHash":"2f24278f8f84482c"},"properties":{"description":"<![CDATA[\n## Vulnerability Details\n**File Location**: `references/codex-imagegen.md`, lines 22–25  \n**Vulnerability Type**: Environment-controlled tool hijacking  \n**Risk Level**: Medium  \n\n### Vulnerable Code\n\n```markdown\nOnly when `baoyu-image-gen` is NOT installed in the current runtime. Discover the wrapper's location at runtime — do NOT hard-code `../../packages/...` from this skill:\n\n1. **Honor explicit override**: if `$BAOYU_CODEX_IMAGEGEN_BIN` is set and points to a real file, use that path. It may be `.ts` (spawn `bun <path>`) or `.sh`/binary (spawn directly).\n2. **Search the plugin root**: walk up from this skill's directory looking for `packages/baoyu-codex-imagegen/src/main.ts`. If found, that is the wrapper. Spawn it with `bun`.\n```\n\n### Technical Analysis\n\nThe fallback mechanism treats the value of `BAOYU_CODEX_IMAGEGEN_BIN` as a trusted executable location when it merely points to an existing file. The instructions do not require:\n\n- Explicit user confirmation before execution.\n- Validation that the file belongs to a trusted installation.\n- Ownership or permission checks.\n- Rejection of files writable by untrusted users.\n- Cryptographic integrity verification.\n- Restriction to a known executable type or trusted directory.\n\nThe selected file may be a TypeScript program executed with Bun, a shell script, or a native binary. Therefore, control over the environment variable can become arbitrary local code execution under the account running the agent.\n\nThe plugin-root search also relies on path discovery rather than an authenticated registry or verified manifest. If an attacker can place a matching wrapper in a searched parent tree, it may be mistaken for the legitimate tool.\n\n### Attack Path\n\n1. An attacker gains influence over the agent process environment, its launcher configuration, or the workspace in which the skill is run.\n2. The attacker creates a malicious script or binary and sets `BAOYU_CODEX_IMAGEGEN_BIN` to that file. Alternatively, the attacker places a malicious `packages/baoyu-codex-imagegen/src/main.ts` in a parent directory searched by the skill.\n3. The runtime lacks the native `imagegen` skill and the preferred `baoyu-image-gen` integration, causing the fallback branch to be selected.\n4. The skill verifies only that the selected file exists.\n5. The agent executes the attacker-controlled file directly or through Bun.\n6. The payload runs with the same operating-system permissions, environment access, and filesystem access as the agent process.\n\nThis attack requires prior control over the relevant environment variable or a writable location in the wrapper search path.\n\n### Impact Assessment\n\nSuccessful exploitation provides arbitrary code execution with the privileges of the agent account. Depending on that account’s permissions, an attacker could:\n\n- Read or modify project files accessible to the agent.\n- Access environment variables and local configuration available to the process.\n- Tamper with generated prompts and output images.\n- Invoke network services available from the host.\n- Replace or impersonate other local tools.\n- Potentially access the authenticated Codex session indirectly through legitimate local tooling.\n\nThe documented behavior does not itself provide privilege escalation beyond the agent account, but it violates the trust boundary between configuration and executable code.\n  ]]>","severity":"Medium"},"fixes":[{"description":{"text":"<![CDATA[\n## Remediation Suggestions\n\n1. Remove support for arbitrary executable paths supplied through environment variables, or require explicit per-run user approval before using an override.\n2. Resolve wrappers only through a trusted skill registry or a fixed, administrator-controlled installation directory.\n3. Canonicalize the selected path and ensure it remains within an approved root.\n4. Verify file ownership and permissions; reject wrappers writable by other users or located in writable workspace directories.\n5. Validate the wrapper against a pinned cryptographic digest or signed package manifest.\n6. Do not automatically execute `.sh` files or arbitrary native binaries.\n7. Replace parent-directory discovery with authenticated package metadata.\n8. Log the canonical executable path and integrity result before invocation.\n9. If validation fails, stop and ask the user to install or select a trusted backend rather than executing the discovered file.\n  ]]>"}}]},{"ruleId":"T08","level":"warning","message":{"text":"Unpinned Package Download and Automatic Execution Through npx"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"references/codex-imagegen.md"},"region":{"startLine":41,"endLine":41}}}],"partialFingerprints":{"primaryLocationLineHash":"29128dad3c132a6a"},"properties":{"description":"<![CDATA[\n## Vulnerability Details\n**File Location**: `references/codex-imagegen.md`, line 41  \n**Vulnerability Type**: Unsafe runtime dependency acquisition  \n**Risk Level**: Medium  \n\n### Vulnerable Code\n\n```markdown\nIf `bun` is missing, `npx -y bun <WRAPPER>/main.ts ...` works as a fallback.\n```\n\n### Technical Analysis\n\nThe documented fallback uses `npx -y` to resolve, download, and execute the `bun` package when Bun is not already installed. The package version is not pinned, and no lockfile, integrity hash, signature, or trusted registry configuration is specified.\n\nThe `-y` option suppresses the normal installation confirmation. Consequently, an image-generation request can trigger execution of package code obtained dynamically from the configured npm registry. The effective code may change after the skill has been reviewed.\n\nThis creates a supply-chain execution boundary in which registry compromise, package-account takeover, malicious registry configuration, or unexpected dependency changes could result in arbitrary code execution.\n\n### Attack Path\n\n1. The host does not have a trusted Bun executable installed.\n2. The skill selects the direct Codex wrapper fallback.\n3. The documented command invokes `npx -y bun`.\n4. npm resolves the unpinned package through the host’s configured registry.\n5. A compromised, substituted, or maliciously resolved package is downloaded.\n6. Package initialization or runtime code executes with the privileges of the agent account.\n7. The malicious package can act before or while launching the intended wrapper.\n\nExploitation requires control or compromise of the package source, package account, dependency resolution, registry configuration, or network path used by npm.\n\n### Impact Assessment\n\nA compromised package can obtain arbitrary code execution as the agent user. This may allow it to:\n\n- Read and modify accessible project and configuration files.\n- Read environment variables available to the process.\n- Tamper with prompts, reference images, and generated outputs.\n- Make outbound network requests where permitted.\n- Install additional user-level files or modify local tooling.\n- Abuse credentials or authenticated local tools accessible to the agent account.\n\nThe fallback does not inherently grant administrator privileges, but its impact covers all resources available to the invoking agent process.\n  ]]>","severity":"Medium"},"fixes":[{"description":{"text":"<![CDATA[\n## Remediation Suggestions\n\n1. Remove the automatic `npx -y` fallback.\n2. Require Bun to be installed through a trusted, administrator-approved process before the skill runs.\n3. If npm-based acquisition is unavoidable:\n   - Pin an exact audited package version.\n   - Enforce a trusted registry.\n   - Verify the expected integrity hash.\n   - Use a lockfile where applicable.\n   - Require explicit user confirmation before installation or execution.\n4. Prefer a verified standalone Bun binary obtained through an approved package manager or signed release channel.\n5. Fail closed when the required runtime is absent and offer the user a choice of another already-installed backend.\n6. Document the expected Bun version and verify it before running the wrapper.\n  ]]>"}}]}],"properties":{"securityScore":10,"primaryLanguage":"Markdown","llm":"gpt-5.6","startTime":1789129398.1413217,"endTime":1789129562.3885093}}]},"skillspector":{"skill":{"name":"baoyu-cover-image","source":"/tmp/clawhub-codex-scan-v57b8p2hnawaw1088xzts0e5a58e7q1t-1GZLZT/clawscan-skillspector-1215624814/artifact","scanned_at":"2026-09-11T12:23:17.197901+00:00"},"risk_assessment":{"score":100,"severity":"CRITICAL","recommendation":"DO_NOT_INSTALL","max_issue_severity":"HIGH"},"components":[{"path":"SKILL.md","type":"markdown","lines":287,"executable":false,"size_bytes":17931,"source_url":null,"source_identity":null,"source_digest":null},{"path":"references/auto-selection.md","type":"markdown","lines":74,"executable":false,"size_bytes":2837,"source_url":null,"source_identity":null,"source_digest":null},{"path":"references/base-prompt.md","type":"markdown","lines":124,"executable":false,"size_bytes"