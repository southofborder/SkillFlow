ext/markdown"},{"path":"technical.md","size":8909,"sha256":"cd34f1e3bcb92ee4bf410ea1bc0d6ed0009dcdcb0e82e574ecbdae5dbaeb2367","contentType":"text/markdown"},{"path":"skill-card.md","size":2306,"sha256":"cd9793ad7e58eab0c2e41de1a928be03224744dcbdf6debcb889eb171d697968","contentType":"text/markdown"}],"security":{"status":"clean","hasWarnings":true,"checkedAt":1789055360682,"model":null,"hasScanResult":true,"sha256hash":"65ce4556a3ccd687b504f033c2659a1df1f43203b34364c9d4c500dfe0e43c9d","virustotalUrl":"https://www.virustotal.com/gui/file/65ce4556a3ccd687b504f033c2659a1df1f43203b34364c9d4c500dfe0e43c9d","scanners":{"vt":{"status":"clean","verdict":null,"normalizedStatus":"clean","analysis":null,"source":"engines","checkedAt":1784978511782},"skillspector":{"status":"suspicious","normalizedStatus":"suspicious","score":31,"severity":"MEDIUM","recommendation":"CAUTION","issueCount":6,"checkedAt":1789055360682},"llm":{"status":"clean","verdict":"benign","normalizedStatus":"clean","confidence":"high","summary":"This SEO skill is a documentation-based assistant that stores disclosed local SEO preferences and history, with no evidence of hidden execution or data theft.","dimensions":[{"detail":"It reads SEO-specific local files and may use user-provided site/Search Console data, which is proportionate for SEO work but can include business-sensitive context.","label":"Credentials","name":"environment_proportionality","rating":"note"},{"detail":"The package consists of Markdown and metadata files; no executable installer, dependency fetch, remote payload, or automatic related-skill installation was found.","label":"Install Mechanism","name":"install_mechanism","rating":"ok"},{"detail":"It tells the agent to use defaults and not start with broad preflight questions; that is scoped to SEO workflow efficiency, not a hidden override or unsafe autonomy.","label":"Instruction Scope","name":"instruction_scope","rating":"note"},{"detail":"Persistent storage under ~/Clawic/data/seo/ is explicitly disclosed, limited to SEO config, site profiles, audits, content drafts, and observed work context; it should remain user-reviewable.","label":"Persistence & Privilege","name":"persistence_privilege","rating":"note"},{"detail":"The skill's guidance for audits, keyword research, content, technical SEO, schema, links, and Search Console work matches its stated SEO purpose.","label":"Purpose & Capability","name":"purpose_capability","rating":"ok"}],"guidance":"Before installing, understand that the skill may keep SEO preferences, site profiles, audit history, keyword tracking, and drafts under ~/Clawic/data/seo/. Review or delete that folder if you do not want prior business context reused, and avoid asking it to store confidential strategy unless that persistence is desired.","findings":"[EA2] expected: The cited phrases appear in SEO trap guidance and audit-deliverable wording, not instructions to autonomously perform destructive or high-impact actions.\n[SQP-2] expected: The persistence concern is real enough for user awareness, but the storage location and categories are disclosed in SKILL.md and setup.md, and writes are limited to declared preferences or observed SEO work context.\n[SQP-3] expected: The locale defaults are configurable SEO defaults and examples, not covert discrimination or fixed user targeting; users can set their target market.","agenticRiskFindings":null,"riskSummary":null,"model":null,"checkedAt":1789055360682}}}}}