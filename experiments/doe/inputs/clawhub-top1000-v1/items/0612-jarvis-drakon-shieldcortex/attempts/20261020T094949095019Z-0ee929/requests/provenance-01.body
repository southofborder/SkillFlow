{"schema":"clawhub.skill.verify.v1","ok":false,"decision":"fail","reasons":["security.status_not_clean"],"slug":"shieldcortex","displayName":"ShieldCortex","pageUrl":"https://clawhub.ai/jarvis-drakon/skills/shieldcortex","publisherHandle":"jarvis-drakon","publisherDisplayName":"jarvis-drakon","publisherProfileUrl":"https://clawhub.ai/jarvis-drakon","version":"5.10.6","resolvedFrom":"version","tag":null,"createdAt":1792479087248,"card":{"available":true,"path":"skill-card.md","url":"https://wry-manatee-359.convex.site/api/v1/skills/shieldcortex/card?ownerHandle=jarvis-drakon&version=5.10.6","sha256":"22bcbe9a292500495bb0568d38e1450ee7337f7bd3736cc57cfd6ec2654b4d1a","size":2459,"contentType":"text/markdown; charset=utf-8"},"artifact":{"sourceFingerprint":"5083250886aa11f7b54e06246d6308662e6332944e1a55bf66046ea76a53c446","bundleFingerprints":["e03367df86543a5103440e01c5a36708177bf9507972d5d8430a39b849969c6a"],"files":[{"path":"SKILL.md","size":32169,"sha256":"9a76009e6917caf536c09328723ba400fdfa8ae5ca02d202253c71a8a0736c34","contentType":"text/markdown"},{"path":"bundled/cortex-memory-hook/HOOK.md","size":8053,"sha256":"5ce164c986240e65ed54c76f86ad3eca9c2592564f3b4e0fcdd7230fd21e5c29","contentType":"text/markdown"},{"path":"bundled/cortex-memory-hook/handler.ts","size":47661,"sha256":"6e70b9d15262076071c86e0a9b94133517297a2bb3d1a5b2f398c346ba450d54","contentType":"video/mp2t"},{"path":"bundled/cortex-memory-hook/runtime.mjs","size":9228,"sha256":"18a53c5f0ef71d7887cae036dd12dd992fb64c9658dfb501ee40f05b1200beef","contentType":"text/javascript"},{"path":"bundled/openclaw-plugin/cloud-sync.js","size":1371,"sha256":"eb55aa7e0fcaaf96d264f4214fa416b1948af88fca69fd11c900af91690994f0","contentType":"text/javascript"},{"path":"bundled/openclaw-plugin/index.js","size":30414,"sha256":"c462af072d1b8e54da41b272e98aebd219f61b73123d01f91ba371a16b793682","contentType":"text/javascript"},{"path":"bundled/openclaw-plugin/intercept-ingest.js","size":936,"sha256":"1b968839aedfbc04d021dd44