{
  "$defs": {
    "CandidateTask": {
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "$ref": "#/$defs/TaskPurpose"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/TaskRequirement"
          },
          "minItems": 1,
          "title": "Requirements",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/TaskIssue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "purpose",
        "requirements",
        "issues"
      ],
      "title": "CandidateTask",
      "type": "object"
    },
    "TaskEvidence": {
      "additionalProperties": false,
      "description": "An exact physical span with an unverified relevance explanation.",
      "properties": {
        "file": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line",
        "reason"
      ],
      "title": "TaskEvidence",
      "type": "object"
    },
    "TaskIssue": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "conflict",
            "ambiguity"
          ],
          "title": "Kind",
          "type": "string"
        },
        "evidences": {
          "items": {
            "$ref": "#/$defs/TaskEvidence"
          },
          "minItems": 1,
          "title": "Evidences",
          "type": "array"
        },
        "requirement_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        },
        "resolution": {
          "enum": [
            "resolved",
            "unresolved"
          ],
          "title": "Resolution",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "evidences",
        "requirement_ids",
        "resolution",
        "reason"
      ],
      "title": "TaskIssue",
      "type": "object"
    },
    "TaskPurpose": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "evidences": {
          "items": {
            "$ref": "#/$defs/TaskEvidence"
          },
          "minItems": 1,
          "title": "Evidences",
          "type": "array"
        }
      },
      "required": [
        "text",
        "evidences"
      ],
      "title": "TaskPurpose",
      "type": "object"
    },
    "TaskRequirement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "evidences": {
          "items": {
            "$ref": "#/$defs/TaskEvidence"
          },
          "minItems": 1,
          "title": "Evidences",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "evidences"
      ],
      "title": "TaskRequirement",
      "type": "object"
    },
    "_FailureResponse": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "const": "cannot_assess",
          "title": "Outcome"
        },
        "failure": {
          "$ref": "#/$defs/_TaskFailure"
        }
      },
      "required": [
        "outcome",
        "failure"
      ],
      "title": "_FailureResponse",
      "type": "object"
    },
    "_TaskFailure": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "evidences": {
          "items": {
            "$ref": "#/$defs/TaskEvidence"
          },
          "minItems": 1,
          "title": "Evidences",
          "type": "array"
        }
      },
      "required": [
        "reason",
        "evidences"
      ],
      "title": "_TaskFailure",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/CandidateTask"
    },
    {
      "$ref": "#/$defs/_FailureResponse"
    }
  ]
}