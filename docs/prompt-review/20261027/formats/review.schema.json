{
  "$defs": {
    "BlockTarget": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Block Id",
          "type": "string"
        },
        "path": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "minimum": 0,
                "type": "integer"
              }
            ]
          },
          "title": "Path",
          "type": "array"
        }
      },
      "required": [
        "block_id",
        "path"
      ],
      "title": "BlockTarget",
      "type": "object"
    },
    "CFGEvidence": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/OperandRef"
            },
            {
              "$ref": "#/$defs/InstructionTarget"
            },
            {
              "$ref": "#/$defs/BlockTarget"
            },
            {
              "$ref": "#/$defs/GraphTarget"
            }
          ],
          "title": "Target"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "target",
        "reason"
      ],
      "title": "CFGEvidence",
      "type": "object"
    },
    "CannotAssessResponse": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "const": "cannot_assess",
          "title": "Outcome"
        },
        "failure": {
          "$ref": "#/$defs/ReviewFailure"
        }
      },
      "required": [
        "outcome",
        "failure"
      ],
      "title": "CannotAssessResponse",
      "type": "object"
    },
    "GraphTarget": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "minimum": 0,
                "type": "integer"
              }
            ]
          },
          "title": "Path",
          "type": "array"
        }
      },
      "required": [
        "path"
      ],
      "title": "GraphTarget",
      "type": "object"
    },
    "InstructionTarget": {
      "additionalProperties": false,
      "properties": {
        "instruction_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Instruction Id",
          "type": "string"
        },
        "path": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "minimum": 0,
                "type": "integer"
              }
            ]
          },
          "title": "Path",
          "type": "array"
        }
      },
      "required": [
        "instruction_id",
        "path"
      ],
      "title": "InstructionTarget",
      "type": "object"
    },
    "OperandRef": {
      "additionalProperties": false,
      "properties": {
        "instruction_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Instruction Id",
          "type": "string"
        },
        "side": {
          "enum": [
            "input",
            "output"
          ],
          "title": "Side",
          "type": "string"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        }
      },
      "required": [
        "instruction_id",
        "side",
        "index"
      ],
      "title": "OperandRef",
      "type": "object"
    },
    "RawDeclarationCheck": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "issue"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "finding_indexes": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Finding Indexes",
          "type": "array"
        },
        "raw_pointer": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Raw Pointer",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "finding_indexes",
        "raw_pointer"
      ],
      "title": "RawDeclarationCheck",
      "type": "object"
    },
    "RawFinding": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "enum": [
            "task",
            "annotation"
          ],
          "title": "Domain",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Ids",
          "type": "array"
        },
        "explanation": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation",
          "type": "string"
        },
        "evidences": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TaskEvidence"
              },
              {
                "$ref": "#/$defs/CFGEvidence"
              },
              {
                "$ref": "#/$defs/RuleEvidence"
              }
            ]
          },
          "minItems": 1,
          "title": "Evidences",
          "type": "array"
        },
        "suggestion": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Suggestion",
          "type": "string"
        },
        "task_objection": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskRepairObjection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "domain",
        "target_ids",
        "explanation",
        "evidences",
        "suggestion"
      ],
      "title": "RawFinding",
      "type": "object"
    },
    "RawRequirementCheck": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "accepted",
            "issue"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "finding_indexes": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "title": "Finding Indexes",
          "type": "array"
        },
        "requirement_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Requirement Id",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "finding_indexes",
        "requirement_id"
      ],
      "title": "RawRequirementCheck",
      "type": "object"
    },
    "RawReviewResponse": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "const": "completed",
          "title": "Outcome"
        },
        "requirement_checks": {
          "items": {
            "$ref": "#/$defs/RawRequirementCheck"
          },
          "minItems": 1,
          "title": "Requirement Checks",
          "type": "array"
        },
        "declaration_checks": {
          "items": {
            "$ref": "#/$defs/RawDeclarationCheck"
          },
          "title": "Declaration Checks",
          "type": "array"
        },
        "reviewed_ir_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Reviewed Ir Ids",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/RawFinding"
          },
          "title": "Findings",
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "requirement_checks",
        "declaration_checks",
        "reviewed_ir_ids",
        "findings"
      ],
      "title": "RawReviewResponse",
      "type": "object"
    },
    "ReviewFailure": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Ids",
          "type": "array"
        },
        "evidences": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TaskEvidence"
              },
              {
                "$ref": "#/$defs/CFGEvidence"
              },
              {
                "$ref": "#/$defs/RuleEvidence"
              }
            ]
          },
          "minItems": 1,
          "title": "Evidences",
          "type": "array"
        }
      },
      "required": [
        "reason",
        "target_ids",
        "evidences"
      ],
      "title": "ReviewFailure",
      "type": "object"
    },
    "RuleEvidence": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Rule Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "reason"
      ],
      "title": "RuleEvidence",
      "type": "object"
    },
    "TaskEvidence": {
      "additionalProperties": false,
      "description": "An exact physical span with an unverified relevance explanation.",
      "properties": {
        "file": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line",
        "reason"
      ],
      "title": "TaskEvidence",
      "type": "object"
    },
    "TaskRepairObjection": {
      "additionalProperties": false,
      "description": "No explanations, graph targets, demands, or arbitrary feedback context.",
      "properties": {
        "code": {
          "enum": [
            "missing_requirement",
            "unsupported_requirement",
            "broadened_requirement",
            "condition_scope",
            "atomicity",
            "conflict_resolution"
          ],
          "title": "Code",
          "type": "string"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/TaskSourceSpan"
          },
          "minItems": 1,
          "title": "Source Spans",
          "type": "array"
        },
        "requirement_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "source_spans",
        "requirement_ids"
      ],
      "title": "TaskRepairObjection",
      "type": "object"
    },
    "TaskSourceSpan": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line"
      ],
      "title": "TaskSourceSpan",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "cannot_assess": "#/$defs/CannotAssessResponse",
      "completed": "#/$defs/RawReviewResponse"
    },
    "propertyName": "outcome"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/RawReviewResponse"
    },
    {
      "$ref": "#/$defs/CannotAssessResponse"
    }
  ]
}