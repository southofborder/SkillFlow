{
  "$defs": {
    "FragmentSourceFinding": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "enum": [
            "cfg",
            "task",
            "annotation"
          ],
          "title": "Domain",
          "type": "string"
        },
        "target_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Ids",
          "type": "array"
        },
        "explanation": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "suggestion": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Suggestion",
          "type": "string"
        },
        "task_objection": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskRepairObjection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "owner": {
          "anyOf": [
            {
              "enum": [
                "processing",
                "task-correspondence",
                "sensitivity"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        }
      },
      "required": [
        "domain",
        "target_ids",
        "explanation",
        "source_refs",
        "suggestion"
      ],
      "title": "FragmentSourceFinding",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "TaskRepairObjection": {
      "additionalProperties": false,
      "description": "No explanations, graph targets, demands, or arbitrary feedback context.",
      "properties": {
        "code": {
          "enum": [
            "missing_requirement",
            "unsupported_requirement",
            "broadened_requirement",
            "condition_scope",
            "atomicity",
            "conflict_resolution"
          ],
          "title": "Code",
          "type": "string"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/TaskSourceSpan"
          },
          "minItems": 1,
          "title": "Source Spans",
          "type": "array"
        },
        "requirement_ids": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        }
      },
      "required": [
        "code",
        "source_spans",
        "requirement_ids"
      ],
      "title": "TaskRepairObjection",
      "type": "object"
    },
    "TaskSourceSpan": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line"
      ],
      "title": "TaskSourceSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "outcome": {
      "const": "completed",
      "title": "Outcome"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/FragmentSourceFinding"
      },
      "title": "Findings",
      "type": "array"
    }
  },
  "required": [
    "outcome",
    "findings"
  ],
  "title": "CompletedFragmentSourceReview",
  "type": "object"
}