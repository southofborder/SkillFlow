{
  "name": "skill-fcg-analyzer",
  "version": "1.0.0",
  "description": "Automated tool to analyze OpenClaw Skill data flow and build Function Call Graphs (FCG)",
  "main": "src/index.js",
  "bin": {
    "skill-fcg-analyzer": "src/index.js"
  },
  "scripts": {
    "analyze": "node src/index.js analyze",
    "batch-analyze": "node src/index.js batch-analyze",
    "fcg-batch": "node scripts/fcg-batch.js",
    "analyze-clawhub": "node scripts/analyze-clawhub.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [
    "openclaw",
    "skill",
    "fcg",
    "function-call-graph",
    "data-flow",
    "analysis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "adm-zip": "^0.5.10",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.0.0-rc.12",
    "graphlib": "^2.1.8",
    "gray-matter": "^4.0.3",
    "node-fetch": "^3.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
