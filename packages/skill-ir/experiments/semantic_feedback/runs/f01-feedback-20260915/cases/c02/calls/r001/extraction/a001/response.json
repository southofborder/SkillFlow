          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"status.txt\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"success\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"return_fast_fetch_retry_body\",\n          \"opcode\": \"return\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_fetch_retry_body\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"archive_fetch\",\n      \"block_name\": \"Call archive.fetch once with source_id\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"call_archive_fetch\",\n          \"opcode\": \"call_archive_fetch\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"archive.fetch\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"source_id_value\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"archive_fetch_body\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"archive_fetch_error\"\n            }\n          ],\n          \"constraints\": [\n            \"After a non-transient first failure or any failed retry of fast.fetch, call archive.fetch with source_id.\",\n            \"Call archive.fetch at most once and pass source_id as its only argument.\",\n            \"If archive.fetch fails, stop and return its error; do not retry archive.fetch.\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_check_archive_fetch_success\",\n          \"opcode\": \"dispatch\"\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"check_archive_fetch_success\",\n      \"block_name\": \"Check whether archive.fetch succeeded\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"check_archive_fetch_success\",\n          \"opcode\": \"check_archive_fetch_success\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"archive_fetch_error\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"archive_fetch_succeeded\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_on_archive_fetch_success\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"archive_fetch_succeeded\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"return_archive_fetch_success\",\n      \"block_name\": \"Append success status and return the archive.fetch response body\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"append_status_success_archive_fetch\",\n          \"opcode\": \"append_final_status_to_status_file\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"status.txt\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"success\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"return_archive_fetch_body\",\n          \"opcode\": \"return\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"archive_fetch_body\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"return_archive_fetch_failure\",\n      \"block_name\": \"Append failure 