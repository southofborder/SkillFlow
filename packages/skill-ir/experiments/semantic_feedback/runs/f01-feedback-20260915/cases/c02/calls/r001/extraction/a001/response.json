"{\n  \"entry_block_ref\": \"read_source_id\",\n  \"constraints\": [\n    \"On either tool's success, return that successful response's body value unchanged and make no further fetch calls.\",\n    \"Never pass FAST_KEY to archive.fetch or diagnostic output anywhere in this workflow.\",\n    \"Before returning from every success or failure path, append the final status to local status.txt.\"\n  ],\n  \"declared_context_keys\": [\n    \"source_id\",\n    \"FAST_KEY\"\n  ],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_source_id\",\n      \"block_name\": \"Read source_id from the user's request\",\n      \"data_source_kind\": \"context\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_source_id_from_request\",\n          \"opcode\": \"read_source_id_from_request\",\n          \"inputs\": [\n            {\n              \"type\": \"context_key\",\n              \"identifier\": \"source_id\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"source_id_value\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_read_fast_key\",\n          \"opcode\": \"dispatch\"\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"read_fast_key\",\n      \"block_name\": \"Read FAST_KEY from the environment\",\n      \"data_source_kind\": \"context\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_fast_key_from_environment\",\n          \"opcode\": \"read_fast_key_from_environment\",\n          \"inputs\": [\n            {\n              \"type\": \"context_key\",\n              \"identifier\": \"FAST_KEY\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_key_value\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_check_fast_key\",\n          \"opcode\": \"dispatch\"\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"check_fast_key\",\n      \"block_name\": \"Check whether FAST_KEY is present\",\n      \"data_source_kind\": null,\n      \"constraints\": [\n        \"If FAST_KEY is present, try fast.fetch first with source_id and FAST_KEY; if it is absent, go directly to archive.fetch without calling fast.fetch.\"\n      ],\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"check_fast_key_presence\",\n          \"opcode\": \"check_fast_key_presence\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_key_value\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_key_present\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_on_fast_key_presence\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_key_present\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"fast_fetch_first\",\n      \"block_name\": \"Try fast.fetch first with source_id and FAST_KEY\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"call_fast_fetch_first\",\n          \"opcode\": \"call_fast_fetch\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"fast.fetch\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"source_id_value\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_key_value\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_fetch_body\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_fetch_error\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_check_fast_fetch_first_success\",\n          \"opcode\": \"dispatch\"\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"check_fast_fetch_first_success\",\n      \"block_name\": \"Check whether the first fast.fetch attempt succeeded\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"check_fast_fetch_first_success\",\n          \"opcode\": \"check_fast_fetch_success\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_fetch_error\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_fetch_succeeded\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_on_fast_fetch_first_success\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_fetch_succeeded\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"check_fast_fetch_first_transient\",\n      \"block_name\": \"Check whether the first fast.fetch failure was transient\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"check_fast_fetch_first_transient\",\n          \"opcode\": \"check_transient_error\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_fetch_error\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_fetch_error_transient\"\n            }\n          ]\n        },\n   