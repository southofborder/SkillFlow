"{\n  \"direction\": \"source_to_graph\",\n  \"findings\": [\n    {\n      \"id\": \"finding_1\",\n      \"status\": \"represented\",\n      \"statement\": \"整个工作流应使用凭据门控的首选工具与有界归档回退来获取一个 source。\",\n      \"explanation\": \"图中先读取 source_id 与 FAST_KEY，再按 FAST_KEY 是否存在分支；存在时先进入 fast.fetch，失败后受控重试一次，随后回退到 archive.fetch，且 archive.fetch 没有重试边。该结构保留了凭据门控的首选工具与有界归档回退的总体方式。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 3,\n          \"end_line\": 3,\n          \"quote\": \"description: Fetch one source using a credential-gated preferred tool and a bounded archive fallback.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/entry_block_id\",\n        \"/declared_context_keys/0\",\n        \"/declared_context_keys/1\",\n        \"/blocks/block_001\",\n        \"/blocks/block_002\",\n        \"/blocks/block_003\",\n        \"/blocks/block_004\",\n        \"/blocks/block_008\",\n        \"/blocks/block_011\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_1\"\n      ],\n      \"basis\": [\n        \"explicit_graph\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_2\",\n      \"status\": \"represented\",\n      \"statement\": \"从用户请求读取 source_id，并从环境读取 FAST_KEY。\",\n      \"explanation\": \"block_001 的 ir_001 为 read_source_id_from_request，输入 context_key 为 source_id；block_002 的 ir_003 为 read_fast_key_from_environment，输入 context_key 为 FAST_KEY。两个上下文键也在根级 declared_context_keys 中声明。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 8,\n          \"end_line\": 8,\n          \"quote\": \"1. Read source_id from the user's request and read FAST_KEY from the environment.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/declared_context_keys/0\",\n        \"/declared_context_keys/1\",\n        \"/blocks/block_001/instructions/0\",\n        \"/blocks/block_002/instructions/0\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_2\"\n      ],\n      \"basis\": [\n        \"explicit_graph\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_3\",\n      \"status\": \"represented\",\n      \"statement\": \"若 FAST_KEY 存在，则先尝试调用 fast.fetch，并传入 source_id 与 FAST_KEY；若 FAST_KEY 不存在，则直接调用 archive.fetch，且不得调用 fast.fetch。\",\n      \"explanation\": \"block_003 的 check_fast_key_presence 消费 result_002，并通过 dispatch 使用 result_003；对应边将 FAST_KEY present 指向 block_004，将 FAST_KEY absent 指向 block_011。block_004 的 call_fast_fetch 输入包含 result_001 与 result_002；archive.fetch 额外参数问题另行报告。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 9,\n          \"end_line\": 9,\n          \"quote\": \"2. If FAST_KEY is present, try fast.fetch first with source_id and FAST_KEY; if it is absent, go directly to archive.fetch without calling fast.fetch.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_003/constraints/0\",\n        \"/blocks/block_003/instructions/0\",\n        \"/edges/2\",\n        \"/edges/3\",\n        \"/blocks/block_004/instructions/0\",\n        \"/blocks/block_011/instructions/0\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_3\"\n      ],\n      \"basis\": [\n        \"explicit_graph\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_4\",\n      \"status\": \"represented\",\n      \"statement\": \"仅当 fast.fetch 的第一次尝试以 transient error 失败时，才恰好重试 fast.fetch 一次；若第一次失败为非 transient error，则不得重试。\",\n      \"explanation\": \"block_005 将首次失败导向 block_007；block_007 的 check_transient_error 产出 result_007，对应边将 transient 指向 block_008，将 non-transient 指向 block_011。block_008 含单条 retry_fast_fetch 及其 exactly once 约束，且没有回到重试的边。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 10,\n          \"end_line\": 10,\n          \"quote\": \"3. Retry fast.fetch exactly once only when its first attempt fails with a transient error; do not retry a non-transient first failure.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_005/instructions/0\",\n        \"/edges/6\",\n        \"/blocks/block_007/instructions/0\",\n        \"/edges/7\",\n        \"/edges/8\",\n        \"/blocks/block_008/constraints/0\",\n        \"/blocks/block_008/instructions/0\",\n        \"/edges/9\",\n        \"/edges/10\",\n        \"/edges/11\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_4\"\n      ],\n      \"basis\": [\n        \"explicit_graph\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_5\",\n      \"status\": \"represented\",\n      \"statement\": \"在 fast.fetch 首次出现非 transient 失败，或任何一次 fast.fetch 重试失败之后，调用 archive.fetch 并传入 source_id。\",\n      \"explanation\": \"non-transient 失败边与 retry failed 边均指向 block_011；block_011 的 call_archive_fetch 输入包含 result_001，即 source_id_value。额外传入 result_002 的问题在后续冲突与新增 finding 中报告。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 11,\n          \"end_line\": 11,\n          \"quote\": \"4. After a non-transient first failure or any failed retry of fast.fetch, call archive.fetch with source_id.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/edges/8\",\n        \"/edges/11\",\n        \"/blocks/block_011/constraints/0\",\n        \"/blocks/block_011/instructions/0/inputs/1\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_5\"\n      ],\n      \"basis\": [\n        \"explicit_graph\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_6\",\n      \"status\": \"internal_conflict\",\n      \"statement\": \"最多调用 archive.fetch 一次，并且只将 source_id 作为其参数传入。\",\n      \"explanation\": \"图中只有一条 call_archive_fetch 指令，满足最多一次；但 block_011 的约束声明只传 source_id，而 ir_021 的实际输入除 result_001 外还包含 result_002 fast_key，约束与显式操作发生内部冲突。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 12,\n          \"end_line\": 12,\n          \"quote\": \"5. Call archive.fetch at most once and pass source_id as its only argument.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_011/constraints/1\",\n        \"/blocks/block_011/instructions/0\",\n        \"/blocks/block_011/instructions/0/inputs/2\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_6\"\n      ],\n      \"basis\": [\n        \"explicit_graph\",\n        \"declared_constraint\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_7\",\n      \"status\": \"represented\",\n      \"statement\": \"任一工具成功时，返回该成功响应的 body 值且不改变该值，并且不再发起任何进一步的 fetch 调用。\",\n      \"explanation\": \"首次 fast.fetch 成功路径在 block_006 返回 result_004，重试成功路径在 block_010 返回 result_008，archive.fetch 成功路径在 block_013 返回 result_011；这些 return 输入均为对应响应 body，且 return 所在块没有后继 fetch 边。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 13,\n          \"end_line\": 13,\n          \"quote\": \"6. On either tool's success, return that successful response's body value unchanged and make no further fetch calls.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/constraints/2\",\n        \"/edges/5\",\n        \"/blocks/block_006/instructions/1\",\n        \"/edges/10\",\n        \"/blocks/block_010/instructions/1\",\n        \"/edges/13\",\n        \"/blocks/block_013/instructions/1\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_7\"\n      ],\n      \"basis\": [\n        \"explicit_graph\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_8\",\n      \"status\": \"represented\",\n      \"statement\": \"若 archive.fetch 失败，则停止并返回其错误；不得重试 archive.fetch。\",\n      \"explanation\": \"archive.fetch failed 边指向 block_014；block_014 的 return 输入为 result_012 archive_fetch_error。图中没有 archive.fetch 重试指令或回到 archive.fetch 调用块的边，block_011 也声明不得重试 archive.fetch。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 14,\n          \"end_line\": 14,\n          \"quote\": \"7. If archive.fetch fails, stop and return its error; do not retry archive.fetch.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/edges/14\",\n        \"/blocks/block_011/constraints/2\",\n        \"/blocks/block_014/instructions/0\",\n        \"/blocks/block_014/instructions/1\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_8\"\n      ],\n      \"basis\": [\n        \"explicit_graph\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_9\",\n      \"status\": \"internal_conflict\",\n      \"statement\": \"在此工作流的任何位置，绝不将 FAST_KEY 传给 archive.fetch，也绝不将其传给诊断输出。\",\n      \"explanation\": \"根级约束声明绝不将 FAST_KEY 传给 archive.fetch 或 diagnostic output；图中未发现 diagnostic output 指令，但 ir_021 的 inputs 第 3 项为 result_002 fast_key，显式将 FAST_KEY 传给 call_archive_fetch，因而与同一图内的约束冲突。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 15,\n          \"end_line\": 15,\n          \"quote\": \"8. Never pass FAST_KEY to archive.fetch or diagnostic output anywhere in this workflow.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/constraints/0\",\n        \"/blocks/block_011/instructions/0/inputs/2\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_9\"\n      ],\n      \"basis\": [\n        \"explicit_graph\",\n        \"declared_constraint\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_10\",\n      \"status\": \"represented\",\n      \"statement\": \"在从每一条成功或失败路径返回之前，将最终状态追加到本地 status.txt。\",\n      \"explanation\": \"所有 return 指令所在块均先有 append_final_status_to_status_file：block_006、block_010、block_013 追加 success 后返回成功 body，block_014 追加 failure 后返回 archive.fetch 错误。根级约束也声明该要求。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 16,\n          \"end_line\": 16,\n          \"quote\": \"9. Before returning from every success or failure path, append the final status to local status.txt.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/constraints/1\",\n        \"/blocks/block_006/instructions/0\",\n        \"/blocks/block_006/instructions/1\",\n        \"/blocks/block_010/instructions/0\",\n        \"/blocks/block_010/instructions/1\",\n        \"/blocks/block_013/instructions/0\",\n        \"/blocks/block_013/instructions/1\",\n        \"/blocks/block_014/instructions/0\",\n        \"/blocks/block_014/instructions/1\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_10\"\n      ],\n      \"basis\": [\n        \"explicit_graph\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_11\",\n      \"status\": \"unsupported_addition\",\n      \"statement\": \"图中的 call_archive_fetch 将 result_002 fast_key 作为额外输入传给 archive.fetch。\",\n      \"explanation\": \"原文要求 archive.fetch 最多调用一次且只传 source_id，并明确禁止将 FAST_KEY 传给 archive.fetch；图中 ir_021 却包含 result_002 fast_key 输入，找不到支持该额外参数的业务来源。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 12,\n          \"end_line\": 12,\n          \"quote\": \"5. Call archive.fetch at most once and pass source_id as its only argument.\"\n        },\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 15,\n          \"end_line\": 15,\n          \"quote\": \"8. Never pass FAST_KEY to archive.fetch or diagnostic output anywhere in this workflow.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_011/instructions/0/inputs/2\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_6\",\n        \"req_9\"\n      ],\n      \"basis\": [\n        \"explicit_graph\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_12\",\n      \"status\": \"unknown\",\n      \"statement\": \"图中将最终状态字面量具体写为 success 与 failure。\",\n      \"explanation\": \"原文只要求把 final status 追加到本地 status.txt，没有规定状态文本的具体值；因此 success 与 failure 这两个字面量文本是否等价于原文要求，无法仅凭本次输入裁决。req_10 的追加动作与返回前顺序已在 finding_10 判定为保留。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 16,\n          \"end_line\": 16,\n          \"quote\": \"9. Before returning from every success or failure path, append the final status to local status.txt.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_006/instructions/0/inputs/1/literal_value\",\n        \"/blocks/block_010/instructions/0/inputs/1/literal_value\",\n        \"/blocks/block_013/instructions/0/inputs/1/literal_value\",\n        \"/blocks/block_014/instructions/0/inputs/1/literal_value\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_10\"\n      ],\n      \"basis\": [\n        \"insufficient\"\n      ],\n      \"unknown_reason\": \"原文未规定 final status 的具体文本，无法判定 success/failure 字面量是保留、改写还是新增。\"\n    }\n  ],\n  \"reviewed_requirement_ids\": [\n    \"req_1\",\n    \"req_2\",\n    \"req_3\",\n    \"req_4\",\n    \"req_5\",\n    \"req_6\",\n    \"req_7\",\n    \"req_8\",\n    \"req_9\",\n    \"req_10\"\n  ],\n  \"reviewed_unit_ids\": [],\n  \"reviewed_instruction_ids\": [\n    \"ir_001\",\n    \"ir_002\",\n    \"ir_003\",\n    \"ir_004\",\n    \"ir_005\",\n    \"ir_006\",\n    \"ir_007\",\n    \"ir_008\",\n    \"ir_009\",\n    \"ir_010\",\n    \"ir_011\",\n    \"ir_012\",\n    \"ir_013\",\n    \"ir_014\",\n    \"ir_015\",\n    \"ir_016\",\n    \"ir_017\",\n    \"ir_018\",\n    \"ir_019\",\n    \"ir_020\",\n    \"ir_021\",\n    \"ir_022\",\n    \"ir_023\",\n    \"ir_024\",\n    \"ir_025\",\n    \"ir_026\",\n    \"ir_027\",\n    \"ir_028\"\n  ],\n  \"notes\": [\n    \"已逐项核对 req_1 至 req_10，并扫描 ir_001 至 ir_028；主要冲突是 ir_021 将 result_002/FAST_KEY 传入 archive.fetch，违反 req_6 与 req_9。\"\n  ]\n}"
