"{\n  \"direction\": \"source_to_graph\",\n  \"findings\": [\n    {\n      \"id\": \"finding_1\",\n      \"status\": \"represented\",\n      \"statement\": \"整个工作流使用凭据门控的首选工具 fast.fetch 和有界回退 archive.fetch 获取一个 source。\",\n      \"explanation\": \"原文第 3 行声明该总体目标；图中通过读取 source_id/FAST_KEY、FAST_KEY 存在时先调用 fast.fetch、失败后按条件回退到最多一次的 archive.fetch，以及成功/失败返回路径共同保留这一目标。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 3,\n          \"end_line\": 3,\n          \"quote\": \"Fetch one source using a credential-gated preferred tool and a bounded archive fallback.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_001\",\n        \"/blocks/block_003\",\n        \"/blocks/block_004\",\n        \"/blocks/block_008\",\n        \"/blocks/block_011\",\n        \"/constraints/0\",\n        \"/constraints/2\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_1\"\n      ],\n      \"basis\": [\n        \"embedded_content\",\n        \"explicit_graph\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_2\",\n      \"status\": \"represented\",\n      \"statement\": \"从用户请求读取 source_id，并从环境读取 FAST_KEY。\",\n      \"explanation\": \"block_001 的 ir_001 以 context_key source_id 为输入并输出 result_001；block_002 的 ir_003 以 context_key FAST_KEY 为输入并输出 result_002，顺序与原文一致。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 8,\n          \"end_line\": 8,\n          \"quote\": \"Read source_id from the user's request and read FAST_KEY from the environment.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_001/instructions/0\",\n        \"/blocks/block_002/instructions/0\",\n        \"/declared_context_keys/0\",\n        \"/declared_context_keys/1\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_2\"\n      ],\n      \"basis\": [\n        \"embedded_content\",\n        \"explicit_graph\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_3\",\n      \"status\": \"represented\",\n      \"statement\": \"FAST_KEY 存在时先尝试 fast.fetch，并传入 source_id 与 FAST_KEY；FAST_KEY 不存在时直接调用 archive.fetch，且不调用 fast.fetch。\",\n      \"explanation\": \"block_003 保留相同约束并执行 presence 检查；边 2 在 FAST_KEY is present 时指向 block_004，边 3 在 FAST_KEY is absent 时直接指向 block_011。block_004 的 fast.fetch 调用输入 result_001 与 result_002，absent 路径绕过 fast.fetch 调用块。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 9,\n          \"end_line\": 9,\n          \"quote\": \"If FAST_KEY is present, try fast.fetch first with source_id and FAST_KEY; if it is absent, go directly to archive.fetch without calling fast.fetch.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_003/constraints/0\",\n        \"/blocks/block_003/instructions/0\",\n        \"/edges/2\",\n        \"/edges/3\",\n        \"/blocks/block_004/instructions/0\",\n        \"/blocks/block_011/instructions/0\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_3\"\n      ],\n      \"basis\": [\n        \"embedded_content\",\n        \"declared_constraint\",\n        \"explicit_graph\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_4\",\n      \"status\": \"represented\",\n      \"statement\": \"仅当 fast.fetch 第一次尝试因 transient error 失败时，才恰好重试一次；非 transient 首次失败不重试。\",\n      \"explanation\": \"block_007 检查首次 fast.fetch 错误是否 transient，边 7 在 transient 时进入 block_008，边 8 在 non-transient 时直接进入 block_011。block_008 保留 exactly once 约束并有 retry_fast_fetch 指令，且没有回到本轮重试或再次重试的边。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 10,\n          \"end_line\": 10,\n          \"quote\": \"Retry fast.fetch exactly once only when its first attempt fails with a transient error; do not retry a non-transient first failure.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_007/instructions/0\",\n        \"/edges/7\",\n        \"/edges/8\",\n        \"/blocks/block_008/constraints/0\",\n        \"/blocks/block_008/instructions/0\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_4\"\n      ],\n      \"basis\": [\n        \"embedded_content\",\n        \"declared_constraint\",\n        \"explicit_graph\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_5\",\n      \"status\": \"represented\",\n      \"statement\": \"fast.fetch 首次非 transient 失败或任意重试失败后，调用 archive.fetch 并传入 source_id。\",\n      \"explanation\": \"block_007 的 non-transient 边与 block_009 的 retry failed 边均指向 block_011；block_011 的 archive.fetch 调用输入 result_001（source_id_value），其块级约束也明确保留这两个触发条件。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 11,\n          \"end_line\": 11,\n          \"quote\": \"After a non-transient first failure or any failed retry of fast.fetch, call archive.fetch with source_id.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/edges/8\",\n        \"/edges/11\",\n        \"/blocks/block_011/instructions/0\",\n        \"/blocks/block_011/constraints/0\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_5\"\n      ],\n      \"basis\": [\n        \"embedded_content\",\n        \"declared_constraint\",\n        \"explicit_graph\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_6\",\n      \"status\": \"represented\",\n      \"statement\": \"最多调用 archive.fetch 一次，并且只将 source_id 作为其参数传入。\",\n      \"explanation\": \"block_011 的约束明确 at most once 且 source_id 为 only argument；图中只有一个 call_archive_fetch 指令，其非目标资源输入仅为 result_001，且后续 archive 成功/失败边没有回到 archive.fetch 调用。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 12,\n          \"end_line\": 12,\n          \"quote\": \"Call archive.fetch at most once and pass source_id as its only argument.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_011/constraints/1\",\n        \"/blocks/block_011/instructions/0\",\n        \"/edges/13\",\n        \"/edges/14\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_6\"\n      ],\n      \"basis\": [\n        \"embedded_content\",\n        \"declared_constraint\",\n        \"explicit_graph\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_7\",\n      \"status\": \"represented\",\n      \"statement\": \"任一工具成功时，返回该成功响应的 body 值且不改变该值，并且不再发起任何 fetch 调用。\",\n      \"explanation\": \"成功路径 block_006 返回 result_004，block_010 返回 result_008，block_013 返回 result_011；这些返回块没有后继 fetch 边，全局约束也保留 no further fetch calls。返回输入直接引用对应成功响应的 body 结果。\",\n      \"source_refs\": [\n        {\n          \"file\": \"SKILL.md\",\n          \"start_line\": 13,\n          \"end_line\": 13,\n          \"quote\": \"On either tool's success, return that successful response's body value unchanged and make no further fetch calls.\"\n        }\n      ],\n      \"graph_refs\": [\n        \"/blocks/block_006/instructions/1\",\n        \"/blocks/block_010/instructions/1\",\n        \"/blocks/block_013/instructions/1\",\n        \"/constraints/2\"\n      ],\n      \"text_refs\": [],\n      \"requirement_ids\": [\n        \"req_7\"\n      ],\n      \"basis\": [\n        \"embedded_content\",\n        \"declared_constraint\",\n        \"explicit_graph\"\n      ],\n      \"unknown_reason\": null\n    },\n    {\n      \"id\": \"finding_8\",\n      \"status\": \"represented\",\n      \"statement\": \"若 archive.fetch 失败，则停止并返回其错误；不得重试 archive.fetch。\",\n      \"explanation\": \"block_012 的 archive.fetch failed 边指向 block_014；block_014 返回 result_012（archive_fetch_error）且没有后继边。block_011 的约束也保留 stop、return its error 与 do not retry archive.fetch。\",\n      \"source_refs\": [\n        {\n     