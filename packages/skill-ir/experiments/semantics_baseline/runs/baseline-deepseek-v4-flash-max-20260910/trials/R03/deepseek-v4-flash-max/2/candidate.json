      "block_name": "Run bundled inspect_pr_checks.py to inspect failing checks",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "run_inspect_pr_checks",
          "opcode": "inspect_pr_checks",
          "inputs": [
