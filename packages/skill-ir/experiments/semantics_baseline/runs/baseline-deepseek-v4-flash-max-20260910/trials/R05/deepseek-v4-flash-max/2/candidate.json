{
  "entry_block_ref": "read_user_request",
  "constraints": [
    "Linear MCP server must be connected and accessible via OAuth.",
    "Confirm access to the relevant Linear workspace, teams, and projects.",
    "Follow these steps in order. Do not skip steps."
  ],
  "declared_context_keys": [
    "user_request"
  ],
  "blocks": [
    {
      "block_ref": "read_user_request",
      "block_name": "Read the user's Linear request",
      "data_source_kind": "context",
      "instructions": [
        {
          "instruction_ref": "read_user_request",
          "opcode": "read_user_request",
          "inputs": [
            {
              "type": "context_key",
              "identifier": "user_request"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "raw_user_request"
            }
          ]
        },
        {
          "instruction_ref": "go_clarify_goal",
          "opcode": "dispatch"
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "clarify_goal_scope",
      "block_name": "Clarify the user's goal and scope",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "clarify_user_goal_and_scope",
          "opcode": "clarify_user_goal_and_scope",
          "inputs": [
            {
              "type": "result",
              "identifier": "raw_user_request"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "clarified_goal_scope"
            }
          ]
        },
        {
          "instruction_ref": "go_select_workflow",
          "opcode": "dispatch"
        }
      ],
      "constraints": [
        "Confirm team/project, priority, labels, cycle, and due dates as needed."
      ]
    },
    {
      "block_ref": "select_workflow_and_tools",
      "block_name": "Select the Linear workflow and confirm required identifiers",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "select_linear_workflow",
          "opcode": "select_linear_workflow",
          "inputs": [
            {
              "type": "result",
              "identifier": "clarified_goal_scope"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "selected_workflow"
            }
          ],
          "metadata": {
            "workflow_options": [
              "Sprint Planning",
              "Bug Triage",
              "Documentation Audit",
              "Team Workload Balance",
              "Release Planning",
              "Cross-Project Dependencies",
              "Automated Status Updates",
              "Smart Labeling",
              "Sprint Retrospectives"
            ]
          }
        },
        {
          "instruction_ref": "identify_linear_mcp_tools",
          "opcode": "identify_linear_mcp_tools",
          "inputs": [
            {
              "type": "result",
              "identifier": "selected_workflow"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "required_tools"
            }
          ],
          "metadata": {
            "available_tools": {
              "Issue Management": [
                "list_issues",
                "get_issue",
                "create_issue",
                "update_issue",
                "list_my_issues",
                "list_issue_statuses",
                "list_issue_labels",
                "create_issue_label"
              ],
              "Project & Team": [
                "list_projects",
                "get_project",
                "create_project",
                "update_project",
                "list_teams",
                "get_team",
                "list_users"
              ],
              "Documentation & Collaboration": [
                "list_documents",
                "get_document",
                "search_documentation",
                "list_comments",
                "create_comment",
                "list_cycles"
              ]
            }
          }
        },
        {
          "instruction_ref": "confirm_linear_identifiers",
          "opcode": "confirm_linear_identifiers",
          "inputs": [
            {
              "type": "result",
              "identifier": "clarified_goal_scope"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "confirmed_identifiers"
            }
          ]
        },
        {
          "instruction_ref": "go_read_linear_context",
          "opcode": "dispatch"
        }
      ],
      "constraints": [
        "Select the appropriate workflow (see Practical Workflows) and identify the Linear MCP tools you will need.",
        "Confirm required identifiers (issue ID, project ID, team key) before calling tools."
      ]
    },
    {
      "block_ref": "read_linear_context",
      "block_name": "Read Linear context with list/get/search MCP tools",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "execute_linear_mcp_read_calls",
          "opcode": "execute_linear_mcp_read_calls",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "linear_mcp_server"
            },
            {
              "type": "result",
              "identifier": "required_tools"
            },
            {
              "type": "result",
              "identifier": "confirmed_identifiers"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "linear_read_results"
            },
            {
              "type": "result",
              "identifier": "linear_read_error"
            }
          ],
          "metadata": {
            "mcp_server": {
              "type": "mcp",
              "value": "linear",
              "transport": "streamable_http",
              "url": "https://mcp.linear.app/mcp"
            }
          }
        },
        {
          "instruction_ref": "dispatch_after_read",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "linear_read_error"
            }
          ]
        }
      ],
      "constraints": [
        "Read first (list/get/search) to build context."
      ]
    },
    {
      "block_ref": "plan_linear_changes",
      "block_name": "Determine Linear changes from the read context",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "determine_linear_changes",
          "opcode": "determine_linear_changes",
          "inputs": [
            {
              "type": "result",
              "identifier": "linear_read_results"
            },
            {
              "type": "result",
              "identifier": "selected_workflow"
            },
            {
              "type": "result",
              "identifier": "confirmed_identifiers"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "planned_linear_changes"
            }
          ]
        },
        {
          "instruction_ref": "go_write_linear",
          "opcode": "dispatch"
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "write_linear_changes",
      "block_name": "Create or update Linear items",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "execute_linear_mcp_write_calls",
          "opcode": "execute_linear_mcp_write_calls",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "linear_mcp_server"
            },
            {
              "type": "result",
              "identifier": "planned_linear_changes"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "linear_write_results"
            },
            {
              "type": "result",
              "identifier": "linear_write_error"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_after_write",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "linear_write_error"
            }
          ]
        }
      ],
      "constraints": [
        "Create or update next (issues, projects, labels, comments) with all required fields.",
        "For bulk operations, explain the grouping logic before applying changes."
      ]
    },
    {
      "block_ref": "summarize_linear_results",
      "block_name": "Summarize Linear results, gaps, and next actions",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "summarize_results_and_propose_next_actions",
          "opcode": "summarize_linear_results_and_propose_next_actions",
          "inputs": [
            {
              "type": "result",
              "identifier": "selected_workflow"
            },
            {
              "type": "result",
              "identifier": "linear_read_results"
            },
            {
              "type": "result",
              "identifier": "linear_write_results"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "linear_workflow_outcome"
            }
          ]
        },
        {
          "instruction_ref": "return_linear_outcome",
          "opcode": "return",
          "inputs": [
            {
              "type": "result",
              "identifier": "linear_workflow_outcome"
            }
          ]
        }
      ],
      "constraints": [
        "Summarize results, call out remaining gaps or blockers, and propose next actions (additional issues, label changes, assignments, or follow-up comments)."
      ]
    },
    {
      "block_ref": "setup_mcp_commands",
      "block_name": "Set up the Linear MCP server",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "add_linear_mcp_server",
          "opcode": "add_linear_mcp_server",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "codex_cli"
            },
            {
              "type": "literal",
              "literal_value": "linear"
            },
            {
              "type": "literal",
              "literal_value": "https://mcp.linear.app/mcp"
            }
          ],
          "outputs": [],
          "metadata": {
            "script_content": "codex mcp add linear --url https://mcp.linear.app/mcp"
          }
        },
        {
          "instruction_ref": "enable_codex_remote_mcp_client",
          "opcode": "enable_codex_remote_mcp_client",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "codex_cli"
            }
          ],
          "outputs": [],
          "metadata": {
            "script_content": "Set `[features] rmcp_client = true` in config.toml OR run `codex --enable rmcp_client`"
          }
        },
        {
          "instruction_ref": "go_login_linear_mcp",
          "opcode": "dispatch"
        }
      ],
      "constraints": [
        "If any MCP call fails because Linear MCP is not connected, pause and set it up.",
        "On Windows, if connection errors occur, try configuring the Linear MCP to run via WSL using the provided JSON configuration: {\"mcpServers\": {\"linear\": {\"command\": \"wsl\", \"args\": [\"npx\", \"-y\", \"mcp-remote\", \"https://mcp.linear.app/sse\", \"--transport\", \"sse-only\"]}}}"
      ]
    },
    {
      "block_ref": "login_linear_mcp",
      "block_name": "Log in to Linear MCP with OAuth",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "login_linear_mcp_oauth",
          "opcode": "login_linear_mcp_oauth",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "linear_mcp_server"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "linear_mcp_login_success"
            }
          ],
          "metadata": {
            "script_content": "codex mcp login linear"
          }
        },
        {
          "instruction_ref": "dispatch_after_login",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "linear_mcp_login_success"
            }
          ]
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "tell_user_restart",
      "block_name": "Tell the user to restart Codex and end",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "return_restart_instruction",
          "opcode": "return",
          "inputs": [
            {
              "type": "literal",
              "literal_value": "Restart Codex; when you try again, continue with Step 1."
            }
          ]
        }
      ],
      "constraints": [
        "After successful login, the user will have to restart Codex. Finish your answer and tell them so when they try again they can continue with Step 1."
      ]
    }
  ],
