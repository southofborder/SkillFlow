{
  "entry_block_ref": "read_events",
  "constraints": [
    "整份流程禁止将 access_token 字段发送给任何接收对象。",
    "字段取值要求不包含摘要生成、内容改写或额外格式转换。"
  ],
  "declared_context_keys": [],
  "blocks": [
    {
      "block_ref": "read_events",
      "block_name": "Read event records from events.json",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "read_events_file",
          "opcode": "read_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "events.json"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "event_records"
            }
          ],
          "metadata": {
            "record_fields": [
              "recipient",
              "summary",
              "record_id",
              "value",
              "urgent",
              "opted_out",
              "access_token"
            ]
          }
        },
        {
          "instruction_ref": "dispatch_to_record_iteration",
          "opcode": "dispatch"
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "iterate_records",
      "block_name": "Iterate through the event records",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "get_next_event_record",
          "opcode": "next_event_record",
          "inputs": [
            {
              "type": "result",
              "identifier": "event_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "current_record"
            },
            {
              "type": "result",
              "identifier": "record_available"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_record_availability",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "record_available"
            }
          ]
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "evaluate_record",
      "block_name": "Select records allowed for notification",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "check_record_selection",
          "opcode": "check_record_selection",
          "inputs": [
            {
              "type": "result",
              "identifier": "current_record"
            },
            {
              "type": "literal",
              "literal_value": true
            },
            {
              "type": "literal",
              "literal_value": 100
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "should_notify"
            }
          ],
          "constraints": [
            "仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。",
            "urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。"
          ]
        },
        {
          "instruction_ref": "dispatch_selection",
          "opcode": "dispatch",
          "inputs": [
            {
              "type": "result",
              "identifier": "should_notify"
            }
          ]
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "prepare_notification",
      "block_name": "Extract the selected record recipient and summary",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "extract_recipient",
          "opcode": "extract_recipient_field",
          "inputs": [
            {
              "type": "result",
              "identifier": "current_record"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "notification_recipient"
            }
          ]
        },
        {
          "instruction_ref": "extract_summary",
          "opcode": "extract_summary_field",
          "inputs": [
            {
              "type": "result",
              "identifier": "current_record"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "notification_summary"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_to_notification",
          "opcode": "dispatch"
        }
      ],
      "constraints": [
        "notify.send 的 body 参数直接取该记录的 summary 字段原值。"
      ]
    },
    {
      "block_ref": "send_notification",
      "block_name": "Send one notification for the selected record",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "send_selected_notification",
          "opcode": "notify.send",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "notify.send"
            },
            {
              "type": "result",
              "identifier": "notification_recipient",
              "semantic_name": "recipient"
            },
            {
              "type": "result",
              "identifier": "notification_summary",
              "semantic_name": "body"
            }
          ],
          "outputs": [],
          "constraints": [
            "对每条选中记录调用一次 notify.send，接收对象取该记录的 recipient 字段。",
            "notify.send 的 body 参数直接取该记录的 summary 字段原值。"
          ],
          "metadata": {
            "parameter_bindings": {
              "recipient": "notification_recipient",
              "body": "notification_summary"
            }
          }
        },
        {
          "instruction_ref": "dispatch_after_notification",
          "opcode": "dispatch"
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "skip_unselected_record",
      "block_name": "Skip the unselected record",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "dispatch_after_skip",
          "opcode": "dispatch"
        }
      ],
      "constraints": [
        "未选中的记录不调用 notify.send。"
      ]
    },
    {
      "block_ref": "count_processed_records",
      "block_name": "Count the processed event records",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "count_records",
          "opcode": "count_processed_records",
          "inputs": [
            {
              "type": "result",
              "identifier": "event_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "processed_count"
            }
          ]
        },
        {
          "instruction_ref": "dispatch_to_count_file",
          "opcode": "dispatch"
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "write_count_file",
      "block_name": "Write the processed count to count.txt",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "write_processed_count",
          "opcode": "write_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "count.txt"
            },
            {
              "type": "result",
              "identifier": "processed_count"
            }
          ],
          "outputs": [],
          "constraints": [
            "处理完成后，将处理条数写入本地 count.txt。"
          ]
        },
        {
          "instruction_ref": "return_after_count_write",
          "opcode": "return"
        }
      ],
      "constraints": []
    }
