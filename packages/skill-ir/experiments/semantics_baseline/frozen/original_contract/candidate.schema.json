{
  "$defs": {
    "CandidateBlock": {
      "additionalProperties": false,
      "description": "A behavior unit proposed by the LLM.\n\nA block states only what happens inside it.  Which of its values are\nreadable elsewhere is a property of the paths through the graph, so it is\nchecked against CFG paths rather than declared here.",
      "properties": {
        "block_ref": {
          "title": "Block Ref",
          "type": "string"
        },
        "block_name": {
          "title": "Block Name",
          "type": "string"
        },
        "data_source_kind": {
          "anyOf": [
            {
              "enum": [
                "context",
                "external"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Source Kind"
        },
        "instructions": {
          "items": {
            "$ref": "#/$defs/CandidateInstruction"
          },
          "title": "Instructions",
          "type": "array"
        }
      },
      "required": [
        "block_ref",
        "block_name"
      ],
      "title": "CandidateBlock",
      "type": "object"
    },
    "CandidateEdge": {
      "additionalProperties": false,
      "description": "A control-flow edge proposed by the LLM.",
      "properties": {
        "source_block_ref": {
          "title": "Source Block Ref",
          "type": "string"
        },
        "target_block_ref": {
          "title": "Target Block Ref",
          "type": "string"
        },
        "condition_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition Text"
        }
      },
      "required": [
        "source_block_ref",
        "target_block_ref"
      ],
      "title": "CandidateEdge",
      "type": "object"
    },
    "CandidateInstruction": {
      "additionalProperties": false,
      "description": "An instruction proposed by the LLM before canonical compilation.",
      "properties": {
        "instruction_ref": {
          "title": "Instruction Ref",
          "type": "string"
        },
        "opcode": {
          "title": "Opcode",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/Operand"
          },
          "title": "Inputs",
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/Operand"
          },
          "title": "Outputs",
          "type": "array"
        },
        "metadata": {
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "instruction_ref",
        "opcode"
      ],
      "title": "CandidateInstruction",
      "type": "object"
    },
    "Operand": {
      "additionalProperties": false,
      "description": "One typed instruction input or output.\n\nRESULT identifies an instruction result; CONTEXT_KEY identifies a declared\nruntime entry; EXTERNAL_RESOURCE identifies a file, tool, API, or service.\nOnly LITERAL stores a payload in ``literal_value``. ``semantic_name`` keeps\nthe extractor's wording when compilation assigns a result identifier.\nResult identifiers are global; a single instruction can produce several.",
      "properties": {
        "type": {
          "$ref": "#/$defs/OperandType"
        },
        "identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identifier"
        },
        "literal_value": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Literal Value"
        },
        "semantic_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Name"
        }
      },
      "required": [
        "type"
      ],
      "title": "Operand",
      "type": "object"
    },
    "OperandType": {
      "description": "The source or destination kind of an operand.",
      "enum": [
        "literal",
        "context_key",
        "result",
        "external_resource"
      ],
      "title": "OperandType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The complete untrusted analysis returned by the LLM.",
  "properties": {
    "entry_block_ref": {
      "title": "Entry Block Ref",
      "type": "string"
    },
    "declared_context_keys": {
      "items": {
        "type": "string"
      },
      "title": "Declared Context Keys",
      "type": "array"
    },
    "blocks": {
      "items": {
        "$ref": "#/$defs/CandidateBlock"
      },
      "title": "Blocks",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/CandidateEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "diagnostics": {
      "items": {
        "type": "string"
      },
      "title": "Diagnostics",
      "type": "array"
    }
  },
  "required": [
    "entry_block_ref"
  ],
  "title": "IRAnalysisCandidate",
  "type": "object"
}
