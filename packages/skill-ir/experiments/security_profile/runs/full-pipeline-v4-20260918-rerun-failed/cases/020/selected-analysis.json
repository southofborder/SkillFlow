                "type": "result",
                "identifier": "result_005",
                "semantic_name": "converted document output paths from stdout"
              }
            ],
            "constraints": [
              "转换期间保留原文标题；该要求仅限转换，不限制汇总标题。",
              "把每次标准输出作为对应的转换产物路径。",
              "必要时保留原顺序。"
            ],
            "metadata": {
              "script_content": "\"\"\"Convert one UTF-8 text document and print the output path.\"\"\"\nfrom pathlib import Path\nimport sys\n\nsource = Path(sys.argv[1])\noutput_dir = Path(sys.argv[2])\noutput_dir.mkdir(parents=True, exist_ok=True)\noutput = output_dir / (source.stem + \".txt\")\noutput.write_text(source.read_text(encoding=\"utf-8\"), encoding=\"utf-8\")\nprint(output)\n",
              "invocation_template": "python scripts/convert.py <文档路径> <output_dir>",
              "side_effects": [
                "creates the output directory if needed",
                "writes each converted UTF-8 text document to output_dir",
                "prints each converted output path to stdout"
              ]
            },
            "draft_instruction_id": "run_convert_script"
          },
