"{\n  \"entry_block_ref\": \"check_pdftoppm\",\n  \"constraints\": [\n    \"No required environment variables.\",\n    \"Prefer visual review: render PDF pages to PNGs and inspect them.\",\n    \"After each meaningful update, re-render pages and verify alignment, spacing, and legibility.\",\n    \"Use tmp/pdfs/ for intermediate files; delete when done.\",\n    \"Write final artifacts under output/pdf/ when working in this repo.\",\n    \"Keep filenames stable and descriptive.\",\n    \"Maintain polished visual design: consistent typography, spacing, margins, and section hierarchy.\",\n    \"Avoid rendering issues: clipped text, overlapping elements, broken tables, black squares, or unreadable glyphs.\",\n    \"Charts, tables, and images must be sharp, aligned, and clearly labeled.\",\n    \"Use ASCII hyphens only. Avoid U+2011 (non-breaking hyphen) and other Unicode dashes.\",\n    \"Citations and references must be human-readable; never leave tool tokens or placeholder strings.\",\n    \"Do not deliver until the latest PNG inspection shows zero visual or formatting defects.\",\n    \"Confirm headers/footers, page numbering, and section transitions look polished.\",\n    \"Keep intermediate files organized or remove them after final approval.\"\n  ],\n  \"declared_context_keys\": [\n    \"pdftoppm_available\",\n    \"uv_available\"\n  ],\n  \"blocks\": [\n    {\n      \"block_ref\": \"check_pdftoppm\",\n      \"block_name\": \"Check whether pdftoppm is available for rendering\",\n      \"data_source_kind\": \"context\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_pdftoppm_available\",\n          \"opcode\": \"read_pdftoppm_availability\",\n          \"inputs\": [\n            {\n              \"type\": \"context_key\",\n              \"identifier\": \"pdftoppm_available\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"pdftoppm_available\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_on_pdftoppm\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"pdftoppm_available\"\n            }\n          ]\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"render_pages\",\n      \"block_name\": \"Render PDF pages to PNGs with pdftoppm\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"pdftoppm_render\",\n          \"opcode\": \"pdftoppm_render_pdf_pages_to_png\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"pdftoppm\"\n            },\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"input_pdf\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"updated_pdf\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"generated_pdf\"\n            },\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"output_prefix\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"rendered_pngs\"\n            }\n          ],\n          \"metadata\": {\n            \"script_content\": \"pdftoppm -png $INPUT_PDF $OUTPUT_PREFIX\"\n          },\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_inspect\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"missing_poppler\",\n      \"block_name\": \"Install Poppler or ask the user to review locally\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"handle_missing_poppler\",\n          \"opcode\": \"install_poppler_or_ask_user_to_review_locally\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"poppler\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"poppler_fallback_result\"\n            }\n          ],\n          \"metadata\": {\n            \"script_content\": \"# macOS (Homebrew)\\nbrew install poppler\\n\\n# Ubuntu/Debian\\nsudo apt-get install -y poppler-utils\"\n          },\n          \"constraints\": [\n            \"If installation isn't possible in this environment, tell the user which dependency is missing and how to install it locally.\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"return_fallback\",\n          \"opcode\": \"return\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"poppler_fallback_result\"\n            }\n          ]\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"inspect_pages\",\n      \"block_name\": \"Inspect rendered pages for visual defects\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"inspect_pngs\",\n          \"opcode\": \"inspect_rendered_pngs\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"rendered_pngs\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"inspection_findings\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_on_inspection\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"inspection_findings\"\n            }\n          ]\n        }\n      ],\n      \"constraints\": [\n        \"After each meaningful update, re-render pages and verify alignment, spacing, and legibility.\"\n      ]\n    },\n    {\n      \"block_ref\": \"apply_update\",\n      \"block_name\": \"Apply a meaningful update to the PDF\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"apply_update\",\n          \"opcode\": \"apply_meaningful_pdf_update\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"inspection_findings\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"updated_pdf\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_re_render\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"final_checks\",\n      \"block_name\": \"Perform final checks and prepare delivery\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"confirm_layout\",\n          \"opcode\": \"confirm_headers_footers_page_numbering_section_transitions\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"rendered_pngs\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"layout_confirmed\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"cleanup_intermediate\",\n          \"opcode\": \"organize_or_remove_intermediate_files\",\n          \"inputs\": [\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"tmp/pdfs/\"\n            }\n          ],\n          \"outputs\": []\n        },\n        {\n          \"instruction_ref\": \"return_success\",\n          \"opcode\": \"return\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"layout_confirmed\"\n            }\n          ]\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"generate_pdf\",\n      \"block_name\": \"Generate a new PDF with reportlab\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"generate_with_reportlab\",\n          \"opcode\": \"generate_pdf_with_reportlab\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"reportlab\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"generated_pdf\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_render\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": []\n        }\n      ],\n      \"constraints\": [\n        \"Use reportlab to generate PDFs when creating new documents.\",\n        \"Write final artifacts under output/pdf/ when working in this repo.\"\n      ]\n    },\n    {\n      \"block_ref\": \"extract_text\",\n      \"block_name\": \"Extract text from a PDF with pdfplumber or pypdf\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"extract_text\",\n          \"opcode\": \"extract_pdf_text_with_pdfplumber_or_pypdf\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"pdfplumber\"\n            },\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"pypdf\"\n            },\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"input_pdf\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"extracted_text\"\n            }\n          ],\n          \"constraints\": [\n            \"Use pdfplumber (or pypdf) for text extraction and quick checks; do not rely on it for layout fidelity.\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"return_extracted_text\",\n          \"opcode\": \"return\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"extracted_text\"\n            }\n          ]\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"check_uv\",\n      \"block_name\": \"Check whether uv is available\",\n      \"data_source_kind\": \"context\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_uv_available\",\n          \"opcode\": \"read_uv_availability\",\n          \"inputs\": [\n            {\n              \"type\": \"context_key\",\n              \"identifier\": \"uv_available\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"uv_available\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_on_uv\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"uv_available\"\n            }\n          ]\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"install_uv\",\n      \"block_name\": \"Install Python PDF packages with uv\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"uv_pip_install\",\n          \"opcode\": \"uv_pip_install\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"uv\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"reportlab\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"pdfplumber\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"pypdf\"\n            }\n          ],\n          \"outputs\": [],\n          \"metadata\": {\n            \"script_content\": \"uv pip install reportlab pdfplumber pypdf\"\n          },\n          \"constraints\": [\n            \"Prefer uv for dependency management.\",\n            \"If installation isn't possible in this environment, tell the user which dependency is missing and how to install it locally.\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"return_uv\",\n          \"opcode\": \"return\",\n          \"inputs\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"install_pip\",\n      \"block_name\": \"Install Python PDF packages with pip\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"pip_install\",\n          \"opcode\": \"python3_m_pip_install\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"python3\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"reportlab\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"pdfplumber\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"pypdf\"\n            }\n          ],\n          \"outputs\": [],\n          \"metadata\": {\n            \"script_content\": \"python3 -m pip install reportlab pdfplumber pypdf\"\n          },\n          \"constraints\": [\n            \"If installation isn't possible in this environment, tell the user which dependency is missing and how to install it locally.\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"return_pip\",\n          \"opcode\": \"return\",\n          \"inputs\": []\n        }\n      ],\n      \"constraints\": []\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"check_pdftoppm\",\n      \"target_block_ref\": \"render_pages\",\n      \"condition_text\": \"pdftoppm available\"\n    },\n    {\n      \"source_block_ref\": \"check_pdftoppm\",\n      \"target_block_ref\": \"missing_poppler\",\n      \"condition_text\": \"pdftoppm unavailable\"\n    },\n    {\n      \"source_block_ref\": \"render_pages\",\n      \"target_block_ref\": \"inspect_pages\"\n    },\n    {\n      \"source_block_ref\": \"inspect_pages\",\n      \"target_block_ref\": \"apply_update\",\n      \"condition_text\": \"visual or formatting defects found\"\n    },\n    {\n      \"source_block_ref\": \"inspect_pages\",\n      \"target_block_ref\": \"final_checks\",\n      \"condition_text\": \"zero visual or formatting defects\"\n    },\n    {\n      \"source_block_ref\": \"apply_update\",\n      \"target_block_ref\": \"render_pages\"\n    },\n    {\n      \"source_block_ref\": \"generate_pdf\",\n      \"target_block_ref\": \"render_pages\"\n    },\n    {\n      \"source_block_ref\": \"check_uv\",\n      \"target_block_ref\": \"install_uv\",\n      \"condition_text\": \"uv available\"\n    },\n    {\n      \"source_block_ref\": \"check_uv\",\n      \"target_block_ref\": \"install_pip\",\n      \"condition_text\": \"uv unavailable\"\n    }\n  ],\n  \"diagnostics\": [\n    \"LICENSE.txt is a software license and contains no runtime behavior.\",\n    \"agents/openai.yaml contains skill interface metadata (display name, short description, icon, default prompt) and no executable behavior.\",\n    \"assets/pdf.png is a binary asset and was not read; it contains no executable behavior.\",\n    \"The 'When to use' section and frontmatter description describe skill applicability and were not modeled as runtime control flow.\",\n    \"The skill defines multiple independent entry points for visual review, PDF generation, text extraction, and dependency installation. The entry_block_ref points to the visual review workflow.\",\n    \"Context keys 'pdftoppm_available' and 'uv_available' are inferred from conditional instructions ('if available', 'If uv is unavailable').\"\n  ]\n}"
