constraints\": [\n            \"Save outputs under `output/transcribe/` when working in this repo.\",\n            \"Use `output/transcribe/<job-id>/` for evaluation runs.\",\n            \"Use `--out-dir` for multiple files to avoid overwriting.\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"return_saved\",\n          \"opcode\": \"return\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"validated_transcript\"\n            }\n          ]\n        }\n      ],\n      \"constraints\": []\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_request\",\n      \"target_block_ref\": \"read_api_key\"\n    },\n    {\n      \"source_block_ref\": \"read_api_key\",\n      \"target_block_ref\": \"ask_user_set_key\",\n      \"condition_text\": \"OPENAI_API_KEY is not set and dry-run is false\"\n    },\n    {\n      \"source_block_ref\": \"read_api_key\",\n      \"target_block_ref\": \"warn_missing_key_dry_run\",\n      \"condition_text\": \"OPENAI_API_KEY is not set and dry-run is true\"\n    },\n    {\n      \"source_block_ref\": \"read_api_key\",\n      \"target_block_ref\": \"read_skill_env\",\n      \"condition_text\": \"OPENAI_API_KEY is set\"\n    },\n    {\n      \"source_block_ref\": \"warn_missing_key_dry_run\",\n      \"target_block_ref\": \"read_skill_env\"\n    },\n    {\n      \"source_block_ref\": \"read_skill_env\",\n      \"target_block_ref\": \"compute_cli_path\"\n    },\n    {\n      \"source_block_ref\": \"compute_cli_path\",\n      \"target_block_ref\": \"choose_params\"\n    },\n    {\n      \"source_block_ref\": \"choose_params\",\n      \"target_block_ref\": \"run_cli_dry\",\n      \"condition_text\": \"dry-run is true\"\n    },\n    {\n      \"source_block_ref\": \"choose_params\",\n      \"target_block_ref\": \"ensure_sdk\",\n      \"condition_text\": \"dry-run is false\"\n    },\n    {\n      \"source_block_ref\": \"ensure_sdk\",\n      \"target_bl