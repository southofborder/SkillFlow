"{\n  \"entry_block_ref\": \"read_request\",\n  \"declared_context_keys\": [],\n  \"constraints\": [\n    \"Call index.search exactly once.\",\n    \"Do not invoke index.delete anywhere in this workflow.\",\n    \"index.search supports fuzzy matching; this note does not request fuzzy expansion in this workflow.\",\n    \"Parameter descriptions are call requirements and do not instruct pre-call validation or normalization.\"\n  ],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_request\",\n      \"block_name\": \"Read the user-supplied request.json\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_request_json\",\n          \"opcode\": \"read_request_json\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"request.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_term\",\n              \"semantic_name\": \"request.term\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_from_date\",\n              \"semantic_name\": \"request.from_date\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_limit\",\n              \"semantic_name\": \"request.limit\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"from_date_present\",\n              \"semantic_name\": \"whether from_date is present\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"limit_present\",\n              \"semantic_name\": \"whether limit is present\"\n            }\n          ],\n          \"constraints\": [],\n          \"metadata\": {\n            \"description\": \"Read the user-supplied request.json, which contains term and may contain from_date and limit.\"\n          }\n        },\n        {\n          \"instruction_ref\": \"go_search\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"call_search\",\n      \"block_name\": \"Call index.search once with the request parameters\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"search_index\",\n          \"opcode\": \"call_index_search\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"index.search\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_term\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_from_date\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"from_date_present\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_limit\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"limit_present\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"search_total\",\n              \"semantic_name\": \"search response total\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"search_items\",\n              \"semantic_name\": \"search response items\"\n            }\n          ],\n          \"constraints\": [\n            \"Use request.term unchanged as the query argument.\",\n            \"When from_date is present, pass its value unchanged; the accepted format is YYYY-MM-DD.\",\n            \"When from_date is missing, omit the from_date argument.\",\n            \"When