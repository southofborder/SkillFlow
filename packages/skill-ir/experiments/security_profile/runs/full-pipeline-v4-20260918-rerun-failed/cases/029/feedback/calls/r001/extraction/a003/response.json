": \"return_restart_instruction\",\n      \"block_name\": \"Tell the user to restart Codex after successful login\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"return_restart_instruction_ir\",\n          \"opcode\": \"return\",\n          \"inputs\": [\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"After successful login, restart Codex. Then continue with Step 1 when you try again.\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"clarify_goal_scope\",\n      \"block_name\": \"Clarify the user's goal and scope\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"clarify_linear_goal_and_scope_ir\",\n          \"opcode\": \"clarify_linear_goal_and_scope\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"user_request_text\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"clarified_goal_scope\",\n              \"semantic_name\": \"clarified goal and scope\"\n            }\n          ],\n          \"constraints\": [\n            \"Clarify the user's goal and scope (e.g., issue triage, sprint planning, documentation audit, workload balance).\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"confirm_linear_scope_details_ir\",\n          \"opcode\": \"confirm_linear_scope_details\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"clarified_goal_scope\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"confirmed_scope\",\n              \"semantic_name\": \"confirmed scope details\"\n            }\n          ],\n          \"constraints\": [\n            \"Confirm team/project, priority, labels, cycle, and due dates as needed.\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_select_workflow\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"select_workflow_and_tools\",\n      \"block_name\": \"Select the Linear workflow and identify required MCP tools\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"select_linear_workflow_ir\",\n          \"opcode\": \"select_linear_workflow\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"confirmed_scope\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": [\n                {\n                  \"name\": \"Sprint Planning\",\n                  \"description\": \"Review open issues for a target team, pick top items by priority, and create a new cycle (e.g., \\\"Q1 Performance Sprint\\\") with assignments.\"\n                },\n                {\n                  \"name\": \"Bug Triage\",\n                  \"description\": \"List critical/high-priority bugs, rank by user impact, and move the top items to \\\"In Progress.\\\"\"\n                },\n                {\n                  \"name\": \"Documentation Audit\",\n                  \"description\": \"Search documentation (e.g., API auth), then open labeled \\\"documentation\\\" issues for gaps or outdated sections with detailed fixes.\"\n                },\n                {\n                  \"name\": \"Team Workload Balance\",\n                  \"description\": \"Group active issues by assignee, flag anyone with high load, and suggest or apply redistributions.\"\n                },\n                {\n                  \"name\": \"Release Planning\",\n                  \"description\": \"Create a project (e.g., \\\"v2.0 Release\\\") with milestones (feature freeze, beta, docs, launch) and generate issues with estimates.\"\n                },\n                {\n                  \"name\": \"Cross-Project Dependencies\",\n                  \"description\": \"Find all \\\"blocked\\\" issues, identify blockers, and create linked issues if missing.\"\n                },\n                {\n                  \"name\": \"Automated Status Updates\",\n                  \"description\": \"Find your issues with stale updates and add status comments based on current state/blockers.\"\n                },\n                {\n                  \"name\": \"Smart Labeling\",\n                  \"description\": \"Analyze unlabeled issues, suggest/apply labels, and create missing label categories.\"\n                },\n                {\n                  \"name\": \"Sprint Retrospectives\",\n                  \"description\": \"Generate a report for the last completed cycle, note completed vs. pushed work, and open discussion issues for patterns.\"\n                }\n              ]\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_workflow\",\n              \"semantic_name\": \"selected workflow\"\n            }\n          ],\n          \"constraints\": [\n            \"Select the appropriate workflow (see Practical Workflows below).\"\n          ],\n          \"metadata\": {\n            \"practical_workflows_source\": \"SKILL.md Practical Workflows\"\n          }\n        },\n        {\n          \"instruction_ref\": \"identify_linear_mcp_tools_ir\",\n          \"opcode\": \"identify_linear_mcp_tools\",\n          \"inputs\": [\n  