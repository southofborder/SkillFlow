tadata\": {\n            \"script_content\": \"codex mcp add linear --url https://mcp.linear.app/mcp\",\n            \"transport\": \"streamable_http\",\n            \"url\": \"https://mcp.linear.app/mcp\"\n          }\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_choose_enablement\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": [\n        \"If any MCP call fails because Linear MCP is not connected, pause and set it up.\",\n        \"Windows/WSL note: If you see connection errors on Windows, try configuring the Linear MCP to run via WSL: {\\\"mcpServers\\\": {\\\"linear\\\": {\\\"command\\\": \\\"wsl\\\", \\\"args\\\": [\\\"npx\\\", \\\"-y\\\", \\\"mcp-remote\\\", \\\"https://mcp.linear.app/sse\\\", \\\"--transport\\\", \\\"sse-only\\\"]}}}\"\n      ]\n    },\n    {\n      \"block_ref\": \"choose_remote_mcp_enablement\",\n      \"block_name\": \"Choose how to enable the remote MCP client\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"dispatch_choose_enablement\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"set [features] rmcp_client = true in config.toml or run codex --enable rmcp_client\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": [\n        \"Set `[features] rmcp_client = true` in `config.toml` or run `codex --enable rmcp_client`.\"\n      ]\n    },\n    {\n      \"block_ref\": \"set_config_toml_rmcp_client\",\n      \"block_name\": \"Enable remote MCP client in config.toml\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"set_config_toml_rmcp_client_ir\",\n          \"opcode\": \"set_config_toml_rmcp_client_true\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"config_toml\",\n              \"semantic_name\": \"config.toml\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"[features]\\nrmcp_client = true\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"Set `[features] rmcp_client = true` in `config.toml`.\"\n          ],\n          \"metadata\": {\n            \"config_toml\": \"[features]\\nrmcp_client = true\"\n          }\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_login_from_config\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"run_codex_enable_rmcp_client\",\n      \"block_name\": \"Enable remote MCP client with Codex CLI\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"run_codex_enable_rmcp_client_ir\",\n          \"opcode\": \"run_codex_enable_rmcp_client\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"codex_cli\",\n              \"semantic_name\": \"Codex CLI\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"--enable rmcp_client\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"Run `codex --enable rmcp_client`.\"\n          ],\n          \"metadata\": {\n            \"script_content\": \"codex --enable rmcp_client\"\n          }\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_login_from_cli\",\n          \"opcode\": \"dispatch\",\n          