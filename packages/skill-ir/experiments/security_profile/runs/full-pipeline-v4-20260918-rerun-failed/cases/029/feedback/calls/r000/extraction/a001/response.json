ed fields.\",\n        \"For bulk operations, explain grouping logic before applying changes.\"\n      ]\n    },\n    {\n      \"block_ref\": \"summarize\",\n      \"block_name\": \"Summarize Linear results and return next actions\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"summarize_linear_workflow_results\",\n          \"opcode\": \"summarize_linear_workflow_results\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"linear_context\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"linear_update_results\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"confirmed_linear_scope\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_workflow\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"linear_workflow_summary\"\n            }\n          ],\n          \"constraints\": [\n            \"Summarize results, call out remaining gaps or blockers, and propose next actions.\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"return_summary\",\n          \"opcode\": \"return\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"linear_workflow_summary\"\n            }\n          ]\n        }\n      ],\n      \"constraints\": [\n        \"Summarize results, call out remaining gaps or blockers, and propose next actions.\"\n      ]\n    },\n    {\n      \"block_ref\": \"setup_configure\",\n      \"block_name\": \"Configure Linear MCP and enable remote MCP client\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"add_linear_mcp_server\",\n          \"opcode\": \"add_linear_mcp_server\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"codex_cli\",\n              \"semantic_name\": \"Codex CLI\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"linear\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"https://mcp.linear.app/mcp\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"Run `codex mcp add linear --url https://mcp.linear.app/mcp`.\"\n          ],\n          \"metadata\": {\n            \"script_content\": \"codex mcp add linear --url https://mcp.linear.app/mcp\"\n          }\n        },\n        {\n          \"instruction_ref\": \"enable_remote_mcp_client\",\n          \"opcode\": \"enable_remote_mcp_client\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"config_toml\",\n              \"semantic_name\": \"config.toml\"\n            },\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"codex_cli\",\n              \"semantic_name\": \"Codex CLI\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"features.rmcp_client=true\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"Set `[features] rmcp_client = true` in `config.toml` or run `codex --enable rmcp_client`.\"\n          ],\n          \"metadata\": {\n            \"script_content\": \"codex --enable rmcp_client\",\n            \"config_toml\": \"[features]\\nrmcp_client = true\"\n          }\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_login\",\n          \"opcode\": \"dispatch\"\n        }\n      ],\n      \"constraints\": [\n        \"Set up Linear MCP (if not already configured).\",\n        \