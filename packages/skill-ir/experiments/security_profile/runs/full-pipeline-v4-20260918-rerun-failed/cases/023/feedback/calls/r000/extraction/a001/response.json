"{\n  \"entry_block_ref\": \"read_manifest\",\n  \"constraints\": [\n    \"整份流程不得修改输入原文文件。\",\n    \"整份流程禁止把文档上传到外部服务。\",\n    \"必要时保留原顺序。\"\n  ],\n  \"declared_context_keys\": [\n    \"output_dir\",\n    \"delivery_path\"\n  ],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_manifest\",\n      \"block_name\": \"Read the user-provided manifest.json\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_manifest_file\",\n          \"opcode\": \"read_manifest_file\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"manifest.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"manifest_content\"\n            }\n          ],\n          \"constraints\": [],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_parse_manifest\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"parse_manifest\",\n      \"block_name\": \"Extract document paths from the manifest\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"extract_document_paths\",\n          \"opcode\": \"extract_document_paths_from_manifest\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"manifest_content\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"document_paths\"\n            }\n          ],\n          \"constraints\": [],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_read_request_settings\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"read_request_settings\",\n      \"block_name\": \"Read output_dir and delivery_path from the request\",\n      \"data_source_kind\": \"context\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_request_delivery_settings\",\n          \"opcode\": \"read_request_delivery_settings\",\n          \"inputs\": [\n            {\n              \"type\": \"context_key\",\n              \"identifier\": \"output_dir\"\n            },\n            {\n              \"type\": \"context_key\",\n              \"identifier\": \"delivery_path\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_output_dir\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_delivery_path\"\n            }\n          ],\n          \"constraints\": [],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_convert_documents\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"convert_documents\",\n      \"block_name\": \"Convert each document with scripts/convert.py and collect stdout paths\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"convert_documents_with_convert_script\",\n          \"opcode\": \"convert_documents_with_convert_script\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"scripts/convert.py\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"document_paths\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_output_dir\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"conversion_artifact_paths\"\n            }\n          ],\n          \"constraints\": [\n            \"转换期间保留原文标题；该要求仅限转换，不限制汇总标题。\",\n            \"转换通过 scripts/convert.py 完成；主流程只使用脚本输出路径，不重复执行脚本内部的处理。\"\n          ],\n          \"metadata\": {\n            \"script_content\": \"\\\"\\\"\\\"Convert one UTF-8 text document and print the output path.\\\"\\\"\\\"\\nfrom pathlib import Path\\nimport sys\\n\\nsource = Path(sys.argv[1])\\noutput_dir = Path(sys.argv[2])\\noutput_dir.mkdir(parents=True, exist_ok=True)\\noutput = output_dir / (source.stem + \\\".txt\\\")\\noutput.write_text(source.read_text(encoding=\\\"utf-8\\\"), encoding=\\\"utf-8\\\")\\nprint(output)\\n\",\n            \"invocation_template\": \"python scripts/convert.py <文档路径> <output_dir>\"\n          }\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_package_bundle\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"package_bundle\",\n      \"block_name\": \"Package conversion artifact paths into bundle.zip with scripts/package.py\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"package_conversion_artifacts\",\n          \"opcode\": \"package_conversion_artifacts_with_package_script\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"scripts/package.py\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"conversion_artifact_paths\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"bundle.zip\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"bundle_zip_path\"\n            }\n          ],\n          \"constraints\": [\n            \"打包时必须采用下方“参考步骤”的命令，并将转换产物路径列表传给 --paths。\"\n          ],\n          \"metadata\": {\n            \"script_content\": \"\\\"\\\"\\\"Build the explicitly requested ZIP from supplied output paths.\\\"\\\"\\\"\\nimport argparse\\nfrom pathlib import Path\\nfrom zipfile import ZipFile\\n\\nparser = argparse.ArgumentParser()\\nparser.add_argument(\\\"--paths\\\", nargs=\\\"+\\\", required=True)\\nparser.add_argument(\\\"--output\\\", required=True)\\nargs = parser.parse_args()\\nwith ZipFile(args.output, \\\"w\\\") as archive:\\n    for filename in args.paths:\\n        path = Path(filename)\\n        archive.write(path, arcname=path.name)\\n\",\n            \"reference_step_command\": \"python scripts/package.py --paths <转换产物路径列表> --output bundle.zip\"\n          }\n        },\n        {\n          \"instruction_ref\": \"dispatch_to_deliver_bundle\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"deliver_bundle\",\n      \"block_name\": \"Deliver bundle.zip to the requested delivery_path\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"deliver_bundle_to_delivery_path\",\n          \"opcode\": \"deliver_bundle_to_requested_path\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"bundle_zip_path\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_delivery_path\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"return_after_delivery\",\n          \"opcode\": \"return\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_manifest\",\n      \"target_block_ref\": \"parse_manifest\"\n    },\n    {\n      \"source_block_ref\": \"parse_manifest\",\n      \"target_block_ref\": \"read_request_settings\"\n    },\n    {\n      \"source_block_ref\": \"read_request_settings\",\n      \"target_block_ref\": \"convert_documents\"\n    },\n    {\n      \"source_block_ref\": \"convert_documents\",\n      \"target_block_ref\": \"package_bundle\"\n    },\n    {\n      \"source_block_ref\": \"package_bundle\",\n      \"target_block_ref\": \"deliver_bundle\"\n    }\n  ],\n  \"diagnostics\": [\n    \"Historical example to write receipt.txt is explicitly marked as not executed; no runtime instruction was created for it.\",\n    \"The per-document convert.py invocation is represented as one batch external acquisition block that consumes the document path list and output_dir and produces the list of stdout conversion artifact paths.\",\n    \"scripts/convert.py and scripts/package.py are treated as black-box operations; their original code bodies are preserved in instruction metadata.script_content.\",\n    \"manifest.json is modeled as an external file resource; output_dir and delivery_path are modeled as runtime context keys.\"\n  ]\n}"
