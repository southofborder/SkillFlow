"{\n  \"entry_block_ref\": \"read_manifest\",\n  \"constraints\": [\n    \"整份流程不得修改输入原文文件。\",\n    \"整份流程禁止把文档上传到外部服务。\",\n    \"必要时保留原顺序。\"\n  ],\n  \"declared_context_keys\": [\n    \"output_dir\",\n    \"delivery_path\"\n  ],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_manifest\",\n      \"block_name\": \"读取用户提供的 manifest.json\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_manifest_file\",\n          \"opcode\": \"read_manifest_file\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"manifest.json\",\n              \"semantic_name\": \"manifest.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"manifest_content\",\n              \"semantic_name\": \"manifest_content\"\n            }\n          ],\n          \"constraints\": [],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"go_parse_manifest\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"extract_document_paths\",\n      \"block_name\": \"按 manifest 的 paths 列表获取文档路径\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"extract_document_paths_from_manifest\",\n          \"opcode\": \"extract_document_paths_from_manifest\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"manifest_content\",\n              \"semantic_name\": \"manifest_content\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"paths\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"document_paths_list\",\n              \"semantic_name\": \"document_paths\"\n            }\n          ],\n          \"constraints\": [],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"go_read_request_settings\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"read_request_settings\",\n      \"block_name\": \"从请求中读取 output_dir 和 delivery_path\",\n      \"data_source_kind\": \"context\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_request_delivery_settings\",\n          \"opcode\": \"read_request_delivery_settings\",\n          \"inputs\": [\n            {\n              \"type\": \"context_key\",\n              \"identifier\": \"output_dir\",\n              \"semantic_name\": \"output_dir\"\n            },\n            {\n              \"type\": \"context_key\",\n              \"identifier\": \"delivery_path\",\n              \"semantic_name\": \"delivery_path\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_output_dir\",\n              \"semantic_name\": \"request_output_dir\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_delivery_path\",\n              \"semantic_name\": \"request_delivery_path\"\n            }\n          ],\n          \"constraints\": [],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"go_convert_documents\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"convert_documents\",\n      \"block_name\": \"逐个执行 scripts/convert.py 并收集每次 stdout 的转换产物路径\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"convert_documents_one_by_one\",\n          \"opcode\": \"convert_documents_one_by_one_with_convert_script\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"scripts/convert.py\",\n              \"semantic_name\": \"scripts/convert.py\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"document_paths_list\",\n              \"semantic_name\": \"document_paths\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_output_dir\",\n              \"semantic_name\": \"request_output_dir\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"conversion_artifact_paths_list\",\n              \"semantic_name\": \"conversion_artifact_paths\"\n            }\n          ],\n          \"constraints\": [\n            \"逐个执行 python scripts/convert.py <文档路径> <output_dir>，把每次标准输出作为对应的转换产物路径。\",\n            \"对 document_paths_list 中的每个文档路径按输入顺序分别调用 scripts/convert.py；每次调用的 stdout 绑定为 conversion_artifact_paths_list 中与该文档路径对应的产物路径。\",\n            \"转换期间保留原文标题；该要求仅限转换，不限制汇总标题。\",\n            \"转换通过 scripts/convert.py 完成；主流程只使用脚本输出路径，不重复执行脚本内部的处理。\"\n          ],\n          \"metadata\": {\n            \"script_content\": \"\\\"\\\"\\\"Convert one UTF-8 text document and print the output path.\\\"\\\"\\\"\\nfrom pathlib import Path\\nimport sys\\n\\nsource = Path(sys.argv[1])\\noutput_dir = Path(sys.argv[2])\\noutput_dir.mkdir(parents=True, exist_ok=True)\\noutput = output_dir / (source.stem + \\\".txt\\\")\\noutput.write_text(source.read_text(encoding=\\\"utf-8\\\"), encoding=\\\"utf-8\\\")\\nprint(output)\\n\",\n            \"invocation_template\": \"python scripts/convert.py <文档路径> <output_dir>\"\n          }\n        },\n        {\n          \"instruction_ref\": \"go_package_bundle\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"package_bundle\",\n      \"block_name\": \"按参考步骤命令打包转换产物为 bundle.zip\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"package_conversion_artifacts\",\n          \"opcode\": \"package_conversion_artifacts_with_package_script\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"scripts/package.py\",\n              \"semantic_name\": \"scripts/package.py\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"conversion_artifact_paths_list\",\n              \"semantic_name\": \"conversion_artifact_paths\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"bundle.zip\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"打包时必须采用下方“参考步骤”的命令，并将转换产物路径列表传给 --paths。\",\n            \"参考步骤命令：python scripts/package.py --paths <转换产物路径列表> --output bundle.zip\"\n          ],\n          \"metadata\": {\n            \"script_content\": \"\\\"\\\"\\\"Build the explicitly requested ZIP from supplied output paths.\\\"\\\"\\\"\\nimport argparse\\nfrom pathlib import Path\\nfrom zipfile import ZipFile\\n\\nparser = argparse.ArgumentParser()\\nparser.add_argument(\\\"--paths\\\", nargs=\\\"+\\\", required=True)\\nparser.add_argument(\\\"--output\\\", required=True)\\nargs = parser.parse_args()\\nwith ZipFile(args.output, \\\"w\\\") as archive:\\n    for filename in args.paths:\\n        path = Path(filename)\\n        archive.write(path, arcname=path.name)\\n\",\n            \"reference_step_command\": \"python scripts/package.py --paths <转换产物路径列表> --output bundle.zip\"\n          }\n        },\n        {\n          \"instruction_ref\": \"go_deliver_bundle\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"deliver_bundle\",\n      \"block_name\": \"将生成的 bundle.zip 交付到请求的 delivery_path\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"deliver_bundle\",\n          \"opcode\": \"deliver_bundle_to_requested_path\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"bundle.zip\",\n              \"semantic_name\": \"bundle.zip\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"request_delivery_path\",\n              \"semantic_name\": \"request_delivery_path\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"return_after_delivery\",\n          \"opcode\": \"return\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_manifest\",\n      \"target_block_ref\": \"extract_document_paths\"\n    },\n    {\n      \"source_block_ref\": \"extract_document_paths\",\n      \"target_block_ref\": \"read_request_settings\"\n    },\n    {\n      \"source_block_ref\": \"read_request_settings\",\n      \"target_block_ref\": \"convert_documents\"\n    },\n    {\n      \"source_block_ref\": \"convert_documents\",\n      \"target_block_ref\": \"package_bundle\"\n    },\n    {\n      \"source_block_ref\": \"package_bundle\",\n      \"target_block_ref\": \"deliver_bundle\"\n    }\n  ],\n  \"diagnostics\": []\n}"
