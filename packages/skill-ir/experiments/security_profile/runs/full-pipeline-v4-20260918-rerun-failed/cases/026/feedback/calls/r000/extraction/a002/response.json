"{\n  \"entry_block_ref\": \"check_npx\",\n  \"constraints\": [\n    \"Treat this skill as CLI-first automation.\",\n    \"Do not pivot to `@playwright/test` unless the user explicitly asks for test files.\",\n    \"Before proposing commands, check whether `npx` is available (the wrapper depends on it).\",\n    \"If it is not available, pause and ask the user to install Node.js/npm (which provides `npx`).\",\n    \"Once `npx` is present, proceed with the wrapper script. A global install of `playwright-cli` is optional.\",\n    \"Prefer the bundled wrapper script so the CLI works even when it is not globally installed.\",\n    \"Prefer the wrapper unless the repository already standardizes on a global install.\",\n    \"Always snapshot before referencing element ids like `e12`.\",\n    \"Re-snapshot when refs seem stale.\",\n    \"Prefer explicit commands over `eval` and `run-code` unless needed.\",\n    \"When you do not have a fresh snapshot, use placeholder refs like `eX` and say why; do not bypass refs with `run-code`.\",\n    \"Use `--headed` when a visual check will help.\",\n    \"When capturing artifacts in this repo, use `output/playwright/` and avoid introducing new top-level artifact folders.\",\n    \"Default to CLI commands and workflows, not Playwright test specs.\",\n    \"In this repo, run commands from `output/playwright/<label>/` to keep artifacts contained.\",\n    \"If an element ref fails, run `pwcli snapshot` again and retry.\",\n    \"If the page looks wrong, re-open with `--headed` and resize the window.\",\n    \"If a flow depends on prior state, use a named `--session`.\"\n  ],\n  \"declared_context_keys\": [\n    \"PATH\",\n    \"CODEX_HOME\",\n    \"HOME\"\n  ],\n  \"blocks\": [\n    {\n      \"block_ref\": \"check_npx\",\n      \"block_name\": \"Check whether npx is available\",\n      \"data_source_kind\": \"context\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"check_npx_availability\",\n          \"opcode\": \"check_npx_availability\",\n          \"inputs\": [\n            {\n              \"type\": \"context_key\",\n              \"identifier\": \"PATH\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"npx_available\"\n            }\n          ],\n          \"metadata\": {\n            \"script_content\": \"command -v npx >/dev/null 2>&1\"\n          }\n        },\n        {\n          \"instruction_ref\": \"dispatch_npx_check\",\n          \"opcode\": \"dispatch\"\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"decide_npx\",\n      \"block_name\": \"Branch on npx availability\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"dispatch_npx\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"npx_available\"\n            }\n          ]\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"ask_install\",\n      \"block_name\": \"Ask the user to install Node.js/npm\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"ask_user_to_install_nodejs\",\n          \"opcode\": \"ask_user_to_install_nodejs\",\n          \"inputs\": [\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"node --version\\nnpm --version\\nnpm install -g @playwright/cli@latest\\nplaywright-cli --help\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"Provide these steps verbatim.\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_after_install_request\",\n          \"opcode\": \"dispatch\"\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"set_path\",\n      \"block_name\": \"Set the bundled Playwright CLI wrapper path\",\n      \"data_source_kind\": \"context\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"set_playwright_cli_wrapper_path\",\n          \"opcode\": \"set_playwright_cli_wrapper_path\",\n          \"inputs\": [\n            {\n              \"type\": \"context_key\",\n              \"identifier\": \"CODEX_HOME\"\n            },\n            {\n              \"type\": \"context_key\",\n              \"identifier\": \"HOME\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"pwcli_path\"\n            }\n          ],\n          \"metadata\": {\n            \"script_content\": \"export CODEX_HOME=\\\"${CODEX_HOME:-$HOME/.codex}\\\"\\nexport PWCLI=\\\"$CODEX_HOME/skills/playwright/scripts/playwright_cli.sh\\\"\"\n          }\n        },\n        {\n          \"instruction_ref\": \"dispatch_after_path_setup\",\n          \"opcode\": \"dispatch\"\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"open_page\",\n      \"block_name\": \"Open the target browser page\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"open_page\",\n          \"opcode\": \"execute_playwright_cli_wrapper\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"pwcli_path\"\n            },\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"target_webpage\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"open\"\n            }\n          ],\n          \"outputs\": [],\n          \"metadata\": {\n            \"script_content\": \"#!/usr/bin/env bash\\nset -euo pipefail\\n\\nif ! command -v npx >/dev/null 2>&1; then\\n  echo \\\"Error: npx is required but not found on PATH.\\\" >&2\\n  exit 1\\nfi\\n\\nhas_session_flag=\\\"false\\\"\\nfor arg in \\\"$@\\\"; do\\n  case \\\"$arg\\\" in\\n    --session|--session=*)\\n      has_session_flag=\\\"true\\\"\\n      break\\n      ;;\\n  esac\\ndone\\n\\ncmd=(npx --yes --package @playwright/cli playwright-cli)\\nif [[ \\\"${has_session_flag}\\\" != \\\"true\\\" && -n \\\"${PLAYWRIGHT_CLI_SESSION:-}\\\" ]]; then\\n  cmd+=(--session \\\"${PLAYWRIGHT_CLI_SESSION}\\\")\\nfi\\ncmd+=(\\\"$@\\\")\\n\\nexec \\\"${cmd[@]}\\\"\"\n          }\n        },\n        {\n          \"instruction_ref\": \"dispatch_after_open\",\n          \"opcode\": \"dispatch\"\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"snapshot\",\n      \"block_name\": \"Take a browser snapshot to get element refs\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"take_browser_snapshot\",\n          \"opcode\": \"execute_playwright_cli_wrapper\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"pwcli_path\"\n            },\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"browser_session\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"snapshot\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"snapshot_refs\"\n            }\n          ],\n          \"metadata\": {\n            \"script_content\": \"#!/usr/bin/env bash\\nset -euo pipefail\\n\\nif ! command -v npx >/dev/null 2>&1; then\\n  echo \\\"Error: npx is required but not found on PATH.\\\" >&2\\n  exit 1\\nfi\\n\\nhas_session_flag=\\\"false\\\"\\nfor arg in \\\"$@\\\"; do\\n  case \\\"$arg\\\" in\\n    --session|--session=*)\\n      has_session_flag=\\\"true\\\"\\n      break\\n      ;;\\n  esac\\ndone\\n\\ncmd=(npx --yes --package @playwright/cli playwright-cli)\\nif [[ \\\"${has_session_flag}\\\" != \\\"true\\\" && -n \\\"${PLAYWRIGHT_CLI_SESSION:-}\\\" ]]; then\\n  cmd+=(--session \\\"${PLAYWRIGHT_CLI_SESSION}\\\")\\nfi\\ncmd+=(\\\"$@\\\")\\n\\nexec \\\"${cmd[@]}\\\"\"\n          }\n        },\n        {\n          \"instruction_ref\": \"dispatch_after_snapshot\",\n          \"opcode\": \"dispatch\"\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"interact\",\n      \"block_name\": \"Interact with the page using the latest snapshot refs\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"interact_with_snapshot_ref\",\n          \"opcode\": \"execute_playwright_cli_wrapper\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"pwcli_path\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"snapshot_refs\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"click/type/press\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"interaction_result\"\n            }\n          ],\n          \"metadata\": {\n            \"script_content\": \"#!/usr/bin/env bash\\nset -euo pipefail\\n\\nif ! command -v npx >/dev/null 2>&1; then\\n  echo \\\"Error: npx is required but not found on PATH.\\\" >&2\\n  exit 1\\nfi\\n\\nhas_session_flag=\\\"false\\\"\\nfor arg in \\\"$@\\\"; do\\n  case \\\"$arg\\\" in\\n    --session|--session=*)\\n      has_session_flag=\\\"true\\\"\\n      break\\n      ;;\\n  esac\\ndone\\n\\ncmd=(npx --yes --package @playwright/cli playwright-cli)\\nif [[ \\\"${has_session_flag}\\\" != \\\"true\\\" && -n \\\"${PLAYWRIGHT_CLI_SESSION:-}\\\" ]]; then\\n  cmd+=(--session \\\"${PLAYWRIGHT_CLI_SESSION}\\\")\\nfi\\ncmd+=(\\\"$@\\\")\\n\\nexec \\\"${cmd[@]}\\\"\"\n          }\n        },\n        {\n          \"instruction_ref\": \"dispatch_after_interact\",\n          \"opcode\": \"dispatch\"\n        }\n      ],\n      \"constraints\": [\n        \"Always snapshot before referencing element ids like `e12`.\",\n        \"Prefer explicit commands over `eval` and `run-code` unless needed.\"\n      ]\n    },\n    {\n      \"block_ref\": \"assess_resnapshot\",\n      \"block_name\": \"Determine whether a new snapshot is needed\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"assess_need_for_resnapshot\",\n          \"opcode\": \"assess_need_for_resnapshot\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"interaction_result\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"needs_resnapshot\"\n            }\n          ],\n          \"constraints\": [\n            \"Snapshot again after navigation, clicking elements that change the UI substantially, opening/closing modals or menus, and tab switches.\",\n            \"Re-snapshot when refs seem stale.\",\n            \"When a command fails due to a missing ref, snapshot again.\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_resnapshot_decision\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"needs_resnapshot\"\n            }\n          ]\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"capture_artifacts\",\n      \"block_name\": \"Capture browser artifacts when useful\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"capture_browser_artifacts\",\n          \"opcode\": \"execute_playwright_cli_wrapper\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"pwcli_path\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"screenshot/pdf/traces\"\n            }\n          ],\n          \"outputs\": [],\n          \"metadata\": {\n            \"script_content\": \"#!/usr/bin/env bash\\nset -euo pipefail\\n\\nif ! command -v npx >/dev/null 2>&1; then\\n  echo \\\"Error: npx is required but not found on PATH.\\\" >&2\\n  exit 1\\nfi\\n\\nhas_session_flag=\\\"false\\\"\\nfor arg in \\\"$@\\\"; do\\n  case \\\"$arg\\\" in\\n    --session|--session=*)\\n      has_session_flag=\\\"true\\\"\\n      break\\n      ;;\\n  esac\\ndone\\n\\ncmd=(npx --yes --package @playwright/cli playwright-cli)\\nif [[ \\\"${has_session_flag}\\\" != \\\"true\\\" && -n \\\"${PLAYWRIGHT_CLI_SESSION:-}\\\" ]]; then\\n  cmd+=(--session \\\"${PLAYWRIGHT_CLI_SESSION}\\\")\\nfi\\ncmd+=(\\\"$@\\\")\\n\\nexec \\\"${cmd[@]}\\\"\"\n          }\n        },\n        {\n          \"instruction_ref\": \"dispatch_after_capture\",\n          \"opcode\": \"dispatch\"\n        }\n      ],\n      \"constraints\": [\n        \"When capturing artifacts in this repo, use `output/playwright/` and avoid introducing new top-level artifact folders.\"\n      ]\n    },\n    {\n      \"block_ref\": \"finish\",\n      \"block_name\": \"Return the completed browser workflow\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"return_result\",\n          \"opcode\": \"return\",\n          \"inputs\": [\n            {\n              \"type\": \"literal\",\n              \"literal_value\": \"browser workflow completed\"\n            }\n          ]\n        }\n      ],\n      \"constraints\": []\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"check_npx\",\n      \"target_block_ref\": \"decide_npx\"\n    },\n    {\n      \"source_block_ref\": \"decide_npx\",\n      \"target_block_ref\": \"ask_install\",\n      \"condition_text\": \"npx is not available\"\n    },\n    {\n      \"source_block_ref\": \"decide_npx\",\n      \"target_block_ref\": \"set_path\",\n      \"condition_text\": \"npx is available\"\n    },\n    {\n      \"source_block_ref\": \"ask_install\",\n      \"target_block_ref\": \"check_npx\"\n    },\n    {\n      \"source_block_ref\": \"set_path\",\n      \"target_block_ref\": \"open_page\"\n    },\n    {\n      \"source_block_ref\": \"open_page\",\n      \"target_block_ref\": \"snapshot\"\n    },\n    {\n      \"source_block_ref\": \"snapshot\",\n      \"target_block_ref\": \"interact\"\n    },\n    {\n      \"source_block_ref\": \"interact\",\n      \"target_block_ref\": \"assess_resnapshot\"\n    },\n    {\n      \"source_block_ref\": \"assess_resnapshot\",\n      \"target_block_ref\": \"snapshot\",\n      \"condition_text\": \"needs resnapshot\"\n    },\n    {\n      \"source_block_ref\": \"assess_resnapshot\",\n      \"target_block_ref\": \"capture_artifacts\",\n      \"condition_text\": \"no resnapshot needed\"\n    },\n    {\n      \"source_block_ref\": \"capture_artifacts\",\n      \"target_block_ref\": \"finish\"\n    }\n  ],\n  \"diagnostics\": [\n    \"Reference guides (references/cli.md, references/workflows.md) and recommended pattern examples were treated as informational and not extracted as mandatory execution blocks.\",\n    \"agents/openai.yaml, assets, LICENSE.txt, and NOTICE.txt contain metadata, legal text, or binary assets and were not extracted as executable behavior.\",\n    \"The wrapper script's internal npx check and session handling are preserved in metadata.script_content of the wrapper invocation instructions; the skill-level prerequisite check is modeled separately as required by SKILL.md.\"\n  ]\n}"
