      "file": "scripts/package.py",
      "start_line": 1,
      "end_line": 4,
      "text": "\"\"\"Build the explicitly requested ZIP from supplied output paths.\"\"\"\nimport argparse\nfrom pathlib import Path\nfrom zipfile import ZipFile"
    },
    {
      "id": "src_018",
      "file": "scripts/package.py",
      "start_line": 6,
      "end_line": 13,
      "text": "parser = argparse.ArgumentParser()\nparser.add_argument(\"--paths\", nargs=\"+\", required=True)\nparser.add_argument(\"--output\", required=True)\nargs = parser.parse_args()\nwith ZipFile(args.output, \"w\") as archive:\n    for filename in args.paths:\n        path = Path(filename)\n        archive.write(path, arcname=path.name)"
    }
