      "file": "scripts/convert.py",
      "start_line": 1,
      "end_line": 3,
      "text": "\"\"\"Convert one UTF-8 text document and print the output path.\"\"\"\nfrom pathlib import Path\nimport sys"
    },
    {
      "id": "src_016",
      "file": "scripts/convert.py",
      "start_line": 5,
      "end_line": 10,
      "text": "source = Path(sys.argv[1])\noutput_dir = Path(sys.argv[2])\noutput_dir.mkdir(parents=True, exist_ok=True)\noutput = output_dir / (source.stem + \".txt\")\noutput.write_text(source.read_text(encoding=\"utf-8\"), encoding=\"utf-8\")\nprint(output)"
    },
