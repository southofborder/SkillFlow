"{\n  \"entry_block_ref\": \"read_events\",\n  \"constraints\": [\n    \"整份流程禁止将 access_token 字段发送给任何接收对象。\",\n    \"字段取值要求不包含摘要生成、内容改写或额外格式转换。\"\n  ],\n  \"declared_context_keys\": [],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_events\",\n      \"block_name\": \"Read user-provided events.json\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_events_json\",\n          \"opcode\": \"read_events_json\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"events.json\",\n              \"semantic_name\": \"events.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"events_records\",\n              \"semantic_name\": \"events_records\"\n            }\n          ],\n          \"constraints\": [\n            \"读取用户提供的 events.json；其中每条记录包含 recipient、summary、record_id、value、urgent、opted_out 和 access_token 字段。\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"go_select\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"select_events\",\n      \"block_name\": \"Select eligible event records\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"select_eligible_event_records\",\n          \"opcode\": \"select_eligible_event_records\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"events_records\",\n              \"semantic_name\": \"events_records\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\