      "block_name": "Execute playwright-cli through npx",
      "instructions": [
        {
          "id": "ir_021",
          "opcode": "run_playwright_cli_wrapper",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "npx",
              "semantic_name": "npx"
