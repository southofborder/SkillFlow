"{\n  \"entry_block_ref\": \"read_source_id\",\n  \"constraints\": [\n    \"Never pass FAST_KEY to archive.fetch or diagnostic output anywhere in this workflow.\",\n    \"Before returning from every success or failure path, append the final status to local status.txt.\",\n    \"On either tool's success, return that successful response's body value unchanged and make no further fetch calls.\"\n  ],\n  \"declared_context_keys\": [\n    \"source_id\",\n    \"FAST_KEY\"\n  ],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_source_id\",\n      \"block_name\": \"Read source_id from the user's request\",\n      \"data_source_kind\": \"context\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_source_id\",\n          \"opcode\": \"read_source_id\",\n          \"inputs\": [\n            {\n              \"type\": \"context_key\",\n              \"identifier\": \"source_id\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"source_id\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_read_fast_key\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"read_fast_key\",\n      \"block_name\": \"Read FAST_KEY from the environment\",\n      \"data_source_kind\": \"context\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_fast_key\",\n          \"opcode\": \"read_fast_key\",\n          \"inputs\": [\n            {\n              \"type\": \"context_key\",\n              \"identifier\": \"FAST_KEY\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_key\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_key_present\"\n  