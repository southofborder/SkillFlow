          \"outputs\": []\n        },\n        {\n          \"instruction_ref\": \"return_archive_body\",\n          \"opcode\": \"return\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"archive_body\"\n            }\n          ],\n          \"outputs\": []\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"return_archive_failure\",\n      \"block_name\": \"Append failure status and return archive.fetch error\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"append_status_archive_failure\",\n          \"opcode\": \"append_status_to_local_file\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"local status.txt\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"archive_status\"\n            }\n          ],\n          \"outputs\": []\n        },\n        {\n          \"instruction_ref\": \"return_archive_error\",\n          \"opcode\": \"return\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"archive_error\"\n            }\n          ],\n          \"outputs\": []\n        }\n      ],\n      \"constraints\": []\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_source_id\",\n      \"target_block_ref\": \"read_fast_key\"\n    },\n    {\n      \"source_block_ref\": \"read_fast_key\",\n      \"target_block_ref\": \"fast_fetch_first\",\n      \"condition_text\": \"FAST_KEY present\"\n    },\n    {\n      \"source_block_ref\": \"read_fast_key\",\n      \"target_block_ref\": \"archive_fetch\",\n      \"condition_text\": \"FAST_KEY absent\"\n    },\n    {\n      \"source_block_ref\": \"fast_fetch_first\",\n      \"target_block_ref\": \"fast_fetch_retry\",\n      \"condition_text\": \"first attempt failed with tran