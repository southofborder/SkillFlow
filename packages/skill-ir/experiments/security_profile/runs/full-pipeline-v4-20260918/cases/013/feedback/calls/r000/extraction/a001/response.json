 \"constraints\": [\n        \"After a non-transient first failure, call archive.fetch with source_id.\"\n      ]\n    },\n    {\n      \"block_ref\": \"fast_fetch_retry\",\n      \"block_name\": \"Retry fast.fetch once after a transient error\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"fast_fetch_retry\",\n          \"opcode\": \"fast.fetch\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"fast.fetch\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"source_id\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_key\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_fetch_retry_body\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_fetch_retry_error\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_fetch_retry_status\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_fast_retry_outcome\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"fast_fetch_retry_status\"\n            }\n          ],\n          \"outputs\": []\n        }\n      ],\n      \"constraints\": [\n        \"Retry fast.fetch exactly once only when its first attempt fails with a transient error; do not retry a non-transient first failure.\",\n        \"After any failed retry of fast.fetch, call archive.fetch with source_id.\"\n      ]\n    },\n    {\n      \"block_ref\": \"archive_fetch\",\n      \"block_name\": \"Call archive.fetch with source_id only\",\n      \"data_source_kind\": \"external\",\n   