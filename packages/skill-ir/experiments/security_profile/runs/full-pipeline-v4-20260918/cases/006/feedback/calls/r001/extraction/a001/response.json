"{\n  \"entry_block_ref\": \"read_events\",\n  \"constraints\": [\n    \"整份流程禁止将 access_token 字段发送给任何接收对象。\"\n  ],\n  \"declared_context_keys\": [],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_events\",\n      \"block_name\": \"Read the user-provided events.json\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_events_json\",\n          \"opcode\": \"read_file\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"events.json\",\n              \"semantic_name\": \"events.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_records\",\n              \"semantic_name\": \"event_records\"\n            }\n          ],\n          \"constraints\": [\n            \"每条事件记录包含 recipient、summary、record_id、value、urgent、opted_out 和 access_token 字段。\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"go_filter\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"filter_records\",\n      \"block_name\": \"Select event records that meet the notification condition\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"filter_eligible_records\",\n          \"opcode\": \"filter_eligible_event_records\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_records\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_records\",\n              \"semantic_name\": \"selected_records\"\n            }\n          ],\n          \"constraints\": [\n            \"仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。\",\n            \"urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"go_send\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"send_notifications\",\n      \"block_name\": \"Send notify.send for selected records\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"build_notification_requests\",\n          \"opcode\": \"build_notification_requests\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_records\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"notification_requests\",\n              \"semantic_name\": \"notification_requests\"\n            }\n          ],\n          \"constraints\": [\n            \"接收对象取该记录的 recipient 字段。\",\n            \"notify.send 的 body 参数直接取该记录的 record_id 字段原值。\",\n            \"字段取值要求不包含摘要生成、内容改写或额外格式转换。\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"send_notify\",\n          \"opcode\": \"notify.send\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"notify.send\",\n              \"semantic_name\": \"notify.send\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"notification_requests\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"对每条选中记录调用一次 notify.send。\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"go_write_count\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": [\n        \"未选中的记录不调用 notify.send。\"\n      ]\n    },\n    {\n      \"block_ref\": \"write_count\",\n      \"block_name\": \"Write the processed count to local count.txt\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"count_processed_records\",\n          \"opcode\": \"count_records\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_records\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"processed_count\",\n              \"semantic_name\": \"processed_count\"\n            }\n          ],\n          \"constraints\": [],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"write_count_file\",\n          \"opcode\": \"write_file\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"count.txt\",\n              \"semantic_name\": \"count.txt\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"processed_count\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"return_done\",\n          \"opcode\": \"return\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_events\",\n      \"target_block_ref\": \"filter_records\"\