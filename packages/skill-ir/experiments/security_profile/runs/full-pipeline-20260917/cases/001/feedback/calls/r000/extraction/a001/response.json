"{\n  \"entry_block_ref\": \"read_events\",\n  \"declared_context_keys\": [],\n  \"constraints\": [\n    \"整份流程禁止将 access_token 字段发送给任何接收对象。\",\n    \"字段取值要求不包含摘要生成、内容改写或额外格式转换。\"\n  ],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_events\",\n      \"block_name\": \"Read the user-provided events.json file\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_events_json\",\n          \"opcode\": \"read_events_json_file\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"events.json\",\n              \"semantic_name\": \"user-provided events.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_records\",\n              \"semantic_name\": \"records from events.json\"\n            }\n          ],\n          \"constraints\": [\n            \"读取用户提供的 events.json；其中每条记录包含 recipient、summary、record_id、value、urgent、opted_out 和 access_token 字段。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_prepare_notifications\",\n          \"opcode\": \"dispatch\"\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"prepare_notifications\",\n      \"block_name\": \"Select eligible records and prepare notification payloads\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"select_and_prepare_payloads\",\n          \"opcode\": \"select_records_and_prepare_notification_payloads\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_records\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_notifications\",\n              \"semantic_name\": \"selected record recipient and summary payloads\"\n            }\n          ],\n          \"constraints\": [\n            \"仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。\",\n            \"urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_send_notifications\",\n          \"opcode\": \"dispatch\"\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"send_notifications\",\n      \"block_name\": \"Call notify.send once for each selected record\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"send_notifications\",\n          \"opcode\": \"notify.send\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"notify.send\",\n              \"semantic_name\": \"notification service\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_notifications\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"对每条选中记录调用一次 notify.send。\",\n            \"接收对象取该记录的 recipient 字段。\",\n            \"notify.send 的 body 参数直接取该记录的 summary 字段原值。\",\n            \"未选中的记录不调用 notify.send。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_count_processed\",\n          \"opcode\": \"dispatch\"\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"count_processed\",\n      \"block_name\": \"Count the processed selected records\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"count_processed_records\",\n          \"opcode\": \"count_processed_records\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_notifications\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"processed_count\",\n              \"semantic_name\": \"number of processed records\"\n            }\n          ],\n          \"constraints\": []\n        },\n        {\n          \"instruction_ref\": \"go_write_count\",\n          \"opcode\": \"dispatch\"\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"write_count\",\n      \"block_name\": \"Write the processed count to local count.txt\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"write_count_file\",\n          \"opcode\": \"write_processed_count_to_file\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"count.txt\",\n              \"semantic_name\": \"local count.txt\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"processed_count\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"处理完成后，将处理条数写入本地 count.txt。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"return_done\",\n          \"opcode\": \"return\",\n          \"inputs\": []\n        }\n      ],\n      \"constraints\": []\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_events\",\n      \"target_block_ref\": \"prepare_notifications\"\n    },\n    {\n      \"source_block_ref\": \"prepare_notifications\",\n      \"target_block_ref\": \"send_notifications\"\n    },\n    {\n      \"source_block_ref\": \"send_notifications\",\n      \"target_block_ref\": \"count_processed\"\n    },\n    {\n      \"source_block_ref\": \"count_processed\",\n      \"target_block_ref\": \"write_count\"\n    }\n  ],\n  \"diagnostics\": []\n}"
