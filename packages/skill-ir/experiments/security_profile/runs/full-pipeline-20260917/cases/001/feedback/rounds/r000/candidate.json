              "identifier": "selected_notifications"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "processed_count",
              "semantic_name": "number of processed records"
            }
          ],
          "constraints": []
        },
        {
          "instruction_ref": "go_write_count",
          "opcode": "dispatch"
        }
      ],
      "constraints": []
    },
