{
  "entry_block_ref": "read_events",
  "declared_context_keys": [],
  "constraints": [
    "整份流程禁止将 access_token 字段发送给任何接收对象。",
    "字段取值要求不包含摘要生成、内容改写或额外格式转换。"
  ],
  "blocks": [
    {
      "block_ref": "read_events",
      "block_name": "Read the user-provided events.json file",
      "data_source_kind": "external",
      "instructions": [
        {
          "instruction_ref": "read_events_json",
          "opcode": "read_events_json_file",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "events.json",
              "semantic_name": "user-provided events.json"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "event_records",
              "semantic_name": "records from events.json"
            }
          ],
          "constraints": [
            "读取用户提供的 events.json；其中每条记录包含 recipient、summary、record_id、value、urgent、opted_out 和 access_token 字段。"
          ]
        },
        {
          "instruction_ref": "go_prepare_notifications",
          "opcode": "dispatch"
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "prepare_notifications",
      "block_name": "Select eligible records and prepare notification payloads",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "select_and_prepare_payloads",
          "opcode": "select_records_and_prepare_notification_payloads",
          "inputs": [
            {
              "type": "result",
              "identifier": "event_records"
            }
          ],
          "outputs": [
            {
              "type": "result",
              "identifier": "selected_notifications",
              "semantic_name": "selected record recipient and summary payloads"
            }
          ],
          "constraints": [
            "仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。",
            "urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。"
          ]
        },
        {
          "instruction_ref": "go_send_notifications",
          "opcode": "dispatch"
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "send_notifications",
      "block_name": "Call notify.send once for each selected record",
      "data_source_kind": null,
      "instructions": [
        {
          "instruction_ref": "send_notifications",
          "opcode": "notify.send",
          "inputs": [
            {
              "type": "external_resource",
              "identifier": "notify.send",
              "semantic_name": "notification service"
            },
            {
              "type": "result",
              "identifier": "selected_notifications"
            }
          ],
          "outputs": [],
          "constraints": [
            "对每条选中记录调用一次 notify.send。",
            "接收对象取该记录的 recipient 字段。",
            "notify.send 的 body 参数直接取该记录的 summary 字段原值。",
            "未选中的记录不调用 notify.send。"
          ]
        },
        {
          "instruction_ref": "go_count_processed",
          "opcode": "dispatch"
        }
      ],
      "constraints": []
    },
    {
      "block_ref": "count_processed",
