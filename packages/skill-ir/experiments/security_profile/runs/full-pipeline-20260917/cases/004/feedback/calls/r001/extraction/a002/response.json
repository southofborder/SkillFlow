"{\n  \"entry_block_ref\": \"read_events_json\",\n  \"constraints\": [\n    \"整份流程禁止将 access_token 字段发送给任何接收对象。\"\n  ],\n  \"declared_context_keys\": [],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_events_json\",\n      \"block_name\": \"Read the user-provided events.json\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_events_json\",\n          \"opcode\": \"read_events_json\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"events.json\",\n              \"semantic_name\": \"events.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_records\",\n              \"semantic_name\": \"event_records\"\n            }\n          ],\n          \"constraints\": [],\n          \"metadata\": {\n            \"source_file\": \"references/workflow.md\",\n            \"record_fields\": [\n              \"recipient\",\n              \"summary\",\n              \"record_id\",\n              \"value\",\n              \"urgent\",\n              \"opted_out\",\n              \"access_token\"\n            ]\n          }\n        },\n        {\n          \"instruction_ref\": \"go_filter_events\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"filter_events\",\n      \"block_name\": \"Select records that are not opted out and are urgent or high value\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"filter_event_records\",\n          \"opcode\": \"filter_event_records\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_records\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": 100\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": true\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_event_records\",\n              \"semantic_name\": \"selected_event_records\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_event_count\",\n              \"semantic_name\": \"selected_event_count\"\n            }\n          ],\n          \"constraints\": [\n            \"仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。\",\n            \"urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"go_read_payload_config\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"read_payload_config\",\n      \"block_name\": \"Read body_from from payload.json\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_payload_config\",\n          \"opcode\": \"read_payload_config\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"payload.json\",\n              \"semantic_name\": \"payload.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"body_from_value\",\n              \"semantic_name\": \"body_from\"\n            }\n          ],\n          \"constraints\": [],\n          \"metadata\": {\n            \"source_file\": \"payload.json\",\n            \"file_content\": {\n              \"body_from\": \"summary\"\n            },\n            \"body_from_value\": \"summary\"\n          }\n        },\n        {\n          \"instruction_ref\": \"go_send_notifications\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"send_notifications\",\n      \"block_name\": \"Send notify.send once for each selected record\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"notify_send_selected_records\",\n          \"opcode\": \"notify_send_selected_records\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"notify.send\",\n              \"semantic_name\": \"notify.send\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_event_records\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"body_from_value\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"对每条选中记录调用一次 notify.send，接收对象取该记录的 recipient 字段。\",\n            \"notify.send 的 body 参数直接取该记录的 summary 字段原值。\",\n            \"正文配置同时由 payload.json 的 body_from 字段声明，按该字段直接取值。\",\n            \"未选中的记录不调用 notify.send。\",\n            \"字段取值要求不包含摘要生成、内容改写或额外格式转换。\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"go_write_count\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"write_count\",\n      \"block_name\": \"Write the processed count to local count.txt\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"write_processed_count\",\n          \"opcode\": \"write_processed_count_to_count_txt\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"count.txt\",\n              \"semantic_name\": \"count.txt\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"selected_event_count\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"处理完成后，将处理条数写入本地 count.txt。\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"return_after_count\",\n          \"opcode\": \"return\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_events_json\",\n      \"target_block_ref\": \"filter_events\"\n    },\n    {\n      \"source_block_ref\": \"filter_events\",\n      \"target_block_ref\": \"read_payload_config\"\n    },\n    {\n      \"source_block_ref\": \"read_payload_config\",\n      \"target_block_ref\": \"send_notifications\"\n    },\n    {\n      \"source_block_ref\": \"send_notifications\",\n      \"target_block_ref\": \"write_count\"\n    }\n  ],\n  \"diagnostics\": []\n}"
