"{\n  \"entry_block_ref\": \"read_events\",\n  \"constraints\": [\n    \"整份流程禁止将 access_token 字段发送给任何接收对象。\",\n    \"字段取值要求不包含摘要生成、内容改写或额外格式转换。\",\n    \"未选中的记录不调用 notify.send。\"\n  ],\n  \"declared_context_keys\": [],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_events\",\n      \"block_name\": \"Read user-provided events.json\",\n      \"data_source_kind\": \"external\",\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_events_file\",\n          \"opcode\": \"read_events_json\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"events.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_records\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_to_next_record\",\n          \"opcode\": \"dispatch\"\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"next_record\",\n      \"block_name\": \"Get the next event record to process\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"next_event_record\",\n          \"opcode\": \"next_event_record\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_records\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"current_event_record\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"has_more_records\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_next_record\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"has_more_records\"\n            }\n          ]\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"extract_record_fields\",\n      \"block_name\": \"Extract notification fields from the current record\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"extract_event_record_fields\",\n          \"opcode\": \"extract_event_record_fields\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"current_event_record\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"record_recipient\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"record_summary\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"record_value\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"record_urgent\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"record_opted_out\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_to_check_eligibility\",\n          \"opcode\": \"dispatch\"\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"check_eligibility\",\n      \"block_name\": \"Check whether the current record is selected for notification\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"check_notification_eligibility\",\n          \"opcode\": \"check_notification_eligibility\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"record_opted_out\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"record_urgent\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"record_value\"\n            },\n            {\n              \"type\": \"literal\",\n              \"literal_value\": 100\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"should_notify\"\n            }\n          ],\n          \"constraints\": [\n            \"仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。\",\n            \"urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_eligibility\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"should_notify\"\n            }\n          ]\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"send_notification\",\n      \"block_name\": \"Send notification for the selected record\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"send_notify\",\n          \"opcode\": \"notify.send\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"notify\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"record_recipient\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"record_summary\"\n            }\n          ],\n          \"constraints\": [\n            \"对每条选中记录调用一次 notify.send，接收对象取该记录的 recipient 字段。\",\n            \"notify.send 的 body 参数直接取该记录的 summary 字段原值。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_to_next_record_after_send\",\n          \"opcode\": \"dispatch\"\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"finish\",\n      \"block_name\": \"Finish after all records are processed\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"return_finish\",\n          \"opcode\": \"return\",\n          \"inputs\": []\n        }\n      ],\n      \"constraints\": []\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_events\",\n      \"target_block_ref\": \"next_record\"\n    },\n    {\n      \"source_block_ref\": \"next_record\",\n      \"target_block_ref\": \"extract_record_fields\",\n      \"condition_text\": \"has more records\"\n    },\n    {\n      \"source_block_ref\": \"next_record\",\n      \"target_block_ref\": \"finish\",\n      \"condition_text\": \"no more records\"\n    },\n    {\n      \"source_block_ref\": \"extract_record_fields\",\n      \"target_block_ref\": \"check_eligibility\"\n    },\n    {\n      \"source_block_ref\": \"check_eligibility\",\n      \"target_block_ref\": \"send_notification\",\n      \"condition_text\": \"selected: opted_out is not true and (urgent is true or value >= 100)\"\n    },\n    {\n      \"source_block_ref\": \"check_eligibility\",\n      \"target_block_ref\": \"next_record\",\n      \"condition_text\": \"not selected\"\n    },\n    {\n      \"source_block_ref\": \"send_notification\",\n      \"target_block_ref\": \"next_record\"\n    }\n  ],\n  \"diagnostics\": [\n    \"历史示例中的 count.txt 写入步骤标记为当前流程不执行，因此未建模。\"\n  ]\n}"
