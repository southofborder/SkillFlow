"{\n  \"entry_block_ref\": \"read_events_file\",\n  \"declared_context_keys\": [],\n  \"constraints\": [\n    \"整份流程禁止将 access_token 字段发送给任何接收对象。\",\n    \"字段取值要求不包含摘要生成、内容改写或额外格式转换。\",\n    \"未选中的记录不调用 notify.send。\"\n  ],\n  \"blocks\": [\n    {\n      \"block_ref\": \"read_events_file\",\n      \"block_name\": \"Read events.json\",\n      \"data_source_kind\": \"external\",\n      \"constraints\": [\n        \"读取用户提供的 events.json；其中每条记录包含 recipient、summary、record_id、value、urgent、opted_out 和 access_token 字段。\"\n      ],\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_events_json\",\n          \"opcode\": \"read_events_json\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"events.json\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_records\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_to_next_event\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": []\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"next_event\",\n      \"block_name\": \"Get the next event record\",\n      \"data_source_kind\": null,\n      \"constraints\": [],\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"get_next_record\",\n          \"opcode\": \"get_next_event_record\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"event_records\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"current_event_record\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"has_next_event_record\"\n            }\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_next\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"has_next_event_record\"\n            }\n          ],\n          \"outputs\": []\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"evaluate_record\",\n      \"block_name\": \"Evaluate notification selection for the current record\",\n      \"data_source_kind\": null,\n      \"constraints\": [\n        \"仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。\",\n        \"urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。\"\n      ],\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"evaluate_selection\",\n          \"opcode\": \"evaluate_notification_selection\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"current_event_record\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"record_selected\"\n            }\n          ],\n          \"constraints\": [\n            \"仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。\",\n            \"urgent 为 true 只豁免数值门槛，不豁免 opted_out 的限制。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"dispatch_selection\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"record_selected\"\n            }\n          ],\n          \"outputs\": []\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"send_notification\",\n      \"block_name\": \"Send notify.send for the selected record\",\n      \"data_source_kind\": null,\n      \"constraints\": [\n        \"对每条选中记录调用一次 notify.send，接收对象取该记录的 recipient 字段。\",\n        \"notify.send 的 body 参数直接取该记录的 summary 字段原值。\",\n        \"未选中的记录不调用 notify.send。\"\n      ],\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"read_recipient\",\n          \"opcode\": \"read_recipient_field\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"current_event_record\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"notification_recipient\"\n            }\n          ],\n          \"constraints\": [\n            \"接收对象取该记录的 recipient 字段。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"read_summary\",\n          \"opcode\": \"read_summary_field\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"current_event_record\"\n            }\n          ],\n          \"outputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"notification_body\"\n            }\n          ],\n          \"constraints\": [\n            \"notify.send 的 body 参数直接取该记录的 summary 字段原值。\",\n            \"字段取值要求不包含摘要生成、内容改写或额外格式转换。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"send_notify\",\n          \"opcode\": \"notify.send\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"notify.send\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"notification_recipient\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"notification_body\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"对每条选中记录调用一次 notify.send。\",\n            \"整份流程禁止将 access_token 字段发送给任何接收对象。\"\n          ]\n        },\n        {\n          \"instruction_ref\": \"go_to_next_after_send\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": []\n        }\n      ]\n    },\n    {\n      \"block_ref\": \"write_count\",\n    