ue\": \"transform\", \"basis\": \"cfg\", \"ref_id\": \"g_0027\", \"quote\": \"count_processed_records\", \"reason\": \"对输入集合计数是实际计算，属 transform；不产生读取、写入或外发效果。\", \"effect_index\": 0}\n      ]\n    },\n    \"ir_008\": {\n      \"operator\": [\"agent_runtime\"],\n      \"roles\": [],\n      \"effects\": [],\n      \"evidences\": [\n        {\"field\": \"operator\", \"value\": \"agent_runtime\", \"basis\": \"cfg\", \"ref_id\": \"g_0028\", \"quote\": \"dispatch\", \"reason\": \"该指令是无输入输出的控制转移，由本地运行流程执行跳转，未涉及其他执行主体。\"},\n        {\"field\": \"roles\", \"value\": null, \"basis\": \"cfg\", \"ref_id\": \"g_0028\", \"quote\": \"dispatch\", \"reason\": \"控制跳转不引入、送达或加工内容，没有可支持的角色标签，故为空。\"},\n        {\"field\": \"effects\", \"value\": null, \"basis\": \"cfg\", \"ref_id\": \"g_0028\", \"quote\": \"dispatch\", \"reason\": \"dispatch 只做控制流转移；词表内无适用效果，但跳转本身仍影响后续执行顺序。\"}\n      ]\n    },\n    \"ir_009\": {\n      \"operator\": [\"agent_runtime\"],\n      \"roles\": [\"sink\"],\n      \"effects\": [\"fs_write\"],\n      \"evidences\": [\n        {\"field\": \"operator\", \"value\": \"agent_runtime\", \"basis\": \"source\", \"ref_id\": \"src_003\", \"quote\": \"处理完成后，将处理条数写入本地 count.txt。\", \"reason\": \"本地写文件步骤由 agent_runtime 执行；源文未提及模型或外部工具参与。\"},\n        {\"field\": \"roles\", \"value\": \"sink\", \"basis\": \"source\", \"ref_id\": \"src_003\", \"quote\": \"处理完成后，将处理条数写入本地 count.txt。\", \"reason\": \"写入使内容到达本地存储位置，属 sink；写入内容为计数值本身。\"},\n        {\"field\": \"effects\", \"value\": \"fs_write\", \"basis\": \"cfg\", \"ref_id\": \"g_0033\", \"quote\": \"write_file\", \"reason\": \"该 IR 的 opcode 值为 write_file 且目标为本地文件，产生 fs_write 效果。\", \"effect_index\": 0}\n      ]\n    },\n    \"ir_010\": {\n      \"operator\": [\"agent_runtime\"],\n      \"roles\": [],\n      \"effects\": [],\n      \"evidences\": [\n        {\"field\": \"operator\", \"value\": \"agent_runtime\", \"basis\": \"cfg\", \"ref_id\": \"g_0034\", \"quote\": \"return\", \"reason\": \"该指令结束流程，由运行流程执行返回控制。\"},\n        {\"field\": \"roles\", \"value\": null, \"basis\": \"cfg\", \"ref_id\": \"g_0034\", \"quote\": \"return\", \"reason\": \"结束控制不引入、送达或加工内容，无适用角色标签。\"},\n        {\"field\": \"effects\", \"value\": null, \"basis\": \"cfg\", \"ref_id\": \"g_0034\", \"quote\": \"return\", \"reason\": \"普通返回只是控制结束，词表内无适用效果；它也不等于面向用户的输出。\"}\n      ]\n    }\n  },\n  \"locations\": {\n    \"loc_events_json\": {\n      \"kind\": \"storage\",\n      \"name\": \"用户提供的 events.json\",\n      \"operand_refs\": [\n        {\"instruction_id\": \"ir_001\", \"side\": \"input\", \"index\": 0}\n      ]\n    },\n    \"loc_count_txt\": {\n      \"kind\": \"storage\",\n      \"name\": \"count.txt\",\n      \"operand_refs\": [\n        {\"instruction_id\": \"ir_009\", \"side\": \"input\", \"index\": 0}\n      ]\n    },\n    \"loc_notify_send\": {\n      \"kind\": \"remote\",\n      \"name\": \"notify.send\",\n      \"operand_refs\": [\n        {\"instruction_id\": \"ir_005\", \"side\": \"input\", \"index\": 0}\n      ]\n    }\n  },\n  \"transfer_specs\": {\n    \"ir_001\": {\n      \"events\": [\n        {\n          \"kind\": \"processing\",\n          \"mode\": \"default\",\n          \"returns\": [],\n          \"events\": [\n            {\n              \"effect_index\": 0,\n              \"atomic_ops\": [\n                {\n                  \"op\": \"read\",\n                  \"location\": \"loc_events_json\",\n                  \"output\": \"event_records\",\n                  \"evidences\": [\n                    {\"basis\": \"cfg\", \"ref_id\": \"g_0009\", \"quote\": \"read_file\", \"reason\": \"该 IR 的 opcode 值为 read_file，输入为文件资源，执行对文件内容的读取。\"},\n                    {\"basis\": \"execution_model\", \"ref_id\": \"EM01\", \"quote\": \"Preserve the related source whole as a possible acquisition scope unless an explicit interface or mechanism restricts the read or returned content.\", \"reason\": \"EM01：未见键限定接口或机制限制，获取范围保留为文件整体内容，不用单个字段替代来源整体。\"}\n                  ]\n                }\n              ]\n            }\n          ],\n          \"evidences\": [\n            {\"basis\": \"source\", \"ref_id\": \"src_003\", \"quote\": \"读取用户提供的 events.json\", \"reason\": \"源文只规定读取该文件，没有规定模型处理，也没有隔离执行与受限回传机制，故按默认模式编译，returns 为空。\"},\n            {\"basis\": \"execution_model\", \"ref_id\": \"EM03\", \"quote\": \"For content acquired for the agent's natural-language processing with no explicit isolation or restricted routing, retain possible model observation of the acquired version.\", \"reason\": \"EM03：读取所得版本在无显式隔离或受限路由时保留被模型观察的可能；这是契约默认，不是实测事件。\"}\n          ]\n        }\n      ],\n      \"output_bindings\": [\n        {\n          \"output_index\": 0,\n          \"value\": {\"kind\": \"local\", \"name\": \"event_records\"},\n          \"evidences\": [\n            {\"basis\": \"cfg\", \"ref_id\": \"g_0009\", \"quote\": \"event_records\", \"reason\": \"输出语义名为 event_records，绑定刚读取的整份文件内容，未做字段级替换。\"}\n          ]\n        }\n      ]\n    },\n    \"ir_002\": {\n      \"events\": [],\n      \"output_bindings\": []\n    },\n    \"ir_003\": {\n      \"events\": [\n        {\n          \"kind\": \"processing\",\n          \"mode\": \"default\",\n          \"returns\": [],\n          \"events\": [\n            {\n              \"effect_index\": 0,\n              \"atomic_ops\": [\n                {\n                  \"op\": \"filter_items\",\n                  \"input\": {\"kind\": \"input\", \"index\": 0},\n                  \"predicate\": \"仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。\",\n                  \"output\": \"selected_records\",\n                  \"evidences\": [\n                    {\"basis\": \"source\", \"ref_id\": \"src_003\", \"quote\": \"仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。\", \"reason\": \"该条件作为筛选谓词记录；静态分析不执行自然语言谓词，只保留选择关系。\"},\n                    {\"basis\": \"execution_model\", \"ref_id\": \"EM11\", \"quote\": \"filter_items preserves selected input elements unchanged under its recorded predicate\", \"reason\": \"EM11：筛选保留被选中元素原样，不对元素字段做改写。\"}\n                  ]\n                }\n              ]\n            }\n          ],\n          \"evidences\": [\n            {\"basis\": \"source\", \"ref_id\": \"src_003\", \"quote\": \"仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时，选中该记录。\", \"reason\": \"源文给出筛选条件，但未规定模型执行，也未规定隔离执行与受限回传机制，因此按默认模式编译，returns 为空。\"},\n            {\"basis\": \"execution_model\", \"ref_id\": \"EM10\", \"quote\": \"Default mode retains possible observation of read/receive outputs and non-isolated transformation inputs\", \"reason\": \"EM10：默认模式下，筛选所依据的读取输出保留被模型观察的可能；本段未声称存在局部隔离。\"}\n          ]\n        }\n      ],\n      \"output_bindings\": [\n        {\n          \"output_index\": 0,\n          \"value\": {\"kind\": \"local\", \"name\": \"selected_records\"},\n          \"evidences\": [\n            {\"basis\": \"cfg\", \"ref_id\": \"g_0015\", \"quote\": \"selected_records\", \"reason\": \"该 IR 输出语义名为 selected_records，绑定筛选得到的记录集合。\"}\n          ]\n        }\n      ]\n    },\n    \"ir_004\": {\n      \"events\": [],\n      \"output_bindings\": []\n    },\n    \"ir_005\": {\n      \"events\": [\n        {\n          \"kind\": \"for_each\",\n          \"collection\": {\"kind\": \"input\", \"index\": 1},\n          \"item\": \"record\",\n          \"body\": [\n            {\n              \"kind\": \"processing\",\n              \"mode\": \"default\",\n              \"returns\": [],\n              \"events\": [\n                {\n                  \"effect_index\": 0,\n                  \"atomic_ops\": [\n                    {\n                      \"op\": \"select_part\",\n                      \"input\": {\"kind\": \"local\", \"name\": \"record\"},\n                      \"path\": [\"recipient\"],\n                      \"output\": \"recipient_value\",\n                      \"evidences\": [\n                        {\"basis\": \"source\", \"ref_id\": \"src_003\", \"quote\": \"接收对象取该记录的 recipient 字段。\", \"reason\": \"源文明确接收对象取当前记录的 recipient 字段，属于对同一元素的显式字段选取。\"},\n                        {\"basis\": \"execution_model\", \"ref_id\": \"EM11\", \"quote\": \"for_each introduces one shared element binding per possible element so selections and delivery parameters retain that element's identity\", \"reason\": \"EM11：在同一元素绑定上选择字段，保证 recipient 与 summary 来自同一条记录。\"}\n                      ]\n                    },\n                    {\n                      \"op\": \"select_part\",\n                      \"input\": {\"kind\": \"local\", \"name\": \"record\"},\n                      \"path\": [\"summary\"],\n                      \"output\": \"summary_value\",\n                      \"evidences\": [\n                        {\"basis\": \"source\", \"ref_id\": \"src_003\", \"quote\": \"notify.send 的 body 参数直接取该记录的 summary 字段原值。\", \"reason\": \"源文明确 body 参数直接取 summary 原值，是字段选择而非摘要生成或内容改写。\"}\n                      ]\n                    },\n                    {\n                      \"op\": \"deliver\",\n                      \"inputs\": [{\"kind\": \"local\", \"name\": \"recipient_value\"}, {\"kind\": \"local\", \"name\": \"summary_value\"}],\n                      \"target\": \"loc_notify_send\",\n                      \"evidences\": [\n                        {\"basis\": \"source\", \"ref_id\": \"src_003\", \"quote\": \"对每条选中记录调用一次 notify.send，接收对象取该记录的 recipient 字段。\", \"reason\": \"投递实参仅为同一条记录选出的 recipient 与 summary，顺序对应接收对象与 body；未加入 access_token 等其它字段。\"},\n                        {\"basis\": \"source\", \"ref_id\": \"src_003\", \"quote\": \"整份流程禁止将 access_token 字段发送给任何接收对象。\", \"reason\": \"该禁止限定投递内容不得包含 access_token；这里只记录实际绑定的两个值，没有把禁止项当成已执行的防护动作。\"},\n                        {\"basis\": \"execution_model\", \"ref_id\": \"EM06\", \"quote\": \"delivery must retain actual selected values, input order, result identities, and explicit prohibitions\", \"reason\": \"EM06：投递需保留实际选中的值与明确禁止项，参数范围不因容器整体被保留而扩大。\"}\n                      ]\n                    }\n                  ]\n                }\n  