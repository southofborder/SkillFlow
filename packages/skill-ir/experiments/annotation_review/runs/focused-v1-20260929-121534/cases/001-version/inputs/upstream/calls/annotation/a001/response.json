"{\n  \"profiles\": {\n    \"ir_001\": {\n      \"operator\": [\"agent_runtime\"],\n      \"roles\": [\"source\"],\n      \"effects\": [\"fs_read\"],\n      \"evidences\": [\n        {\"field\": \"operator\", \"value\": \"agent_runtime\", \"basis\": \"source\", \"ref_id\": \"src_003\", \"quote\": \"读取用户提供的 events.json\", \"reason\": \"源文第1步要求读取用户提供的文件，属流程内本地动作，执行主体标注为 agent_runtime；源文未提及模型参与该读取。\"},\n        {\"field\": \"roles\", \"value\": \"source\", \"basis\": \"source\", \"ref_id\": \"src_003\", \"quote\": \"读取用户提供的 events.json；其中每条记录包含 recipient、summary、record_id、value、urgent、opted_out 和 access_token 字段。\", \"reason\": \"读取把该文件当前内容整体引入当前流程，充当 source；内容包含记录的全部字段，未做字段级加工。\"},\n        {\"field\": \"effects\", \"value\": \"fs_read\", \"basis\": \"cfg\", \"ref_id\": \"g_0009\", \"quote\": \"read_file\", \"reason\": \"该 IR 的 opcode 值为 read_file 且输入为文件资源，产生对文件内容的读取效果 fs_read。\", \"effect_index\": 0}\n      ]\n    },\n    \"ir_002\": {\n      \"operator\": [\"agent_runtime\"],\n      \"roles\": [],\n      \"effects\": [],\n      \"evidences\": [\n        {\"field\": \"operator\", \"value\": \"agent_runtime\", \"basis\": \"cfg\", \"ref_id\": \"g_0010\", \"quote\": \"dispatch\", \"reason\": \"该指令是无输入输出的控制转移，由本地运行流程执行跳转，未涉及其他执行主体。\"},\n        {\"field\": \"roles\", \"value\": null, \"basis\": \"cfg\", \"ref_id\": \"g_0010\", \"quote\": \"dispatch\", \"reason\": \"控制跳转不引入、送达或加工内容，没有可支持的 source/sink/transformer 角色标签，故为空。\"},\n        {\"field\": \"effects\", \"value\": null, \"basis\": \"cfg\", \"ref_id\": \"g_0010\", \"quote\": \"dispatch\", \"reason\": \"dispatch 只做控制流转移，不读取、不写入、不发送、不转换内容；词表内无适用效果，但控制转移本身仍影响后续执行顺序。\"}\n      ]\n    },\n    \"ir_003\": {\n      \"operator\": [\"agent_runtime\"],\n      \"roles\": [\"transformer\"],\n      \"effects\": [\"transform\"],\n      \"evidences\": [\n        {\"field\": \"operator\", \"value\": \"agent_runtime\", \"basis\": \"source\", \"ref_id\": \"src_003\", \"quote\": \"仅当 opted_out 不为 true，且 urgent 为 true 或 value 大于等于 100 时