antic_name\": \"search response items\"\n            }\n          ],\n          \"constraints\": [],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"return_items\",\n          \"opcode\": \"return\",\n          \"inputs\": [\n            {\n              \"type\": \"result\",\n              \"identifier\": \"response_items\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"Return the search response's items value unchanged.\"\n          ],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_request\",\n      \"target_block_ref\": \"extract_params\"\n    },\n    {\n      \"source_block_ref\": \"extract_params\",\n      \"target_block_ref\": \"search\"\n    },\n    {\n      \"source_block_ref\": \"search\",\n      \"target_block_ref\": \"post_search\"\n    }\n  ],\n  \"diagnostics\": [\n    \"将 query.yaml 视为 Skill 静态配置，其 missing_arguments 设置以约束形式作用于 index.search；未将其建模为运行时文件读取。\",\n    \"from_date 和 limit 的可选性通过 extract_optional_* 产生的 presence 标志及 index.search 上的约束表示，未拆分为控制流分支，以保持 index.search 只调用一次。\"\n  ]\n}"
