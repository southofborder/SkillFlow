 {\n              \"type\": \"result\",\n              \"identifier\": \"processed_count\"\n            }\n          ],\n          \"constraints\": [],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"go_write\",\n          \"opcode\": \"dispatch\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    },\n    {\n      \"block_ref\": \"write_count\",\n      \"block_name\": \"将处理条数写入本地 count.txt\",\n      \"data_source_kind\": null,\n      \"instructions\": [\n        {\n          \"instruction_ref\": \"write_count\",\n          \"opcode\": \"write_file\",\n          \"inputs\": [\n            {\n              \"type\": \"external_resource\",\n              \"identifier\": \"count.txt\"\n            },\n            {\n              \"type\": \"result\",\n              \"identifier\": \"processed_count\"\n            }\n          ],\n          \"outputs\": [],\n          \"constraints\": [\n            \"处理完成后，将处理条数写入本地 count.txt。\"\n          ],\n          \"metadata\": {}\n        },\n        {\n          \"instruction_ref\": \"finish\",\n          \"opcode\": \"return\",\n          \"inputs\": [],\n          \"outputs\": [],\n          \"constraints\": [],\n          \"metadata\": {}\n        }\n      ],\n      \"constraints\": []\n    }\n  ],\n  \"edges\": [\n    {\n      \"source_block_ref\": \"read_events_file\",\n      \"target_block_ref\": \"select_events\"\n    },\n    {\n      \"source_block_ref\": \"select_events\",\n      \"target_block_ref\": \"send_notifications\"\n    },\n    {\n      \"source_block_ref\": \"send_notifications\",\n      \"target_block_ref\": \"count_processed\"\n    },\n    {\n      \"source_block_ref\": \"count_processed\",\n      \"target_block_ref\": \"write_count\"\n    }\n  ],\n  \"diagnostics\": [\n    \"源文中的“处理条数”未明确是全部记录数还是选中记录数，此处按全部读取并处理的记录数提取。\",\n    \"源文中的每记录循环（对每条选中记录调用 notif