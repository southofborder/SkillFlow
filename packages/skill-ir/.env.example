# Add these entries to the repository-root .env, or set process variables.
# Do not overwrite an existing .env or commit a real API key.
LLM_API_KEY=
LLM_ENDPOINT=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-v4-flash
LLM_REASONING_EFFORT=max

# HTTP transport settings (milliseconds).
LLM_TIMEOUT=180000
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MS=500
LLM_RETRY_MAX_BACKOFF_MS=8000
