{
  "$defs": {
    "AlternativesRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "alternatives",
          "title": "Kind"
        },
        "items": {
          "items": {
            "discriminator": {
              "mapping": {
                "alternatives": "#/$defs/AlternativesRef",
                "input": "#/$defs/InputRef",
                "literal": "#/$defs/LiteralRef",
                "local": "#/$defs/LocalRef"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/InputRef"
              },
              {
                "$ref": "#/$defs/LocalRef"
              },
              {
                "$ref": "#/$defs/LiteralRef"
              },
              {
                "$ref": "#/$defs/AlternativesRef"
              }
            ]
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "items"
      ],
      "title": "AlternativesRef",
      "type": "object"
    },
    "EachStep": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "each",
          "title": "Kind"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EachStep",
      "type": "object"
    },
    "FlatTaskEvidence": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line"
      ],
      "title": "FlatTaskEvidence",
      "type": "object"
    },
    "InputRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "input",
          "title": "Kind"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "index"
      ],
      "title": "InputRef",
      "type": "object"
    },
    "JsonValue": {},
    "LiteralRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "literal",
          "title": "Kind"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "LiteralRef",
      "type": "object"
    },
    "LocalRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "local",
          "title": "Kind"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "LocalRef",
      "type": "object"
    },
    "ScopedSensitivity": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "discriminator": {
            "mapping": {
              "alternatives": "#/$defs/AlternativesRef",
              "input": "#/$defs/InputRef",
              "literal": "#/$defs/LiteralRef",
              "local": "#/$defs/LocalRef"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/InputRef"
            },
            {
              "$ref": "#/$defs/LocalRef"
            },
            {
              "$ref": "#/$defs/LiteralRef"
            },
            {
              "$ref": "#/$defs/AlternativesRef"
            }
          ],
          "title": "Value"
        },
        "path": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "$ref": "#/$defs/EachStep"
              }
            ]
          },
          "title": "Path",
          "type": "array"
        },
        "property": {
          "default": "value",
          "enum": [
            "value",
            "presence",
            "cardinality",
            "shape",
            "truth"
          ],
          "title": "Property",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "evidences": {
          "items": {
            "$ref": "#/$defs/FlatTaskEvidence"
          },
          "title": "Evidences",
          "type": "array"
        },
        "instruction_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Instruction Id",
          "type": "string"
        },
        "scope_path": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "minimum": 0,
                "type": "integer"
              }
            ]
          },
          "title": "Scope Path",
          "type": "array"
        }
      },
      "required": [
        "value",
        "label",
        "instruction_id"
      ],
      "title": "ScopedSensitivity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "declarations": {
      "items": {
        "$ref": "#/$defs/ScopedSensitivity"
      },
      "title": "Declarations",
      "type": "array"
    }
  },
  "title": "SensitivityFragment",
  "type": "object"
}
