{
  "$defs": {
    "CandidateEdge": {
      "additionalProperties": false,
      "description": "A control-flow edge proposed by the LLM.",
      "properties": {
        "source_block_ref": {
          "title": "Source Block Ref",
          "type": "string"
        },
        "target_block_ref": {
          "title": "Target Block Ref",
          "type": "string"
        },
        "condition_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition Text"
        }
      },
      "required": [
        "source_block_ref",
        "target_block_ref"
      ],
      "title": "CandidateEdge",
      "type": "object"
    },
    "ContextOperand": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "context_key",
          "title": "Type"
        },
        "identifier": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Identifier",
          "type": "string"
        }
      },
      "required": [
        "type",
        "identifier"
      ],
      "title": "ContextOperand",
      "type": "object"
    },
    "LiteralOperand": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "literal",
          "title": "Type"
        },
        "literal_value": {
          "description": "The actual JSON value, including explicit null when that is the source value.",
          "title": "Literal Value"
        }
      },
      "required": [
        "type",
        "literal_value"
      ],
      "title": "LiteralOperand",
      "type": "object"
    },
    "ResourceOperand": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "external_resource",
          "title": "Type"
        },
        "identifier": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Identifier",
          "type": "string"
        }
      },
      "required": [
        "type",
        "identifier"
      ],
      "title": "ResourceOperand",
      "type": "object"
    },
    "ResultOperand": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "result",
          "title": "Type"
        },
        "identifier": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Identifier",
          "type": "string"
        }
      },
      "required": [
        "type",
        "identifier"
      ],
      "title": "ResultOperand",
      "type": "object"
    },
    "WireBlock": {
      "additionalProperties": false,
      "properties": {
        "block_ref": {
          "title": "Block Ref",
          "type": "string"
        },
        "block_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Name"
        },
        "data_source_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Source Kind"
        },
        "instructions": {
          "items": {
            "$ref": "#/$defs/WireInstruction"
          },
          "title": "Instructions",
          "type": "array"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        }
      },
      "required": [
        "block_ref"
      ],
      "title": "WireBlock",
      "type": "object"
    },
    "WireInstruction": {
      "additionalProperties": false,
      "properties": {
        "opcode": {
          "title": "Opcode",
          "type": "string"
        },
        "inputs": {
          "items": {
            "discriminator": {
              "mapping": {
                "context_key": "#/$defs/ContextOperand",
                "external_resource": "#/$defs/ResourceOperand",
                "literal": "#/$defs/LiteralOperand",
                "result": "#/$defs/ResultOperand"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LiteralOperand"
              },
              {
                "$ref": "#/$defs/ResultOperand"
              },
              {
                "$ref": "#/$defs/ContextOperand"
              },
              {
                "$ref": "#/$defs/ResourceOperand"
              }
            ]
          },
          "title": "Inputs",
          "type": "array"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/ResultOperand"
          },
          "title": "Outputs",
          "type": "array"
        },
        "constraints": {
          "items": {
            "type": "string"
          },
          "title": "Constraints",
          "type": "array"
        },
        "metadata": {
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "opcode"
      ],
      "title": "WireInstruction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entry_block_ref": {
      "title": "Entry Block Ref",
      "type": "string"
    },
    "blocks": {
      "items": {
        "$ref": "#/$defs/WireBlock"
      },
      "title": "Blocks",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/CandidateEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "constraints": {
      "items": {
        "type": "string"
      },
      "title": "Constraints",
      "type": "array"
    },
    "diagnostics": {
      "items": {
        "type": "string"
      },
      "title": "Diagnostics",
      "type": "array"
    }
  },
  "required": [
    "entry_block_ref",
    "blocks"
  ],
  "title": "CFGWire",
  "type": "object"
}